# Clave de API de Google Gemini (Google AI Studio)
# Obtenela en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Twitter / X Bot Automation (@politicheck_ok)
# Obtenelas gratis en: https://developer.x.com/en/portal/dashboard
# Asegurate de configurar permisos de 'Read and Write' en tu App de X
TWITTER_API_KEY=your_twitter_consumer_key
TWITTER_API_SECRET=your_twitter_consumer_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# Vercel Cron Secret (opcional, para proteger la ruta de sincronización en producción)
CRON_SECRET=politicheck_cron_dev_secret

# Puerto de desarrollo local (opcional)
PORT=4321

