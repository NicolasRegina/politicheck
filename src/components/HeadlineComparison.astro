---
import type { Article } from '../types';
import { getOutletMeta } from '../utils/outlets';

interface Props {
  articles: Article[];
  storyId: string;
  isLeadStory?: boolean;
}

const { articles, storyId, isLeadStory = false } = Astro.props;

const FACTUALITY_LABELS: Record<string, string> = {
  muy_alta: 'Factualidad: Muy Alta',
  alta: 'Factualidad: Alta',
  mixta: 'Factualidad: Mixta',
};

const FUNDING_LABELS: Record<string, string> = {
  privado_corporativo: 'Privado',
  sindical_partidario: 'Sindical / Partidario',
  publico_estatal: 'Público / Estatal',
  independiente_suscripcion: 'Independiente',
};

const enrichedArticles = articles.map((art) => {
  const outlet = getOutletMeta(art.outletId);
  return {
    art,
    outlet,
    leaning: outlet.baselineLeaning,
    factualityLabel: FACTUALITY_LABELS[outlet.factuality] || 'Factualidad: Alta',
    fundingLabel: FUNDING_LABELS[outlet.ownership?.fundingType] || 'Privado',
    ownerGroup: outlet.ownership?.group || 'Medio auditado',
  };
});

const ofiArticles = enrichedArticles.filter((e) => e.leaning === 'oficialismo');
const opoArticles = enrichedArticles.filter((e) => e.leaning === 'oposicion');
const cenArticles = enrichedArticles.filter((e) => e.leaning === 'centro_datos');

const leaningCounts = {
  all: articles.length,
  oficialismo: ofiArticles.length,
  centro_datos: cenArticles.length,
  oposicion: opoArticles.length,
};

// Pick initial active mobile tab with content
const initialMobilePole = ofiArticles.length > 0 ? 'oficialismo' : (opoArticles.length > 0 ? 'oposicion' : 'centro_datos');
---

<div class="headline-comparison-container space-y-5" data-story-id={storyId}>
  <!-- Top Controls: View Mode Switcher (Cara a Cara default | Vista Grilla) -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule pb-3">
    <div class="inline-flex items-center p-0.5 rounded-md bg-surface-muted border border-rule text-xs font-sans" role="tablist" aria-label="Modo de visualización del comparador">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-view-mode="cara-a-cara"
        class="view-mode-btn px-3 py-1 rounded-md bg-ink text-canvas font-semibold transition-colors cursor-pointer"
      >
        Cara a Cara
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-view-mode="grilla"
        class="view-mode-btn px-3 py-1 rounded-md text-ink-muted hover:text-ink font-medium transition-colors cursor-pointer"
      >
        Vista Grilla ({articles.length})
      </button>
    </div>

    <span class="filter-status-badge text-[11px] font-mono text-ink-muted">
      {articles.length} medios cotejados
    </span>
  </div>

  <!-- =========================================================================
       MODE 1: CARA A CARA (DEFAULT — ADR-0008 Feature #2)
       ========================================================================= -->
  <div class="cara-a-cara-view space-y-5">
    <!-- Mobile Pole Switcher (<md) -->
    <div class="flex md:hidden items-center gap-1.5 overflow-x-auto pb-1 text-xs font-mono">
      <button
        type="button"
        data-mobile-pole="oficialismo"
        class={`mobile-pole-btn px-2.5 py-1.5 rounded-md border transition-colors whitespace-nowrap cursor-pointer inline-flex items-center gap-1.5 ${initialMobilePole === 'oficialismo' ? 'bg-ink text-canvas border-ink font-semibold' : 'bg-surface border-rule text-ink-muted'}`}
      >
        <span class="w-2 h-2 rounded-full bg-spec-ofi"></span>
        <span>Oficialismo ({ofiArticles.length})</span>
      </button>
      <button
        type="button"
        data-mobile-pole="oposicion"
        class={`mobile-pole-btn px-2.5 py-1.5 rounded-md border transition-colors whitespace-nowrap cursor-pointer inline-flex items-center gap-1.5 ${initialMobilePole === 'oposicion' ? 'bg-ink text-canvas border-ink font-semibold' : 'bg-surface border-rule text-ink-muted'}`}
      >
        <span class="w-2 h-2 rounded-full bg-spec-opo"></span>
        <span>Oposición ({opoArticles.length})</span>
      </button>
      <button
        type="button"
        data-mobile-pole="centro_datos"
        class={`mobile-pole-btn px-2.5 py-1.5 rounded-md border transition-colors whitespace-nowrap cursor-pointer inline-flex items-center gap-1.5 ${initialMobilePole === 'centro_datos' ? 'bg-ink text-canvas border-ink font-semibold' : 'bg-surface border-rule text-ink-muted'}`}
      >
        <span class="w-2 h-2 rounded-full bg-spec-cen"></span>
        <span>Centro ({cenArticles.length})</span>
      </button>
    </div>

    <!-- 2 Parallel Columns: Oficialismo vs Oposición -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- Oficialismo Column -->
      <div
        class={`pole-column space-y-3 ${initialMobilePole !== 'oficialismo' ? 'hidden md:block' : ''}`}
        data-pole-col="oficialismo"
      >
        <div class="flex items-center justify-between pb-2 border-b-2 border-spec-ofi text-xs font-mono uppercase tracking-wider">
          <span class="inline-flex items-center gap-2 font-bold text-ink">
            <span class="w-2.5 h-2.5 rounded-full bg-spec-ofi"></span>
            Oficialismo
          </span>
          <span class="text-ink-muted">{ofiArticles.length} {ofiArticles.length === 1 ? 'medio' : 'medios'}</span>
        </div>

        {ofiArticles.length > 0 ? (
          <div class="space-y-3">
            {ofiArticles.map(({ art, outlet, factualityLabel, fundingLabel, ownerGroup }) => (
              <a
                href={art.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block p-4 rounded-md bg-surface border border-rule hover:border-ink-muted/70 transition-colors space-y-2"
              >
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <div class="min-w-0">
                    <div class="font-sans text-xs font-bold text-ink">{outlet.name}</div>
                    <div class="font-sans text-[11px] text-ink-muted truncate max-w-[240px]" title={`${ownerGroup} · ${fundingLabel}`}>
                      {ownerGroup} · {fundingLabel}
                    </div>
                  </div>
                  <span class="shrink-0 px-2 py-0.5 rounded bg-surface-muted border border-rule font-mono text-[10px] font-semibold text-ink-secondary">
                    {factualityLabel}
                  </span>
                </div>

                <h4 class="font-editorial text-base font-bold text-ink group-hover:text-accent leading-[1.22] transition-colors">
                  “{art.title}”
                </h4>

                {art.snippet && (
                  <p class="text-xs text-ink-secondary line-clamp-2 leading-relaxed font-sans">
                    {art.snippet}
                  </p>
                )}

                <div class="flex items-center justify-between text-[11px] font-mono text-ink-muted pt-2 border-t border-rule">
                  <span>{art.publishedAt}</span>
                  <span class="inline-flex items-center gap-1 text-accent font-semibold group-hover:underline">
                    Leer en {art.outletName} ↗
                  </span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="p-5 rounded-md bg-surface-muted/60 border border-dashed border-rule text-xs text-ink-muted font-sans">
            Ningún medio de línea oficialista registró cobertura de esta historia en el período analizado.
          </div>
        )}
      </div>

      <!-- Oposición Column -->
      <div
        class={`pole-column space-y-3 ${initialMobilePole !== 'oposicion' ? 'hidden md:block' : ''}`}
        data-pole-col="oposicion"
      >
        <div class="flex items-center justify-between pb-2 border-b-2 border-spec-opo text-xs font-mono uppercase tracking-wider">
          <span class="inline-flex items-center gap-2 font-bold text-ink">
            <span class="w-2.5 h-2.5 rounded-full bg-spec-opo"></span>
            Oposición
          </span>
          <span class="text-ink-muted">{opoArticles.length} {opoArticles.length === 1 ? 'medio' : 'medios'}</span>
        </div>

        {opoArticles.length > 0 ? (
          <div class="space-y-3">
            {opoArticles.map(({ art, outlet, factualityLabel, fundingLabel, ownerGroup }) => (
              <a
                href={art.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block p-4 rounded-md bg-surface border border-rule hover:border-ink-muted/70 transition-colors space-y-2"
              >
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <div class="min-w-0">
                    <div class="font-sans text-xs font-bold text-ink">{outlet.name}</div>
                    <div class="font-sans text-[11px] text-ink-muted truncate max-w-[240px]" title={`${ownerGroup} · ${fundingLabel}`}>
                      {ownerGroup} · {fundingLabel}
                    </div>
                  </div>
                  <span class="shrink-0 px-2 py-0.5 rounded bg-surface-muted border border-rule font-mono text-[10px] font-semibold text-ink-secondary">
                    {factualityLabel}
                  </span>
                </div>

                <h4 class="font-editorial text-base font-bold text-ink group-hover:text-accent leading-[1.22] transition-colors">
                  “{art.title}”
                </h4>

                {art.snippet && (
                  <p class="text-xs text-ink-secondary line-clamp-2 leading-relaxed font-sans">
                    {art.snippet}
                  </p>
                )}

                <div class="flex items-center justify-between text-[11px] font-mono text-ink-muted pt-2 border-t border-rule">
                  <span>{art.publishedAt}</span>
                  <span class="inline-flex items-center gap-1 text-accent font-semibold group-hover:underline">
                    Leer en {art.outletName} ↗
                  </span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="p-5 rounded-md bg-surface-muted/60 border border-dashed border-rule text-xs text-ink-muted font-sans">
            Ningún medio de línea opositora registró cobertura de esta historia en el período analizado.
          </div>
        )}
      </div>
    </div>

    <!-- Reference Strip: Centro / Datos -->
    {cenArticles.length > 0 && (
      <div
        class={`pole-column rounded-md bg-surface-muted border border-rule p-4 space-y-3 ${initialMobilePole !== 'centro_datos' ? 'hidden md:block' : ''}`}
        data-pole-col="centro_datos"
      >
        <div class="flex items-center justify-between border-b border-rule pb-2 text-xs font-mono uppercase tracking-wider">
          <span class="inline-flex items-center gap-2 font-bold text-ink">
            <span class="w-2.5 h-2.5 rounded-full bg-spec-cen"></span>
            Referencia Centro / Datos
          </span>
          <span class="text-ink-muted">{cenArticles.length} {cenArticles.length === 1 ? 'medio' : 'medios'}</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {cenArticles.map(({ art, outlet, factualityLabel, fundingLabel, ownerGroup }) => (
            <a
              href={art.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block p-3.5 rounded-md bg-surface border border-rule hover:border-ink-muted/70 transition-colors space-y-1.5"
            >
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div class="min-w-0">
                  <div class="font-sans text-xs font-bold text-ink">{outlet.name}</div>
                  <div class="font-sans text-[11px] text-ink-muted truncate max-w-[220px]">
                    {ownerGroup} · {fundingLabel}
                  </div>
                </div>
                <span class="shrink-0 px-2 py-0.5 rounded bg-surface-muted border border-rule font-mono text-[10px] font-semibold text-ink-secondary">
                  {factualityLabel}
                </span>
              </div>

              <h4 class="font-editorial text-sm sm:text-base font-bold text-ink group-hover:text-accent leading-snug transition-colors">
                “{art.title}”
              </h4>

              <div class="flex items-center justify-between text-[11px] font-mono text-ink-muted pt-1.5 border-t border-rule">
                <span>{art.publishedAt}</span>
                <span class="text-accent font-semibold group-hover:underline">Leer ↗</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- =========================================================================
       MODE 2: VISTA GRILLA ENRIQUECIDA (Sin paginado prematuro de a 4 — Fix #8)
       ========================================================================= -->
  <div class="grilla-view hidden space-y-4">
    <!-- Non-partisan Leaning Filter Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto text-[11px] font-mono py-0.5 filter-buttons-row">
      <button
        type="button"
        class="filter-pill-btn active px-3 py-1 rounded-md bg-ink text-canvas font-semibold transition-colors cursor-pointer border border-ink"
        data-filter="all"
      >
        Todos ({leaningCounts.all})
      </button>

      {leaningCounts.oficialismo > 0 && (
        <button
          type="button"
          class="filter-pill-btn px-2.5 py-1 rounded-md bg-surface hover:border-ink text-ink-secondary border border-rule transition-colors cursor-pointer inline-flex items-center gap-1.5"
          data-filter="oficialismo"
        >
          <span class="w-2 h-2 rounded-full bg-spec-ofi"></span>
          <span>Oficialismo ({leaningCounts.oficialismo})</span>
        </button>
      )}

      {leaningCounts.centro_datos > 0 && (
        <button
          type="button"
          class="filter-pill-btn px-2.5 py-1 rounded-md bg-surface hover:border-ink text-ink-secondary border border-rule transition-colors cursor-pointer inline-flex items-center gap-1.5"
          data-filter="centro_datos"
        >
          <span class="w-2 h-2 rounded-full bg-spec-cen"></span>
          <span>Centro / Datos ({leaningCounts.centro_datos})</span>
        </button>
      )}

      {leaningCounts.oposicion > 0 && (
        <button
          type="button"
          class="filter-pill-btn px-2.5 py-1 rounded-md bg-surface hover:border-ink text-ink-secondary border border-rule transition-colors cursor-pointer inline-flex items-center gap-1.5"
          data-filter="oposicion"
        >
          <span class="w-2 h-2 rounded-full bg-spec-opo"></span>
          <span>Oposición ({leaningCounts.oposicion})</span>
        </button>
      )}
    </div>

    <!-- Cards Grid (shows up to 8 before optional expand) -->
    <div class={`articles-grid grid gap-3.5 ${isLeadStory ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1'}`}>
      {enrichedArticles.map(({ art, outlet, leaning, factualityLabel, fundingLabel, ownerGroup }) => (
        <a
          href={art.url}
          target="_blank"
          rel="noopener noreferrer"
          class="article-comparison-card group block p-4 rounded-md bg-surface border border-rule hover:border-ink-muted/70 transition-colors space-y-2"
          data-leaning={leaning}
        >
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class={`w-2 h-2 rounded-full shrink-0 ${leaning === 'oficialismo' ? 'bg-spec-ofi' : leaning === 'oposicion' ? 'bg-spec-opo' : 'bg-spec-cen'}`}></span>
                <span class="font-sans text-xs font-bold text-ink">{outlet.name}</span>
              </div>
              <div class="font-sans text-[11px] text-ink-muted truncate max-w-[240px]" title={`${ownerGroup} · ${fundingLabel}`}>
                {ownerGroup} · {fundingLabel}
              </div>
            </div>
            <span class="shrink-0 px-2 py-0.5 rounded bg-surface-muted border border-rule font-mono text-[10px] font-semibold text-ink-secondary">
              {factualityLabel}
            </span>
          </div>

          {art.specificFocus && (
            <div class="text-[11px] font-sans text-ink-muted">
              Foco: <span class="text-ink-secondary font-medium">{art.specificFocus}</span>
            </div>
          )}

          <h4 class="font-editorial text-base font-bold text-ink group-hover:text-accent leading-[1.22] transition-colors">
            “{art.title}”
          </h4>

          {art.snippet && (
            <p class="text-xs text-ink-secondary line-clamp-2 leading-relaxed font-sans">
              {art.snippet}
            </p>
          )}

          <div class="flex items-center justify-between text-[11px] font-mono text-ink-muted pt-2 border-t border-rule">
            <span>{art.publishedAt}</span>
            <span class="inline-flex items-center gap-1 text-accent font-semibold group-hover:underline">
              Ir a {art.outletName} ↗
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Expand button if > 8 cards -->
    <div class="expand-more-wrap hidden pt-2 text-center">
      <button
        type="button"
        class="expand-more-btn px-4 py-2 rounded-md border border-rule bg-surface hover:border-ink text-xs font-sans font-semibold text-ink transition-colors cursor-pointer"
      >
        Ver todos los medios restantes
      </button>
    </div>
  </div>
</div>

<script>
  function initHeadlineComparators() {
    const containers = document.querySelectorAll('.headline-comparison-container');
    containers.forEach(container => {
      if (container.hasAttribute('data-initialized')) return;
      container.setAttribute('data-initialized', 'true');

      const viewModeBtns = Array.from(container.querySelectorAll<HTMLButtonElement>('.view-mode-btn'));
      const caraView = container.querySelector<HTMLElement>('.cara-a-cara-view');
      const grillaView = container.querySelector<HTMLElement>('.grilla-view');

      const mobilePoleBtns = Array.from(container.querySelectorAll<HTMLButtonElement>('.mobile-pole-btn'));
      const poleCols = Array.from(container.querySelectorAll<HTMLElement>('.pole-column'));

      const cards = Array.from(container.querySelectorAll<HTMLElement>('.article-comparison-card'));
      const filterBtns = Array.from(container.querySelectorAll<HTMLButtonElement>('.filter-pill-btn'));
      const expandWrap = container.querySelector<HTMLElement>('.expand-more-wrap');
      const expandBtn = container.querySelector<HTMLButtonElement>('.expand-more-btn');
      const filterStatusBadge = container.querySelector<HTMLElement>('.filter-status-badge');

      let currentFilter = 'all';
      let showAll = false;
      const initialLimit = 8;

      function switchViewMode(mode: 'cara-a-cara' | 'grilla') {
        viewModeBtns.forEach(btn => {
          const isActive = btn.getAttribute('data-view-mode') === mode;
          btn.setAttribute('aria-selected', String(isActive));
          btn.classList.toggle('bg-ink', isActive);
          btn.classList.toggle('text-canvas', isActive);
          btn.classList.toggle('font-semibold', isActive);
          btn.classList.toggle('text-ink-muted', !isActive);
          btn.classList.toggle('font-medium', !isActive);
        });
        if (caraView && grillaView) {
          caraView.classList.toggle('hidden', mode !== 'cara-a-cara');
          grillaView.classList.toggle('hidden', mode !== 'grilla');
        }
      }

      viewModeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-view-mode') === 'grilla' ? 'grilla' : 'cara-a-cara';
          switchViewMode(mode);
        });
      });

      // Mobile pole tabs inside Cara a Cara
      mobilePoleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const pole = btn.getAttribute('data-mobile-pole');
          if (!pole) return;
          mobilePoleBtns.forEach(b => {
            const active = b.getAttribute('data-mobile-pole') === pole;
            b.classList.toggle('bg-ink', active);
            b.classList.toggle('text-canvas', active);
            b.classList.toggle('border-ink', active);
            b.classList.toggle('font-semibold', active);
            b.classList.toggle('bg-surface', !active);
            b.classList.toggle('border-rule', !active);
            b.classList.toggle('text-ink-muted', !active);
          });
          poleCols.forEach(col => {
            const match = col.getAttribute('data-pole-col') === pole;
            col.classList.toggle('hidden', !match);
            col.classList.add('md:block');
          });
        });
      });

      function renderGrilla() {
        const filtered = cards.filter(card => {
          if (currentFilter === 'all') return true;
          return card.getAttribute('data-leaning') === currentFilter;
        });

        cards.forEach(c => c.classList.add('hidden'));
        const visibleCount = showAll ? filtered.length : Math.min(filtered.length, initialLimit);
        filtered.slice(0, visibleCount).forEach(c => c.classList.remove('hidden'));

        if (filterStatusBadge) {
          filterStatusBadge.textContent = `${filtered.length} ${filtered.length === 1 ? 'medio' : 'medios'} cotejados`;
        }

        if (expandWrap && expandBtn) {
          const remaining = filtered.length - visibleCount;
          if (remaining > 0) {
            expandWrap.classList.remove('hidden');
            expandBtn.textContent = `Ver los ${remaining} medios restantes`;
          } else {
            expandWrap.classList.add('hidden');
          }
        }
      }

      function applyLeaningFilter(leaning: string) {
        currentFilter = leaning;
        showAll = false;
        filterBtns.forEach(b => {
          const active = b.getAttribute('data-filter') === leaning;
          b.classList.toggle('active', active);
          b.classList.toggle('bg-ink', active);
          b.classList.toggle('text-canvas', active);
          b.classList.toggle('border-ink', active);
          b.classList.toggle('font-semibold', active);
          b.classList.toggle('bg-surface', !active);
          b.classList.toggle('text-ink-secondary', !active);
          b.classList.toggle('border-rule', !active);
        });
        renderGrilla();
      }

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          applyLeaningFilter(btn.getAttribute('data-filter') || 'all');
        });
      });

      if (expandBtn) {
        expandBtn.addEventListener('click', () => {
          showAll = true;
          renderGrilla();
        });
      }

      renderGrilla();

      // Read ?sesgo= query param from Portada SpectrumBar navigation (Fix #2)
      const urlSesgo = new URLSearchParams(window.location.search).get('sesgo');
      if (urlSesgo && ['oficialismo', 'centro_datos', 'oposicion'].includes(urlSesgo)) {
        switchViewMode('grilla');
        applyLeaningFilter(urlSesgo);
      }

      // Wire clicks on in-page SpectrumBar triggers
      document.querySelectorAll('.spectrum-filter-trigger').forEach(trigger => {
        trigger.addEventListener('click', () => {
          const leaning = trigger.getAttribute('data-trigger-leaning');
          if (!leaning) return;
          switchViewMode('grilla');
          applyLeaningFilter(leaning);
          document.getElementById('comparativa')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    });
  }

  initHeadlineComparators();
  document.addEventListener('astro:page-load', initHeadlineComparators);
</script>
