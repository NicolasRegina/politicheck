---
// src/components/ShareModal.astro
---

<dialog 
  id="politicheck-share-modal" 
  class="backdrop:bg-slate-950/80 backdrop:backdrop-blur-sm fixed inset-0 m-auto z-50 p-0 rounded-3xl bg-white dark:bg-navy-dark text-slate-900 dark:text-slate-100 border border-slate-200 dark:border-slate-800 shadow-2xl max-w-lg w-[calc(100%-2rem)] max-h-[92vh] overflow-y-auto open:animate-in open:fade-in-0 open:zoom-in-95"
>
  <div class="p-5 sm:p-6 space-y-4">
    <!-- Header -->
    <div class="flex items-start justify-between gap-3 border-b border-slate-100 dark:border-slate-800/80 pb-3.5">
      <div>
        <div class="flex items-center gap-2 text-xs font-sans font-semibold text-slate-500 dark:text-slate-400">
          <span id="share-modal-category">Difusión cívica</span>
        </div>
        <h3 id="share-modal-title" class="font-editorial text-xl sm:text-2xl font-bold text-slate-950 dark:text-white mt-0.5">
          Difusión y placa para redes
        </h3>
      </div>
      <button 
        type="button" 
        id="share-modal-close-btn"
        class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 flex items-center justify-center text-slate-500 dark:text-slate-300 text-sm font-bold transition-colors cursor-pointer"
        aria-label="Cerrar modal"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <!-- Visual Graphic Card Section (1080x1080 Canvas Generator) -->
    <div class="space-y-2.5">
      <div class="flex items-center justify-between text-xs font-sans">
        <span class="text-slate-700 dark:text-slate-300 font-semibold flex items-center gap-1.5">
          <svg aria-hidden="true" class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          <span>Placa visual autogenerada (1:1 HD)</span>
        </span>
        <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-bold">Lista para WhatsApp y redes</span>
      </div>

      <!-- Preview Box with canvas rendered as image -->
      <div class="relative rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800/90 bg-header-dark shadow-sm flex items-center justify-center aspect-[16/10] sm:aspect-[16/9] max-h-[220px]">
        <canvas id="share-card-canvas" width="1080" height="1080" class="hidden" aria-hidden="true"></canvas>
        <img 
          id="share-card-preview-img" 
          src="" 
          alt="Vista previa de la placa gráfica" 
          class="w-full h-full object-contain"
        />
        <div id="share-card-loading" class="absolute inset-0 flex items-center justify-center bg-slate-950/70 text-slate-300 text-xs font-sans gap-2">
          <span class="w-4 h-4 border-2 border-current border-t-transparent rounded-full motion-safe:animate-spin" aria-hidden="true"></span>
          <span>Generando placa...</span>
        </div>
      </div>

      <!-- Primary Action: 1-Click Clipboard Image Copy & Direct Download -->
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 pt-0.5">
        <button 
          type="button"
          id="btn-copy-card-image"
          class="sm:col-span-8 flex items-center justify-center gap-2 py-2.5 px-3.5 rounded-xl bg-navy-dark hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-950 font-sans text-xs font-bold shadow-xs hover:shadow-md transition-colors cursor-pointer"
        >
          <span id="btn-copy-card-icon" aria-hidden="true">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
          </span>
          <span id="btn-copy-card-text">Copiar placa al portapapeles</span>
        </button>

        <button 
          type="button"
          id="btn-download-card-image"
          class="sm:col-span-4 flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-sans text-xs font-semibold transition-colors cursor-pointer shadow-2xs"
          title="Descargar imagen PNG en alta definición"
        >
          <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
          <span>Descargar</span>
        </button>
      </div>

      <div id="share-clipboard-feedback" class="hidden p-2 rounded-lg text-center font-sans text-[11px]"></div>
    </div>

    <!-- Message Preview Box -->
    <div class="space-y-1.5 pt-1 border-t border-slate-100 dark:border-slate-800/80">
      <div class="flex items-center justify-between text-[11px] font-sans text-slate-500 dark:text-slate-400">
        <span>Texto prediseñado con enlace:</span>
        <span>1 clic para enviar</span>
      </div>
      <div 
        id="share-modal-preview" 
        class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs font-sans text-slate-700 dark:text-slate-300 leading-relaxed italic max-h-20 overflow-y-auto"
      >
      </div>
    </div>

    <!-- Quick Social Link Triggers -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-0.5">
      <!-- WhatsApp -->
      <a 
        id="share-btn-wa" 
        href="#" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-1.5 py-2 px-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-sans text-xs font-bold shadow-2xs transition-colors"
      >
        <svg aria-hidden="true" class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>WhatsApp</span>
      </a>

      <!-- X (Twitter) -->
      <a 
        id="share-btn-x" 
        href="#" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-1.5 py-2 px-2.5 rounded-xl bg-black hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-200 text-white dark:text-black font-sans text-xs font-bold shadow-2xs transition-colors"
      >
        <span class="text-xs font-bold font-mono">𝕏</span>
        <span>Twitter</span>
      </a>

      <!-- Telegram -->
      <a 
        id="share-btn-tg" 
        href="#" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-1.5 py-2 px-2.5 rounded-xl bg-sky-500 hover:bg-sky-600 text-white font-sans text-xs font-bold shadow-2xs transition-colors"
      >
        <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
        <span>Telegram</span>
      </a>

      <!-- Copy Link -->
      <button 
        type="button" 
        id="share-btn-copy" 
        class="flex items-center justify-center gap-1.5 py-2 px-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 font-sans text-xs font-bold transition-colors cursor-pointer shadow-2xs"
      >
        <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
        <span id="share-copy-label">Enlace</span>
      </button>
    </div>

    <!-- Mobile Native Share (Conditional) -->
    <div id="share-native-wrapper" class="hidden pt-0.5">
      <button 
        type="button" 
        id="share-btn-native"
        class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-sans text-xs font-semibold transition-colors cursor-pointer"
      >
        <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
        <span>Más aplicaciones en tu teléfono</span>
      </button>
    </div>
  </div>
</dialog>

<script is:inline>
  (() => {
    const modal = document.getElementById('politicheck-share-modal');
    const closeBtn = document.getElementById('share-modal-close-btn');
    const previewEl = document.getElementById('share-modal-preview');
    const titleEl = document.getElementById('share-modal-title');
    const categoryEl = document.getElementById('share-modal-category');
    const btnWa = document.getElementById('share-btn-wa');
    const btnX = document.getElementById('share-btn-x');
    const btnTg = document.getElementById('share-btn-tg');
    const btnCopy = document.getElementById('share-btn-copy');
    const copyLabel = document.getElementById('share-copy-label');
    const nativeWrapper = document.getElementById('share-native-wrapper');
    const btnNative = document.getElementById('share-btn-native');

    // Canvas elements
    const canvas = document.getElementById('share-card-canvas');
    const previewImg = document.getElementById('share-card-preview-img');
    const cardLoading = document.getElementById('share-card-loading');
    const btnCopyCard = document.getElementById('btn-copy-card-image');
    const btnCopyCardText = document.getElementById('btn-copy-card-text');
    const btnDownloadCard = document.getElementById('btn-download-card-image');
    const feedbackBox = document.getElementById('share-clipboard-feedback');

    let currentShareData = {
      title: 'Politicheck Argentina',
      headline: '',
      text: 'Observatorio de medios y compromisos electorales',
      url: window.location.href,
      category: 'Difusión Cívica',
      spectrum: { oficialismo: 0, centro: 0, oposicion: 0 },
      outlets: ''
    };

    let generatedCardBlob = null;

    function closeModal() {
      if (modal && modal.open) {
        modal.close();
      }
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    // Close on backdrop click
    if (modal) {
      modal.addEventListener('click', (e) => {
        const rect = modal.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) closeModal();
      });
    }

    // Helper: Wrap text on Canvas
    function wrapText(ctx, text, x, y, maxWidth, lineHeight, maxLines = 4) {
      const words = text.split(' ');
      let line = '';
      let linesDrawn = 0;

      for (let n = 0; n < words.length; n++) {
        const testLine = line + words[n] + ' ';
        const metrics = ctx.measureText(testLine);
        const testWidth = metrics.width;

        if (testWidth > maxWidth && n > 0) {
          linesDrawn++;
          if (linesDrawn >= maxLines) {
            ctx.fillText(line.trim() + '...', x, y);
            return y + lineHeight;
          }
          ctx.fillText(line.trim(), x, y);
          line = words[n] + ' ';
          y += lineHeight;
        } else {
          line = testLine;
        }
      }

      ctx.fillText(line.trim(), x, y);
      return y + lineHeight;
    }

    // Draw Vector P-Checkmark Logo directly on 2D Canvas
    function drawBrandLogo(ctx, cx, cy, radius) {
      // 1. Base dark circle
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.fillStyle = '#0B111A';
      ctx.fill();

      // 2. Ivory perimeter ring
      ctx.lineWidth = radius * 0.08;
      ctx.strokeStyle = '#F4F2EB';
      ctx.stroke();

      // 3. Architectural white letter 'P'
      ctx.fillStyle = '#F8F9FA';
      ctx.font = `bold ${Math.round(radius * 1.05)}px 'Inter', sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('P', cx - radius * 0.12, cy - radius * 0.02);

      // 4. Argentine light-blue checkmark dot
      ctx.beginPath();
      ctx.arc(cx + radius * 0.44, cy + radius * 0.38, radius * 0.22, 0, Math.PI * 2);
      ctx.fillStyle = '#6BA4D9';
      ctx.fill();

      // Reset alignment
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
    }

    // Native HTML5 Canvas 1080x1080 Visual Share Card Generator
    async function renderGraphicCard() {
      if (!canvas) return;
      if (cardLoading) cardLoading.classList.remove('hidden');

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const width = 1080;
      const height = 1080;

      // 1. Background: Deep rich dark canvas with subtle gradient
      const bgGrad = ctx.createLinearGradient(0, 0, width, height);
      bgGrad.addColorStop(0, '#0F1626');
      bgGrad.addColorStop(0.5, '#0A0E17');
      bgGrad.addColorStop(1, '#07090F');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, width, height);

      // Outer accent border
      ctx.strokeStyle = '#1E293B';
      ctx.lineWidth = 14;
      ctx.strokeRect(7, 7, width - 14, height - 14);

      // 2. Header: Logo, Institutional Title & Category Badge
      drawBrandLogo(ctx, 110, 110, 48);

      ctx.fillStyle = '#F8F9FA';
      ctx.font = "900 42px 'Plus Jakarta Sans', sans-serif";
      ctx.fillText('POLITICHECK', 180, 115);

      ctx.fillStyle = '#94A3B8';
      ctx.font = "500 16px 'JetBrains Mono', monospace";
      ctx.fillText('OBSERVATORIO DE COBERTURA & AUDITORÍA CÍVICA', 182, 145);

      // Category Pill at top right
      const category = (currentShareData.category || 'POLÍTICA').toUpperCase();
      ctx.font = "bold 18px 'JetBrains Mono', monospace";
      const catMetrics = ctx.measureText(category);
      const catBoxWidth = catMetrics.width + 36;
      const catBoxX = width - 80 - catBoxWidth;

      ctx.fillStyle = '#1E293B';
      ctx.beginPath();
      ctx.roundRect(catBoxX, 85, catBoxWidth, 44, 22);
      ctx.fill();
      ctx.strokeStyle = '#334155';
      ctx.lineWidth = 2;
      ctx.stroke();

      ctx.fillStyle = '#6BA4D9';
      ctx.fillText(category, catBoxX + 18, 113);

      // Top separator rule
      ctx.strokeStyle = '#1E293B';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(80, 190);
      ctx.lineTo(width - 80, 190);
      ctx.stroke();

      // 3. Volanta / Kicker
      ctx.fillStyle = '#6BA4D9';
      ctx.font = "bold 18px 'JetBrains Mono', monospace";
      ctx.fillText('🗞️ CRUCE SIMULTÁNEO DE REDACCIONES', 80, 240);

      // 4. Grand Headline
      ctx.fillStyle = '#FFFFFF';
      ctx.font = "bold 44px 'Newsreader', serif, sans-serif";
      const headlineText = currentShareData.headline || currentShareData.title || 'Cobertura periodística del día';
      const endY = wrapText(ctx, headlineText, 80, 310, width - 160, 56, 4);

      // 5. Outlets cited
      if (currentShareData.outlets) {
        ctx.fillStyle = '#94A3B8';
        ctx.font = "18px 'Inter', sans-serif";
        ctx.fillText(`Medios contrastados: ${currentShareData.outlets}`, 80, Math.min(endY + 30, 570));
      }

      // 6. Spectrum Card Container
      const spectrumCardY = 620;
      const spectrumCardH = 260;

      ctx.fillStyle = '#0F1626';
      ctx.beginPath();
      ctx.roundRect(80, spectrumCardY, width - 160, spectrumCardH, 20);
      ctx.fill();
      ctx.strokeStyle = '#1E293B';
      ctx.lineWidth = 2;
      ctx.stroke();

      // Spectrum Card Title
      ctx.fillStyle = '#E2E8F0';
      ctx.font = "bold 20px 'JetBrains Mono', monospace";
      ctx.fillText('ESPECTRO DE ENCUADRE EDITORIAL', 115, spectrumCardY + 45);

      ctx.fillStyle = '#64748B';
      ctx.font = "14px 'JetBrains Mono', monospace";
      ctx.fillText('Basado en análisis de IA neutral sobre fuentes RSS públicas', 115, spectrumCardY + 75);

      // Spectrum Horizontal Bar
      const barX = 115;
      const barY = spectrumCardY + 105;
      const barW = width - 230;
      const barH = 34;

      const ofi = currentShareData.spectrum.oficialismo || 0;
      const cen = currentShareData.spectrum.centro || 0;
      const opo = currentShareData.spectrum.oposicion || 0;

      // Base bar background
      ctx.fillStyle = '#1E293B';
      ctx.beginPath();
      ctx.roundRect(barX, barY, barW, barH, 17);
      ctx.fill();

      // Render Bar Segments
      let curX = barX;
      if (ofi > 0) {
        const segW = (barW * ofi) / 100;
        ctx.fillStyle = '#8B5CF6'; // Violet Oficialismo
        ctx.beginPath();
        ctx.roundRect(curX, barY, segW, barH, [17, 0, 0, 17]);
        ctx.fill();
        curX += segW;
      }
      if (cen > 0) {
        const segW = (barW * cen) / 100;
        ctx.fillStyle = '#10B981'; // Emerald Centro
        ctx.beginPath();
        ctx.roundRect(curX, barY, segW, barH, (ofi === 0 ? [17, 0, 0, 17] : [0, 0, 0, 0]));
        ctx.fill();
        curX += segW;
      }
      if (opo > 0) {
        const segW = (barW * opo) / 100;
        ctx.fillStyle = '#F59E0B'; // Amber Oposición
        ctx.beginPath();
        ctx.roundRect(curX, barY, segW, barH, [0, 17, 17, 0]);
        ctx.fill();
      }

      // Legend Numbers under the bar
      const legY = barY + 70;
      ctx.font = "bold 22px 'JetBrains Mono', monospace";

      // 🟣 Oficialismo
      ctx.fillStyle = '#C4B5FD';
      ctx.fillText(`🟣 Oficialismo: ${ofi}%`, 115, legY);

      // 🟢 Centro / Datos
      ctx.fillStyle = '#6EE7B7';
      ctx.fillText(`🟢 Centro: ${cen}%`, 430, legY);

      // 🟠 Oposición
      ctx.fillStyle = '#FCD34D';
      ctx.fillText(`🟠 Oposición: ${opo}%`, 740, legY);

      // 7. Footer: Transparency watermark and live web URL
      ctx.strokeStyle = '#1E293B';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(80, 930);
      ctx.lineTo(width - 80, 930);
      ctx.stroke();

      ctx.fillStyle = '#94A3B8';
      ctx.font = "18px 'Inter', sans-serif";
      ctx.fillText('Comparativa sin sesgo de 31 redacciones en simultáneo', 80, 985);

      ctx.fillStyle = '#6BA4D9';
      ctx.font = "bold 26px 'JetBrains Mono', monospace";
      ctx.textAlign = 'right';
      ctx.fillText('👉 www.politicheck.com.ar', width - 80, 985);
      ctx.textAlign = 'left';

      // Export canvas to Image preview and cache blob
      canvas.toBlob((blob) => {
        if (blob) {
          generatedCardBlob = blob;
          const dataUrl = URL.createObjectURL(blob);
          if (previewImg) previewImg.src = dataUrl;
        }
        if (cardLoading) cardLoading.classList.add('hidden');
      }, 'image/png');
    }

    // Global modal opener
    window.openShareModal = function(opts) {
      currentShareData = {
        title: opts.title || 'Politicheck Argentina',
        headline: opts.headline || opts.title || '',
        text: opts.text || '',
        url: opts.url || window.location.href,
        category: opts.category || 'Difusión Cívica',
        spectrum: opts.spectrum || { oficialismo: 33, centro: 34, oposicion: 33 },
        outlets: opts.outlets || ''
      };

      if (titleEl) titleEl.textContent = opts.modalTitle || 'Difusión y Placa para Redes';
      if (categoryEl) categoryEl.textContent = currentShareData.category;
      if (previewEl) previewEl.textContent = `"${currentShareData.text}"`;

      // Setup Social URLs
      const fullShareText = `${currentShareData.text}\n\n${currentShareData.url}`;
      if (btnWa) {
        btnWa.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(fullShareText)}`;
      }
      if (btnX) {
        btnX.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(currentShareData.text)}&url=${encodeURIComponent(currentShareData.url)}`;
      }
      if (btnTg) {
        btnTg.href = `https://t.me/share/url?url=${encodeURIComponent(currentShareData.url)}&text=${encodeURIComponent(currentShareData.text)}`;
      }

      // Reset copy button states
      if (copyLabel) copyLabel.textContent = 'Enlace';
      if (feedbackBox) feedbackBox.classList.add('hidden');

      // Check native share support on mobile
      if (nativeWrapper && navigator.share && /mobile|android|iphone|ipad/i.test(navigator.userAgent)) {
        nativeWrapper.classList.remove('hidden');
      } else if (nativeWrapper) {
        nativeWrapper.classList.add('hidden');
      }

      if (modal && typeof modal.showModal === 'function') {
        modal.showModal();
      }

      // Render the graphic card dynamically
      renderGraphicCard();
    };

    // Helper: Trigger file download
    function downloadBlob(blob, filename = 'politicheck-placa.png') {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    // 1-Click Clipboard Image Copy
    if (btnCopyCard) {
      btnCopyCard.addEventListener('click', async () => {
        if (!generatedCardBlob) return;

        btnCopyCard.disabled = true;
        btnCopyCardText.textContent = 'Copiando placa...';

        try {
          // Check ClipboardItem image support
          if (navigator.clipboard && typeof window.ClipboardItem !== 'undefined') {
            const item = new window.ClipboardItem({ 'image/png': generatedCardBlob });
            await navigator.clipboard.write([item]);

            btnCopyCardText.textContent = 'Placa copiada al portapapeles';
            btnCopyCard.classList.add('bg-emerald-600', 'text-white');

            if (feedbackBox) {
              feedbackBox.textContent = 'Placa copiada. Ya podés pegarla con Ctrl+V en WhatsApp Web, Telegram o redes.';
              feedbackBox.className = 'p-2 rounded-lg text-center font-sans text-xs bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800';
              feedbackBox.classList.remove('hidden');
            }

            setTimeout(() => {
              btnCopyCardText.textContent = 'Copiar placa al portapapeles';
              btnCopyCard.classList.remove('bg-emerald-600');
              btnCopyCard.disabled = false;
            }, 3000);
          } else {
            throw new Error('ClipboardItem no soportado');
          }
        } catch (err) {
          console.warn('[ShareModal] Clipboard copy fallback to download:', err);
          downloadBlob(generatedCardBlob, 'politicheck-placa.png');

          btnCopyCardText.textContent = 'Placa descargada en tu equipo';

          if (feedbackBox) {
            feedbackBox.textContent = 'Tu navegador no permite escribir imágenes al portapapeles. Se descargó la placa directamente.';
            feedbackBox.className = 'p-2 rounded-lg text-center font-sans text-xs bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800';
            feedbackBox.classList.remove('hidden');
          }

          setTimeout(() => {
            btnCopyCardText.textContent = 'Copiar placa al portapapeles';
            btnCopyCard.disabled = false;
          }, 3000);
        }
      });
    }

    // Direct Image Download Button
    if (btnDownloadCard) {
      btnDownloadCard.addEventListener('click', () => {
        if (generatedCardBlob) {
          downloadBlob(generatedCardBlob, 'politicheck-placa.png');
        }
      });
    }

    // Copy Link action
    if (btnCopy) {
      btnCopy.addEventListener('click', () => {
        navigator.clipboard.writeText(currentShareData.url).then(() => {
          if (copyLabel) copyLabel.textContent = '¡Copiado!';
          setTimeout(() => {
            if (copyLabel) copyLabel.textContent = 'Enlace';
          }, 2500);
        });
      });
    }

    // Native share action
    if (btnNative) {
      btnNative.addEventListener('click', () => {
        if (navigator.share) {
          navigator.share({
            title: currentShareData.title,
            text: currentShareData.text,
            url: currentShareData.url
          }).catch(() => {});
        }
      });
    }
  })();
</script>
