---
// src/components/ShareModal.astro
---

<dialog 
  id="politicheck-share-modal" 
  class="backdrop:bg-slate-950/70 backdrop:backdrop-blur-xs fixed inset-0 m-auto z-50 p-0 rounded-3xl bg-white dark:bg-[#0F1420] text-slate-900 dark:text-slate-100 border border-slate-200 dark:border-slate-800 shadow-2xl max-w-lg w-[calc(100%-2rem)] open:animate-in open:fade-in-0 open:zoom-in-95"
>
  <div class="p-6 sm:p-7 space-y-5">
    <!-- Header -->
    <div class="flex items-start justify-between gap-3 border-b border-slate-100 dark:border-slate-800/80 pb-4">
      <div>
        <div class="flex items-center gap-2 text-[10px] font-mono font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span id="share-modal-category">Difusión Cívica</span>
        </div>
        <h3 id="share-modal-title" class="font-editorial text-xl sm:text-2xl font-bold text-slate-950 dark:text-white mt-1">
          Compartir en Redes Sociales
        </h3>
      </div>
      <button 
        type="button" 
        id="share-modal-close-btn"
        class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 flex items-center justify-center text-slate-500 dark:text-slate-300 text-sm font-bold transition-colors cursor-pointer"
        aria-label="Cerrar modal"
      >
        ✕
      </button>
    </div>

    <!-- Message Preview Box -->
    <div class="space-y-1.5">
      <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 dark:text-slate-400">
        <span>Mensaje prediseñado para compartir:</span>
        <span class="text-[10px]">1 clic para enviar</span>
      </div>
      <div 
        id="share-modal-preview" 
        class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs sm:text-sm font-sans text-slate-700 dark:text-slate-300 leading-relaxed italic"
      >
      </div>
    </div>

    <!-- 1-Click Action Buttons -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
      <!-- WhatsApp Button -->
      <a 
        id="share-btn-wa" 
        href="#" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-mono text-xs font-bold shadow-xs hover:shadow-md transition-all"
      >
        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>WhatsApp</span>
      </a>

      <!-- X (Twitter) Button -->
      <a 
        id="share-btn-x" 
        href="#" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl bg-black hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-200 text-white dark:text-black font-mono text-xs font-bold shadow-xs hover:shadow-md transition-all"
      >
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <span>X (Twitter)</span>
      </a>

      <!-- Telegram Button -->
      <a 
        id="share-btn-tg" 
        href="#" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl bg-sky-500 hover:bg-sky-600 text-white font-mono text-xs font-bold shadow-xs hover:shadow-md transition-all"
      >
        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
        <span>Telegram</span>
      </a>

      <!-- Copy Link Button -->
      <button 
        type="button" 
        id="share-btn-copy" 
        class="flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 font-mono text-xs font-bold transition-all cursor-pointer shadow-xs"
      >
        <span id="share-copy-icon">🔗</span>
        <span id="share-copy-label">Copiar enlace</span>
      </button>
    </div>

    <!-- Mobile Native Share Button (Conditional) -->
    <div id="share-native-wrapper" class="hidden pt-1">
      <button 
        type="button" 
        id="share-btn-native"
        class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-mono text-xs font-semibold transition-colors cursor-pointer"
      >
        <span>📲 Más opciones en tu teléfono</span>
      </button>
    </div>
  </div>
</dialog>

<script is:inline>
  (() => {
    const modal = document.getElementById('politicheck-share-modal');
    const closeBtn = document.getElementById('share-modal-close-btn');
    const previewEl = document.getElementById('share-modal-preview');
    const titleEl = document.getElementById('share-modal-title');
    const categoryEl = document.getElementById('share-modal-category');
    const btnWa = document.getElementById('share-btn-wa');
    const btnX = document.getElementById('share-btn-x');
    const btnTg = document.getElementById('share-btn-tg');
    const btnCopy = document.getElementById('share-btn-copy');
    const copyLabel = document.getElementById('share-copy-label');
    const copyIcon = document.getElementById('share-copy-icon');
    const nativeWrapper = document.getElementById('share-native-wrapper');
    const btnNative = document.getElementById('share-btn-native');

    let currentShareData = {
      title: 'Politicheck Argentina',
      text: 'Observatorio de medios y compromisos electorales',
      url: window.location.href,
      category: 'Difusión Cívica'
    };

    function closeModal() {
      if (modal && modal.open) {
        modal.close();
      }
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    // Close when clicking dialog backdrop
    if (modal) {
      modal.addEventListener('click', (e) => {
        const rect = modal.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) closeModal();
      });
    }

    // Global opener function
    window.openShareModal = function(opts) {
      currentShareData = {
        title: opts.title || 'Politicheck Argentina',
        text: opts.text || '',
        url: opts.url || window.location.href,
        category: opts.category || 'Difusión Cívica'
      };

      if (titleEl) titleEl.textContent = opts.modalTitle || 'Compartir en Redes';
      if (categoryEl) categoryEl.textContent = currentShareData.category;
      if (previewEl) previewEl.textContent = `"${currentShareData.text}"`;

      // Setup Social URLs
      const fullShareText = `${currentShareData.text}\n\n${currentShareData.url}`;
      if (btnWa) {
        btnWa.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(fullShareText)}`;
      }
      if (btnX) {
        btnX.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(currentShareData.text)}&url=${encodeURIComponent(currentShareData.url)}`;
      }
      if (btnTg) {
        btnTg.href = `https://t.me/share/url?url=${encodeURIComponent(currentShareData.url)}&text=${encodeURIComponent(currentShareData.text)}`;
      }

      // Reset copy button state
      if (copyLabel) copyLabel.textContent = 'Copiar enlace';
      if (copyIcon) copyIcon.textContent = '🔗';

      // Check native share support on mobile
      if (nativeWrapper && navigator.share && /mobile|android|iphone|ipad/i.test(navigator.userAgent)) {
        nativeWrapper.classList.remove('hidden');
      } else if (nativeWrapper) {
        nativeWrapper.classList.add('hidden');
      }

      if (modal && typeof modal.showModal === 'function') {
        modal.showModal();
      }
    };

    // Copy action
    if (btnCopy) {
      btnCopy.addEventListener('click', () => {
        navigator.clipboard.writeText(currentShareData.url).then(() => {
          if (copyLabel) copyLabel.textContent = '¡Copiado!';
          if (copyIcon) copyIcon.textContent = '✅';
          setTimeout(() => {
            if (copyLabel) copyLabel.textContent = 'Copiar enlace';
            if (copyIcon) copyIcon.textContent = '🔗';
          }, 2500);
        });
      });
    }

    // Native share action
    if (btnNative) {
      btnNative.addEventListener('click', () => {
        if (navigator.share) {
          navigator.share({
            title: currentShareData.title,
            text: currentShareData.text,
            url: currentShareData.url
          }).catch(() => {});
        }
      });
    }
  })();
</script>
