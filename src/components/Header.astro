---
interface Props {
  activeTab?: string;
}

const { activeTab = 'temas-del-dia' } = Astro.props;
---

<header class="sticky top-0 z-50 bg-white/90 dark:bg-[#090D16]/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-850 transition-colors duration-200">
  <!-- Top ticker bar -->
  <div class="bg-slate-100/90 dark:bg-slate-950/80 border-b border-slate-200/80 dark:border-slate-900 py-1.5 px-4 text-xs font-mono text-slate-600 dark:text-slate-400">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600 dark:bg-emerald-500"></span>
        </span>
        <span class="text-slate-800 dark:text-slate-300 font-semibold tracking-wider text-[11px] uppercase">
          En Vivo • Monitor Electoral Argentina
        </span>
      </div>
      <div class="flex items-center gap-4 text-[11px] text-slate-500 dark:text-slate-400">
        <span class="hidden sm:inline">Feeds RSS verificados</span>
        <span class="hidden sm:inline">•</span>
        <a href="#metodologia" class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors underline underline-offset-2">
          Metodología y Fuentes
        </a>
      </div>
    </div>
  </div>

  <!-- Main navigation container -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <!-- Brand identity -->
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-slate-900 dark:bg-slate-100 flex items-center justify-center font-bold text-white dark:text-slate-950 font-mono text-lg shadow-sm group-hover:scale-105 transition-transform">
          P
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="font-extrabold tracking-tight text-xl text-slate-900 dark:text-white font-mono uppercase">
              POLITICHECK
            </span>
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 font-semibold">
              .ar
            </span>
          </div>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono tracking-wider">
            ANÁLISIS DE SESGOS & PROMESAS
          </span>
        </div>
      </a>

      <!-- Mobile Theme Toggle Button -->
      <button 
        type="button" 
        class="theme-toggle md:hidden p-2 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
        aria-label="Alternar tema claro y oscuro"
      >
        <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>

    <!-- Navigation & Controls -->
    <div class="flex items-center gap-3">
      <!-- View Switcher Tabs -->
      <nav class="flex items-center p-1 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-medium w-full md:w-auto overflow-x-auto" id="view-tabs">
        <button 
          type="button"
          data-tab="temas-del-dia"
          class="tab-btn px-3.5 sm:px-4 py-2 rounded-lg transition-all duration-200 flex items-center gap-2 text-slate-900 dark:text-white bg-white dark:bg-slate-800 shadow-sm whitespace-nowrap"
        >
          <svg class="w-4 h-4 text-slate-700 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span>Temas del Día</span>
        </button>

        <button 
          type="button"
          data-tab="ultimo-momento"
          class="tab-btn px-3.5 sm:px-4 py-2 rounded-lg transition-all duration-200 flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 whitespace-nowrap"
        >
          <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Último Momento</span>
        </button>

        <button 
          type="button"
          data-tab="mirada-exterior"
          class="tab-btn px-3.5 sm:px-4 py-2 rounded-lg transition-all duration-200 flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 whitespace-nowrap"
        >
          <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Mirada Exterior</span>
        </button>
      </nav>

      <!-- Desktop Theme Toggle Button -->
      <button 
        type="button" 
        class="theme-toggle hidden md:flex items-center justify-center w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
        aria-label="Alternar tema claro y oscuro"
        title="Alternar entre modo claro y oscuro"
      >
        <!-- Sun icon (shown in dark mode to switch to light) -->
        <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown in light mode to switch to dark) -->
        <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Theme Toggle Logic
  const themeToggles = document.querySelectorAll('.theme-toggle');
  
  themeToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('politicheck-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('politicheck-theme', 'dark');
      }
    });
  });
</script>
