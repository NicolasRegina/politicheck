---
import { fetchLiveFinancialData, fetchLiveWeather } from '../services/finance';
import BreakingBanner from './BreakingBanner.astro';
import BrandLogo from './BrandLogo.astro';
import { detectBreakingNews } from '../services/breaking';
import { getCachedClusteredStories } from '../services/ai/clustering';
import { getLastSyncTimestampAsync } from '../services/rss/sync';
import { isBrazilElectionActive } from '../data/brasil_election';

interface Props {
  stories?: any[];
  serverSyncIso?: string | null;
}

const { stories: propStories, serverSyncIso: propSyncIso } = Astro.props;

// Fetch initial data at build/render time (Memory-cached with 15m TTL)
const finance = await fetchLiveFinancialData();
const weather = await fetchLiveWeather();

const initialBlue = finance ? finance.blue : 1555;
const initialOficial = finance ? finance.oficial : 1545;
const initialMep = finance ? finance.mep : 1548;
const initialRiesgoPais = finance ? finance.riesgoPais : 628;
const initialIpc = finance ? finance.ipc : 1.7;
const initialTemp = weather ? weather.temperature : 19;

// Dynamic server-rendered live date in Spanish
const now = new Date();
const serverDateFormatted = new Intl.DateTimeFormat('es-AR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(now);

// Detect active breaking news strictly from real clustered stories (Use prop if provided)
let cachedStories = propStories;
if (!cachedStories || cachedStories.length === 0) {
  const { getNewsClustersFromSupabase } = await import('../services/supabase');
  const cloudStories = (await getNewsClustersFromSupabase(1440)) || [];
  cachedStories = cloudStories.length > 0 ? cloudStories : getCachedClusteredStories();
}
const breakingAlert = detectBreakingNews(cachedStories);

// Get real server sync timestamp directly from cloud cache (Use prop if provided)
const serverSyncIso = propSyncIso || (await getLastSyncTimestampAsync()) || new Date().toISOString();
---

<!-- 1. STATIC TOP CHROME (Scrolls away to preserve reading viewport — ADR-0008 Fix #1) -->
<header class="bg-canvas transition-colors duration-200">
  <!-- Top Ticker Bar -->
  <div class="h-8 bg-surface-muted border-b border-rule px-3 sm:px-4 text-[10px] sm:text-[11px] font-mono text-ink-muted flex items-center overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden whitespace-nowrap">
    <div class="max-w-7xl mx-auto w-full flex items-center justify-between gap-3 sm:gap-4 shrink-0">
      <!-- Date & Weather -->
      <div class="flex items-center gap-2 shrink-0">
        <span class="font-semibold text-ink capitalize" id="ticker-live-date">
          {serverDateFormatted}
        </span>
        <span class="text-rule-strong/30" aria-hidden="true">|</span>
        <span id="ticker-live-weather">
          Bs. As. <span id="weather-temp-val">{initialTemp}</span>°C
        </span>
      </div>

      <!-- Financial Ticker -->
      <div class="flex items-center gap-3 sm:gap-4 text-[10px] tracking-tight shrink-0">
        <span class="text-rule-strong/30" aria-hidden="true">|</span>
        <div class="flex items-center gap-1" title="Cotización venta Dólar Blue (dolarapi.com)">
          <span>BLUE:</span>
          <span class="font-semibold text-ink" id="ticker-blue-val">${initialBlue}</span>
        </div>
        <span class="text-rule-strong/30 hidden sm:inline" aria-hidden="true">|</span>
        <div class="hidden sm:flex items-center gap-1" title="Cotización venta Dólar Oficial">
          <span>OFICIAL:</span>
          <span class="font-semibold text-ink" id="ticker-oficial-val">${initialOficial}</span>
        </div>
        <span class="text-rule-strong/30" aria-hidden="true">|</span>
        <div class="flex items-center gap-1" title="Cotización Bolsa MEP">
          <span>MEP:</span>
          <span class="font-semibold text-ink" id="ticker-mep-val">${initialMep}</span>
        </div>
        <span class="text-rule-strong/30" aria-hidden="true">|</span>
        <div class="flex items-center gap-1" title="Riesgo País Argentina (argentinadatos.com)">
          <span>RIESGO:</span>
          <span class="font-semibold text-ink" id="ticker-riesgo-val">{initialRiesgoPais}</span>
        </div>
        <span class="text-rule-strong/30 hidden sm:inline" aria-hidden="true">|</span>
        <div class="hidden sm:flex items-center gap-1" title="Índice de Precios al Consumidor mensual (INDEC)">
          <span>IPC:</span>
          <span class="font-semibold text-ink" id="ticker-ipc-val">{initialIpc.toString().replace('.', ',')}%</span>
        </div>
      </div>

      <!-- Live Sync & Institutional Links -->
      <div class="flex items-center gap-2.5 sm:gap-3 text-[10px] sm:text-[11px] shrink-0 font-sans">
        <button
          type="button"
          id="btn-manual-sync"
          class="flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-surface border border-rule text-ink-secondary hover:border-ink transition-colors cursor-pointer"
          title="Noticias en tiempo real. Clic para refrescar portada."
        >
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-accent" id="sync-ping-dot" aria-hidden="true"></span>
          <span class="font-semibold text-[10px] text-ink">En vivo</span>
          <span class="text-rule-strong/30" aria-hidden="true">|</span>
          <span
            class="text-ink-muted text-[10px] font-mono"
            id="sync-time-ago"
            data-server-sync={serverSyncIso}
          >
            Sincronizando...
          </span>
        </button>

        <a href="/guias" class="hidden sm:inline hover:text-accent transition-colors underline underline-offset-2">
          Guías
        </a>
        <a href="/metodologia" class="hidden sm:inline hover:text-accent transition-colors underline underline-offset-2">
          Metodología
        </a>
        <button
          type="button"
          onclick="if(typeof window.openLiveChat === 'function') window.openLiveChat('debate-electoral');"
          class="hidden sm:inline-flex items-center gap-1.5 hover:text-accent transition-colors underline underline-offset-2 cursor-pointer font-medium"
        >
          <span>Chat Electoral</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Breaking News Banner -->
  <BreakingBanner alert={breakingAlert} />

  <!-- Editorial Masthead (Static — includes official P-Checkmark isotipo) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 sm:py-5 border-b border-rule">
    <div class="grid grid-cols-1 md:grid-cols-12 items-center gap-3">
      <!-- Left Column -->
      <div class="hidden md:flex md:col-span-3 flex-col text-[11px] font-sans text-ink-muted space-y-0.5">
        <span class="font-semibold text-ink">31 Redacciones Monitoreadas</span>
        <span>Cobertura cruzada en tiempo real</span>
      </div>

      <!-- Center Column: Masthead with P-Checkmark Isotipo -->
      <div class="col-span-12 md:col-span-6 text-center">
        <a href="/" class="inline-flex flex-col items-center group">
          <div class="inline-flex items-center gap-2.5 sm:gap-3">
            <BrandLogo size={38} class="shrink-0" />
            <h1 class="font-editorial text-3xl sm:text-5xl font-bold tracking-tight text-ink group-hover:opacity-85 transition-opacity leading-none">
              Politicheck
              <span class="sr-only">: Noticias de Política Argentina, Cobertura de Medios y Elecciones 2027</span>
            </h1>
          </div>
          <p class="mt-1.5 font-sans text-[11px] sm:text-xs text-ink-muted font-medium tracking-wide">
            Observatorio de Política Argentina, Encuadres Mediáticos y Elecciones 2027
          </p>
        </a>
      </div>

      <!-- Right Column: Quick Actions -->
      <div class="hidden md:flex md:col-span-3 items-center justify-end gap-2.5">
        <button
          type="button"
          onclick="window.openPwaInstallPrompt?.()"
          class="inline-flex items-center justify-center gap-1.5 h-8 px-3 rounded-md bg-surface hover:border-ink border border-rule text-ink text-xs font-sans font-medium transition-colors cursor-pointer"
          title="Instalar Politicheck en tu celular o computadora"
          aria-label="Instalar aplicación Politicheck"
        >
          <svg aria-hidden="true" class="w-3.5 h-3.5 text-ink-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Instalar App</span>
        </button>

        <button
          type="button"
          class="theme-toggle inline-flex items-center justify-center h-8 w-8 rounded-md bg-surface hover:border-ink border border-rule text-ink-secondary hover:text-ink transition-colors cursor-pointer"
          aria-label="Alternar modo claro y oscuro"
          title="Alternar entre modo Crema Editorial (claro) y Carbón Cálido (oscuro)"
        >
          <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- 2. COMPACT STICKY NAVIGATION BAR (~50px — ADR-0008 Fix #1) -->
<div class="sticky top-0 z-40 bg-canvas border-b border-rule transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-12 sm:h-[52px] flex items-center justify-between gap-2 sm:gap-3">
    <!-- Left: Sections (Desktop) & Compact Brand (Mobile) -->
    <div class="flex items-center gap-2 min-w-0">
      <a href="/" class="inline-flex md:hidden items-center shrink-0" aria-label="Inicio Politicheck">
        <BrandLogo size={24} />
      </a>

      <nav
        class="flex items-center gap-1 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden text-xs font-medium text-ink-muted"
        id="newspaper-sections-nav"
        aria-label="Secciones editoriales"
      >
        <button
          type="button"
          data-nav-section="all"
          class="nav-section-btn px-2 py-1 rounded-md hover:bg-surface-muted hover:text-ink transition-colors whitespace-nowrap cursor-pointer text-ink font-semibold"
        >
          Portada
        </button>
        <button
          type="button"
          data-nav-section="Política"
          class="nav-section-btn px-2 py-1 rounded-md hover:bg-surface-muted hover:text-ink transition-colors whitespace-nowrap cursor-pointer"
        >
          Política
        </button>
        <button
          type="button"
          data-nav-section="Economía"
          class="nav-section-btn px-2 py-1 rounded-md hover:bg-surface-muted hover:text-ink transition-colors whitespace-nowrap cursor-pointer"
        >
          Economía
        </button>
        <button
          type="button"
          data-nav-section="Sociedad"
          class="nav-section-btn px-2 py-1 rounded-md hover:bg-surface-muted hover:text-ink transition-colors whitespace-nowrap cursor-pointer"
        >
          Sociedad
        </button>
      </nav>
    </div>

    <!-- Right: Search + Desktop View Switcher + Mobile Theme Toggle -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- Quick Search Input -->
      <div class={`relative shrink-0 ${isBrazilElectionActive ? 'w-32 sm:w-36 lg:w-40' : 'w-36 sm:w-40 lg:w-48'}`}>
        <input
          type="text"
          id="search-input"
          placeholder="Buscar..."
          class="w-full bg-surface border border-rule rounded-md pl-2.5 pr-7 py-1 text-xs text-ink placeholder-ink-muted focus:outline-none focus:border-accent transition-colors font-sans"
        />
        <svg aria-hidden="true" class="w-3.5 h-3.5 text-ink-muted absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Mobile Theme Toggle (in compact sticky bar) -->
      <button
        type="button"
        class="theme-toggle md:hidden inline-flex items-center justify-center h-7 w-7 rounded-md bg-surface border border-rule text-ink-secondary hover:text-ink transition-colors cursor-pointer shrink-0"
        aria-label="Alternar modo claro y oscuro"
      >
        <svg class="w-3.5 h-3.5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="w-3.5 h-3.5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Desktop View Switcher Tabs (Aligned with CONTEXT.md domain language) -->
      <nav class="hidden md:flex items-center p-0.5 rounded-md bg-surface-muted border border-rule text-xs font-sans shrink-0" id="view-tabs" aria-label="Vistas principales">
        <button
          type="button"
          data-tab="temas-del-dia"
          class={`tab-btn py-1 rounded-md transition-colors duration-150 flex items-center gap-1.5 text-canvas bg-ink whitespace-nowrap font-semibold cursor-pointer ${isBrazilElectionActive ? 'px-2' : 'px-2.5'}`}
        >
          <span>Temas del Día</span>
        </button>

        <button
          type="button"
          data-tab="ultimo-momento"
          class={`tab-btn py-1 rounded-md transition-colors duration-150 flex items-center gap-1.5 text-ink-muted hover:text-ink whitespace-nowrap cursor-pointer ${isBrazilElectionActive ? 'px-2' : 'px-2.5'}`}
        >
          <span>Último Momento</span>
        </button>

        <button
          type="button"
          data-tab="mirada-exterior"
          class={`tab-btn py-1 rounded-md transition-colors duration-150 flex items-center gap-1.5 text-ink-muted hover:text-ink whitespace-nowrap cursor-pointer ${isBrazilElectionActive ? 'px-2' : 'px-2.5'}`}
        >
          <span>Mirada Exterior</span>
        </button>

        <button
          type="button"
          data-tab="promesas"
          class={`tab-btn py-1 rounded-md transition-colors duration-150 flex items-center gap-1.5 text-ink-muted hover:text-ink whitespace-nowrap cursor-pointer ${isBrazilElectionActive ? 'px-2' : 'px-2.5'}`}
        >
          <span>Promesas 2027</span>
        </button>

        {isBrazilElectionActive && (
          <button
            type="button"
            data-tab="elecciones-brasil"
            class="tab-btn brazil-pill-bg relative overflow-hidden pl-2.5 pr-8 py-1 rounded-md border border-rule text-xs font-semibold text-white transition-opacity hover:opacity-90 flex items-center gap-1.5 whitespace-nowrap cursor-pointer shrink-0 ml-0.5"
            title="Cobertura Especial: Elecciones Presidenciales Brasil 2026"
          >
            <span class="tracking-tight drop-shadow-xs">Brasil 2026</span>
          </button>
        )}
      </nav>
    </div>
  </div>
</div>

<!-- 3. MOBILE BOTTOM NAVIGATION (ADR-0008 Fix #4 — <768px) -->
<div id="mobile-more-sheet" class="md:hidden hidden fixed bottom-16 inset-x-3 z-50 rounded-md bg-surface border border-rule shadow-lg p-3 space-y-1.5">
  <div class="flex items-center justify-between pb-1.5 border-b border-rule">
    <span class="text-[11px] font-mono uppercase tracking-wider text-ink-muted font-semibold">Más en Politicheck</span>
    <button type="button" id="mobile-more-close" class="text-xs text-ink-muted hover:text-ink px-1.5 py-0.5" aria-label="Cerrar menú">✕</button>
  </div>
  <button type="button" data-mobile-tab="mirada-exterior" class="mobile-nav-tab w-full text-left px-2.5 py-2 rounded-md text-xs font-medium text-ink hover:bg-surface-muted flex items-center justify-between">
    <span>Mirada Exterior</span>
    <span class="text-[10px] font-mono text-ink-muted">Prensa internacional</span>
  </button>
  {isBrazilElectionActive && (
    <button type="button" data-mobile-tab="elecciones-brasil" class="mobile-nav-tab w-full text-left px-2.5 py-2 rounded-md text-xs font-medium text-ink hover:bg-surface-muted flex items-center justify-between">
      <span>Elecciones Brasil 2026</span>
      <span class="text-[10px] font-mono text-ink-muted">Especial</span>
    </button>
  )}
  <a href="/metodologia" class="block w-full text-left px-2.5 py-2 rounded-md text-xs font-medium text-ink hover:bg-surface-muted">
    Metodología y 31 Medios
  </a>
  <button
    type="button"
    onclick="document.getElementById('mobile-more-sheet')?.classList.add('hidden'); if(typeof window.openLiveChat === 'function') window.openLiveChat('debate-electoral');"
    class="w-full text-left px-2.5 py-2 rounded-md text-xs font-medium text-ink hover:bg-surface-muted"
  >
    Chat Electoral en Vivo
  </button>
  <button
    type="button"
    onclick="document.getElementById('mobile-more-sheet')?.classList.add('hidden'); window.openPwaInstallPrompt?.();"
    class="w-full text-left px-2.5 py-2 rounded-md text-xs font-medium text-accent hover:bg-surface-muted"
  >
    Instalar App (PWA)
  </button>
</div>

<nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-surface border-t border-rule" aria-label="Navegación principal móvil">
  <div class="grid grid-cols-5 h-15">
    <button type="button" data-mobile-tab="temas-del-dia" class="mobile-nav-tab flex flex-col items-center justify-center gap-0.5 text-[10px] font-semibold text-accent">
      <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
      <span>Temas</span>
    </button>

    <button type="button" data-mobile-tab="ultimo-momento" class="mobile-nav-tab flex flex-col items-center justify-center gap-0.5 text-[10px] font-medium text-ink-muted">
      <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      <span>Últ. Mom.</span>
    </button>

    <button type="button" data-mobile-tab="promesas" class="mobile-nav-tab flex flex-col items-center justify-center gap-0.5 text-[10px] font-medium text-ink-muted">
      <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span>Promesas</span>
    </button>

    <a href="/guias" class="flex flex-col items-center justify-center gap-0.5 text-[10px] font-medium text-ink-muted hover:text-ink">
      <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
      <span>Guías</span>
    </a>

    <button type="button" id="mobile-more-btn" class="flex flex-col items-center justify-center gap-0.5 text-[10px] font-medium text-ink-muted hover:text-ink" aria-expanded="false" aria-controls="mobile-more-sheet">
      <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
      <span>Más</span>
    </button>
  </div>
</nav>

<script>
  // 1. Theme Toggle Logic
  const themeToggles = document.querySelectorAll('.theme-toggle');
  themeToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('politicheck-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('politicheck-theme', 'dark');
      }
    });
  });

  // 2. Dynamic Live Date Formatting (Intl in Spanish)
  const dateEl = document.getElementById('ticker-live-date');
  if (dateEl) {
    const now = new Date();
    const formatter = new Intl.DateTimeFormat('es-AR', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    });
    dateEl.textContent = formatter.format(now);
  }

  // 3. Client-Side Live Dollar Hydration via dolarapi.com
  async function hydrateLiveRates() {
    try {
      const res = await fetch('https://dolarapi.com/v1/dolares');
      if (!res.ok) return;
      const data = await res.json();

      const blue = data.find((d: any) => d.casa === 'blue');
      const oficial = data.find((d: any) => d.casa === 'oficial');
      const mep = data.find((d: any) => d.casa === 'bolsa');

      if (blue) {
        const el = document.getElementById('ticker-blue-val');
        if (el) el.textContent = `$${blue.venta}`;
      }
      if (oficial) {
        const el = document.getElementById('ticker-oficial-val');
        if (el) el.textContent = `$${oficial.venta}`;
      }
      if (mep) {
        const el = document.getElementById('ticker-mep-val');
        if (el) el.textContent = `$${Math.round(mep.venta)}`;
      }
    } catch (e) {
      console.warn('Could not refresh live dollar rates:', e);
    }
  }

  // 4. Client-Side Live Weather Hydration via open-meteo
  async function hydrateLiveWeather() {
    try {
      const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=-34.6132&longitude=-58.3772&current_weather=true');
      if (!res.ok) return;
      const data = await res.json();
      const tempVal = Math.round(data.current_weather.temperature);
      const el = document.getElementById('weather-temp-val');
      if (el) el.textContent = String(tempVal);
    } catch (e) {
      console.warn('Could not refresh live weather:', e);
    }
  }

  hydrateLiveRates();
  hydrateLiveWeather();

  // 5. Dynamic Navigation between Header Sections and Category Filtering
  const navSectionButtons = document.querySelectorAll<HTMLButtonElement>('.nav-section-btn');
  navSectionButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetSec = btn.getAttribute('data-nav-section');
      if (!targetSec) return;

      if (window.location.pathname !== '/' && window.location.pathname !== '') {
        if (targetSec === 'promesas') {
          window.location.href = '/?tab=promesas';
        } else if (targetSec === 'all') {
          window.location.href = '/';
        } else {
          window.location.href = `/?sec=${encodeURIComponent(targetSec)}`;
        }
        return;
      }

      navSectionButtons.forEach(b => {
        b.classList.remove('text-ink', 'font-semibold');
        b.classList.add('text-ink-muted');
      });
      btn.classList.add('text-ink', 'font-semibold');
      btn.classList.remove('text-ink-muted');

      const mainTab = document.querySelector<HTMLButtonElement>('[data-tab="temas-del-dia"]');
      if (mainTab) mainTab.click();

      if (typeof (window as any).politicheckFilterCategory === 'function') {
        (window as any).politicheckFilterCategory(targetSec);
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  // 5b. Tab buttons redirect to home tab when clicked from a subpage
  const headerTabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  headerTabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      if (window.location.pathname !== '/' && window.location.pathname !== '') {
        const targetTab = btn.getAttribute('data-tab');
        if (!targetTab) return;
        window.location.href = targetTab === 'temas-del-dia'
          ? '/'
          : `/?tab=${encodeURIComponent(targetTab)}`;
      }
    });
  });

  // 5c. Mobile Bottom Nav & "Más" Sheet
  const moreBtn = document.getElementById('mobile-more-btn');
  const moreSheet = document.getElementById('mobile-more-sheet');
  const moreClose = document.getElementById('mobile-more-close');

  if (moreBtn && moreSheet) {
    moreBtn.addEventListener('click', () => {
      const isHidden = moreSheet.classList.toggle('hidden');
      moreBtn.setAttribute('aria-expanded', String(!isHidden));
    });
  }
  if (moreClose && moreSheet && moreBtn) {
    moreClose.addEventListener('click', () => {
      moreSheet.classList.add('hidden');
      moreBtn.setAttribute('aria-expanded', 'false');
    });
  }

  const mobileNavTabs = document.querySelectorAll<HTMLButtonElement>('.mobile-nav-tab');
  mobileNavTabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-mobile-tab');
      if (!targetTab) return;

      if (moreSheet) moreSheet.classList.add('hidden');

      if (window.location.pathname !== '/' && window.location.pathname !== '') {
        window.location.href = targetTab === 'temas-del-dia'
          ? '/'
          : `/?tab=${encodeURIComponent(targetTab)}`;
        return;
      }

      // Highlight active mobile tab
      mobileNavTabs.forEach(b => {
        b.classList.remove('text-accent', 'font-semibold');
        b.classList.add('text-ink-muted', 'font-medium');
      });
      btn.classList.add('text-accent', 'font-semibold');
      btn.classList.remove('text-ink-muted', 'font-medium');

      // Delegate to existing desktop tab handler so index.astro switches views seamlessly
      const desktopTab = document.querySelector<HTMLButtonElement>(`.tab-btn[data-tab="${targetTab}"]`);
      if (desktopTab) desktopTab.click();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  // Global header search input: handle enter key if on external page
  const headerSearchInput = document.getElementById('search-input') as HTMLInputElement | null;
  if (headerSearchInput) {
    headerSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const val = headerSearchInput.value.trim();
        if (window.location.pathname !== '/' && window.location.pathname !== '') {
          window.location.href = `/?q=${encodeURIComponent(val)}`;
        }
      }
    });
  }

  // --- Dynamic Live Sync Timestamp Logic ---
  const syncTimeAgo = document.getElementById('sync-time-ago');

  function updateSyncTimeAgo() {
    if (!syncTimeAgo) return;
    const serverSync = syncTimeAgo.getAttribute('data-server-sync');
    const localSync = localStorage.getItem('politicheck_last_sync_timestamp');

    let syncTimeMs = serverSync ? new Date(serverSync).getTime() : 0;
    if (localSync) {
      const localMs = parseInt(localSync, 10);
      if (localMs > syncTimeMs) syncTimeMs = localMs;
    }

    if (!syncTimeMs || isNaN(syncTimeMs)) {
      syncTimeAgo.textContent = 'Actualizado recién';
      return;
    }

    const diffMs = Date.now() - syncTimeMs;
    const diffMins = Math.floor(diffMs / 60000);
    const syncDate = new Date(syncTimeMs);
    const timeFormatted = syncDate.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }) + ' hs';

    if (diffMins < 1) {
      syncTimeAgo.textContent = `Recién (${timeFormatted})`;
    } else if (diffMins < 60) {
      syncTimeAgo.textContent = `Hace ${diffMins} min`;
    } else if (diffMins < 1440) {
      const diffHours = Math.floor(diffMins / 60);
      syncTimeAgo.textContent = `Hoy ${timeFormatted} (${diffHours}h)`;
    } else {
      const dayFormatted = syncDate.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit' });
      syncTimeAgo.textContent = `${dayFormatted} ${timeFormatted}`;
    }
  }

  updateSyncTimeAgo();
  setInterval(updateSyncTimeAgo, 30000);

  fetch('/api/rss/sync?status=true')
    .then(res => res.json())
    .then(data => {
      if (data.lastSyncTimestamp && syncTimeAgo) {
        syncTimeAgo.setAttribute('data-server-sync', data.lastSyncTimestamp);
        updateSyncTimeAgo();

        const syncMs = new Date(data.lastSyncTimestamp).getTime();
        const diffMins = (Date.now() - syncMs) / 60000;
        if (diffMins > 25 && !sessionStorage.getItem('pc_sync_triggered')) {
          sessionStorage.setItem('pc_sync_triggered', '1');
          fetch('/api/rss/sync').catch(() => {});
        }
      }
    })
    .catch(() => {});

  const manualSyncBtn = document.getElementById('btn-manual-sync') || document.getElementById('btn-header-sync');
  if (manualSyncBtn) {
    manualSyncBtn.addEventListener('click', async () => {
      const timeSpan = document.getElementById('sync-time-ago');
      if (timeSpan) timeSpan.textContent = 'Actualizando...';
      try {
        await fetch('/api/rss/sync?refresh=true', { method: 'GET' });
      } catch (e) {}
      window.location.reload();
    });
  }

  fetch('https://api.argentinadatos.com/v1/finanzas/indices/riesgo-pais/ultimo')
    .then(r => r.json())
    .then(d => {
      if (d && typeof d.valor === 'number') {
        const rpEl = document.getElementById('ticker-riesgo-val');
        if (rpEl) rpEl.textContent = `${d.valor} pb`;
      }
    })
    .catch(() => {});

  fetch('https://api.argentinadatos.com/v1/finanzas/indices/inflacion')
    .then(r => r.json())
    .then(data => {
      if (Array.isArray(data) && data.length > 0) {
        const latest = data[data.length - 1];
        if (typeof latest.valor === 'number') {
          const ipcEl = document.getElementById('ticker-ipc-val');
          if (ipcEl) ipcEl.textContent = `${latest.valor.toString().replace('.', ',')}%`;
        }
      }
    })
    .catch(() => {});
</script>
