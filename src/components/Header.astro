---
import { fetchLiveFinancialData, fetchLiveWeather } from '../services/finance';
import BreakingBanner from './BreakingBanner.astro';
import { detectBreakingNews } from '../services/breaking';
import { getCachedClusteredStories } from '../services/ai/clustering';
import { MOCK_STORIES } from '../data/mockData';
import { getLastSyncTimestamp } from '../services/rss/sync';

interface Props {
  activeTab?: string;
}

const { activeTab = 'temas-del-dia' } = Astro.props;

// Fetch initial data at build/render time
const finance = await fetchLiveFinancialData();
const weather = await fetchLiveWeather();

const initialBlue = finance ? finance.blue : 1340;
const initialOficial = finance ? finance.oficial : 1020;
const initialMep = finance ? finance.mep : 1285;
const initialTemp = weather ? weather.temperature : 19;

// Detect active breaking news
const cachedStories = getCachedClusteredStories();
const storiesForAlert = cachedStories.length > 0 ? cachedStories : MOCK_STORIES;
const breakingAlert = detectBreakingNews(storiesForAlert);

// Get real server sync timestamp
const serverSyncIso = getLastSyncTimestamp() || new Date().toISOString();
---

<header class="sticky top-0 z-50 bg-white/95 dark:bg-[#0A0E17]/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 transition-colors duration-200 shadow-xs">
  <!-- Top Ticker Bar: Financial Indicators & Weather (Clarín / La Nación / Ámbito style) -->
  <div class="bg-slate-100/90 dark:bg-slate-950 border-b border-slate-200/80 dark:border-slate-900 py-1 px-4 text-[11px] font-mono text-slate-600 dark:text-slate-400">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-y-1">
      <!-- Date & Weather (Dynamic) -->
      <div class="flex items-center gap-3">
        <span class="font-semibold text-slate-800 dark:text-slate-200 capitalize" id="ticker-live-date">
          Sábado, 26 de septiembre de 2026
        </span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span class="hidden sm:inline text-slate-600 dark:text-slate-400" id="ticker-live-weather">
          Buenos Aires (<span id="weather-temp-val">{initialTemp}</span>°C)
        </span>
      </div>

      <!-- Financial Ticker (Live Dólar API Integration) -->
      <div class="hidden lg:flex items-center gap-4 text-[10px] tracking-tight">
        <div class="flex items-center gap-1.5" title="Cotización venta Dólar Blue (dolarapi.com)">
          <span class="text-slate-500 dark:text-slate-400">DÓLAR BLUE:</span>
          <span class="font-bold text-slate-900 dark:text-slate-100" id="ticker-blue-val">${initialBlue}</span>
        </div>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <div class="flex items-center gap-1.5" title="Cotización venta Dólar Oficial">
          <span class="text-slate-500 dark:text-slate-400">OFICIAL:</span>
          <span class="font-bold text-slate-900 dark:text-slate-100" id="ticker-oficial-val">${initialOficial}</span>
        </div>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <div class="flex items-center gap-1.5" title="Cotización Bolsa MEP">
          <span class="text-slate-500 dark:text-slate-400">MEP:</span>
          <span class="font-bold text-slate-900 dark:text-slate-100" id="ticker-mep-val">${initialMep}</span>
        </div>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <div class="flex items-center gap-1.5">
          <span class="text-slate-500 dark:text-slate-400">RIESGO PAÍS:</span>
          <span class="font-bold text-slate-900 dark:text-slate-100">1.180 pts</span>
        </div>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <div class="flex items-center gap-1.5">
          <span class="text-slate-500 dark:text-slate-400">IPC MENSUAL:</span>
          <span class="font-bold text-emerald-700 dark:text-emerald-400">2,4%</span>
        </div>
      </div>

      <!-- Live Sync status & Methodology -->
      <div class="flex items-center gap-2.5 text-[11px]">
        <!-- Live Sync Status Badge (Public) -->
        <div class="flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 shadow-2xs">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-bold uppercase tracking-wider text-[10px] text-emerald-700 dark:text-emerald-400">EN VIVO</span>
          <span class="text-slate-300 dark:text-slate-700">•</span>
          <span 
            class="text-slate-500 dark:text-slate-400 text-[10px] font-mono" 
            id="sync-time-ago"
            data-server-sync={serverSyncIso}
          >
            Sincronizando...
          </span>
        </div>

        <span class="text-slate-300 dark:text-slate-700">•</span>
        <a href="/metodologia" class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors underline underline-offset-2">
          Metodología
        </a>
      </div>
    </div>
  </div>

  <!-- Breaking News Banner (Alerta / Último Momento) -->
  <BreakingBanner alert={breakingAlert} />

  <!-- The Editorial Masthead (The New York Times / La Nación format) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4">
    <div class="grid grid-cols-1 md:grid-cols-12 items-center gap-4 border-b border-slate-200 dark:border-slate-800 pb-4">
      <!-- Left Column: Edition Metadata -->
      <div class="hidden md:flex md:col-span-3 flex-col text-[11px] font-mono text-slate-500 dark:text-slate-400 space-y-0.5">
        <span class="font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-widest text-[10px]">Edición Digital Nacional</span>
        <span>Año I • Registro N° 1</span>
        <span>Cobertura de 31 redacciones en simultáneo</span>
      </div>

      <!-- Center Column: Grand Newspaper Title -->
      <div class="col-span-12 md:col-span-6 text-center">
        <a href="/" class="inline-block group">
          <h1 class="font-editorial text-3xl sm:text-5xl md:text-5xl font-black tracking-wider text-slate-950 dark:text-white uppercase group-hover:opacity-90 transition-opacity">
            POLITICHECK
          </h1>
          <div class="mt-1 flex items-center justify-center gap-2">
            <span class="h-px w-6 sm:w-12 bg-slate-400 dark:bg-slate-600"></span>
            <p class="font-mono text-[10px] sm:text-[11px] uppercase tracking-widest text-slate-600 dark:text-slate-400 font-medium">
              Observatorio de Cobertura Periodística & Auditoría Electoral
            </p>
            <span class="h-px w-6 sm:w-12 bg-slate-400 dark:bg-slate-600"></span>
          </div>
        </a>
      </div>

      <!-- Right Column: Quick Status & Theme Switcher -->
      <div class="col-span-12 md:col-span-3 flex items-center justify-between md:justify-end gap-3">
        <div class="hidden sm:flex flex-col text-right text-[10px] font-mono text-slate-500 dark:text-slate-400">
          <span class="font-semibold text-slate-800 dark:text-slate-200 uppercase">Sin Sesgo Partidario</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-bold">100% Fuentes Oficiales RSS</span>
        </div>

        <!-- Theme Toggle Button -->
        <button 
          type="button" 
          class="theme-toggle flex items-center justify-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-900 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-xs font-mono transition-colors cursor-pointer"
          aria-label="Alternar modo claro y oscuro"
          title="Alternar entre modo papel (claro) y nocturno (oscuro)"
        >
          <!-- Sun icon for dark mode -->
          <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon for light mode -->
          <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span class="text-[11px] hidden sm:inline">Modo Lectura</span>
        </button>
      </div>
    </div>

    <!-- Newspaper Sections Bar & View Switcher (The Classical Hairline Navigation) -->
    <div class="pt-2 flex flex-col lg:flex-row lg:items-center justify-between gap-2.5">
      <!-- Traditional Newspaper Sections (Dynamic Filtering) -->
      <nav class="flex items-center gap-1 sm:gap-2 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden shrink-0 text-[12px] font-semibold tracking-wide uppercase text-slate-700 dark:text-slate-300 py-1" id="newspaper-sections-nav" aria-label="Secciones del periódico">
        <button 
          type="button" 
          data-nav-section="all" 
          class="nav-section-btn px-2.5 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-950 dark:hover:text-white transition-colors whitespace-nowrap cursor-pointer text-slate-950 dark:text-white font-bold"
        >
          Portada
        </button>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <button 
          type="button" 
          data-nav-section="Política" 
          class="nav-section-btn px-2.5 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-950 dark:hover:text-white transition-colors whitespace-nowrap cursor-pointer"
        >
          Política
        </button>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <button 
          type="button" 
          data-nav-section="Economía" 
          class="nav-section-btn px-2.5 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-950 dark:hover:text-white transition-colors whitespace-nowrap cursor-pointer"
        >
          Economía
        </button>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <button 
          type="button" 
          data-nav-section="Sociedad" 
          class="nav-section-btn px-2.5 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-950 dark:hover:text-white transition-colors whitespace-nowrap cursor-pointer"
        >
          Sociedad
        </button>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <button 
          type="button" 
          data-nav-section="promesas" 
          class="nav-section-btn px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-100 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors whitespace-nowrap cursor-pointer"
        >
          Promesas 2027
        </button>
      </nav>

      <!-- Search Bar & View Switcher (Streamlined Controls) -->
      <div class="flex items-center gap-2 shrink-0 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
        <!-- Quick Search input (Compact) -->
        <div class="relative w-36 sm:w-44 lg:w-48 shrink-0">
          <input 
            type="text" 
            id="search-input"
            placeholder="Buscar..." 
            class="w-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg pl-3 pr-7 py-1 text-xs text-slate-900 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-slate-400 dark:focus:border-slate-500 focus:bg-white dark:focus:bg-slate-950 shadow-xs transition-colors font-sans"
          />
          <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- View Switcher Tabs (Temas del Día / Noticias / Mirada Exterior) -->
        <nav class="flex items-center p-1 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-mono shrink-0" id="view-tabs">
          <button 
            type="button"
            data-tab="temas-del-dia"
            class="tab-btn px-2.5 sm:px-3 py-1.5 rounded-lg transition-all duration-200 flex items-center gap-1.5 text-slate-900 dark:text-white bg-white dark:bg-slate-800 shadow-xs whitespace-nowrap font-bold"
          >
            <svg class="w-3.5 h-3.5 text-slate-700 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <span>Tapa del Día</span>
          </button>

          <button 
            type="button"
            data-tab="ultimo-momento"
            class="tab-btn px-2.5 sm:px-3 py-1.5 rounded-lg transition-all duration-200 flex items-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 whitespace-nowrap"
          >
            <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Minuto a Minuto</span>
          </button>

          <button 
            type="button"
            data-tab="mirada-exterior"
            class="tab-btn px-2.5 sm:px-3 py-1.5 rounded-lg transition-all duration-200 flex items-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 whitespace-nowrap"
          >
            <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Mirada Exterior</span>
          </button>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  // 1. Theme Toggle Logic
  const themeToggles = document.querySelectorAll('.theme-toggle');
  themeToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('politicheck-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('politicheck-theme', 'dark');
      }
    });
  });

  // 2. Dynamic Live Date Formatting (Intl in Spanish)
  const dateEl = document.getElementById('ticker-live-date');
  if (dateEl) {
    const now = new Date();
    const formatter = new Intl.DateTimeFormat('es-AR', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    });
    dateEl.textContent = formatter.format(now);
  }

  // 3. Client-Side Live Dollar Hydration via dolarapi.com
  async function hydrateLiveRates() {
    try {
      const res = await fetch('https://dolarapi.com/v1/dolares');
      if (!res.ok) return;
      const data = await res.json();
      
      const blue = data.find((d: any) => d.casa === 'blue');
      const oficial = data.find((d: any) => d.casa === 'oficial');
      const mep = data.find((d: any) => d.casa === 'bolsa');

      if (blue) {
        const el = document.getElementById('ticker-blue-val');
        if (el) el.textContent = `$${blue.venta}`;
      }
      if (oficial) {
        const el = document.getElementById('ticker-oficial-val');
        if (el) el.textContent = `$${oficial.venta}`;
      }
      if (mep) {
        const el = document.getElementById('ticker-mep-val');
        if (el) el.textContent = `$${Math.round(mep.venta)}`;
      }
    } catch (e) {
      console.warn('Could not refresh live dollar rates:', e);
    }
  }

  // 4. Client-Side Live Weather Hydration via open-meteo
  async function hydrateLiveWeather() {
    try {
      const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=-34.6132&longitude=-58.3772&current_weather=true');
      if (!res.ok) return;
      const data = await res.json();
      const tempVal = Math.round(data.current_weather.temperature);
      const el = document.getElementById('weather-temp-val');
      if (el) el.textContent = String(tempVal);
    } catch (e) {
      console.warn('Could not refresh live weather:', e);
    }
  }

  // Trigger background updates on load
  hydrateLiveRates();
  hydrateLiveWeather();

  // 5. Dynamic Navigation between Header Sections and Category Filtering
  const navSectionButtons = document.querySelectorAll<HTMLButtonElement>('.nav-section-btn');
  navSectionButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetSec = btn.getAttribute('data-nav-section');
      if (!targetSec) return;

      // Handle navigation from non-homepage paths
      if (window.location.pathname !== '/' && window.location.pathname !== '') {
        if (targetSec === 'promesas') {
          window.location.href = '/#monitor-promesas';
        } else if (targetSec === 'all') {
          window.location.href = '/';
        } else {
          window.location.href = `/?sec=${encodeURIComponent(targetSec)}`;
        }
        return;
      }

      // Update active state in nav
      navSectionButtons.forEach(b => {
        b.classList.remove('text-slate-950', 'dark:text-white', 'font-bold');
        b.classList.add('text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.add('text-slate-950', 'dark:text-white', 'font-bold');
      btn.classList.remove('text-slate-700', 'dark:text-slate-300');

      if (targetSec === 'promesas') {
        // Switch to main view first if hidden
        const mainTab = document.querySelector<HTMLButtonElement>('[data-tab="temas-del-dia"]');
        if (mainTab) mainTab.click();
        
        // Scroll to Promesas section
        const promesasSec = document.getElementById('monitor-promesas');
        if (promesasSec) {
          promesasSec.scrollIntoView({ behavior: 'smooth' });
        }
        return;
      }

      // Switch to main view
      const mainTab = document.querySelector<HTMLButtonElement>('[data-tab="temas-del-dia"]');
      if (mainTab) mainTab.click();

      // Filter stories on homepage
      const storyItems = document.querySelectorAll<HTMLElement>('.story-item');
      const grandOpeningHeader = document.getElementById('grand-opening-header');
      const grandOpeningLeadCard = document.querySelector<HTMLElement>('#grand-opening-card-wrapper');
      const secondaryHeading = document.getElementById('secondary-stories-heading');
      let firstVisibleMatch: HTMLElement | null = null;
      let visibleCount = 0;

      storyItems.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (targetSec === 'all' || itemCat === targetSec) {
          item.style.display = '';
          visibleCount++;
          if (!firstVisibleMatch) firstVisibleMatch = item;
        } else {
          item.style.display = 'none';
        }
      });

      // Manage Gran Apertura Header visibility
      if (grandOpeningHeader && grandOpeningLeadCard) {
        const leadCat = grandOpeningLeadCard.getAttribute('data-category');
        if (targetSec === 'all' || leadCat === targetSec) {
          grandOpeningHeader.style.display = '';
        } else {
          grandOpeningHeader.style.display = 'none';
        }
      }

      // Update secondary stories section heading dynamically
      if (secondaryHeading) {
        if (targetSec === 'all') {
          secondaryHeading.textContent = 'Temas Destacados en Portada';
        } else {
          secondaryHeading.textContent = `Cobertura en Sección: ${targetSec.toUpperCase()} (${visibleCount} historias)`;
        }
      }

      // Filter status banner management
      const filterBanner = document.getElementById('filter-status-banner');
      const filterText = document.getElementById('filter-status-text');
      if (filterBanner && filterText) {
        if (targetSec === 'all') {
          filterBanner.classList.add('hidden');
          filterBanner.classList.remove('flex');
        } else {
          filterBanner.classList.remove('hidden');
          filterBanner.classList.add('flex');
          filterText.textContent = `${targetSec} • ${visibleCount} historias encontradas`;
        }
      }

      // Smooth scroll to top of news grid or matching story
      if (targetSec === 'all') {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else if (firstVisibleMatch) {
        firstVisibleMatch.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // Global header search input: handle enter key if on external page
  const headerSearchInput = document.getElementById('search-input') as HTMLInputElement | null;
  if (headerSearchInput) {
    headerSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const val = headerSearchInput.value.trim();
        if (window.location.pathname !== '/' && window.location.pathname !== '') {
          window.location.href = `/?q=${encodeURIComponent(val)}`;
        }
      }
    });
  }

  // --- Dynamic Live Sync Timestamp Logic ---
  const syncTimeAgo = document.getElementById('sync-time-ago');

  function updateSyncTimeAgo() {
    if (!syncTimeAgo) return;
    const serverSync = syncTimeAgo.getAttribute('data-server-sync');
    const localSync = localStorage.getItem('politicheck_last_sync_timestamp');

    let syncTimeMs = serverSync ? new Date(serverSync).getTime() : 0;
    if (localSync) {
      const localMs = parseInt(localSync, 10);
      if (localMs > syncTimeMs) syncTimeMs = localMs;
    }

    if (!syncTimeMs || isNaN(syncTimeMs)) {
      syncTimeAgo.textContent = 'Actualizado recién';
      return;
    }

    const diffMs = Date.now() - syncTimeMs;
    const diffMins = Math.floor(diffMs / 60000);
    const syncDate = new Date(syncTimeMs);
    const timeFormatted = syncDate.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }) + ' hs';

    if (diffMins < 1) {
      syncTimeAgo.textContent = `Actualizado recién (${timeFormatted})`;
    } else if (diffMins < 60) {
      syncTimeAgo.textContent = `Hace ${diffMins} min (${timeFormatted})`;
    } else if (diffMins < 1440) {
      const diffHours = Math.floor(diffMins / 60);
      syncTimeAgo.textContent = `Hoy ${timeFormatted} (hace ${diffHours}h)`;
    } else {
      const dayFormatted = syncDate.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit' });
      syncTimeAgo.textContent = `${dayFormatted} a las ${timeFormatted}`;
    }
  }

  updateSyncTimeAgo();
  setInterval(updateSyncTimeAgo, 30000);

  // Background fetch of server live status to overcome CDN edge caching
  fetch('/api/rss/sync?status=true')
    .then(res => res.json())
    .then(data => {
      if (data.lastSyncTimestamp && syncTimeAgo) {
        syncTimeAgo.setAttribute('data-server-sync', data.lastSyncTimestamp);
        updateSyncTimeAgo();
      }
    })
    .catch(() => {});
</script>
