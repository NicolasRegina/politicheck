---
// PwaBanner.astro: Service worker registration, offline indicator, and adaptive PWA install prompt
import BrandLogo from './BrandLogo.astro';
---

<!-- Offline Banner Notification -->
<div 
  id="offline-indicator" 
  class="hidden fixed top-0 inset-x-0 z-50 py-1.5 px-4 bg-amber-500 text-slate-950 font-mono text-xs font-bold text-center shadow-md flex items-center justify-center gap-2"
>
  <span class="w-2 h-2 rounded-full bg-slate-950 motion-safe:animate-ping" aria-hidden="true"></span>
  <span>Modo Sin Conexión: Visualizando noticias guardadas en caché local.</span>
</div>

<!-- Backdrop Overlay for Mobile Bottom Sheet (Subtle tap-to-dismiss) -->
<div 
  id="pwa-backdrop" 
  class="hidden fixed inset-0 z-40 bg-slate-950/40 backdrop-blur-xs transition-opacity duration-300 opacity-0 sm:hidden"
  aria-hidden="true"
></div>

<!-- Adaptive PWA Install Sheet / Card -->
<aside 
  id="pwa-install-banner" 
  class="fixed inset-x-0 bottom-0 sm:inset-x-auto sm:bottom-6 sm:left-6 z-50 w-full sm:max-w-md p-5 sm:p-5 rounded-t-3xl sm:rounded-2xl bg-white/98 dark:bg-slate-900/98 backdrop-blur-md border-t sm:border border-slate-200 dark:border-slate-800 shadow-2xl motion-safe:transition-transform transition-opacity duration-300 ease-out transform translate-y-full opacity-0 pointer-events-none"
  aria-label="Instalar aplicación web de Politicheck"
>
  <!-- Mobile Drag / Bottom Sheet Pill Indicator -->
  <div class="w-12 h-1 rounded-full bg-slate-300 dark:bg-slate-700 mx-auto mb-3 sm:hidden" aria-hidden="true"></div>

  <!-- Header: Brand + Title + Dismiss -->
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-3">
      <BrandLogo size={38} />
      <div>
        <div class="flex items-center gap-1.5">
          <h4 class="font-bold text-slate-950 dark:text-white font-sans text-sm tracking-tight" id="pwa-title-text">
            Instalar Politicheck
          </h4>
          <span class="px-1.5 py-0.5 rounded text-[10px] font-sans font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
            PWA
          </span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-snug" id="pwa-subtitle-text">
          Acceso instantáneo, sin conexión y en pantalla completa
        </p>
      </div>
    </div>
    <button 
      type="button" 
      id="pwa-dismiss-btn" 
      class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      aria-label="Cerrar aviso de instalación"
    >
      <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- VIEW 1: Android / Chromium / Desktop (One-click native install) -->
  <div id="pwa-android-view" class="space-y-3 pt-3">
    <div class="grid grid-cols-3 gap-2 text-[11px] font-sans text-slate-600 dark:text-slate-400 py-1">
      <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-800 text-center flex flex-col items-center gap-0.5">
        <svg aria-hidden="true" class="w-4 h-4 text-amber-500 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        <span class="font-semibold text-slate-800 dark:text-slate-200">1 Toque</span>
        <span class="block text-[10px] text-slate-400">Acceso veloz</span>
      </div>
      <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-800 text-center flex flex-col items-center gap-0.5">
        <svg aria-hidden="true" class="w-4 h-4 text-slate-500 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" /></svg>
        <span class="font-semibold text-slate-800 dark:text-slate-200">Offline</span>
        <span class="block text-[10px] text-slate-400">Caché local</span>
      </div>
      <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-800 text-center flex flex-col items-center gap-0.5">
        <svg aria-hidden="true" class="w-4 h-4 text-emerald-500 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
        <span class="font-semibold text-slate-800 dark:text-slate-200">0 Pauta</span>
        <span class="block text-[10px] text-slate-400">Sin publicidad</span>
      </div>
    </div>

    <div class="flex items-center gap-2 pt-1 font-sans text-xs">
      <button 
        type="button" 
        id="pwa-install-btn" 
        class="flex-1 py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white dark:bg-white dark:hover:bg-slate-100 dark:text-slate-950 font-bold transition-colors shadow-md text-center flex items-center justify-center gap-1.5 cursor-pointer"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
        <span>Instalar App</span>
      </button>
      <button 
        type="button" 
        id="pwa-later-btn" 
        class="py-2.5 px-3.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium transition-colors cursor-pointer"
      >
        Más tarde
      </button>
    </div>
  </div>

  <!-- VIEW 2: iOS / Safari Guide (2-step visual walkthrough) -->
  <div id="pwa-ios-view" class="hidden space-y-3 pt-3">
    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 space-y-2.5 text-xs font-sans">
      <div class="flex items-start gap-2.5">
        <span class="flex items-center justify-center w-6 h-6 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold text-xs shrink-0 mt-0.5 border border-blue-500/20">
          1
        </span>
        <div class="leading-relaxed text-slate-700 dark:text-slate-300 text-xs">
          Tocá el botón <strong class="text-slate-950 dark:text-white">Compartir</strong> 
          <span class="inline-flex items-center justify-center px-1.5 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 align-middle text-blue-500 font-bold text-[10px] mx-0.5">
            <svg aria-hidden="true" class="w-3.5 h-3.5 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
          </span>
          en la barra inferior de Safari.
        </div>
      </div>

      <div class="flex items-start gap-2.5">
        <span class="flex items-center justify-center w-6 h-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-xs shrink-0 mt-0.5 border border-emerald-500/20">
          2
        </span>
        <div class="leading-relaxed text-slate-700 dark:text-slate-300 text-xs">
          Deslizá hacia abajo y seleccioná <strong class="text-slate-950 dark:text-white">"Agregar a pantalla de inicio"</strong> 
          <span class="inline-flex items-center justify-center px-1.5 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 align-middle text-emerald-500 font-bold text-[10px] mx-0.5">
            <svg aria-hidden="true" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          </span>.
        </div>
      </div>
    </div>

    <div class="flex items-center gap-2 pt-1 font-sans text-xs">
      <button 
        type="button" 
        id="pwa-ios-done-btn" 
        class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white dark:bg-white dark:hover:bg-slate-100 dark:text-slate-950 font-bold transition-colors shadow-md text-center cursor-pointer"
      >
        Entendido
      </button>
    </div>
  </div>
</aside>

<script is:inline>
  // Service Worker Registration
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').then((reg) => {
        reg.onupdatefound = () => {
          const installingWorker = reg.installing;
          if (installingWorker) {
            installingWorker.onstatechange = () => {
              if (installingWorker.state === 'installed' && navigator.serviceWorker.controller) {
                console.log('[SW] Nueva versión disponible');
              }
            };
          }
        };
      }).catch((err) => {
        console.warn('[SW] Fallo al registrar Service Worker:', err);
      });
    });
  }

  // Offline / Online Status Handling
  const offlineIndicator = document.getElementById('offline-indicator');
  function updateOnlineStatus() {
    if (!navigator.onLine) {
      if (offlineIndicator) offlineIndicator.classList.remove('hidden');
    } else {
      if (offlineIndicator) offlineIndicator.classList.add('hidden');
    }
  }
  window.addEventListener('online', updateOnlineStatus);
  window.addEventListener('offline', updateOnlineStatus);
  updateOnlineStatus();

  // PWA Adaptive Installation Logic
  (function initPwaInstall() {
    let deferredPrompt = null;
    const banner = document.getElementById('pwa-install-banner');
    const backdrop = document.getElementById('pwa-backdrop');
    const installBtn = document.getElementById('pwa-install-btn');
    const dismissBtn = document.getElementById('pwa-dismiss-btn');
    const laterBtn = document.getElementById('pwa-later-btn');
    const iosDoneBtn = document.getElementById('pwa-ios-done-btn');
    const androidView = document.getElementById('pwa-android-view');
    const iosView = document.getElementById('pwa-ios-view');

    // Standalone check (already installed / launched from home screen)
    function isAppStandalone() {
      return window.matchMedia('(display-mode: standalone)').matches || 
             (window.navigator && window.navigator.standalone === true);
    }

    // Platform detection (iOS Safari vs Android / Chromium)
    function isIosDevice() {
      const ua = navigator.userAgent.toLowerCase();
      return /iphone|ipad|ipod/.test(ua) || (Boolean(navigator.maxTouchPoints && navigator.maxTouchPoints > 2) && /macintosh/.test(ua));
    }

    // Check if dismissed and within 3-day cooldown
    function isCoolingDown() {
      const dismissedUntil = localStorage.getItem('politicheck-pwa-dismissed-until');
      if (!dismissedUntil) return false;
      return Date.now() < parseInt(dismissedUntil, 10);
    }

    function showBanner(force = false) {
      if (!banner) return;
      if (isAppStandalone()) {
        if (force && typeof window.showPoliticheckToast === 'function') {
          window.showPoliticheckToast('App ya instalada', 'Politicheck ya está ejecutándose en modo nativo.', 'check');
        }
        return;
      }

      if (!force && isCoolingDown()) {
        return;
      }

      const isIos = isIosDevice();
      if (isIos) {
        if (androidView) androidView.classList.add('hidden');
        if (iosView) iosView.classList.remove('hidden');
      } else {
        if (androidView) androidView.classList.remove('hidden');
        if (iosView) iosView.classList.add('hidden');
      }

      // Display animations
      if (backdrop) {
        backdrop.classList.remove('hidden');
        requestAnimationFrame(() => {
          backdrop.classList.remove('opacity-0');
          backdrop.classList.add('opacity-100');
        });
      }

      banner.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
      banner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
    }

    function hideBanner(saveCooldown = true) {
      if (!banner) return;

      if (saveCooldown) {
        // 3 days cooldown: 3 * 24 * 60 * 60 * 1000 = 259,200,000 ms
        const cooldownTimestamp = Date.now() + (3 * 24 * 60 * 60 * 1000);
        localStorage.setItem('politicheck-pwa-dismissed-until', cooldownTimestamp.toString());
      }

      banner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      banner.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');

      if (backdrop) {
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        setTimeout(() => {
          backdrop.classList.add('hidden');
        }, 300);
      }
    }

    // Capture beforeinstallprompt event (Android / Chromium)
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
    });

    // Install button click handler
    if (installBtn) {
      installBtn.addEventListener('click', async () => {
        if (deferredPrompt) {
          deferredPrompt.prompt();
          const choiceResult = await deferredPrompt.userChoice;
          if (choiceResult && choiceResult.outcome === 'accepted') {
            localStorage.setItem('politicheck-pwa-installed', 'true');
          }
          deferredPrompt = null;
          hideBanner(true);
        } else {
          // If browser didn't fire beforeinstallprompt yet (or already installed)
          if (typeof window.showPoliticheckToast === 'function') {
            window.showPoliticheckToast('Instalar Politicheck', 'Tocá el menú de tu navegador y seleccioná "Instalar aplicación" o "Agregar a la pantalla principal".', 'check');
          }
          hideBanner(true);
        }
      });
    }

    if (dismissBtn) dismissBtn.addEventListener('click', () => hideBanner(true));
    if (laterBtn) laterBtn.addEventListener('click', () => hideBanner(true));
    if (iosDoneBtn) iosDoneBtn.addEventListener('click', () => hideBanner(true));
    if (backdrop) backdrop.addEventListener('click', () => hideBanner(true));

    // Expose global trigger for header button or footer link
    window.openPwaInstallPrompt = function() {
      showBanner(true);
    };

    // Auto-prompt after 3 seconds of reading (if not standalone and not in cooldown)
    if (!isAppStandalone() && !isCoolingDown()) {
      setTimeout(() => {
        showBanner(false);
      }, 3000);
    }
  })();

  // Morning Digest Notification Subscription
  window.subscribeToMorningDigest = async function() {
    if (!('Notification' in window)) {
      if (typeof window.showPoliticheckToast === 'function') {
        window.showPoliticheckToast('Notificaciones no soportadas', 'Tu navegador no admite notificaciones push.', 'check');
      }
      return;
    }

    try {
      const permission = await Notification.requestPermission();
      if (permission === 'granted') {
        localStorage.setItem('politicheck-morning-digest', 'enabled');
        if (typeof window.showPoliticheckToast === 'function') {
          window.showPoliticheckToast(
            'Suscripción activa',
            'Recibirás el resumen con el contraste de las 31 tapas cada mañana a las 8:00 AM.',
            'check'
          );
        }
      } else {
        if (typeof window.showPoliticheckToast === 'function') {
          window.showPoliticheckToast(
            'Permiso denegado',
            'Podés activar las notificaciones desde la configuración del navegador.',
            'check'
          );
        }
      }
    } catch (e) {
      console.warn('Notification error:', e);
    }
  };
</script>
