---
// PwaBanner.astro: Service worker registration, offline indicator, and PWA install prompt
---

<!-- Offline Banner Notification -->
<div 
  id="offline-indicator" 
  class="hidden fixed top-0 inset-x-0 z-50 py-1.5 px-4 bg-amber-500 text-slate-950 font-mono text-xs font-bold text-center shadow-md flex items-center justify-center gap-2"
>
  <span class="w-2 h-2 rounded-full bg-slate-950 animate-ping"></span>
  <span>Modo Sin Conexión: Visualizando noticias guardadas en caché local.</span>
</div>

<!-- Discreet PWA Install Banner -->
<aside 
  id="pwa-install-banner" 
  class="hidden fixed bottom-6 left-6 z-40 max-w-sm p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-3 transition-all duration-300"
  aria-label="Instalar aplicación web de Politicheck"
>
  <div class="flex items-start justify-between gap-2">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-slate-950 dark:bg-white flex items-center justify-center font-bold text-white dark:text-slate-950 font-mono text-base shrink-0 shadow-sm">
        P
      </div>
      <div>
        <h4 class="font-bold text-slate-950 dark:text-white font-mono text-xs">
          Instalar Politicheck
        </h4>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">
          Acceso instantáneo sin conexión y pantalla completa
        </p>
      </div>
    </div>
    <button 
      type="button" 
      id="pwa-dismiss-btn" 
      class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1 text-xs font-bold"
      aria-label="Cerrar aviso de instalación"
    >
      ✕
    </button>
  </div>

  <div class="flex items-center gap-2 pt-1 font-mono text-xs">
    <button 
      type="button" 
      id="pwa-install-btn" 
      class="flex-1 py-1.5 px-3 rounded-lg bg-slate-900 hover:bg-slate-800 text-white dark:bg-white dark:hover:bg-slate-100 dark:text-slate-950 font-bold transition-colors text-center"
    >
      Instalar App
    </button>
    <button 
      type="button" 
      id="pwa-later-btn" 
      class="py-1.5 px-2.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 transition-colors"
    >
      Más tarde
    </button>
  </div>
</aside>

<script is:inline>
  // Service Worker Registration
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').then((reg) => {
        // Check for updates
        reg.onupdatefound = () => {
          const installingWorker = reg.installing;
          if (installingWorker) {
            installingWorker.onstatechange = () => {
              if (installingWorker.state === 'installed' && navigator.serviceWorker.controller) {
                console.log('[SW] Nueva versión disponible');
              }
            };
          }
        };
      }).catch((err) => {
        console.warn('[SW] Fallo al registrar Service Worker:', err);
      });
    });
  }

  // Offline / Online Status Handling
  const offlineIndicator = document.getElementById('offline-indicator');
  function updateOnlineStatus() {
    if (!navigator.onLine) {
      if (offlineIndicator) offlineIndicator.classList.remove('hidden');
    } else {
      if (offlineIndicator) offlineIndicator.classList.add('hidden');
    }
  }
  window.addEventListener('online', updateOnlineStatus);
  window.addEventListener('offline', updateOnlineStatus);
  updateOnlineStatus();

  // PWA Install Prompt handling
  let deferredPrompt = null;
  const pwaBanner = document.getElementById('pwa-install-banner');
  const installBtn = document.getElementById('pwa-install-btn');
  const dismissBtn = document.getElementById('pwa-dismiss-btn');
  const laterBtn = document.getElementById('pwa-later-btn');

  const isDismissed = sessionStorage.getItem('politicheck-pwa-dismissed');

  window.addEventListener('beforeinstallprompt', (e) => {
    // Prevent the mini-infobar from appearing on mobile
    e.preventDefault();
    deferredPrompt = e;

    if (!isDismissed && pwaBanner) {
      pwaBanner.classList.remove('hidden');
    }
  });

  if (installBtn) {
    installBtn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      deferredPrompt = null;
      if (pwaBanner) pwaBanner.classList.add('hidden');
    });
  }

  function dismissPwaBanner() {
    sessionStorage.setItem('politicheck-pwa-dismissed', 'true');
    if (pwaBanner) pwaBanner.classList.add('hidden');
  }

  if (dismissBtn) dismissBtn.addEventListener('click', dismissPwaBanner);
  if (laterBtn) laterBtn.addEventListener('click', dismissPwaBanner);

  // Morning Digest Notification Subscription
  window.subscribeToMorningDigest = async function() {
    if (!('Notification' in window)) {
      if (typeof window.showPoliticheckToast === 'function') {
        window.showPoliticheckToast('Notificaciones no soportadas', 'Tu navegador no admite notificaciones push.', '⚠️');
      }
      return;
    }

    try {
      const permission = await Notification.requestPermission();
      if (permission === 'granted') {
        localStorage.setItem('politicheck-morning-digest', 'enabled');
        if (typeof window.showPoliticheckToast === 'function') {
          window.showPoliticheckToast(
            '¡Suscripción activa!',
            'Recibirás el resumen con el contraste de las 31 tapas cada mañana a las 8:00 AM.',
            '📬'
          );
        }
      } else {
        if (typeof window.showPoliticheckToast === 'function') {
          window.showPoliticheckToast(
            'Permiso denegado',
            'Podés activar las notificaciones desde la configuración del navegador.',
            'ℹ️'
          );
        }
      }
    } catch (e) {
      console.warn('Notification error:', e);
    }
  };
</script>
