---
interface Props {
  size?: number | string;
  class?: string;
  withText?: boolean;
}

const { size = 32, class: className = '', withText = false } = Astro.props;
---

<div class={`inline-flex items-center gap-2.5 ${className}`}>
  <!-- Official Politicheck P-Checkmark Emblem (ADR-0008 Smooth Bézier) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 100 100"
    fill="none"
    width={size}
    height={size}
    class="shrink-0"
    aria-label="Logo Politicheck"
  >
    <circle cx="50" cy="50" r="48.5" fill="#121210" />
    <circle cx="50" cy="50" r="46.5" stroke="#FAF9F6" stroke-opacity="0.9" stroke-width="1.6" fill="none" />
    <path
      fill-rule="evenodd"
      clip-rule="evenodd"
      d="M 26 26 H 49 C 59.5 26 66 32.5 66 41.5 C 66 50.5 59.5 57 49 57 H 37 V 74 H 26 Z M 37 35 V 48 H 48.5 C 53.2 48 56 45.3 56 41.5 C 56 37.7 53.2 35 48.5 35 Z"
      fill="#FAF9F6"
    />
    <path
      d="M 42 60 L 48.8 60 L 52.8 64.5 L 74.5 36.5 L 77 38.5 L 54.2 73.5 C 53.2 75 51.2 75.2 50 73.8 Z"
      fill="#7FB3E0"
    />
  </svg>

  {withText && (
    <span class="font-editorial font-bold text-ink text-base tracking-tight">
      Politicheck
    </span>
  )}
</div>
