---
import type { Article } from '../types';
import { getOutletMeta } from '../utils/outlets';
import { getOptimizedImageUrl } from '../utils/image';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const outletMeta = getOutletMeta(article.outletId);
const optimizedThumbnailUrl = article.imageUrl ? getOptimizedImageUrl(article.imageUrl, 160, 65) : '';
---

<a 
  href={article.url}
  target="_blank" 
  rel="noopener noreferrer"
  class="group block bg-white dark:bg-surface-dark rounded-xl p-3.5 sm:p-4 border border-slate-200 dark:border-slate-800/80 hover:border-slate-300 dark:hover:border-slate-700 transition-colors duration-200 shadow-xs"
>
  <div class="flex gap-3.5 items-start">
    {optimizedThumbnailUrl && (
      <div class="thumbnail-wrapper w-20 h-20 sm:w-24 sm:h-20 shrink-0 overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
        <img 
          src={optimizedThumbnailUrl} 
          data-original-src={article.imageUrl}
          alt={article.title}
          loading="lazy"
          decoding="async"
          width="96"
          height="80"
          referrerpolicy="no-referrer"
          onerror="if (this.dataset.retry !== '1') { this.dataset.retry = '1'; this.setAttribute('src', this.dataset.originalSrc); } else { const w = this.closest('.thumbnail-wrapper'); if (w) w.style.display = 'none'; }"
          class="w-full h-full object-cover motion-safe:group-hover:scale-105 motion-safe:transition-transform duration-300"
        />
      </div>
    )}

    <div class="flex-1 space-y-1 min-w-0">
      <div class="flex items-center justify-between gap-2 text-xs mb-1">
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class={`px-1.5 py-0.5 rounded text-[9px] font-mono font-bold border ${outletMeta.badgeClass}`}>
            {outletMeta.code}
          </span>
          <span class="text-slate-300 dark:text-slate-700">•</span>
          <span class="text-slate-500 dark:text-slate-400 font-mono text-[10px] font-semibold">{article.publishedAt}</span>
        </div>

        <span class="text-slate-400 group-hover:text-slate-700 dark:text-slate-500 dark:group-hover:text-slate-300 font-mono text-[10px] inline-flex items-center gap-1 shrink-0">
          Nota original
          <svg aria-hidden="true" class="w-2.5 h-2.5 motion-safe:group-hover:translate-x-0.5 motion-safe:transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </span>
      </div>

      <h4 class="font-editorial text-sm sm:text-base font-bold text-slate-900 group-hover:text-black dark:text-slate-100 dark:group-hover:text-white leading-snug transition-colors line-clamp-2">
        {article.title}
      </h4>

      {article.snippet && (
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-2 font-sans">
          {article.snippet}
        </p>
      )}
    </div>
  </div>
</a>
