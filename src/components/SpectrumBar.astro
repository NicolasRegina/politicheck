---
import type { SpectrumBreakdown, Article } from '../types';
import { getOutletMeta } from '../utils/outlets';

interface Props {
  spectrum?: SpectrumBreakdown;
  articles?: Article[];
  /** When provided (e.g. on Portada), clicking any pole navigates directly to /historia/[storyId]?sesgo=<pole>#comparativa */
  storyId?: string;
}

const { spectrum: initialSpectrum, articles, storyId } = Astro.props;

// Calculate mathematically exact spectrum based on participating articles
let spectrum = initialSpectrum;

if (articles && articles.length > 0) {
  let ofi = 0;
  let centro = 0;
  let opo = 0;

  articles.forEach((a) => {
    const outlet = getOutletMeta(a.outletId);
    const leaning = outlet?.baselineLeaning || 'centro_datos';
    if (leaning === 'oficialismo') ofi++;
    else if (leaning === 'oposicion') opo++;
    else centro++;
  });

  const total = articles.length;
  const ofiPct = Math.round((ofi / total) * 100);
  const centroPct = Math.round((centro / total) * 100);
  // Ensure the three sum exactly to 100%
  const opoPct = Math.max(0, 100 - ofiPct - centroPct);

  spectrum = {
    oficialismoPct: ofiPct,
    centroDatosPct: centroPct,
    oposicionPct: opoPct,
    totalOutlets: total
  };
}

if (!spectrum) {
  spectrum = { oficialismoPct: 0, centroDatosPct: 100, oposicionPct: 0, totalOutlets: 1 };
}

const poleUrl = (leaning: string) =>
  storyId ? `/historia/${storyId}?sesgo=${leaning}#comparativa` : undefined;
---

<div class="space-y-2">
  <!-- Legend with real percentages (Non-partisan mineral trio — ADR-0008) -->
  <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-[11px] sm:text-xs font-mono">
    {storyId ? (
      <a
        href={poleUrl('oficialismo')}
        class={`inline-flex items-center gap-1.5 transition-colors hover:text-accent rounded py-0.5 ${spectrum.oficialismoPct > 0 ? 'text-ink font-medium' : 'text-ink-muted opacity-50'}`}
        title="Ver titulares de medios de línea oficialista"
      >
        <span class={`w-2 h-2 rounded-full shrink-0 ${spectrum.oficialismoPct > 0 ? 'bg-spec-ofi' : 'bg-rule'}`}></span>
        <strong class="font-semibold">{spectrum.oficialismoPct}%</strong>
        <span class="text-ink-muted">Oficialismo</span>
      </a>
    ) : (
      <button
        type="button"
        class={`spectrum-filter-trigger inline-flex items-center gap-1.5 transition-colors hover:text-accent cursor-pointer text-left rounded px-1 -mx-1 py-0.5 ${spectrum.oficialismoPct > 0 ? 'text-ink font-medium' : 'text-ink-muted opacity-50'}`}
        data-trigger-leaning="oficialismo"
        title="Clic para filtrar por medios de línea oficialista"
      >
        <span class={`w-2 h-2 rounded-full shrink-0 ${spectrum.oficialismoPct > 0 ? 'bg-spec-ofi' : 'bg-rule'}`}></span>
        <strong class="font-semibold">{spectrum.oficialismoPct}%</strong>
        <span class="text-ink-muted">Oficialismo</span>
      </button>
    )}

    {storyId ? (
      <a
        href={poleUrl('centro_datos')}
        class={`inline-flex items-center gap-1.5 transition-colors hover:text-accent rounded py-0.5 ${spectrum.centroDatosPct > 0 ? 'text-ink font-medium' : 'text-ink-muted opacity-50'}`}
        title="Ver titulares de medios de centro y datos factuales"
      >
        <span class={`w-2 h-2 rounded-full shrink-0 ${spectrum.centroDatosPct > 0 ? 'bg-spec-cen' : 'bg-rule'}`}></span>
        <strong class="font-semibold">{spectrum.centroDatosPct}%</strong>
        <span class="text-ink-muted">Centro</span>
      </a>
    ) : (
      <button
        type="button"
        class={`spectrum-filter-trigger inline-flex items-center gap-1.5 transition-colors hover:text-accent cursor-pointer text-left rounded px-1 -mx-1 py-0.5 ${spectrum.centroDatosPct > 0 ? 'text-ink font-medium' : 'text-ink-muted opacity-50'}`}
        data-trigger-leaning="centro_datos"
        title="Clic para filtrar por medios de centro y datos factuales"
      >
        <span class={`w-2 h-2 rounded-full shrink-0 ${spectrum.centroDatosPct > 0 ? 'bg-spec-cen' : 'bg-rule'}`}></span>
        <strong class="font-semibold">{spectrum.centroDatosPct}%</strong>
        <span class="text-ink-muted">Centro</span>
      </button>
    )}

    {storyId ? (
      <a
        href={poleUrl('oposicion')}
        class={`inline-flex items-center gap-1.5 transition-colors hover:text-accent rounded py-0.5 ${spectrum.oposicionPct > 0 ? 'text-ink font-medium' : 'text-ink-muted opacity-50'}`}
        title="Ver titulares de medios de línea opositora"
      >
        <span class={`w-2 h-2 rounded-full shrink-0 ${spectrum.oposicionPct > 0 ? 'bg-spec-opo' : 'bg-rule'}`}></span>
        <strong class="font-semibold">{spectrum.oposicionPct}%</strong>
        <span class="text-ink-muted">Oposición</span>
      </a>
    ) : (
      <button
        type="button"
        class={`spectrum-filter-trigger inline-flex items-center gap-1.5 transition-colors hover:text-accent cursor-pointer text-left rounded px-1 -mx-1 py-0.5 ${spectrum.oposicionPct > 0 ? 'text-ink font-medium' : 'text-ink-muted opacity-50'}`}
        data-trigger-leaning="oposicion"
        title="Clic para filtrar por medios de línea opositora"
      >
        <span class={`w-2 h-2 rounded-full shrink-0 ${spectrum.oposicionPct > 0 ? 'bg-spec-opo' : 'bg-rule'}`}></span>
        <strong class="font-semibold">{spectrum.oposicionPct}%</strong>
        <span class="text-ink-muted">Oposición</span>
      </button>
    )}
  </div>

  <!-- Editorial Fine Spectrum Track (6px — no partisan colors, no shadow-inner) -->
  <div class="w-full h-1.5 rounded-full bg-surface-muted flex overflow-hidden gap-0.5" role="img" aria-label={`Espectro de cobertura: ${spectrum.oficialismoPct}% oficialismo, ${spectrum.centroDatosPct}% centro, ${spectrum.oposicionPct}% oposición`}>
    {spectrum.oficialismoPct > 0 && (
      storyId ? (
        <a
          href={poleUrl('oficialismo')}
          class="h-full bg-spec-ofi transition-opacity duration-200 hover:opacity-80"
          style={`width: ${spectrum.oficialismoPct}%`}
          title={`Oficialismo: ${spectrum.oficialismoPct}% — Ver titulares`}
          aria-label={`Ver titulares oficialistas (${spectrum.oficialismoPct}%)`}
        ></a>
      ) : (
        <div
          class="spectrum-filter-trigger h-full bg-spec-ofi transition-opacity duration-200 hover:opacity-80 cursor-pointer"
          style={`width: ${spectrum.oficialismoPct}%`}
          data-trigger-leaning="oficialismo"
          title={`Enfoque Oficialista: ${spectrum.oficialismoPct}% (Clic para filtrar)`}
          tabindex="0"
          role="button"
        ></div>
      )
    )}

    {spectrum.centroDatosPct > 0 && (
      storyId ? (
        <a
          href={poleUrl('centro_datos')}
          class="h-full bg-spec-cen transition-opacity duration-200 hover:opacity-80"
          style={`width: ${spectrum.centroDatosPct}%`}
          title={`Centro / Datos: ${spectrum.centroDatosPct}% — Ver titulares`}
          aria-label={`Ver titulares de centro y datos (${spectrum.centroDatosPct}%)`}
        ></a>
      ) : (
        <div
          class="spectrum-filter-trigger h-full bg-spec-cen transition-opacity duration-200 hover:opacity-80 cursor-pointer"
          style={`width: ${spectrum.centroDatosPct}%`}
          data-trigger-leaning="centro_datos"
          title={`Centro / Datos Factuales: ${spectrum.centroDatosPct}% (Clic para filtrar)`}
          tabindex="0"
          role="button"
        ></div>
      )
    )}

    {spectrum.oposicionPct > 0 && (
      storyId ? (
        <a
          href={poleUrl('oposicion')}
          class="h-full bg-spec-opo transition-opacity duration-200 hover:opacity-80"
          style={`width: ${spectrum.oposicionPct}%`}
          title={`Oposición: ${spectrum.oposicionPct}% — Ver titulares`}
          aria-label={`Ver titulares opositores (${spectrum.oposicionPct}%)`}
        ></a>
      ) : (
        <div
          class="spectrum-filter-trigger h-full bg-spec-opo transition-opacity duration-200 hover:opacity-80 cursor-pointer"
          style={`width: ${spectrum.oposicionPct}%`}
          data-trigger-leaning="oposicion"
          title={`Enfoque Opositor: ${spectrum.oposicionPct}% (Clic para filtrar)`}
          tabindex="0"
          role="button"
        ></div>
      )
    )}
  </div>
</div>
