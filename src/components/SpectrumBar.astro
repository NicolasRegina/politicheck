---
import type { SpectrumBreakdown } from '../types';

interface Props {
  spectrum: SpectrumBreakdown;
}

const { spectrum } = Astro.props;
---

<div class="space-y-2">
  <div class="flex items-center justify-between text-xs text-slate-600 dark:text-slate-400 font-mono">
    <span class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-slate-900 dark:bg-slate-200"></span>
      Oficialismo: <strong class="text-slate-900 dark:text-slate-200">{spectrum.oficialismoPct}%</strong>
    </span>
    <span class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-slate-500"></span>
      Centro / Datos: <strong class="text-slate-800 dark:text-slate-300">{spectrum.centroDatosPct}%</strong>
    </span>
    <span class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-700 border border-slate-400 dark:border-slate-500"></span>
      Oposición: <strong class="text-slate-700 dark:text-slate-400">{spectrum.oposicionPct}%</strong>
    </span>
  </div>

  <!-- Bar container with technical monochrome segments in Light & Dark -->
  <div class="w-full h-3 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 p-0.5 flex overflow-hidden gap-0.5 shadow-inner">
    <div 
      class="h-full bg-slate-900 dark:bg-slate-200 rounded-l-sm transition-all duration-500 hover:opacity-90" 
      style={`width: ${spectrum.oficialismoPct}%`}
      title={`Oficialismo: ${spectrum.oficialismoPct}%`}
    ></div>
    <div 
      class="h-full bg-slate-500 transition-all duration-500 hover:opacity-90" 
      style={`width: ${spectrum.centroDatosPct}%`}
      title={`Centro / Datos: ${spectrum.centroDatosPct}%`}
    ></div>
    <div 
      class="h-full bg-slate-300 dark:bg-slate-800 border-l border-slate-300 dark:border-slate-700 rounded-r-sm transition-all duration-500 hover:opacity-90" 
      style={`width: ${spectrum.oposicionPct}%`}
      title={`Oposición: ${spectrum.oposicionPct}%`}
    ></div>
  </div>
</div>
