---
import type { SpectrumBreakdown, Article } from '../types';
import { getOutletMeta } from '../utils/outlets';

interface Props {
  spectrum?: SpectrumBreakdown;
  articles?: Article[];
}

const { spectrum: initialSpectrum, articles } = Astro.props;

// Calculate mathematically exact spectrum based on participating articles
let spectrum = initialSpectrum;

if (articles && articles.length > 0) {
  let ofi = 0;
  let centro = 0;
  let opo = 0;

  articles.forEach((a) => {
    const outlet = getOutletMeta(a.outletId);
    const leaning = outlet?.baselineLeaning || 'centro_datos';
    if (leaning === 'oficialismo') ofi++;
    else if (leaning === 'oposicion') opo++;
    else centro++;
  });

  const total = articles.length;
  const ofiPct = Math.round((ofi / total) * 100);
  const centroPct = Math.round((centro / total) * 100);
  // Ensure the three sum exactly to 100%
  const opoPct = Math.max(0, 100 - ofiPct - centroPct);

  spectrum = {
    oficialismoPct: ofiPct,
    centroDatosPct: centroPct,
    oposicionPct: opoPct,
    totalOutlets: total
  };
}

if (!spectrum) {
  spectrum = { oficialismoPct: 0, centroDatosPct: 100, oposicionPct: 0, totalOutlets: 1 };
}
---

<div class="space-y-1.5 sm:space-y-2">
  <!-- Legend with real percentages derived from participating outlets (Clickable to filter) -->
  <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1.5 text-[10px] sm:text-xs font-mono">
    <button 
      type="button"
      class={`spectrum-filter-trigger flex items-center gap-1.5 transition-all hover:scale-105 cursor-pointer text-left focus:outline-none focus:ring-1 focus:ring-violet-400 rounded px-1 -mx-1 py-0.5 ${spectrum.oficialismoPct > 0 ? 'text-violet-700 dark:text-violet-300 font-semibold' : 'text-slate-400 dark:text-slate-600 opacity-60'}`}
      data-trigger-leaning="oficialismo"
      title="Clic para filtrar por medios de línea oficialista"
    >
      <span class={`w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full shrink-0 ${spectrum.oficialismoPct > 0 ? 'bg-violet-600 dark:bg-violet-500 shadow-xs' : 'bg-slate-300 dark:bg-slate-700'}`}></span>
      <span>Oficialismo:</span> <strong class="font-bold">{spectrum.oficialismoPct}%</strong>
    </button>

    <button 
      type="button"
      class={`spectrum-filter-trigger flex items-center gap-1.5 transition-all hover:scale-105 cursor-pointer text-left focus:outline-none focus:ring-1 focus:ring-emerald-400 rounded px-1 -mx-1 py-0.5 ${spectrum.centroDatosPct > 0 ? 'text-emerald-700 dark:text-emerald-300 font-semibold' : 'text-slate-400 dark:text-slate-600'}`}
      data-trigger-leaning="centro_datos"
      title="Clic para filtrar por medios de centro y datos factuales"
    >
      <span class={`w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full shrink-0 ${spectrum.centroDatosPct > 0 ? 'bg-emerald-500 dark:bg-emerald-400 shadow-xs' : 'bg-slate-300 dark:bg-slate-700'}`}></span>
      <span>Centro / Datos:</span> <strong class="font-bold">{spectrum.centroDatosPct}%</strong>
    </button>

    <button 
      type="button"
      class={`spectrum-filter-trigger flex items-center gap-1.5 transition-all hover:scale-105 cursor-pointer text-left focus:outline-none focus:ring-1 focus:ring-amber-400 rounded px-1 -mx-1 py-0.5 ${spectrum.oposicionPct > 0 ? 'text-amber-700 dark:text-amber-300 font-semibold' : 'text-slate-400 dark:text-slate-600'}`}
      data-trigger-leaning="oposicion"
      title="Clic para filtrar por medios de línea crítica / opositora"
    >
      <span class={`w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full shrink-0 ${spectrum.oposicionPct > 0 ? 'bg-amber-500 dark:bg-amber-400 shadow-xs' : 'bg-slate-300 dark:bg-slate-700'}`}></span>
      <span>Oposición:</span> <strong class="font-bold">{spectrum.oposicionPct}%</strong>
    </button>
  </div>

  <!-- Spectrum Bar: only renders segments with actual percentage > 0 -->
  <div class="w-full h-2.5 sm:h-3 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-0.5 flex overflow-hidden gap-0.5 shadow-inner">
    {spectrum.oficialismoPct > 0 && (
      <div 
        class="spectrum-filter-trigger h-full bg-violet-600 dark:bg-violet-500 rounded-l-full transition-all duration-500 hover:opacity-90 cursor-pointer focus:outline-none focus:ring-1 focus:ring-white/50" 
        style={`width: ${spectrum.oficialismoPct}%`}
        data-trigger-leaning="oficialismo"
        title={`Enfoque Oficialista: ${spectrum.oficialismoPct}% (Clic para filtrar)`}
        tabindex="0"
        role="button"
      ></div>
    )}
    {spectrum.centroDatosPct > 0 && (
      <div 
        class={`spectrum-filter-trigger h-full bg-emerald-500 dark:bg-emerald-400 transition-all duration-500 hover:opacity-90 cursor-pointer focus:outline-none focus:ring-1 focus:ring-white/50 ${spectrum.oficialismoPct === 0 ? 'rounded-l-full' : ''} ${spectrum.oposicionPct === 0 ? 'rounded-r-full' : ''}`} 
        style={`width: ${spectrum.centroDatosPct}%`}
        data-trigger-leaning="centro_datos"
        title={`Centro / Datos Factuales: ${spectrum.centroDatosPct}% (Clic para filtrar)`}
        tabindex="0"
        role="button"
      ></div>
    )}
    {spectrum.oposicionPct > 0 && (
      <div 
        class="spectrum-filter-trigger h-full bg-amber-500 dark:bg-amber-400 rounded-r-full transition-all duration-500 hover:opacity-90 cursor-pointer focus:outline-none focus:ring-1 focus:ring-white/50" 
        style={`width: ${spectrum.oposicionPct}%`}
        data-trigger-leaning="oposicion"
        title={`Enfoque Opositor: ${spectrum.oposicionPct}% (Clic para filtrar)`}
        tabindex="0"
        role="button"
      ></div>
    )}
  </div>

  <!-- Clear Framing Descriptive Micro-Copy -->
  <p class="text-[10px] font-mono text-slate-500 dark:text-slate-400 mt-1 italic leading-tight">
    Distribución calculada sobre el encuadre editorial de las notas publicadas en las últimas 24 horas.
  </p>
</div>
