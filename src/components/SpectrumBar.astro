---
import type { SpectrumBreakdown } from '../types';

interface Props {
  spectrum: SpectrumBreakdown;
}

const { spectrum } = Astro.props;
---

<div class="space-y-2">
  <div class="flex items-center justify-between text-xs font-mono">
    <span class="flex items-center gap-1.5 text-violet-700 dark:text-violet-300">
      <span class="w-2.5 h-2.5 rounded-full bg-violet-600 dark:bg-violet-500 shadow-xs"></span>
      <span>Oficialismo:</span> <strong class="font-bold">{spectrum.oficialismoPct}%</strong>
    </span>
    <span class="flex items-center gap-1.5 text-emerald-700 dark:text-emerald-300">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 dark:bg-emerald-400 shadow-xs"></span>
      <span>Centro / Datos:</span> <strong class="font-bold">{spectrum.centroDatosPct}%</strong>
    </span>
    <span class="flex items-center gap-1.5 text-amber-700 dark:text-amber-300">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-500 dark:bg-amber-400 shadow-xs"></span>
      <span>Oposición:</span> <strong class="font-bold">{spectrum.oposicionPct}%</strong>
    </span>
  </div>

  <!-- Spectrum Bar with distinct, vivid color segments -->
  <div class="w-full h-3 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-0.5 flex overflow-hidden gap-0.5 shadow-inner">
    <div 
      class="h-full bg-violet-600 dark:bg-violet-500 rounded-l-full transition-all duration-500 hover:opacity-90 cursor-help" 
      style={`width: ${spectrum.oficialismoPct}%`}
      title={`Oficialismo: ${spectrum.oficialismoPct}%`}
    ></div>
    <div 
      class="h-full bg-emerald-500 dark:bg-emerald-400 transition-all duration-500 hover:opacity-90 cursor-help" 
      style={`width: ${spectrum.centroDatosPct}%`}
      title={`Centro / Datos Factuales: ${spectrum.centroDatosPct}%`}
    ></div>
    <div 
      class="h-full bg-amber-500 dark:bg-amber-400 rounded-r-full transition-all duration-500 hover:opacity-90 cursor-help" 
      style={`width: ${spectrum.oposicionPct}%`}
      title={`Oposición: ${spectrum.oposicionPct}%`}
    ></div>
  </div>
</div>
