---
interface Props {
  borderClass?: string;
}

const { borderClass = 'border-rule' } = Astro.props;
---

<span
  class={`inline-flex flex-col w-3.5 h-2.5 rounded-[2px] overflow-hidden border shrink-0 ${borderClass}`}
  aria-hidden="true"
>
  <span class="h-1/3 bg-[#6BA4D9]"></span>
  <span class="h-1/3 bg-white flex items-center justify-center">
    <span class="w-0.5 h-0.5 rounded-full bg-amber-400"></span>
  </span>
  <span class="h-1/3 bg-[#6BA4D9]"></span>
</span>
