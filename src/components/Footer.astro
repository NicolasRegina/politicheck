---
import { OUTLETS_REGISTRY } from '../utils/outlets';
import BrandLogo from './BrandLogo.astro';
const outletsList = Object.values(OUTLETS_REGISTRY);
const totalOutlets = outletsList.length;
const nationalCount = outletsList.filter(o => o.category === 'nacional').length;
const foreignCount = outletsList.filter(o => o.category === 'internacional').length;
---

<footer class="mt-20 border-t border-rule bg-surface-muted py-12 text-ink-muted text-xs transition-colors duration-200" id="footer-metodologia">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Col 1: Project Identity -->
      <div class="space-y-3">
        <BrandLogo size={28} withText={true} />
        <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
          Plataforma cívica independiente para el monitoreo y contraste de cobertura mediática y auditoría de compromisos electorales en Argentina.
        </p>
        <div class="text-xs font-sans text-slate-500 dark:text-slate-400">
          Neutralidad metodológica y contraste de encuadres periodísticos.
        </div>
      </div>

      <!-- Col 2: Legal & RSS Methodology -->
      <div class="space-y-3">
        <h3 class="font-semibold text-slate-900 dark:text-slate-200 text-xs font-sans">
          Metodología y fuentes oficiales
        </h3>
        <p class="text-ink-secondary leading-relaxed">
          Politicheck no reproduce notas completas ni elude muros de pago. Agregamos únicamente titulares, metadatos y resúmenes oficiales provistos por los feeds RSS públicos sindicados de {totalOutlets} redacciones periodísticas ({nationalCount} nacionales y {foreignCount} internacionales), redirigiendo siempre al lector a la fuente original.
        </p>
        <div>
          <a href="/metodologia" class="inline-flex items-center gap-1.5 text-xs font-sans text-slate-900 dark:text-white font-semibold underline underline-offset-2 hover:opacity-80 transition-opacity">
            <span>Ver documento metodológico completo</span>
            <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 3: Media Sources Tracked -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="font-semibold text-ink text-xs font-sans">
            {totalOutlets} medios monitoreados
          </h3>
          <span class="text-[11px] font-mono text-ink-muted">{nationalCount} Nac. / {foreignCount} Inter.</span>
        </div>
        <div class="flex flex-wrap gap-1.5 text-[11px] font-sans max-h-48 overflow-y-auto pr-1">
          {outletsList.map((outlet) => (
            <a 
              href={outlet.websiteUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class={`px-2 py-0.5 rounded border transition-colors hover:opacity-80 ${outlet.badgeClass}`}
            >
              {outlet.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom copyright line -->
    <div class="pt-6 border-t border-slate-200 dark:border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-3 text-slate-500 dark:text-slate-400 text-[11px]">
      <div>
        © 2026 Politicheck Argentina. Todos los derechos reservados.
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <button 
          type="button" 
          onclick="window.openPwaInstallPrompt?.()" 
          class="hover:text-slate-900 dark:hover:text-white transition-colors inline-flex items-center gap-1.5 cursor-pointer font-medium whitespace-nowrap"
          title="Instalar la aplicación en tu celular o computadora"
        >
          <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span class="underline">Instalar App</span>
        </button>
        <button 
          type="button" 
          onclick="window.subscribeToMorningDigest?.()" 
          class="hover:text-slate-900 dark:hover:text-white transition-colors inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap"
          title="Recibir alerta matutina con el resumen de tapas a las 8:00 AM"
        >
          <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="underline">Resumen Matutino (8 AM)</span>
        </button>
        <a href="/politicos" class="underline hover:text-slate-900 dark:hover:text-white transition-colors font-semibold whitespace-nowrap">Políticos</a>
        <a href="/guias" class="underline hover:text-slate-900 dark:hover:text-white transition-colors font-semibold whitespace-nowrap">Investigaciones y guías</a>
        <a href="/metodologia" class="underline hover:text-slate-900 dark:hover:text-white transition-colors whitespace-nowrap">Metodología y transparencia</a>
        <a href="/terminos" class="underline hover:text-slate-900 dark:hover:text-white transition-colors whitespace-nowrap">Términos y descargo legal</a>
        <a href="/admin" class="hover:text-slate-900 dark:hover:text-white transition-colors opacity-75 hover:opacity-100 inline-flex items-center gap-1 font-sans text-[11px] whitespace-nowrap" title="Acceso a Control Editorial">
          <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span class="underline">Editorial</span>
        </a>
      </div>
    </div>
  </div>
</footer>