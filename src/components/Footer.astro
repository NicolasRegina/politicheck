      <div>
        © 2026 Politicheck Argentina. Todos los derechos reservados.
      </div>
      <div class="flex items-center gap-4">
        <span>Transparencia Algorítmica</span>
        <span>•</span>
        <span>Código Abierto Cívico</span>
      </div>
    </div>
  </div>
</footer>
