---
import type { StoryCluster } from '../types';
import SpectrumBar from './SpectrumBar.astro';
import { getOptimizedImageUrl } from '../utils/image';

interface Props {
  story: StoryCluster;
}

const { story } = Astro.props;

const optimizedLeadImageUrl = story.imageUrl ? getOptimizedImageUrl(story.imageUrl, 800, 75) : '';
const optimizedLeadMobileImageUrl = story.imageUrl ? getOptimizedImageUrl(story.imageUrl, 480, 70) : '';
const optimizedSecondaryImageUrl = story.imageUrl ? getOptimizedImageUrl(story.imageUrl, 400, 70) : '';

// Persuasive viral copy calculation (optimized strictly <= 280 chars for standard X accounts)
const topOutlets = Array.from(new Set(story.articles.slice(0, 3).map(a => a.outletName)));
const outletsText = topOutlets.join(', ');
const rawHeadline = story.neutralHeadline || '';
const cleanHeadline = rawHeadline.length > 110
  ? rawHeadline.slice(0, 110).trim().replace(/[,.:;]+$/, '') + '...'
  : rawHeadline;
const viralShareText = `🗞️ "${cleanHeadline}"\n\nMedios: ${outletsText}\n📊 Espectro: 🟣 ${story.spectrum?.oficialismoPct ?? 0}% | 🟢 ${story.spectrum?.centroDatosPct ?? 0}% | 🟠 ${story.spectrum?.oposicionPct ?? 0}%\n\n👉 Comparativa sin sesgo:`;
const storyUrl = `https://politicheck.com.ar/historia/${story.id}`;
const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(viralShareText + '\n' + storyUrl)}`;
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(viralShareText)}&url=${encodeURIComponent(storyUrl)}`;
const tgUrl = `https://t.me/share/url?url=${encodeURIComponent(storyUrl)}&text=${encodeURIComponent(viralShareText)}`;
const validArticleTime = story.articles.map(a => a.publishedAt).find(t => t && t !== 'Reciente');
const displayTimestamp = (story.updatedAt && story.updatedAt !== 'Reciente')
  ? story.updatedAt
  : (validArticleTime || 'Hoy');
---

<article 
  class={`bg-white dark:bg-[#0F1420] border border-slate-200 dark:border-slate-800/90 rounded-2xl shadow-xs overflow-hidden transition-all duration-300 hover:border-slate-300 dark:hover:border-slate-700 flex flex-col h-full justify-between ${story.isLeadStory ? 'p-4 sm:p-6 md:p-8 space-y-5 sm:space-y-6 ring-1 ring-slate-900/5 dark:ring-white/5' : 'p-4 sm:p-5 space-y-4'}`} 
  data-story-card={story.id}
>
  <div class="space-y-3.5 sm:space-y-4 flex-1 flex flex-col">
    <!-- Kicker / Volanta & Meta -->
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800/80 pb-2.5">
      <div class="flex items-center gap-2">
        <span class="font-mono text-[10px] sm:text-[11px] font-bold tracking-widest uppercase text-slate-800 dark:text-slate-200">
          {story.kicker || story.category}
        </span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span class="font-mono text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400">{displayTimestamp}</span>
      </div>

      <!-- Outlets count badge -->
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[10px] sm:text-[11px] font-mono text-slate-700 dark:text-slate-300">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-400 dark:bg-slate-500"></span>
        <span>{story.articles.length} medios comparados</span>
      </div>
    </div>

    {story.isLeadStory ? (
      /* LEAD STORY (Gran Apertura de Tapa): Headline, Press Photo, Summary, Spectrum */
      <div class="space-y-4 sm:space-y-5 flex-1 flex flex-col">
        <div class="space-y-2">
          <h2 class="font-editorial text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-950 dark:text-white leading-tight tracking-tight">
            <a href={`/historia/${story.id}`} class="hover:text-blue-900 dark:hover:text-blue-300 transition-colors">
              {story.neutralHeadline}
            </a>
          </h2>
          <p class="text-sm sm:text-base md:text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-sans max-w-4xl line-clamp-3 sm:line-clamp-4">
            {story.summary}
          </p>
        </div>

        <!-- Grand Press Photo with Authentic Caption (Clickable) -->
        {story.imageUrl && (
          <div class="story-img-wrapper space-y-1.5">
            <a 
              href={`/historia/${story.id}`}
              class="group block relative overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 aspect-video max-h-[360px] sm:max-h-[460px]"
              title={`Ver análisis completo: ${story.neutralHeadline}`}
            >
              <img 
                src={optimizedLeadImageUrl} 
                srcset={optimizedLeadMobileImageUrl ? `${optimizedLeadMobileImageUrl} 480w, ${optimizedLeadImageUrl} 800w` : undefined}
                sizes="(max-width: 640px) 100vw, 800px"
                data-original-src={story.imageUrl}
                alt={story.neutralHeadline} 
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="800"
                height="450"
                referrerpolicy="no-referrer"
                onerror="if (this.dataset.retry !== '1') { this.dataset.retry = '1'; this.setAttribute('src', this.dataset.originalSrc); } else { this.closest('.story-img-wrapper')?.style.setProperty('display', 'none'); }"
                class="w-full h-full object-cover object-center transition-transform duration-300 group-hover:scale-[1.02]"
              />
            </a>
            {story.imageCaption && (
              <p class="text-[10px] sm:text-[11px] font-mono text-slate-500 dark:text-slate-400 italic px-1">
                {story.imageCaption}
              </p>
            )}
          </div>
        )}

        <!-- Coverage Spectrum Bar (Aligned toward bottom) -->
        <div class="bg-slate-50 dark:bg-slate-950/60 rounded-xl p-3 sm:p-4 border border-slate-200/90 dark:border-slate-800 mt-auto">
          <div class="flex items-center justify-between text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1.5 sm:mb-2">
            <span class="font-semibold">Distribución del Espectro Editorial</span>
            <span>Base: {story.spectrum.totalOutlets} medios monitoreados</span>
          </div>
          <SpectrumBar spectrum={story.spectrum} articles={story.articles} />
        </div>
      </div>
    ) : (
      /* SECONDARY STORY: Balanced Bento Card with Clickable Image, Headline, 3-line Summary, Spectrum */
      <div class="space-y-3 sm:space-y-3.5 flex-1 flex flex-col">
        {story.imageUrl && (
          <div class="story-img-wrapper space-y-1.5">
            <a 
              href={`/historia/${story.id}`}
              class="group block relative overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 aspect-video max-h-[175px]"
              title={`Ver análisis completo: ${story.neutralHeadline}`}
            >
              <img 
                src={optimizedSecondaryImageUrl} 
                data-original-src={story.imageUrl}
                alt={story.neutralHeadline} 
                loading="lazy"
                decoding="async"
                width="400"
                height="225"
                referrerpolicy="no-referrer"
                onerror="if (this.dataset.retry !== '1') { this.dataset.retry = '1'; this.setAttribute('src', this.dataset.originalSrc); } else { this.closest('.story-img-wrapper')?.style.setProperty('display', 'none'); }"
                class="w-full h-full object-cover object-center transition-transform duration-300 group-hover:scale-105"
              />
            </a>
            {story.imageCaption && (
              <p class="text-[10px] font-mono text-slate-500 dark:text-slate-400 italic px-1 truncate">
                {story.imageCaption}
              </p>
            )}
          </div>
        )}

        <div class="space-y-1.5">
          <h3 class="font-editorial text-lg sm:text-xl font-bold text-slate-950 dark:text-white leading-snug tracking-tight">
            <a href={`/historia/${story.id}`} class="hover:text-blue-900 dark:hover:text-blue-300 transition-colors">
              {story.neutralHeadline}
            </a>
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-sans line-clamp-3">
            {story.summary}
          </p>
        </div>

        <!-- Compact Spectrum Bar (Aligned toward bottom) -->
        <div class="bg-slate-50 dark:bg-slate-950/60 rounded-lg p-2.5 sm:p-3 border border-slate-200/80 dark:border-slate-800 mt-auto">
          <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">
            <span>Espectro Editorial</span>
            <span>{story.spectrum.totalOutlets} medios</span>
          </div>
          <SpectrumBar spectrum={story.spectrum} articles={story.articles} />
        </div>
      </div>
    )}
  </div>

  <!-- Dedicated Story Analysis Link & 1-Click Viral Share Bar (Always aligned at bottom) -->
  <div class="mt-auto pt-3 sm:pt-3.5 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-2.5">
    <!-- 1-Click Share Icons & Modal Trigger -->
    <div class="flex items-center gap-1.5 flex-wrap">
      <button 
        type="button"
        class="share-story-btn inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-mono font-medium transition-colors cursor-pointer"
        data-title={story.neutralHeadline}
        data-url={storyUrl}
        data-text={viralShareText}
        data-category={story.category}
        data-headline={story.neutralHeadline}
        data-oficialismo={story.spectrum?.oficialismoPct ?? 0}
        data-centro={story.spectrum?.centroDatosPct ?? 0}
        data-oposicion={story.spectrum?.oposicionPct ?? 0}
        data-outlets={story.articles?.map(a => a.outletName).slice(0, 4).join(', ') ?? ''}
        title="Abrir opciones de difusión y placa visual"
      >
        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        <span>Compartir</span>
      </button>

      <!-- Quick 1-Click Social Triggers -->
      <a 
        href={waUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 border border-emerald-200 dark:border-emerald-800/80 transition-transform hover:scale-105"
        title="Compartir directo en WhatsApp"
      >
        <span class="text-xs">📱</span>
      </a>

      <a 
        href={xUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 transition-transform hover:scale-105"
        title="Publicar en X (Twitter)"
      >
        <span class="text-xs font-bold font-mono">𝕏</span>
      </a>

      <a 
        href={tgUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-400 hover:bg-sky-100 dark:hover:bg-sky-900/60 border border-sky-200 dark:border-sky-800/80 transition-transform hover:scale-105"
        title="Compartir en Telegram"
      >
        <span class="text-xs">✈️</span>
      </a>
    </div>

    <!-- Primary Action Button: Ver análisis completo -->
    <a 
      href={`/historia/${story.id}`}
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-950 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-950 text-xs font-mono font-bold transition-all cursor-pointer shadow-xs hover:shadow-sm"
    >
      <span>Ver análisis completo</span>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</article>

<script>
  function setupShareButtons() {
    document.querySelectorAll('.share-story-btn').forEach((btn) => {
      if (btn.hasAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const title = btn.getAttribute('data-title') || '';
        const url = btn.getAttribute('data-url') || '';
        const text = btn.getAttribute('data-text') || '';
        const category = btn.getAttribute('data-category') || 'Difusión Cívica';
        const headline = btn.getAttribute('data-headline') || title;
        const oficialismo = parseInt(btn.getAttribute('data-oficialismo') || '0', 10);
        const centro = parseInt(btn.getAttribute('data-centro') || '0', 10);
        const oposicion = parseInt(btn.getAttribute('data-oposicion') || '0', 10);
        const outlets = btn.getAttribute('data-outlets') || '';

        if (typeof (window as any).openShareModal === 'function') {
          (window as any).openShareModal({
            title,
            url,
            text,
            category,
            headline,
            spectrum: { oficialismo, centro, oposicion },
            outlets,
            modalTitle: 'Difusión y Placa para Redes'
          });
        }
      });
    });
  }

  // Setup on page load and on client-side routing
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupShareButtons);
  } else {
    setupShareButtons();
  }
</script>
