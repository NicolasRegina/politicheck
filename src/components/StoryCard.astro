---
import type { StoryCluster } from '../types';
import SpectrumBar from './SpectrumBar.astro';
import HeadlineComparison from './HeadlineComparison.astro';
import { getOutletMeta } from '../utils/outlets';

interface Props {
  story: StoryCluster;
}

const { story } = Astro.props;
---

<article class={`bg-white dark:bg-[#0F1420] border border-slate-200 dark:border-slate-800/90 rounded-2xl shadow-xs overflow-hidden transition-all duration-300 hover:border-slate-300 dark:hover:border-slate-700 ${story.isLeadStory ? 'p-6 sm:p-8 space-y-6 ring-1 ring-slate-900/5 dark:ring-white/5' : 'p-5 sm:p-6 space-y-5'}`}>
  <!-- Kicker / Volanta & Meta -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
    <div class="flex items-center gap-2">
      {story.kicker ? (
        <span class="font-mono text-[11px] font-bold tracking-widest uppercase text-slate-800 dark:text-slate-200">
          {story.kicker}
        </span>
      ) : (
        <span class="font-mono text-[11px] font-bold tracking-widest uppercase text-slate-800 dark:text-slate-200">
          {story.category}
        </span>
      )}
      <span class="text-slate-300 dark:text-slate-700">•</span>
      <span class="font-mono text-[11px] text-slate-500 dark:text-slate-400">{story.updatedAt}</span>
    </div>

    <!-- Outlets count badge -->
    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[11px] font-mono text-slate-700 dark:text-slate-300">
      <span class="w-1.5 h-1.5 rounded-full bg-slate-400 dark:bg-slate-500"></span>
      <span>{story.articles.length} medios comparados</span>
    </div>
  </div>

  <!-- Story Presentation Layout -->
  {story.isLeadStory ? (
    /* LEAD STORY (Gran Apertura de Tapa): Headline, Big Press Photo, Summary, Spectrum */
    <div class="space-y-6">
      <div class="space-y-3">
        <h2 class="font-editorial text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-950 dark:text-white leading-tight tracking-tight">
          <a href={`/historia/${story.id}`} class="hover:text-blue-900 dark:hover:text-blue-300 transition-colors">
            {story.neutralHeadline}
          </a>
        </h2>
        <p class="text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-sans max-w-4xl">
          {story.summary}
        </p>
      </div>

      <!-- Grand Press Photo with Authentic Caption -->
      {story.imageUrl && (
        <div class="story-img-wrapper space-y-2">
          <div class="relative overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 aspect-video max-h-[460px]">
            <img 
              src={story.imageUrl} 
              alt={story.neutralHeadline} 
              loading="eager"
              referrerpolicy="no-referrer"
              onerror="const w = this.closest('.story-img-wrapper'); if (w) w.style.display = 'none';"
              class="w-full h-full object-cover object-center"
            />
          </div>
          {story.imageCaption && (
            <p class="text-[11px] font-mono text-slate-500 dark:text-slate-400 italic px-1">
              {story.imageCaption}
            </p>
          )}
        </div>
      )}

      <!-- Coverage Spectrum Bar -->
      <div class="bg-slate-50 dark:bg-slate-950/60 rounded-xl p-4 border border-slate-200/90 dark:border-slate-800">
        <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-2">
          <span class="font-semibold">Distribución del Espectro Editorial</span>
          <span>Base: {story.spectrum.totalOutlets} medios monitoreados</span>
        </div>
        <SpectrumBar spectrum={story.spectrum} articles={story.articles} />
      </div>
    </div>
  ) : (
    /* SECONDARY STORY: 2-column or stacked layout */
    <div class="space-y-4">
      {story.imageUrl && (
        <div class="story-img-wrapper space-y-1.5">
          <div class="relative overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 aspect-video max-h-[240px]">
            <img 
              src={story.imageUrl} 
              alt={story.neutralHeadline} 
              loading="lazy"
              referrerpolicy="no-referrer"
              onerror="const w = this.closest('.story-img-wrapper'); if (w) w.style.display = 'none';"
              class="w-full h-full object-cover object-center"
            />
          </div>
          {story.imageCaption && (
            <p class="text-[10px] font-mono text-slate-500 dark:text-slate-400 italic px-1 truncate">
              {story.imageCaption}
            </p>
          )}
        </div>
      )}

      <div class="space-y-2">
        <h3 class="font-editorial text-xl sm:text-2xl font-bold text-slate-950 dark:text-white leading-snug tracking-tight">
          <a href={`/historia/${story.id}`} class="hover:text-blue-900 dark:hover:text-blue-300 transition-colors">
            {story.neutralHeadline}
          </a>
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-sans">
          {story.summary}
        </p>
      </div>

      <!-- Compact Spectrum Bar -->
      <div class="bg-slate-50 dark:bg-slate-950/60 rounded-lg p-3 border border-slate-200/80 dark:border-slate-800">
        <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">
          <span>Espectro Editorial</span>
          <span>{story.spectrum.totalOutlets} medios</span>
        </div>
        <SpectrumBar spectrum={story.spectrum} articles={story.articles} />
      </div>
    </div>
  )}

  <!-- AI Cross-Framing Synthesis (Dictamen de Encuadres) -->
  {story.aiComparisonNotice && (
    <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 space-y-1.5">
      <div class="flex items-center gap-2 text-[10px] font-mono font-bold uppercase tracking-widest text-slate-700 dark:text-slate-300">
        <svg class="w-3.5 h-3.5 text-slate-600 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Dictamen Politicheck: Matriz de Encuadres y Énfasis</span>
      </div>
      <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
        {story.aiComparisonNotice}
      </p>
    </div>
  )}

  <!-- Comparative Headlines: Interactive Leaning Filter & Pagination -->
  <div class="space-y-3 pt-2 border-t border-slate-200 dark:border-slate-800">
    <div class="text-[11px] font-mono uppercase tracking-wider font-semibold text-slate-600 dark:text-slate-400 flex items-center justify-between">
      <span>Titulares y Enfoques Cruzados de Cada Redacción:</span>
      <span class="text-[10px] text-slate-400 dark:text-slate-500 font-normal">Filtro por sesgo y paginación</span>
    </div>

    <HeadlineComparison articles={story.articles} storyId={story.id} isLeadStory={story.isLeadStory} />
  </div>

    <!-- Dedicated Story Analysis Link & Share -->
    <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-2.5">
      <div class="flex items-center gap-2">
        <button 
          type="button"
          class="share-story-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-[11px] font-mono font-medium transition-colors cursor-pointer"
          data-title={story.neutralHeadline}
          data-url={`https://politicheck.com.ar/historia/${story.id}`}
          title="Compartir este contraste"
        >
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span>Compartir contraste</span>
        </button>
      </div>

      <a 
        href={`/historia/${story.id}`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-900 dark:text-slate-100 text-xs font-mono font-bold transition-colors cursor-pointer"
      >
        <span>Ver análisis profundo y timeline</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</article>
