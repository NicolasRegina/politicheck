---
import type { StoryCluster } from '../types';
import SpectrumBar from './SpectrumBar.astro';
import HeadlineComparison from './HeadlineComparison.astro';

interface Props {
  story: StoryCluster;
}

const { story } = Astro.props;

// Persuasive viral copy calculation
const topOutlets = story.articles.slice(0, 4).map(a => a.outletName);
const outletsText = topOutlets.length > 1
  ? `${topOutlets.slice(0, -1).join(', ')} y ${topOutlets[topOutlets.length - 1]}`
  : topOutlets[0] || 'múltiples redacciones';
const viralShareText = `Mirá cómo ${outletsText} cubrieron esta misma noticia en simultáneo: "${story.neutralHeadline}". Comparativa sin sesgo en Politicheck:`;
const storyUrl = `https://politicheck.com.ar/historia/${story.id}`;
const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(viralShareText + ' ' + storyUrl)}`;
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(viralShareText)}&url=${encodeURIComponent(storyUrl)}`;
const tgUrl = `https://t.me/share/url?url=${encodeURIComponent(storyUrl)}&text=${encodeURIComponent(viralShareText)}`;
const validArticleTime = story.articles.map(a => a.publishedAt).find(t => t && t !== 'Reciente');
const displayTimestamp = (story.updatedAt && story.updatedAt !== 'Reciente')
  ? story.updatedAt
  : (validArticleTime || 'Hoy');
---

<article class={`bg-white dark:bg-[#0F1420] border border-slate-200 dark:border-slate-800/90 rounded-2xl shadow-xs overflow-hidden transition-all duration-300 hover:border-slate-300 dark:hover:border-slate-700 flex flex-col h-full justify-between ${story.isLeadStory ? 'p-4 sm:p-6 md:p-8 space-y-4 sm:space-y-6 ring-1 ring-slate-900/5 dark:ring-white/5' : 'p-4 sm:p-5 md:p-6 space-y-3.5 sm:space-y-5'}`} data-story-card={story.id}>
  <div class="space-y-4 sm:space-y-5">
    <!-- Kicker / Volanta & Meta -->
    <div class="flex flex-wrap items-center justify-between gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-2.5 sm:pb-3">
      <div class="flex items-center gap-2">
        {story.kicker ? (
          <span class="font-mono text-[10px] sm:text-[11px] font-bold tracking-widest uppercase text-slate-800 dark:text-slate-200">
            {story.kicker}
          </span>
        ) : (
          <span class="font-mono text-[10px] sm:text-[11px] font-bold tracking-widest uppercase text-slate-800 dark:text-slate-200">
            {story.category}
          </span>
        )}
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span class="font-mono text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400">{displayTimestamp}</span>
      </div>

      <!-- Outlets count badge -->
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[10px] sm:text-[11px] font-mono text-slate-700 dark:text-slate-300">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-400 dark:bg-slate-500"></span>
        <span>{story.articles.length} medios comparados</span>
      </div>
    </div>

    <!-- Mobile Segmented Controller (< lg viewports only) -->
    <div class="lg:hidden flex rounded-xl bg-slate-100 dark:bg-slate-900/90 p-1 border border-slate-200 dark:border-slate-800 text-[11px] font-mono font-semibold" data-card-segmented-nav>
      <button 
        type="button" 
        class="seg-toggle-btn active flex-1 py-1.5 px-2 rounded-lg text-center transition-all bg-white dark:bg-slate-800 text-slate-950 dark:text-white shadow-2xs font-bold cursor-pointer"
        data-target="panel-sintesis"
      >
        <span>📑 Síntesis y Espectro</span>
      </button>
      <button 
        type="button" 
        class="seg-toggle-btn flex-1 py-1.5 px-2 rounded-lg text-center transition-all text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer"
        data-target="panel-redacciones"
      >
        <span>⚖️ Redacciones ({story.articles.length})</span>
      </button>
    </div>

    <!-- PANEL 1: SÍNTESIS Y ESPECTRO (Visible on mobile by default, always visible on lg:) -->
    <div class="card-panel-sintesis space-y-4 sm:space-y-6 block lg:!block">
      <!-- Story Presentation Layout -->
      {story.isLeadStory ? (
        /* LEAD STORY (Gran Apertura de Tapa): Headline, Big Press Photo, Summary, Spectrum */
        <div class="space-y-4 sm:space-y-6">
          <div class="space-y-2 sm:space-y-3">
            <h2 class="font-editorial text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-950 dark:text-white leading-tight tracking-tight">
              <a href={`/historia/${story.id}`} class="hover:text-blue-900 dark:hover:text-blue-300 transition-colors">
                {story.neutralHeadline}
              </a>
            </h2>
            <p class="text-sm sm:text-base md:text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-sans max-w-4xl">
              {story.summary}
            </p>
          </div>

          <!-- Grand Press Photo with Authentic Caption -->
          {story.imageUrl && (
            <div class="story-img-wrapper space-y-1.5 sm:space-y-2">
              <div class="relative overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 aspect-video max-h-[360px] sm:max-h-[460px]">
                <img 
                  src={story.imageUrl} 
                  alt={story.neutralHeadline} 
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  onerror="this.closest('.story-img-wrapper')?.style.setProperty('display', 'none');"
                  class="w-full h-full object-cover object-center"
                />
              </div>
              {story.imageCaption && (
                <p class="text-[10px] sm:text-[11px] font-mono text-slate-500 dark:text-slate-400 italic px-1">
                  {story.imageCaption}
                </p>
              )}
            </div>
          )}

          <!-- Coverage Spectrum Bar -->
          <div class="bg-slate-50 dark:bg-slate-950/60 rounded-xl p-3 sm:p-4 border border-slate-200/90 dark:border-slate-800">
            <div class="flex items-center justify-between text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1.5 sm:mb-2">
              <span class="font-semibold">Distribución del Espectro Editorial</span>
              <span>Base: {story.spectrum.totalOutlets} medios monitoreados</span>
            </div>
            <SpectrumBar spectrum={story.spectrum} articles={story.articles} />
          </div>
        </div>
      ) : (
        /* SECONDARY STORY: Balanced 3-column Bento Card with Fixed 160px Image */
        <div class="space-y-3 sm:space-y-4">
          {story.imageUrl && (
            <div class="story-img-wrapper space-y-1.5">
              <div class="relative overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 aspect-video max-h-[160px]">
                <img 
                  src={story.imageUrl} 
                  alt={story.neutralHeadline} 
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  onerror="this.closest('.story-img-wrapper')?.style.setProperty('display', 'none');"
                  class="w-full h-full object-cover object-center"
                />
              </div>
              {story.imageCaption && (
                <p class="text-[10px] font-mono text-slate-500 dark:text-slate-400 italic px-1 truncate">
                  {story.imageCaption}
                </p>
              )}
            </div>
          )}

          <div class="space-y-1.5 sm:space-y-2">
            <h3 class="font-editorial text-lg sm:text-xl font-bold text-slate-950 dark:text-white leading-snug tracking-tight">
              <a href={`/historia/${story.id}`} class="hover:text-blue-900 dark:hover:text-blue-300 transition-colors">
                {story.neutralHeadline}
              </a>
            </h3>
            <!-- Summary with line clamp and Ver más toggle -->
            <div class="story-expandable-block">
              <p class="expandable-text text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-sans line-clamp-2 sm:line-clamp-3">
                {story.summary}
              </p>
              {story.summary && story.summary.length > 110 && (
                <button 
                  type="button" 
                  class="btn-toggle-expand inline-flex items-center gap-1 text-[10px] sm:text-[11px] font-mono font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 cursor-pointer pt-1"
                >
                  <span>Ver más</span>
                  <svg class="w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              )}
            </div>
          </div>

          <!-- Compact Spectrum Bar -->
          <div class="bg-slate-50 dark:bg-slate-950/60 rounded-lg p-2.5 sm:p-3 border border-slate-200/80 dark:border-slate-800">
            <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">
              <span>Espectro Editorial</span>
              <span>{story.spectrum.totalOutlets} medios</span>
            </div>
            <SpectrumBar spectrum={story.spectrum} articles={story.articles} />
          </div>
        </div>
      )}

      <!-- AI Cross-Framing Synthesis (Dictamen de Encuadres) -->
      {story.aiComparisonNotice && (
        <div class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 space-y-1.5">
          <div class="flex items-center gap-2 text-[10px] font-mono font-bold uppercase tracking-widest text-slate-700 dark:text-slate-300">
            <svg class="w-3.5 h-3.5 text-slate-600 dark:text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="truncate">Dictamen Politicheck: Matriz de Encuadres</span>
          </div>
          <!-- AI Notice with line clamp and Ver más toggle -->
          <div class="story-expandable-block">
            <p class="expandable-text text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed line-clamp-2">
              {story.aiComparisonNotice}
            </p>
            {story.aiComparisonNotice.length > 120 && (
              <button 
                type="button" 
                class="btn-toggle-expand inline-flex items-center gap-1 text-[10px] font-mono font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 cursor-pointer pt-0.5"
              >
                <span>Ver más</span>
                <svg class="w-2.5 h-2.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            )}
          </div>
        </div>
      )}
    </div>

    <!-- PANEL 2: CONTRASTE DE REDACCIONES (Hidden on mobile by default, always visible on lg:) -->
    <div class="card-panel-redacciones space-y-3 pt-2 border-t border-slate-200 dark:border-slate-800 hidden lg:!block">
      <div class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider font-semibold text-slate-600 dark:text-slate-400 flex items-center justify-between">
        <span>Titulares y Enfoques Cruzados:</span>
        <span class="text-[9px] sm:text-[10px] text-slate-400 dark:text-slate-500 font-normal">Filtro por sesgo</span>
      </div>

      <HeadlineComparison articles={story.articles} storyId={story.id} isLeadStory={story.isLeadStory} />
    </div>
  </div>

  <!-- Dedicated Story Analysis Link & 1-Click Viral Share Bar (Always aligned at bottom) -->
  <div class="mt-auto pt-3 sm:pt-3.5 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-2.5 sm:gap-3">
    <!-- 1-Click Share Icons & Modal Trigger -->
    <div class="flex items-center gap-1.5 flex-wrap">
      <button 
        type="button"
        class="share-story-btn inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-mono font-medium transition-colors cursor-pointer"
        data-title={story.neutralHeadline}
        data-url={storyUrl}
        data-text={viralShareText}
        data-category={story.category}
        data-headline={story.neutralHeadline}
        data-oficialismo={story.spectrum?.oficialismoPct ?? 0}
        data-centro={story.spectrum?.centroDatosPct ?? 0}
        data-oposicion={story.spectrum?.oposicionPct ?? 0}
        data-outlets={story.articles?.map(a => a.outletName).slice(0, 4).join(', ') ?? ''}
        title="Abrir opciones de difusión y placa visual"
      >
        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        <span>Compartir</span>
      </button>

      <!-- Quick 1-Click Social Triggers -->
      <a 
        href={waUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 border border-emerald-200 dark:border-emerald-800/80 transition-transform hover:scale-105"
        title="Compartir directo en WhatsApp"
      >
        <span class="text-xs">📱</span>
      </a>

      <a 
        href={xUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 transition-transform hover:scale-105"
        title="Publicar en X (Twitter)"
      >
        <span class="text-xs font-bold font-mono">𝕏</span>
      </a>

      <a 
        href={tgUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-400 hover:bg-sky-100 dark:hover:bg-sky-900/60 border border-sky-200 dark:border-sky-800/80 transition-transform hover:scale-105"
        title="Compartir en Telegram"
      >
        <span class="text-xs">✈️</span>
      </a>
    </div>

    <a 
      href={`/historia/${story.id}`}
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 dark:bg-slate-100 dark:hover:bg-white text-white dark:text-slate-900 text-xs font-mono font-bold transition-colors cursor-pointer shadow-xs"
    >
      <span>Ver análisis</span>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</article>

<script>
  function setupExpandButtons() {
    document.querySelectorAll('.btn-toggle-expand').forEach((btn) => {
      // Avoid duplicate bindings
      if (btn.hasAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const container = btn.closest('.story-expandable-block');
        if (!container) return;
        const text = container.querySelector('.expandable-text');
        const span = btn.querySelector('span');
        const icon = btn.querySelector('svg');
        if (!text || !span) return;

        const isExpanded = text.classList.contains('line-clamp-none');
        if (isExpanded) {
          text.classList.remove('line-clamp-none');
          span.textContent = 'Ver más';
          if (icon) icon.classList.remove('rotate-180');
        } else {
          text.classList.add('line-clamp-none');
          span.textContent = 'Ver menos';
          if (icon) icon.classList.add('rotate-180');
        }
      });
    });
  }

  function setupMobileSegmentedToggles() {
    document.querySelectorAll('[data-card-segmented-nav]').forEach((nav) => {
      if (nav.hasAttribute('data-bound')) return;
      nav.setAttribute('data-bound', 'true');

      const card = nav.closest('article');
      if (!card) return;

      const panelSintesis = card.querySelector('.card-panel-sintesis');
      const panelRedacciones = card.querySelector('.card-panel-redacciones');
      const buttons = nav.querySelectorAll('.seg-toggle-btn');

      buttons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const target = btn.getAttribute('data-target');

          buttons.forEach((b) => {
            b.classList.remove('active', 'bg-white', 'dark:bg-slate-800', 'text-slate-950', 'dark:text-white', 'shadow-2xs', 'font-bold');
            b.classList.add('text-slate-500', 'dark:text-slate-400');
          });

          btn.classList.add('active', 'bg-white', 'dark:bg-slate-800', 'text-slate-950', 'dark:text-white', 'shadow-2xs', 'font-bold');
          btn.classList.remove('text-slate-500', 'dark:text-slate-400');

          if (target === 'panel-sintesis') {
            panelSintesis?.classList.remove('hidden');
            panelRedacciones?.classList.add('hidden');
          } else {
            panelSintesis?.classList.add('hidden');
            panelRedacciones?.classList.remove('hidden');
          }
        });
      });
    });
  }

  function setupShareButtons() {
    document.querySelectorAll('.share-story-btn').forEach((btn) => {
      if (btn.hasAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const title = btn.getAttribute('data-title') || '';
        const url = btn.getAttribute('data-url') || '';
        const text = btn.getAttribute('data-text') || '';
        const category = btn.getAttribute('data-category') || 'Difusión Cívica';
        const headline = btn.getAttribute('data-headline') || title;
        const oficialismo = parseInt(btn.getAttribute('data-oficialismo') || '0', 10);
        const centro = parseInt(btn.getAttribute('data-centro') || '0', 10);
        const oposicion = parseInt(btn.getAttribute('data-oposicion') || '0', 10);
        const outlets = btn.getAttribute('data-outlets') || '';

        if (typeof (window as any).openShareModal === 'function') {
          (window as any).openShareModal({
            title,
            url,
            text,
            category,
            headline,
            spectrum: { oficialismo, centro, oposicion },
            outlets,
            modalTitle: 'Difusión y Placa para Redes'
          });
        }
      });
    });
  }

  function initStoryCardBehaviors() {
    setupExpandButtons();
    setupMobileSegmentedToggles();
    setupShareButtons();
  }

  // Setup on page load and on client-side routing
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStoryCardBehaviors);
  } else {
    initStoryCardBehaviors();
  }
</script>

