---
import type { StoryCluster } from '../types';
import SpectrumBar from './SpectrumBar.astro';
import { getOptimizedImageUrl } from '../utils/image';

interface Props {
  story: StoryCluster;
}

const { story } = Astro.props;

const optimizedLeadImageUrl = story.imageUrl ? getOptimizedImageUrl(story.imageUrl, 800, 75) : '';
const optimizedLeadMobileImageUrl = story.imageUrl ? getOptimizedImageUrl(story.imageUrl, 480, 70) : '';
const optimizedSecondaryImageUrl = story.imageUrl ? getOptimizedImageUrl(story.imageUrl, 400, 70) : '';

// Persuasive neutral viral copy (<= 280 chars for X — no partisan emojis per ADR-0008)
const topOutlets = Array.from(new Set(story.articles.slice(0, 3).map(a => a.outletName)));
const outletsText = topOutlets.join(', ');
const rawHeadline = story.neutralHeadline || '';
const cleanHeadline = rawHeadline.length > 110
  ? rawHeadline.slice(0, 110).trim().replace(/[,.:;]+$/, '') + '...'
  : rawHeadline;
const viralShareText = `"${cleanHeadline}"\n\nMedios: ${outletsText}\nEspectro: Oficialismo ${story.spectrum?.oficialismoPct ?? 0}% · Centro ${story.spectrum?.centroDatosPct ?? 0}% · Oposición ${story.spectrum?.oposicionPct ?? 0}%\n\nComparativa de encuadres en Politicheck:`;
const storyUrl = `https://politicheck.com.ar/historia/${story.id}`;
const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(viralShareText + '\n' + storyUrl)}`;
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(viralShareText)}&url=${encodeURIComponent(storyUrl)}`;
const tgUrl = `https://t.me/share/url?url=${encodeURIComponent(storyUrl)}&text=${encodeURIComponent(viralShareText)}`;
const validArticleTime = story.articles.map(a => a.publishedAt).find(t => t && t !== 'Reciente');
const displayTimestamp = (story.updatedAt && story.updatedAt !== 'Reciente')
  ? story.updatedAt
  : (validArticleTime || 'Hoy');
---

<article
  class={`bg-surface border border-rule rounded-md overflow-hidden transition-colors duration-200 hover:border-ink-muted/60 flex flex-col h-full justify-between ${story.isLeadStory ? 'p-5 sm:p-7 space-y-5' : 'p-4 sm:p-5 space-y-4'}`}
  data-story-card={story.id}
>
  <div class="space-y-3.5 flex-1 flex flex-col">
    <!-- Kicker / Volanta & Meta -->
    <div class="flex flex-wrap items-center justify-between gap-2 pb-2.5 border-b border-rule">
      <div class="flex items-center gap-2">
        <span class="font-sans text-[11px] font-bold uppercase tracking-wider text-accent">
          {story.kicker || story.category}
        </span>
        <span class="text-rule-strong/30" aria-hidden="true">·</span>
        <span class="font-mono text-[11px] text-ink-muted">{displayTimestamp}</span>
      </div>

      <span class="font-mono text-[11px] text-ink-muted">
        {story.articles.length} medios comparados
      </span>
    </div>

    {story.isLeadStory ? (
      /* LEAD STORY (Gran Apertura de Tapa) */
      <div class="space-y-4 flex-1 flex flex-col">
        <div class="space-y-2.5 min-w-0">
          <h2 class="font-editorial text-2xl sm:text-3xl md:text-[2.25rem] font-bold text-ink leading-[1.12] tracking-tight min-w-0 break-words">
            <a href={`/historia/${story.id}`} class="hover:text-accent transition-colors">
              {story.neutralHeadline}
            </a>
          </h2>
          <p class="text-sm sm:text-base text-ink-secondary leading-relaxed font-sans max-w-4xl line-clamp-3 sm:line-clamp-4">
            {story.summary}
          </p>
        </div>

        <!-- Press Photo -->
        {story.imageUrl && (
          <div class="story-img-wrapper space-y-1.5">
            <a
              href={`/historia/${story.id}`}
              class="group block relative overflow-hidden rounded border border-rule bg-surface-muted aspect-video max-h-[360px] sm:max-h-[440px]"
              title={`Ver análisis completo: ${story.neutralHeadline}`}
            >
              <img
                src={optimizedLeadImageUrl}
                srcset={optimizedLeadMobileImageUrl ? `${optimizedLeadMobileImageUrl} 480w, ${optimizedLeadImageUrl} 800w` : undefined}
                sizes="(max-width: 640px) 100vw, 800px"
                data-original-src={story.imageUrl}
                alt={story.neutralHeadline}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="800"
                height="450"
                referrerpolicy="no-referrer"
                onerror="if (this.dataset.retry !== '1') { this.dataset.retry = '1'; this.setAttribute('src', this.dataset.originalSrc); } else { this.closest('.story-img-wrapper')?.style.setProperty('display', 'none'); }"
                class="w-full h-full object-cover object-center motion-safe:transition-transform duration-300 motion-safe:group-hover:scale-[1.015]"
              />
            </a>
            {story.imageCaption && (
              <p class="text-[11px] font-sans text-ink-muted italic">
                {story.imageCaption}
              </p>
            )}
          </div>
        )}

        <!-- Integrated Editorial Spectrum Bar (No nested card box) -->
        <div class="pt-3 border-t border-rule mt-auto">
          <SpectrumBar spectrum={story.spectrum} articles={story.articles} storyId={story.id} />
        </div>
      </div>
    ) : (
      /* SECONDARY STORY */
      <div class="space-y-3.5 flex-1 flex flex-col">
        {story.imageUrl && (
          <div class="story-img-wrapper space-y-1">
            <a
              href={`/historia/${story.id}`}
              class="group block relative overflow-hidden rounded border border-rule bg-surface-muted aspect-video max-h-[175px]"
              title={`Ver análisis completo: ${story.neutralHeadline}`}
            >
              <img
                src={optimizedSecondaryImageUrl}
                data-original-src={story.imageUrl}
                alt={story.neutralHeadline}
                loading="lazy"
                decoding="async"
                width="400"
                height="225"
                referrerpolicy="no-referrer"
                onerror="if (this.dataset.retry !== '1') { this.dataset.retry = '1'; this.setAttribute('src', this.dataset.originalSrc); } else { this.closest('.story-img-wrapper')?.style.setProperty('display', 'none'); }"
                class="w-full h-full object-cover object-center motion-safe:transition-transform duration-300 motion-safe:group-hover:scale-[1.02]"
              />
            </a>
            {story.imageCaption && (
              <p class="text-[11px] font-sans text-ink-muted italic truncate">
                {story.imageCaption}
              </p>
            )}
          </div>
        )}

        <div class="space-y-1.5 min-w-0">
          <h3 class="font-editorial text-lg sm:text-[1.28rem] font-bold text-ink leading-[1.15] tracking-tight min-w-0 break-words">
            <a href={`/historia/${story.id}`} class="hover:text-accent transition-colors">
              {story.neutralHeadline}
            </a>
          </h3>
          <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed font-sans line-clamp-3">
            {story.summary}
          </p>
        </div>

        <!-- Integrated Editorial Spectrum Bar -->
        <div class="pt-3 border-t border-rule mt-auto">
          <SpectrumBar spectrum={story.spectrum} articles={story.articles} storyId={story.id} />
        </div>
      </div>
    )}
  </div>

  <!-- Footer Actions (Monochromatic editorial controls) -->
  <div class="mt-auto pt-3 border-t border-rule flex flex-wrap items-center justify-between gap-2.5">
    <div class="flex items-center gap-1.5 flex-wrap">
      <button
        type="button"
        class="share-story-btn inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-rule bg-surface-muted/60 hover:bg-surface-muted text-ink-secondary hover:text-ink text-xs font-sans font-medium transition-colors cursor-pointer"
        data-title={story.neutralHeadline}
        data-url={storyUrl}
        data-text={viralShareText}
        data-category={story.category}
        data-headline={story.neutralHeadline}
        data-oficialismo={story.spectrum?.oficialismoPct ?? 0}
        data-centro={story.spectrum?.centroDatosPct ?? 0}
        data-oposicion={story.spectrum?.oposicionPct ?? 0}
        data-outlets={story.articles?.map(a => a.outletName).slice(0, 4).join(', ') ?? ''}
        title="Abrir opciones de difusión y placa visual"
      >
        <svg aria-hidden="true" class="w-3.5 h-3.5 text-ink-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        <span>Compartir</span>
      </button>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-surface-muted/60 hover:bg-surface-muted text-ink-muted hover:text-ink border border-rule transition-colors"
        title="Compartir directo en WhatsApp"
        aria-label="Compartir en WhatsApp"
      >
        <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
      </a>

      <a
        href={xUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-surface-muted/60 hover:bg-surface-muted text-ink-muted hover:text-ink border border-rule transition-colors"
        title="Publicar en X (Twitter)"
        aria-label="Publicar en X"
      >
        <span class="text-xs font-bold font-mono">𝕏</span>
      </a>

      <a
        href={tgUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-surface-muted/60 hover:bg-surface-muted text-ink-muted hover:text-ink border border-rule transition-colors"
        title="Compartir en Telegram"
        aria-label="Compartir en Telegram"
      >
        <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </a>
    </div>

    <a
      href={`/historia/${story.id}`}
      class="inline-flex items-center gap-1.5 text-xs font-sans font-semibold text-accent hover:underline underline-offset-4 transition-colors cursor-pointer"
    >
      <span>Analizar encuadres</span>
      <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</article>

<script>
  function setupShareButtons() {
    document.querySelectorAll('.share-story-btn').forEach((btn) => {
      if (btn.hasAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const title = btn.getAttribute('data-title') || '';
        const url = btn.getAttribute('data-url') || '';
        const text = btn.getAttribute('data-text') || '';
        const category = btn.getAttribute('data-category') || 'Difusión Cívica';
        const headline = btn.getAttribute('data-headline') || title;
        const oficialismo = parseInt(btn.getAttribute('data-oficialismo') || '0', 10);
        const centro = parseInt(btn.getAttribute('data-centro') || '0', 10);
        const oposicion = parseInt(btn.getAttribute('data-oposicion') || '0', 10);
        const outlets = btn.getAttribute('data-outlets') || '';

        if (typeof (window as any).openShareModal === 'function') {
          (window as any).openShareModal({
            title,
            url,
            text,
            category,
            headline,
            spectrum: { oficialismo, centro, oposicion },
            outlets,
            modalTitle: 'Difusión y Placa para Redes'
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupShareButtons);
  } else {
    setupShareButtons();
  }
</script>
