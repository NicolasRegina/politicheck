---
import type { StoryCluster } from '../types';
import SpectrumBar from './SpectrumBar.astro';

interface Props {
  story: StoryCluster;
}

const { story } = Astro.props;
---

<article class="glass-panel rounded-2xl p-6 sm:p-7 space-y-5 border border-slate-200 dark:border-slate-800/80 hover:border-slate-300 dark:hover:border-slate-700/80 transition-all duration-300">
  <!-- Top metadata row -->
  <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-2">
      <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold tracking-wide uppercase text-[11px] border border-slate-200 dark:border-slate-700/60">
        {story.category}
      </span>
      <span class="text-slate-400">•</span>
      <span class="text-slate-500 dark:text-slate-400 font-mono">{story.updatedAt}</span>
    </div>

    <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-900/90 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 font-mono text-[11px]">
      <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
      </svg>
      <span>{story.articles.length} medios cubriendo</span>
    </div>
  </div>

  <!-- Neutral Headline & Summary -->
  <div class="space-y-2">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100 leading-snug tracking-tight hover:text-black dark:hover:text-white transition-colors">
      {story.neutralHeadline}
    </h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
      {story.summary}
    </p>
  </div>

  <!-- Spectrum Bar Section -->
  <div class="pt-2 pb-1 bg-slate-50 dark:bg-slate-950/40 rounded-xl p-4 border border-slate-200 dark:border-slate-850/60">
    <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2 flex items-center justify-between">
      <span>Espectro de Cobertura Editorial</span>
      <span class="text-slate-500 dark:text-slate-400">Total: {story.spectrum.totalOutlets} medios</span>
    </div>
    <SpectrumBar spectrum={story.spectrum} />
  </div>

  <!-- AI Framing Comparison Note -->
  {story.aiComparisonNotice && (
    <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-100/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs text-slate-700 dark:text-slate-300">
      <div class="p-1 rounded-md bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-200 mt-0.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <div class="space-y-0.5">
        <span class="font-semibold text-slate-900 dark:text-slate-200 uppercase tracking-wider text-[10px] block">Contraste de Encuadres (IA)</span>
        <p class="text-slate-600 dark:text-slate-400 leading-relaxed">{story.aiComparisonNotice}</p>
      </div>
    </div>
  )}

  <!-- Coverage by Outlet: The Titles Compared -->
  <div class="space-y-2.5 pt-2">
    <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">
      Titulares Según Cada Medio:
    </div>

    <div class="grid grid-cols-1 gap-2.5">
      {story.articles.map((art) => (
        <a 
          href={art.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group block p-3.5 rounded-xl bg-slate-50 hover:bg-slate-100 dark:bg-slate-900/40 dark:hover:bg-slate-850/90 border border-slate-200/90 hover:border-slate-300 dark:border-slate-800/80 dark:hover:border-slate-700 transition-all duration-200"
        >
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1.5 mb-1.5">
            <span class="font-semibold text-xs text-slate-800 group-hover:text-black dark:text-slate-200 dark:group-hover:text-white flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-slate-400 group-hover:bg-slate-600 dark:bg-slate-500 dark:group-hover:bg-slate-300 transition-colors"></span>
              {art.outletName}
            </span>
            {art.specificFocus && (
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-200/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-300/80 dark:border-slate-700/40 w-fit">
                Foco: {art.specificFocus}
              </span>
            )}
          </div>
          <p class="text-sm text-slate-800 group-hover:text-slate-950 dark:text-slate-300 dark:group-hover:text-slate-100 font-medium leading-snug">
            "{art.title}"
          </p>
          <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 mt-2 font-mono">
            <span>{art.publishedAt}</span>
            <span class="inline-flex items-center gap-1 text-slate-500 group-hover:text-slate-800 dark:text-slate-400 dark:group-hover:text-slate-300">
              Leer nota completa en {art.outletName}
              <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</article>
