---
import type { CampaignPromise } from '../types';
import { getPolitician } from '../data/politicians';
import Promesometro from './Promesometro.astro';

interface Props {
  promise: CampaignPromise;
}

const { promise } = Astro.props;
const politician = getPolitician(promise.candidate);

// Status color tokens (PolitiFact-style)
const getStatusTheme = (status: string) => {
  switch (status) {
    case 'cumplida':
      return {
        label: 'Cumplida',
        borderAccent: 'border-l-emerald-500',
        badgeClass: 'bg-emerald-50 text-emerald-950 dark:bg-emerald-950/80 dark:text-emerald-200 border-emerald-300 dark:border-emerald-800',
        quoteBorder: 'border-l-emerald-500',
        bgSubtle: 'bg-emerald-50/20'
      };
    case 'en_progreso':
      return {
        label: 'En progreso',
        borderAccent: 'border-l-amber-500',
        badgeClass: 'bg-amber-50 text-amber-950 dark:bg-amber-950/80 dark:text-amber-200 border-amber-300 dark:border-amber-800',
        quoteBorder: 'border-l-amber-500',
        bgSubtle: 'bg-amber-50/20'
      };
    case 'en_pausa':
      return {
        label: 'En pausa',
        borderAccent: 'border-l-orange-500',
        badgeClass: 'bg-orange-50 text-orange-950 dark:bg-orange-950/80 dark:text-orange-200 border-orange-300 dark:border-orange-800',
        quoteBorder: 'border-l-orange-500',
        bgSubtle: 'bg-orange-50/20'
      };
    case 'incumplida':
      return {
        label: 'Incumplida',
        borderAccent: 'border-l-rose-500',
        badgeClass: 'bg-rose-50 text-rose-950 dark:bg-rose-950/80 dark:text-rose-200 border-rose-300 dark:border-rose-800',
        quoteBorder: 'border-l-rose-500',
        bgSubtle: 'bg-rose-50/20'
      };
    default:
      return {
        label: 'En evaluación',
        borderAccent: 'border-l-slate-400',
        badgeClass: 'bg-slate-50 text-slate-900 dark:bg-slate-900 dark:text-slate-300 border-slate-300 dark:border-slate-700',
        quoteBorder: 'border-l-slate-400',
        bgSubtle: ''
      };
  }
};

const theme = getStatusTheme(promise.status);

const getInitials = (name: string) => {
  return name
    .split(' ')
    .map(p => p[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
};

const votes = promise.votes || { fulfilled: 0, inProgress: 0, broken: 0 };
---

<div 
  class={`promise-card bg-white dark:bg-[#0F1420] border border-slate-200 dark:border-slate-800/90 rounded-2xl p-5 sm:p-6 space-y-4 shadow-sm hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all flex flex-col justify-between border-l-4 ${theme.borderAccent}`}
  data-candidate={promise.candidate}
  data-status={promise.status}
  data-coalition={promise.coalition}
  data-category={promise.category}
  data-id={promise.id}
>
  <div class="space-y-4">
    <!-- PolitiFact Header: Politician circular photo, quote mark, name pill & stated context -->
    <div class="flex items-start gap-3.5 border-b border-slate-100 dark:border-slate-800/80 pb-3.5">
      <!-- Politician Avatar Headshot (with quote mark) -->
      <div class="relative shrink-0">
        {politician.avatar ? (
          <img 
            src={politician.avatar} 
            alt={promise.candidate} 
            class="w-13 h-13 rounded-full object-cover ring-2 ring-white dark:ring-slate-800 shadow-md border border-slate-200 dark:border-slate-700"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
        ) : null}
        
        <!-- Fallback initials if image missing or broken -->
        <div 
          class={`w-13 h-13 rounded-full font-mono text-xs font-bold items-center justify-center shadow-md border ${politician.partyColor.badgeBg} ${politician.avatar ? 'hidden' : 'flex'}`}
        >
          {getInitials(promise.candidate)}
        </div>

        <!-- Quotation icon badge -->
        <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center text-[11px] font-serif shadow-xs">
          “
        </div>
      </div>

      <!-- Candidate name & context -->
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <!-- Candidate Name Badge with party background -->
          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-md font-sans text-sm font-extrabold border shadow-2xs ${politician.partyColor.badgeBg}`}>
            {promise.candidate}
          </span>

          <!-- Coalition Pill -->
          <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
            {promise.coalition}
          </span>
        </div>

        <!-- Role & Stated Context (PolitiFact style) -->
        <p class="text-xs text-slate-500 dark:text-slate-400 font-sans mt-1 leading-snug">
          declaró en: <span class="font-medium text-slate-700 dark:text-slate-300">{promise.statedAt}</span>
        </p>
      </div>
    </div>

    <!-- Quote & Meter Section (PolitiFact Visual Dual Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-4 items-center">
      <!-- Verbatim Promise Quote with colored left bar -->
      <blockquote class={`font-editorial text-base sm:text-lg italic font-medium text-slate-900 dark:text-slate-100 border-l-4 ${theme.quoteBorder} pl-4 py-1 leading-relaxed bg-slate-50/50 dark:bg-slate-900/40 rounded-r-xl`}>
        {promise.promiseText}
      </blockquote>

      <!-- Visual Truth-O-Meter / Promesómetro -->
      <div class="flex justify-center md:justify-end shrink-0">
        <Promesometro status={promise.status} />
      </div>
    </div>

    <!-- Factual Observatory Audit Notes & Proof -->
    <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1.5 text-xs">
      <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Dictamen de Auditoría Factual:</span>
      </div>
      <p class="text-slate-700 dark:text-slate-300 leading-relaxed font-sans">
        {promise.auditNotes}
      </p>

      {promise.officialProof && (
        <div class="pt-1.5 border-t border-slate-200/60 dark:border-slate-800/80 flex items-start gap-1.5 text-[11px] font-mono text-slate-600 dark:text-slate-400">
          <span class="font-semibold shrink-0 text-slate-800 dark:text-slate-200">Prueba Documental:</span>
          <span>{promise.officialProof}</span>
        </div>
      )}
    </div>
  </div>

  <!-- Interactive Citizen Thermometer Widget -->
  <div 
    class="space-y-2 pt-2 border-t border-slate-200/70 dark:border-slate-800/70 mt-3 citizen-audit-widget" 
    data-promise-id={promise.id}
    data-votes={JSON.stringify(votes)}
  >
    <div class="flex items-center justify-between text-[11px] font-mono">
      <span class="text-slate-600 dark:text-slate-400 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <strong class="widget-title">Auditoría Ciudadana</strong>
      </span>
      <span class="widget-sub text-slate-500 dark:text-slate-400 text-[10px]">Votá para ver la tendencia comunitaria</span>
    </div>

    <!-- Consensus Progress Bar (Neutral placeholder before voting, revealed on vote) -->
    <div class="consensus-bar relative h-2.5 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden flex transition-all duration-500">
      <div class="bar-placeholder absolute inset-0 bg-slate-200/50 dark:bg-slate-800/50 flex items-center justify-center transition-opacity duration-300"></div>
      <div class="bar-fulfilled bg-emerald-500 transition-all duration-700 opacity-0" style="width: 0%"></div>
      <div class="bar-in-progress bg-amber-500 transition-all duration-700 opacity-0" style="width: 0%"></div>
      <div class="bar-broken bg-rose-500 transition-all duration-700 opacity-0" style="width: 0%"></div>
    </div>

    <!-- Live Vote Buttons (Clean without biasing numbers) -->
    <div class="grid grid-cols-3 gap-2 pt-1">
      <button 
        type="button"
        class="vote-btn flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-[11px] font-mono text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-300 hover:border-emerald-300 transition-all cursor-pointer shadow-2xs"
        data-vote-type="fulfilled"
        data-promise-id={promise.id}
      >
        <span>👍</span>
        <span>Cumple</span>
        <span class="vote-pct font-bold text-[10px] hidden count-fulfilled"></span>
      </button>

      <button 
        type="button"
        class="vote-btn flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 hover:bg-amber-50 dark:hover:bg-amber-950/40 text-[11px] font-mono text-slate-700 dark:text-slate-300 hover:text-amber-700 dark:hover:text-amber-300 hover:border-amber-300 transition-all cursor-pointer shadow-2xs"
        data-vote-type="inProgress"
        data-promise-id={promise.id}
      >
        <span>⏳</span>
        <span>En proceso</span>
        <span class="vote-pct font-bold text-[10px] hidden count-in-progress"></span>
      </button>

      <button 
        type="button"
        class="vote-btn flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-[11px] font-mono text-slate-700 dark:text-slate-300 hover:text-rose-700 dark:hover:text-rose-300 hover:border-rose-300 transition-all cursor-pointer shadow-2xs"
        data-vote-type="broken"
        data-promise-id={promise.id}
      >
        <span>👎</span>
        <span>Incumple</span>
        <span class="vote-pct font-bold text-[10px] hidden count-broken"></span>
      </button>
    </div>

    <!-- Source date & official link footer -->
    <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 dark:text-slate-400 pt-2 border-t border-slate-200/50 dark:border-slate-800/50">
      <a 
        href={`/promesa/${promise.id}`}
        class="inline-flex items-center gap-1.5 font-bold text-slate-900 dark:text-slate-100 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
        title="Ver ficha técnica y auditoría individual"
      >
        <span>Ficha y auditoría</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <div class="flex items-center gap-3 shrink-0">
        <button 
          type="button"
          class="share-promise-btn inline-flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-100 transition-colors cursor-pointer"
          data-candidate={promise.candidate}
          data-text={promise.promiseText}
          data-id={promise.id}
          title="Compartir promesa y auditoría"
        >
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span>Compartir</span>
        </button>

        <a 
          href={promise.sourceUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-sky-700 dark:text-sky-400 hover:text-sky-900 dark:hover:text-sky-300 font-semibold underline underline-offset-2 transition-colors"
        >
          <span>Fuente</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
