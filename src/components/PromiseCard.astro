---
import type { CampaignPromise } from '../types';

interface Props {
  promise: CampaignPromise;
}

const { promise } = Astro.props;

const getStatusBadge = (status: string) => {
  switch (status) {
    case 'cumplida':
      return {
        label: 'Cumplida',
        class: 'bg-emerald-50 text-emerald-900 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800'
      };
    case 'en_progreso':
      return {
        label: 'En progreso',
        class: 'bg-sky-50 text-sky-900 dark:bg-sky-950/60 dark:text-sky-300 border-sky-300 dark:border-sky-800'
      };
    case 'en_pausa':
      return {
        label: 'En pausa',
        class: 'bg-amber-50 text-amber-900 dark:bg-amber-950/60 dark:text-amber-300 border-amber-300 dark:border-amber-800'
      };
    case 'incumplida':
      return {
        label: 'Incumplida',
        class: 'bg-rose-50 text-rose-900 dark:bg-rose-950/60 dark:text-rose-300 border-rose-300 dark:border-rose-800'
      };
    default:
      return {
        label: 'En evaluación',
        class: 'bg-slate-50 text-slate-900 dark:bg-slate-900 dark:text-slate-300 border-slate-300 dark:border-slate-700'
      };
  }
};

const badge = getStatusBadge(promise.status);
---

<div class="bg-white dark:bg-[#0F1420] border border-slate-200 dark:border-slate-800/90 rounded-2xl p-5 sm:p-6 space-y-4 shadow-xs hover:border-slate-300 dark:hover:border-slate-700 transition-all">
  <!-- Candidate header and status -->
  <div class="flex flex-wrap items-center justify-between gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3">
    <div>
      <div class="flex items-center gap-2">
        <h4 class="font-editorial text-lg font-bold text-slate-950 dark:text-white">
          {promise.candidate}
        </h4>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
          {promise.coalition}
        </span>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 font-mono mt-0.5">
        {promise.role} • {promise.category}
      </p>
    </div>

    <!-- Status pill -->
    <span class={`px-2.5 py-1 rounded-full text-[11px] font-mono font-bold tracking-wider border ${badge.class}`}>
      {promise.statusLabel}
    </span>
  </div>

  <!-- Verbatim promise quote -->
  <blockquote class="font-editorial text-base sm:text-lg italic text-slate-900 dark:text-slate-100 border-l-2 border-slate-400 dark:border-slate-600 pl-4 py-1 leading-relaxed">
    {promise.promiseText}
  </blockquote>

  <!-- Audit notes -->
  <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1 text-xs">
    <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>Auditoría Factual del Observatorio:</span>
    </div>
    <p class="text-slate-700 dark:text-slate-300 leading-relaxed font-sans">
      {promise.auditNotes}
    </p>
  </div>

  <!-- Source date & link -->
  <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 dark:text-slate-400 pt-1">
    <span>Declarado en: {promise.statedAt}</span>
    <a 
      href={promise.sourceUrl} 
      target="_blank" 
      rel="noopener noreferrer"
      class="hover:text-slate-900 dark:hover:text-slate-200 underline underline-offset-2 transition-colors"
    >
      Documento oficial
    </a>
  </div>
</div>
