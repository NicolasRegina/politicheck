---
import type { CampaignPromise } from '../types';

interface Props {
  promise: CampaignPromise;
}

const { promise } = Astro.props;

const getStatusBadge = (status: string) => {
  switch (status) {
    case 'cumplida':
      return {
        label: 'Cumplida',
        class: 'bg-emerald-50 text-emerald-900 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800'
      };
    case 'en_progreso':
      return {
        label: 'En progreso',
        class: 'bg-sky-50 text-sky-900 dark:bg-sky-950/60 dark:text-sky-300 border-sky-300 dark:border-sky-800'
      };
    case 'en_pausa':
      return {
        label: 'En pausa',
        class: 'bg-amber-50 text-amber-900 dark:bg-amber-950/60 dark:text-amber-300 border-amber-300 dark:border-amber-800'
      };
    case 'incumplida':
      return {
        label: 'Incumplida',
        class: 'bg-rose-50 text-rose-900 dark:bg-rose-950/60 dark:text-rose-300 border-rose-300 dark:border-rose-800'
      };
    default:
      return {
        label: 'En evaluación',
        class: 'bg-slate-50 text-slate-900 dark:bg-slate-900 dark:text-slate-300 border-slate-300 dark:border-slate-700'
      };
  }
};

const badge = getStatusBadge(promise.status);

const getInitials = (name: string) => {
  return name
    .split(' ')
    .map(p => p[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
};

const votes = promise.votes || { fulfilled: 0, inProgress: 0, broken: 0 };
const totalVotes = (votes.fulfilled || 0) + (votes.inProgress || 0) + (votes.broken || 0);
const fulfilledPct = totalVotes > 0 ? Math.round((votes.fulfilled / totalVotes) * 100) : 0;
const inProgressPct = totalVotes > 0 ? Math.round((votes.inProgress / totalVotes) * 100) : 0;
const brokenPct = totalVotes > 0 ? Math.round((votes.broken / totalVotes) * 100) : 0;
---

<div 
  class="promise-card bg-white dark:bg-[#0F1420] border border-slate-200 dark:border-slate-800/90 rounded-2xl p-5 sm:p-6 space-y-4 shadow-xs hover:border-slate-300 dark:hover:border-slate-700 transition-all flex flex-col justify-between"
  data-candidate={promise.candidate}
  data-status={promise.status}
  data-coalition={promise.coalition}
  data-category={promise.category}
  data-id={promise.id}
>
  <div class="space-y-4">
    <!-- Candidate header and status -->
    <div class="flex flex-wrap items-center justify-between gap-2.5 border-b border-slate-200 dark:border-slate-800 pb-3">
      <div class="flex items-center gap-3">
        <!-- Initials Avatar -->
        <div class="w-10 h-10 rounded-xl bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 font-mono text-xs font-bold flex items-center justify-center shrink-0 shadow-xs">
          {getInitials(promise.candidate)}
        </div>

        <div>
          <div class="flex items-center gap-2">
            <h4 class="font-editorial text-lg font-bold text-slate-950 dark:text-white leading-tight">
              {promise.candidate}
            </h4>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
              {promise.coalition}
            </span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 font-mono mt-0.5">
            {promise.role} • <span class="text-slate-700 dark:text-slate-300 font-medium">{promise.category}</span>
          </p>
        </div>
      </div>

      <!-- Status badge pill -->
      <span class={`px-2.5 py-1 rounded-full text-[11px] font-mono font-bold tracking-wider border ${badge.class}`}>
        {promise.statusLabel}
      </span>
    </div>

    <!-- Verbatim promise quote -->
    <blockquote class="font-editorial text-base sm:text-lg italic text-slate-900 dark:text-slate-100 border-l-2 border-slate-900 dark:border-slate-400 pl-4 py-1 leading-relaxed">
      {promise.promiseText}
    </blockquote>

    <!-- Factual Observatory Audit Notes -->
    <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1.5 text-xs">
      <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Dictamen de Auditoría Factual:</span>
      </div>
      <p class="text-slate-700 dark:text-slate-300 leading-relaxed font-sans">
        {promise.auditNotes}
      </p>

      {promise.officialProof && (
        <div class="pt-1.5 border-t border-slate-200/60 dark:border-slate-800/80 flex items-start gap-1.5 text-[11px] font-mono text-slate-600 dark:text-slate-400">
          <span class="font-semibold shrink-0 text-slate-800 dark:text-slate-200">Prueba Documental:</span>
          <span>{promise.officialProof}</span>
        </div>
      )}
    </div>
  </div>

  <!-- Interactive Citizen Thermometer Widget -->
  <div 
    class="space-y-2 pt-2 border-t border-slate-200/70 dark:border-slate-800/70 mt-3 citizen-audit-widget" 
    data-promise-id={promise.id}
    data-votes={JSON.stringify(votes)}
  >
    <div class="flex items-center justify-between text-[11px] font-mono">
      <span class="text-slate-600 dark:text-slate-400 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <strong class="widget-title">Auditoría Ciudadana</strong>
      </span>
      <span class="widget-sub text-slate-400 dark:text-slate-500 text-[10px]">Votá para ver la tendencia</span>
    </div>

    <!-- Consensus Progress Bar (Neutral placeholder before voting, revealed on vote) -->
    <div class="consensus-bar relative h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden flex transition-all duration-500">
      <div class="bar-placeholder absolute inset-0 bg-slate-200/50 dark:bg-slate-800/50 flex items-center justify-center transition-opacity duration-300"></div>
      <div class="bar-fulfilled bg-emerald-500 transition-all duration-700 opacity-0" style="width: 0%"></div>
      <div class="bar-in-progress bg-amber-500 transition-all duration-700 opacity-0" style="width: 0%"></div>
      <div class="bar-broken bg-rose-500 transition-all duration-700 opacity-0" style="width: 0%"></div>
    </div>

    <!-- Live Vote Buttons (Clean without biasing numbers) -->
    <div class="grid grid-cols-3 gap-2 pt-1">
      <button 
        type="button"
        class="vote-btn flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-[11px] font-mono text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-300 transition-all cursor-pointer"
        data-vote-type="fulfilled"
        data-promise-id={promise.id}
      >
        <span>👍</span>
        <span>Cumple</span>
        <span class="vote-pct font-bold text-[10px] hidden count-fulfilled"></span>
      </button>

      <button 
        type="button"
        class="vote-btn flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 hover:bg-amber-50 dark:hover:bg-amber-950/40 text-[11px] font-mono text-slate-700 dark:text-slate-300 hover:text-amber-700 dark:hover:text-amber-300 transition-all cursor-pointer"
        data-vote-type="inProgress"
        data-promise-id={promise.id}
      >
        <span>⏳</span>
        <span>En proceso</span>
        <span class="vote-pct font-bold text-[10px] hidden count-in-progress"></span>
      </button>

      <button 
        type="button"
        class="vote-btn flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-[11px] font-mono text-slate-700 dark:text-slate-300 hover:text-rose-700 dark:hover:text-rose-300 transition-all cursor-pointer"
        data-vote-type="broken"
        data-promise-id={promise.id}
      >
        <span>👎</span>
        <span>Incumple</span>
        <span class="vote-pct font-bold text-[10px] hidden count-broken"></span>
      </button>
    </div>

    <!-- Source date & official link footer -->
    <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 dark:text-slate-400 pt-2 border-t border-slate-200/50 dark:border-slate-800/50">
      <span class="truncate max-w-[200px]" title={promise.statedAt}>
        Declarado en: {promise.statedAt}
      </span>
      <a 
        href={promise.sourceUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 hover:text-slate-900 dark:hover:text-slate-100 font-semibold underline underline-offset-2 transition-colors shrink-0"
      >
        <span>Documento oficial</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</div>
