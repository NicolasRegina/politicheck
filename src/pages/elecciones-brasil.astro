---
import Layout from '../layouts/Layout.astro';
import StoryCard from '../components/StoryCard.astro';
import { getCachedArticlesAsync } from '../services/rss/sync';
import { brazilElectionMetadata, brazilElectionClusters, getLiveBrazilDispatches } from '../data/brasil_election';

export const prerender = false;

// Edge cache for high traffic during the election week
Astro.response.headers.set('Cache-Control', 'public, s-maxage=120, stale-while-revalidate=600');

const liveArticles = await getCachedArticlesAsync();
const liveBrazilDispatches = getLiveBrazilDispatches(liveArticles).slice(0, 12);

const pageTitle = "Especial Elecciones Brasil 2026 • Impacto en Argentina y Mercosur | Politicheck";
const pageDescription = "Especial regional sobre las Elecciones Presidenciales de Brasil 2026 en Politicheck. Análisis de encuadre mediático sobre el balotaje, la relación bilateral con Argentina y el impacto en el Mercosur.";
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  ogType="article"
>
  <div class="space-y-10 py-2 sm:py-4">
    <!-- Breadcrumb & Top Indicator -->
    <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800 pb-3">
      <nav class="flex items-center gap-2">
        <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors underline underline-offset-2">
          ← Volver a Portada Argentina
        </a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white font-bold">Especial Regional: Elecciones Brasil 2026</span>
      </nav>
      <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-bold">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Especial regional, archivo y análisis bilateral</span>
      </div>
    </div>

    <!-- Hero Header Especial con Bandera y Métricas Clave -->
    <header class="relative overflow-hidden rounded-3xl border border-emerald-500/30 dark:border-emerald-500/20 bg-gradient-to-br from-slate-900 via-navy-card to-navy-deep p-6 sm:p-10 text-white shadow-xl">
      <!-- Background Flag Element Subtle Glow -->
      <div 
        class="absolute right-0 top-0 bottom-0 w-2/5 opacity-20 pointer-events-none bg-right center bg-no-repeat bg-contain"
        style="background-image: url('/images/flags/brasil.svg'); mask-image: linear-gradient(to left, black, transparent); -webkit-mask-image: linear-gradient(to left, black, transparent);"
      ></div>

      <div class="relative z-10 space-y-4 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-xs font-sans font-bold">
          <span>Especial regional, elecciones Brasil 2026 y Mercosur</span>
        </div>

        <h1 class="font-editorial text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight">
          Elecciones en Brasil 2026: Cobertura Cruzada & Encuadres Internacionales
        </h1>

        <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed font-light">
          {brazilElectionMetadata.description}
        </p>

        <!-- Quick Facts Bar Bento -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 font-sans text-xs">
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
            <span class="text-slate-400 block text-[11px]">Padrón electoral</span>
            <span class="font-bold text-white text-sm sm:text-base font-mono">{brazilElectionMetadata.electorate}</span>
          </div>
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
            <span class="text-slate-400 block text-[11px]">Sistema electoral</span>
            <span class="font-bold text-emerald-300 text-sm sm:text-base">Urna biométrica</span>
          </div>
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
            <span class="text-slate-400 block text-[11px]">Instancia</span>
            <span class="font-bold text-amber-300 text-sm sm:text-base">Balotaje final</span>
          </div>
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
            <span class="text-slate-400 block text-[11px]">Impacto clave</span>
            <span class="font-bold text-sky-300 text-sm sm:text-base">Comercio y Mercosur</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Sección 1: Grandes Historias y Encuadres Clúster de Brasil -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
        <div class="flex items-center gap-2 text-xs font-sans text-slate-500 dark:text-slate-400">
          <span class="font-bold text-slate-900 dark:text-white">
            Análisis de encuadre y espectro editorial
          </span>
        </div>
        <span class="text-xs font-sans text-slate-400">Folha de S. Paulo, O Globo, FT, El País</span>
      </div>

      <div class="space-y-8" id="brazil-clusters-list">
        {brazilElectionClusters.map((cluster) => (
          <StoryCard story={cluster} />
        ))}
      </div>
    </section>

    <!-- Sección 2: Cables y Despachos de Último Momento sobre Brasil -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
        <div>
          <div class="flex items-center gap-2 text-xs font-sans text-slate-500 dark:text-slate-400">
            <span class="w-2 h-2 rounded-full bg-blue-500 motion-safe:animate-pulse" aria-hidden="true"></span>
            <span class="font-bold text-slate-900 dark:text-white">
              Despachos de corresponsales en vivo
            </span>
          </div>
          <h2 class="font-editorial text-xl sm:text-2xl font-bold text-slate-950 dark:text-white">
            Despachos y Cobertura: Brasil, Lula y el Impacto Regional
          </h2>
        </div>
        <span class="text-xs font-sans text-slate-400">Cables y agencias internacionales</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="brazil-dispatches-grid">
        {liveBrazilDispatches.map((dispatch) => (
          <a
            href={dispatch.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col justify-between p-4 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/60 hover:border-emerald-500/60 dark:hover:border-emerald-500/60 transition-colors hover:shadow-xs"
          >
            <div class="space-y-2">
              <div class="flex items-center justify-between text-[11px] font-mono">
                <span class="font-bold px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 font-sans">
                  {dispatch.outletName}
                </span>
                <span class="text-slate-400">
                  {dispatch.publishedAt}
                </span>
              </div>
              <h3 class="font-editorial text-base font-bold text-slate-900 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-3">
                {dispatch.title}
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-3 leading-relaxed">
                {dispatch.snippet}
              </p>
            </div>
            <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800/50 flex items-center justify-between text-[11px] font-sans text-slate-400 group-hover:text-slate-700 dark:group-hover:text-slate-300">
              <span>Leer en {dispatch.outletName}</span>
              <svg aria-hidden="true" class="w-3 h-3 motion-safe:transition-transform motion-safe:group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Bottom return button -->
    <div class="pt-6 text-center border-t border-slate-200 dark:border-slate-800">
      <a 
        href="/" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-slate-100 dark:hover:bg-white text-white dark:text-slate-950 font-sans text-xs font-bold transition-colors shadow-sm"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        <span>Volver al Observatorio de Noticias de Argentina</span>
      </a>
    </div>
  </div>
</Layout>
