---
import Layout from '../../layouts/Layout.astro';
import { GUIAS_ARTICLES, type GuiaArticle } from '../../data/guias';

export const prerender = true;

export function getStaticPaths() {
  return GUIAS_ARTICLES.filter(g => g.status === 'publicado').map((guia) => ({
    params: { slug: guia.slug },
    props: { guia }
  }));
}

interface Props {
  guia: GuiaArticle;
}

const { guia } = Astro.props;

const pageUrl = `https://www.politicheck.com.ar/guias/${guia.slug}`;
const viralShareText = `🗞️ "${guia.title}"\n\nRadiografía corporativa y auditoría de medios en Politicheck 👉`;

// Structured Data Schemas
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guia.title,
  "description": guia.metaDescription,
  "inLanguage": "es-AR",
  "image": guia.heroImageUrl || "https://www.politicheck.com.ar/icons/icon-512x512.png",
  "author": {
    "@type": "Organization",
    "name": guia.author,
    "url": "https://www.politicheck.com.ar/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Politicheck",
    "url": "https://www.politicheck.com.ar/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.politicheck.com.ar/icons/icon-512x512.png"
    }
  },
  "datePublished": guia.isoPublishedAt,
  "dateModified": guia.isoUpdatedAt
};

const faqSchema = guia.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": guia.faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

<Layout 
  title={`${guia.title} • Politicheck`}
  description={guia.metaDescription}
  canonicalUrl={pageUrl}
  ogType="article"
  image={guia.heroImageUrl}
>
  <!-- Structured Data JSON-LD Injections -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
    
    <!-- Top Breadcrumb & Navigation -->
    <nav class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3 text-xs font-mono">
      <a 
        href="/guias" 
        class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-slate-950 dark:hover:text-white font-bold transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Volver a Cuadernos de Investigación</span>
      </a>

      <div class="flex items-center gap-2 text-slate-400 dark:text-slate-500">
        <span>{guia.kicker}</span>
        <span>•</span>
        <span>{guia.readTimeMinutes} min de lectura</span>
      </div>
    </nav>

    <!-- Header & Article Volanta -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[11px] font-mono font-bold tracking-widest uppercase text-slate-800 dark:text-slate-200">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
        <span>{guia.categoryLabel}</span>
      </div>

      <h1 class="font-editorial text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-950 dark:text-white leading-[1.15] tracking-tight">
        {guia.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-sans font-light">
        {guia.subtitle}
      </p>

      <!-- Metadata Strip -->
      <div class="pt-2 flex flex-wrap items-center justify-between gap-3 border-t border-b border-slate-100 dark:border-slate-800/80 py-3 text-xs font-mono text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-2">
          <span>Por: <strong class="text-slate-800 dark:text-slate-200">{guia.author}</strong></span>
          <span>•</span>
          <span>Publicado: {guia.publishedAt}</span>
        </div>

        <div class="flex items-center gap-1.5 text-[11px]">
          <span>Fuentes: CNV, MOM, MBFC</span>
        </div>
      </div>
    </header>

    <!-- Viral Contrast Share Bar -->
    <section class="flex flex-wrap items-center justify-between gap-3 p-4 rounded-xl bg-slate-50 dark:bg-[#0C101A] border border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2 text-xs font-mono text-slate-700 dark:text-slate-300">
        <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        <span>Compartir esta investigación:</span>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a 
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent(viralShareText + ' ' + pageUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-mono text-xs font-bold transition-all shadow-2xs"
        >
          <span>WhatsApp</span>
        </a>

        <a 
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(viralShareText)}&url=${encodeURIComponent(pageUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-200 text-white dark:text-slate-950 font-mono text-xs font-bold transition-all shadow-2xs"
        >
          <span>Twitter / X</span>
        </a>

        <a 
          href={`https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(viralShareText)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-700 text-white font-mono text-xs font-bold transition-all shadow-2xs"
        >
          <span>Telegram</span>
        </a>

        <button 
          type="button"
          id="copy-guia-btn"
          data-url={pageUrl}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 font-mono text-xs font-semibold transition-all cursor-pointer"
        >
          <span id="copy-guia-text">Copiar enlace</span>
        </button>
      </div>
    </section>

    <!-- Hero Press Image with Authentic Caption -->
    {guia.heroImageUrl && (
      <figure class="space-y-2">
        <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 max-h-[460px]">
          <img 
            src={guia.heroImageUrl} 
            alt={guia.title}
            class="w-full h-full object-cover object-center"
            loading="eager"
          />
        </div>
        {guia.imageCaption && (
          <figcaption class="text-xs font-mono text-slate-500 dark:text-slate-400 pl-1">
            {guia.imageCaption}
          </figcaption>
        )}
      </figure>
    )}

    <!-- Lead Box (Google Featured Snippet Target) -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-[#0F1420] border-l-4 border-slate-900 dark:border-slate-100 space-y-3">
      <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Resumen Ejecutivo & Respuesta Directa
      </div>
      <div set:html={guia.content.leadHtml} />
    </div>

    <!-- Topic Cluster Bidirectional Interlinking Banner -->
    {guia.slug !== 'mapa-de-medios-argentina' ? (
      <div class="p-5 rounded-2xl border border-sky-200 dark:border-sky-900/60 bg-sky-50/50 dark:bg-sky-950/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-sans shadow-xs">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-sky-500/20 text-sky-700 dark:text-sky-300 uppercase tracking-wider">
              Pilar Editorial
            </span>
            <strong class="font-semibold text-slate-900 dark:text-white text-sm">Esta investigación forma parte del Mapa de Medios de Argentina</strong>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Analizamos la estructura accionaria, grupos económicos y auditoría de sesgo de las 31 redacciones monitoreadas en tiempo real.
          </p>
        </div>
        <a 
          href="/guias/mapa-de-medios-argentina" 
          class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-950 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-200 text-white dark:text-slate-950 font-mono text-xs font-bold transition shadow-xs"
        >
          <span>Ver Mapa General →</span>
        </a>
      </div>
    ) : (
      <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#0F1420] space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Monografías Corporativas Detalladas
          </span>
          <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-semibold">
            Series Especiales
          </span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400">
          Profundizá en la composición accionaria, historia empresarial y línea editorial de cada conglomerado:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-1 font-mono text-xs">
          <a href="/guias/quien-es-el-dueno-de-clarin" class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-sky-500 dark:hover:border-sky-500 transition group block">
            <div class="font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400">Grupo Clarín →</div>
            <div class="text-[11px] text-slate-500 font-sans mt-0.5">Clarín, TN, Telecom, Radio Mitre</div>
          </a>
          <a href="/guias/quien-es-el-dueno-de-la-nacion" class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-sky-500 dark:hover:border-sky-500 transition group block">
            <div class="font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400">S.A. La Nación →</div>
            <div class="text-[11px] text-slate-500 font-sans mt-0.5">La Nación, LN+, Familia Saguier</div>
          </a>
          <a href="/guias/quien-es-el-dueno-de-infobae" class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-sky-500 dark:hover:border-sky-500 transition group block">
            <div class="font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400">TXH / Infobae →</div>
            <div class="text-[11px] text-slate-500 font-sans mt-0.5">Infobae Panregional, Daniel Hadad</div>
          </a>
          <a href="/guias/quien-es-el-dueno-de-ambito-financiero" class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-sky-500 dark:hover:border-sky-500 transition group block">
            <div class="font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400">Grupo Indalo →</div>
            <div class="text-[11px] text-slate-500 font-sans mt-0.5">Ámbito Financiero, C5N, Radio 10</div>
          </a>
        </div>
      </div>
    )}

    <!-- Main Editorial Article Sections -->
    <div class="space-y-10 text-slate-800 dark:text-slate-200 leading-relaxed font-sans">
      {guia.content.sections.map((section) => (
        <section id={section.id} class="space-y-4 pt-4 border-t border-slate-100 dark:border-slate-800/80">
          <h2 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white tracking-tight">
            {section.title}
          </h2>
          <div class="space-y-4 text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed" set:html={section.bodyHtml} />
        </section>
      ))}
    </div>

    <!-- Live Contrast Civic Callout -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-gradient-to-br from-slate-50 to-white dark:from-[#0F1420] dark:to-[#0A0E17] p-6 sm:p-8 space-y-4 shadow-xs">
      <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-slate-900 dark:text-white">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        <span>Compará las noticias de hoy en tiempo real</span>
      </div>
      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        En Politicheck podés auditar en este mismo instante cómo titula {guia.outletName || 'este medio'} cada noticia relevante frente a más de 30 redacciones con una barra de espectro editorial tripartito en tiempo real.
      </p>
      <div>
        <a 
          href="/" 
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-950 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-950 font-mono text-xs font-bold transition-all shadow-xs"
        >
          <span>Ir a la Portada de Politicheck</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- FAQ Accordion Section (Minimalist UI) -->
    {guia.faq.length > 0 && (
      <section class="space-y-6 pt-6 border-t border-slate-200 dark:border-slate-800">
        <div class="space-y-1">
          <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 font-bold">
            Preguntas Frecuentes
          </div>
          <h3 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white">
            {guia.faqTitle || `Dudas Habituales sobre ${guia.outletName || guia.title}`}
          </h3>
        </div>

        <div class="divide-y divide-slate-200 dark:divide-slate-800" id="faq-accordion">
          {guia.faq.map((item, idx) => (
            <div class="py-4 space-y-2 faq-item">
              <button 
                type="button" 
                class="faq-toggle w-full flex items-center justify-between text-left gap-4 font-editorial text-lg font-bold text-slate-950 dark:text-white hover:text-blue-900 dark:hover:text-blue-300 transition-colors cursor-pointer"
                aria-expanded={idx === 0 ? "true" : "false"}
              >
                <span>{item.question}</span>
                <span class="faq-icon font-mono text-lg font-light text-slate-400 shrink-0">
                  {idx === 0 ? "−" : "+"}
                </span>
              </button>
              <div class={`faq-answer text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-sans pt-1 ${idx === 0 ? "block" : "hidden"}`}>
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Sources & Citations Footer Strip -->
    <footer class="pt-6 border-t border-slate-200 dark:border-slate-800 text-xs font-mono text-slate-500 dark:text-slate-400 space-y-2">
      <div class="font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Fuentes consultadas y metodología:</div>
      <ul class="list-disc pl-5 space-y-1">
        {guia.sources.map((src) => (
          <li>{src}</li>
        ))}
      </ul>
      <p class="pt-2">
        Investigación elaborada conforme al Art. 10 de la Ley 11.723 de Propiedad Intelectual con fines educativos, cívicos y de auditoría pública.
      </p>
    </footer>

  </article>
</Layout>

<script>
  function setupFaqAccordion() {
    const toggles = document.querySelectorAll('.faq-toggle');
    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const item = toggle.closest('.faq-item');
        if (!item) return;
        const answer = item.querySelector('.faq-answer');
        const icon = item.querySelector('.faq-icon');
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          toggle.setAttribute('aria-expanded', 'false');
          answer?.classList.add('hidden');
          if (icon) icon.textContent = '+';
        } else {
          toggle.setAttribute('aria-expanded', 'true');
          answer?.classList.remove('hidden');
          if (icon) icon.textContent = '−';
        }
      });
    });
  }

  function setupCopyButton() {
    const copyBtn = document.getElementById('copy-guia-btn');
    const copyText = document.getElementById('copy-guia-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', () => {
        const url = copyBtn.getAttribute('data-url') || window.location.href;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(() => {
            copyText.textContent = 'Enlace copiado';
            setTimeout(() => {
              copyText.textContent = 'Copiar enlace';
            }, 2500);
          }).catch(() => {
            window.prompt('Copiá este enlace para compartir:', url);
          });
        } else {
          window.prompt('Copiá este enlace para compartir:', url);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupFaqAccordion();
      setupCopyButton();
    });
  } else {
    setupFaqAccordion();
    setupCopyButton();
  }
</script>
