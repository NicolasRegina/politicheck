---
import Layout from '../../layouts/Layout.astro';
import { GUIAS_ARTICLES } from '../../data/guias';

export const prerender = true;

const publishedGuides = GUIAS_ARTICLES.filter(g => g.status === 'publicado');
const upcomingGuides = GUIAS_ARTICLES.filter(g => g.status === 'proximamente');
const heroGuide = publishedGuides[0];
const otherPublishedGuides = publishedGuides.slice(1);
---

<Layout 
  title="Cuadernos de Investigación: Mapa de Medios y Concentración Editorial • Politicheck"
  description="Investigaciones cívicas sobre quiénes son los dueños de los medios en Argentina, cómo se financian los grupos económicos y cómo se audita su sesgo periodístico."
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-12">
    
    <!-- Top Breadcrumb Navigation -->
    <nav class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4 text-xs font-mono">
      <a href="/" class="inline-flex items-center gap-1.5 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors">
        <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Volver a la Portada</span>
      </a>
      <div class="flex items-center gap-2 text-slate-400 dark:text-slate-500">
        <span>Cuadernos Cívicos</span>
        <span aria-hidden="true">|</span>
        <span>Observatorio Politicheck</span>
      </div>
    </nav>

    <!-- Header Hero Section -->
    <header class="space-y-4 max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-900 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-800 text-xs font-sans font-semibold">
        <span>Investigaciones y mapa de medios</span>
      </div>

      <h1 class="font-editorial text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 dark:text-white leading-[1.1] tracking-tight">
        Quién Controla las Noticias en Argentina
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-sans leading-relaxed max-w-3xl">
        Radiografías corporativas, análisis de composición accionaria y auditoría de encuadres periodísticos. Datos oficiales de la CNV, balances bursátiles y estándares internacionales para informarse con sentido crítico.
      </p>
    </header>

    <!-- Filter Pills Toolbar -->
    <section class="flex flex-wrap items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-4 text-xs font-sans" id="guias-filter-nav">
      <span class="text-slate-400 dark:text-slate-500 mr-1 text-xs">Filtrar por:</span>
      <button 
        type="button" 
        class="guia-filter-btn active px-3 py-1.5 rounded-xl border border-slate-900 dark:border-white bg-slate-950 dark:bg-white text-white dark:text-slate-950 font-bold transition-colors cursor-pointer"
        data-filter="all"
      >
        Todas las investigaciones
      </button>
      <button 
        type="button" 
        class="guia-filter-btn px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition-colors cursor-pointer"
        data-filter="propiedad"
      >
        Propiedad y grupos
      </button>
      <button 
        type="button" 
        class="guia-filter-btn px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition-colors cursor-pointer"
        data-filter="metodologia"
      >
        Metodología general
      </button>
    </section>

    <!-- Bento Grid Section -->
    <section class="space-y-8" id="guias-grid">
      <!-- HERO PUBLISHED CARD (Large Presentation) -->
      {heroGuide && (
        <article 
          class="guia-card bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-800/90 rounded-2xl p-6 sm:p-8 hover:border-slate-300 dark:hover:border-slate-700 transition-colors duration-300 shadow-xs flex flex-col lg:flex-row gap-6 sm:gap-8 items-center"
          data-category={heroGuide.category}
        >
          <div class="lg:w-1/2 space-y-4">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-800 text-sky-800 dark:text-sky-300 text-[11px] font-sans font-bold">
                {heroGuide.kicker || heroGuide.categoryLabel}
              </span>
              <span class="font-mono text-[11px] text-slate-500 dark:text-slate-400">{heroGuide.readTimeMinutes} min de lectura</span>
            </div>

            <h2 class="font-editorial text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-950 dark:text-white leading-tight">
              <a href={`/guias/${heroGuide.slug}`} class="hover:text-blue-900 dark:hover:text-blue-300 transition-colors">
                {heroGuide.title}
              </a>
            </h2>

            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed font-sans">
              {heroGuide.subtitle}
            </p>

            <div class="pt-2 flex flex-wrap items-center gap-4">
              <a 
                href={`/guias/${heroGuide.slug}`}
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-950 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-950 font-sans text-xs font-bold transition-colors shadow-xs"
              >
                <span>Leer investigación completa</span>
                <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <span class="text-xs font-mono text-slate-400 dark:text-slate-500">Actualizado: {heroGuide.updatedAt}</span>
            </div>
          </div>

          <!-- Clickable Hero Image -->
          {heroGuide.heroImageUrl && (
            <div class="lg:w-1/2 w-full">
              <a href={`/guias/${heroGuide.slug}`} class="group block relative overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 aspect-video max-h-[320px]">
                <img 
                  src={heroGuide.heroImageUrl} 
                  alt={heroGuide.title} 
                  class="w-full h-full object-cover object-center motion-safe:transition-transform duration-500 motion-safe:group-hover:scale-105"
                  loading="eager"
                />
                <div class="absolute inset-0 bg-slate-950/10 group-hover:bg-transparent transition-colors"></div>
              </a>
            </div>
          )}
        </article>
      )}

      <!-- OTHER PUBLISHED GUIDES GRID -->
      {otherPublishedGuides.length > 0 && (
        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2">
            <h3 class="font-sans text-xs font-bold text-slate-800 dark:text-slate-200">
              Investigaciones publicadas
            </h3>
            <span class="text-[11px] font-mono text-slate-400">{publishedGuides.length} disponibles</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {otherPublishedGuides.map((guide) => (
              <article 
                class="guia-card bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-800/90 rounded-2xl p-6 flex flex-col justify-between space-y-4 transition-colors hover:border-slate-300 dark:hover:border-slate-700 shadow-xs"
                data-category={guide.category}
              >
                <div class="space-y-3">
                  <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800/80 pb-2">
                    <span class="px-2.5 py-0.5 rounded-full bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-800 text-sky-800 dark:text-sky-300 text-[11px] font-sans font-bold">
                      {guide.categoryLabel}
                    </span>
                    <span class="font-mono text-[11px] text-slate-400">{guide.readTimeMinutes} min de lectura</span>
                  </div>

                  {guide.heroImageUrl && (
                    <a href={`/guias/${guide.slug}`} class="group block relative overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 aspect-video max-h-[200px]">
                      <img 
                        src={guide.heroImageUrl} 
                        alt={guide.title} 
                        class="w-full h-full object-cover object-[50%_25%] motion-safe:transition-transform duration-300 motion-safe:group-hover:scale-105"
                        loading="lazy"
                      />
                    </a>
                  )}

                  <h3 class="font-editorial text-xl font-bold text-slate-950 dark:text-white leading-snug">
                    <a href={`/guias/${guide.slug}`} class="hover:text-blue-900 dark:hover:text-blue-300 transition-colors">
                      {guide.title}
                    </a>
                  </h3>

                  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 font-sans leading-relaxed line-clamp-3">
                    {guide.subtitle}
                  </p>
                </div>

                <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
                  <a 
                    href={`/guias/${guide.slug}`}
                    class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-950 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-950 font-sans text-xs font-bold transition-colors shadow-xs"
                  >
                    <span>Leer investigación</span>
                    <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                  <span class="text-xs font-mono text-slate-400">Actualizado: {guide.updatedAt}</span>
                </div>
              </article>
            ))}
          </div>
        </div>
      )}

      <!-- SECONDARY BENTO GRID: Upcoming Cluster Articles -->
      <div>
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2 mb-6">
          <h3 class="font-sans text-xs font-bold text-slate-700 dark:text-slate-300">
            Próximas entregas del observatorio
          </h3>
          <span class="text-[11px] font-sans text-slate-400">Cluster: Mapa de Medios 2026</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {upcomingGuides.map((guide) => (
            <div 
              class="guia-card bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-800/90 rounded-2xl p-5 sm:p-6 flex flex-col justify-between space-y-4 transition-colors hover:border-slate-300 dark:hover:border-slate-700 shadow-xs"
              data-category={guide.category}
            >
              <div class="space-y-3">
                <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800/80 pb-2">
                  <span class="font-sans text-[11px] font-bold text-slate-500 dark:text-slate-400">
                    {guide.kicker}
                  </span>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-50 dark:bg-amber-950/50 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 font-sans text-[10px] font-semibold">
                    En redacción
                  </span>
                </div>

                <h4 class="font-editorial text-lg sm:text-xl font-bold text-slate-950 dark:text-white leading-snug">
                  {guide.title}
                </h4>

                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-sans leading-relaxed line-clamp-3">
                  {guide.subtitle}
                </p>
              </div>

              <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-mono text-slate-400">
                <span>{guide.readTimeMinutes} min est.</span>
                <span class="text-slate-500 dark:text-slate-400 font-medium font-sans">Publicación: {guide.updatedAt}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Institutional Callout Box -->
    <section class="rounded-2xl border border-slate-200 dark:border-slate-800/90 bg-slate-50 dark:bg-rail-dark p-6 sm:p-8 space-y-4">
      <div class="flex items-center gap-2 font-sans text-xs font-bold text-slate-800 dark:text-slate-200">
        <svg aria-hidden="true" class="w-4 h-4 text-slate-600 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Metodología de auditoría cívica</span>
      </div>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-sans leading-relaxed max-w-4xl">
        Politicheck no acepta pauta publicitaria gubernamental ($0 de fondos estatales) ni tiene filiación con partidos políticos. Cada investigación se basa en registros mercantiles, declaraciones públicas ante la CNV, organismos de defensa de la libertad de prensa (MOM / Reporteros Sin Fronteras) y triangulación algorítmica de titulares.
      </p>
      <div class="pt-1">
        <a 
          href="/metodologia" 
          class="inline-flex items-center gap-1.5 text-xs font-sans font-bold text-slate-900 dark:text-white hover:underline underline-offset-4"
        >
          <span>Consultar la Declaración Metodológica Completa de 31 Medios</span>
          <svg aria-hidden="true" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>

  </main>
</Layout>

<script>
  function setupCategoryFilters() {
    const filterButtons = document.querySelectorAll('.guia-filter-btn');
    const cards = document.querySelectorAll('.guia-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-filter');

        filterButtons.forEach((b) => {
          b.classList.remove('active', 'border-slate-900', 'dark:border-white', 'bg-slate-950', 'dark:bg-white', 'text-white', 'dark:text-slate-950', 'font-bold');
          b.classList.add('border-slate-200', 'dark:border-slate-800', 'bg-white', 'dark:bg-slate-900/60', 'text-slate-700', 'dark:text-slate-300', 'font-medium');
        });

        btn.classList.add('active', 'border-slate-900', 'dark:border-white', 'bg-slate-950', 'dark:bg-white', 'text-white', 'dark:text-slate-950', 'font-bold');
        btn.classList.remove('border-slate-200', 'dark:border-slate-800', 'bg-white', 'dark:bg-slate-900/60', 'text-slate-700', 'dark:text-slate-300', 'font-medium');

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (target === 'all' || category === target) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCategoryFilters);
  } else {
    setupCategoryFilters();
  }
</script>
