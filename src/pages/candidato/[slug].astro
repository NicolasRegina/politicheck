---
import Layout from '../../layouts/Layout.astro';
import PromiseCard from '../../components/PromiseCard.astro';
import StoryCard from '../../components/StoryCard.astro';
import { POLITICIANS, getPolitician } from '../../data/politicians';
import { getPromisesWithLiveVotes, getPromisesStats } from '../../services/promises';
import { getNewsClustersFromSupabase } from '../../services/supabase';
import { getCachedClusteredStories } from '../../services/ai/clustering';
import { getLastSyncTimestampAsync } from '../../services/rss/sync';
import type { StoryCluster } from '../../types';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=900');

function normalizeText(value: string): string {
  return value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();
}

function slugifyCandidate(name: string): string {
  return normalizeText(name)
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function getInitials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .map((part) => part[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
}

function escapeRegExp(value: string): string {
  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

const rawSlug = Astro.params.slug || '';
const normalizedSlug = slugifyCandidate(rawSlug);

const [allPromises, cloudClusters, lastSyncIso] = await Promise.all([
  getPromisesWithLiveVotes(),
  getNewsClustersFromSupabase({ maxAgeDays: 14, limit: 45 }).catch(() => null),
  getLastSyncTimestampAsync().catch(() => null),
]);

// Build canonical candidate name lookup from both POLITICIANS registry and promises dataset
const candidateSlugMap = new Map<string, string>();
for (const name of Object.keys(POLITICIANS)) {
  candidateSlugMap.set(slugifyCandidate(name), name);
}
for (const promise of allPromises) {
  const s = slugifyCandidate(promise.candidate);
  if (!candidateSlugMap.has(s)) {
    candidateSlugMap.set(s, promise.candidate);
  }
}

const resolvedName = candidateSlugMap.get(normalizedSlug) || null;
const isFound = Boolean(resolvedName);

if (!isFound) {
  Astro.response.status = 404;
}

const politician = resolvedName ? getPolitician(resolvedName) : null;
const candidatePromises = resolvedName
  ? allPromises.filter((p) => slugifyCandidate(p.candidate) === normalizedSlug)
  : [];
const stats = getPromisesStats(candidatePromises);

// Fetch recent stories (Supabase 14d with fallback to local cached clusters)
let candidateStories: StoryCluster[] = [];
if (resolvedName) {
  const sourceStories: StoryCluster[] =
    Array.isArray(cloudClusters) && cloudClusters.length > 0
      ? (cloudClusters as StoryCluster[])
      : getCachedClusteredStories();

  const normalizedFullName = normalizeText(resolvedName);
  const nameTokens = normalizedFullName.split(/\s+/).filter(Boolean);
  const surname = nameTokens[nameTokens.length - 1] || normalizedFullName;

  const matchPatterns = Array.from(new Set([normalizedFullName, surname]))
    .filter((term) => term.length >= 3)
    .map((term) => new RegExp(`\\b${escapeRegExp(term)}\\b`, 'i'));

  candidateStories = sourceStories
    .filter((story) => {
      const articleTitles = Array.isArray(story.articles)
        ? story.articles.map((a) => a.title || '').join(' ')
        : '';
      const haystack = normalizeText(
        `${story.neutralHeadline || ''} ${story.summary || ''} ${articleTitles}`
      );
      return matchPatterns.some((rx) => rx.test(haystack));
    })
    .slice(0, 6)
    .map((story) => ({ ...story, isLeadStory: false }));
}

const pageTitle = politician
  ? `${politician.name} • Radiografía de Candidato y Promesómetro | Politicheck`
  : 'Candidato no encontrado • Politicheck';

const pageDescription = politician
  ? `Radiografía de ${politician.name} (${politician.coalition}): ${stats.total} promesas de campaña auditadas (${stats.fulfilled} cumplidas, ${stats.inProgress} en progreso, ${stats.paused} en pausa, ${stats.broken} incumplidas) y cobertura mediática reciente.`
  : 'El perfil de candidato solicitado no fue encontrado en el observatorio de Politicheck.';

const canonicalUrl = politician
  ? `https://www.politicheck.com.ar/candidato/${normalizedSlug}`
  : 'https://www.politicheck.com.ar/promesas';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={politician?.avatar || '/images/social/twitter_banner.jpg'}
  serverSyncIso={lastSyncIso}
>
  {isFound && politician ? (
    <div class="space-y-10 pb-12">
      {/* Breadcrumb */}
      <nav class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono border-b border-rule pb-3">
        <a
          href="/promesas"
          class="inline-flex items-center gap-1.5 text-ink-muted hover:text-ink font-semibold transition-colors"
        >
          <span>← Volver al Monitor de Promesas</span>
        </a>
        <span class="text-ink-muted">Radiografía de Candidato</span>
      </nav>

      {/* Candidate Hero Card */}
      <header class="bg-surface border border-rule rounded-md p-5 sm:p-7 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center gap-5">
          {/* Avatar / Initials */}
          <div class="relative shrink-0">
            {politician.avatar ? (
              <img
                src={politician.avatar}
                alt={politician.name}
                width="88"
                height="88"
                class="w-20 h-20 sm:w-22 sm:h-22 rounded-full object-cover border border-rule bg-surface-muted"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
            ) : null}
            <div
              class={`w-20 h-20 sm:w-22 sm:h-22 rounded-full font-mono text-xl font-bold items-center justify-center border ${politician.partyColor.badgeBg} ${politician.avatar ? 'hidden' : 'flex'}`}
            >
              {getInitials(politician.name)}
            </div>
          </div>

          {/* Identity & Role */}
          <div class="flex-1 min-w-0 space-y-2">
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="font-sans text-[11px] font-bold uppercase tracking-wider text-accent">
                Perfil Verificado
              </span>
              <span class="text-rule-strong/30" aria-hidden="true">·</span>
              <span class="font-mono text-[11px] text-ink-muted">
                {politician.role}
              </span>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <h1 class="font-editorial text-3xl sm:text-4xl font-bold text-ink leading-[1.12] tracking-tight">
                {politician.name}
              </h1>
              <span
                class={`inline-flex items-center px-2.5 py-1 rounded-md font-sans text-xs font-semibold border ${politician.partyColor.badgeBg}`}
              >
                {politician.coalition}
              </span>
            </div>

            <p class="text-sm text-ink-secondary font-sans leading-relaxed max-w-2xl">
              Seguimiento documental de compromisos públicos y cobertura periodística comparada de los últimos 14 días.
            </p>
          </div>
        </div>

        {/* Global Promesómetro Scorecard */}
        <div class="pt-5 border-t border-rule space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-sans text-xs font-bold uppercase tracking-wider text-ink-muted">
              Balance del Promesómetro
            </h2>
            {stats.totalCitizenVotes > 0 && (
              <span class="font-mono text-[11px] text-ink-muted tabular-nums">
                {stats.totalCitizenVotes} votos ciudadanos registrados
              </span>
            )}
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
            <div class="p-3.5 rounded-md bg-surface-muted border border-rule">
              <div class="font-mono text-2xl font-bold text-ink tabular-nums">{stats.total}</div>
              <div class="text-[11px] font-sans text-ink-muted">Total auditadas</div>
            </div>
            <div class="p-3.5 rounded-md bg-surface-muted border border-rule">
              <div class="font-mono text-2xl font-bold text-emerald-700 dark:text-emerald-400 tabular-nums">{stats.fulfilled}</div>
              <div class="text-[11px] font-sans text-ink-muted">Cumplidas</div>
            </div>
            <div class="p-3.5 rounded-md bg-surface-muted border border-rule">
              <div class="font-mono text-2xl font-bold text-amber-700 dark:text-amber-400 tabular-nums">{stats.inProgress}</div>
              <div class="text-[11px] font-sans text-ink-muted">En progreso</div>
            </div>
            <div class="p-3.5 rounded-md bg-surface-muted border border-rule">
              <div class="font-mono text-2xl font-bold text-orange-700 dark:text-orange-400 tabular-nums">{stats.paused}</div>
              <div class="text-[11px] font-sans text-ink-muted">En pausa</div>
            </div>
            <div class="p-3.5 rounded-md bg-surface-muted border border-rule col-span-2 sm:col-span-1">
              <div class="font-mono text-2xl font-bold text-rose-700 dark:text-rose-400 tabular-nums">{stats.broken}</div>
              <div class="text-[11px] font-sans text-ink-muted">Incumplidas</div>
            </div>
          </div>
        </div>
      </header>

      {/* Promesas de Campaña Section */}
      <section class="space-y-5" aria-labelledby="candidate-promises-heading">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-rule pb-3">
          <div>
            <span class="font-sans text-[11px] font-bold uppercase tracking-wider text-accent">
              Auditoría Documental
            </span>
            <h2
              id="candidate-promises-heading"
              class="font-editorial text-2xl sm:text-3xl font-bold text-ink leading-[1.12] tracking-tight"
            >
              Promesas de Campaña ({candidatePromises.length})
            </h2>
          </div>

          {candidatePromises.length > 0 && (
            <div class="flex flex-wrap items-center gap-1.5 text-xs font-sans">
              <button
                type="button"
                data-stat="all"
                class="cand-stat-btn px-2.5 py-1 rounded-md border border-rule bg-surface-muted text-ink font-bold ring-2 ring-ink cursor-pointer transition-colors"
              >
                Todas ({stats.total})
              </button>
              <button
                type="button"
                data-stat="cumplida"
                class="cand-stat-btn px-2.5 py-1 rounded-md border border-emerald-300 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 opacity-80 cursor-pointer transition-colors"
              >
                Cumplida ({stats.fulfilled})
              </button>
              <button
                type="button"
                data-stat="en_progreso"
                class="cand-stat-btn px-2.5 py-1 rounded-md border border-amber-300 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 opacity-80 cursor-pointer transition-colors"
              >
                En progreso ({stats.inProgress})
              </button>
              <button
                type="button"
                data-stat="en_pausa"
                class="cand-stat-btn px-2.5 py-1 rounded-md border border-orange-300 dark:border-orange-800 bg-orange-50 dark:bg-orange-950/60 text-orange-800 dark:text-orange-300 opacity-80 cursor-pointer transition-colors"
              >
                En pausa ({stats.paused})
              </button>
              <button
                type="button"
                data-stat="incumplida"
                class="cand-stat-btn px-2.5 py-1 rounded-md border border-rose-300 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 opacity-80 cursor-pointer transition-colors"
              >
                Incumplida ({stats.broken})
              </button>
            </div>
          )}
        </div>

        {candidatePromises.length > 0 ? (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="cand-promises-grid">
              {candidatePromises.map((promise) => (
                <div class="cand-promise-item" data-status={promise.status}>
                  <PromiseCard promise={promise} />
                </div>
              ))}
            </div>

            <div
              id="cand-promises-empty"
              class="hidden p-8 text-center rounded-md bg-surface border border-dashed border-rule space-y-2"
            >
              <p class="font-editorial text-lg font-bold text-ink">
                No hay promesas con este estado para {politician.name}.
              </p>
              <button
                type="button"
                id="cand-promises-reset"
                class="px-3.5 py-1.5 rounded-md bg-ink text-canvas text-xs font-sans font-semibold cursor-pointer"
              >
                Ver todas las promesas
              </button>
            </div>
          </>
        ) : (
          <div class="p-8 text-center rounded-md bg-surface border border-rule space-y-2">
            <p class="font-editorial text-lg font-bold text-ink">
              Aún no hay promesas verificadas cargadas para {politician.name}.
            </p>
            <p class="text-xs sm:text-sm font-sans text-ink-muted max-w-lg mx-auto">
              El equipo editorial incorpora compromisos verificables a medida que cuentan con respaldo documental primario.
            </p>
          </div>
        )}
      </section>

      {/* Cobertura Mediática Reciente Section */}
      <section class="space-y-5" aria-labelledby="candidate-coverage-heading">
        <div class="flex flex-wrap items-end justify-between gap-3 border-b border-rule pb-3">
          <div>
            <span class="font-sans text-[11px] font-bold uppercase tracking-wider text-accent">
              Últimos 14 Días
            </span>
            <h2
              id="candidate-coverage-heading"
              class="font-editorial text-2xl sm:text-3xl font-bold text-ink leading-[1.12] tracking-tight"
            >
              Cobertura Mediática Reciente
            </h2>
          </div>
          <span class="font-mono text-xs text-ink-muted tabular-nums">
            {candidateStories.length} {candidateStories.length === 1 ? 'historia detectada' : 'historias detectadas'}
          </span>
        </div>

        {candidateStories.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {candidateStories.map((story) => (
              <StoryCard story={story} />
            ))}
          </div>
        ) : (
          <div class="p-8 text-center rounded-md bg-surface border border-rule space-y-3">
            <p class="font-editorial text-lg font-bold text-ink">
              Sin cobertura destacada en los últimos 14 días
            </p>
            <p class="text-xs sm:text-sm font-sans text-ink-muted max-w-lg mx-auto">
              No se registraron agrupaciones de noticias recientes que mencionen a {politician.name} en titulares o resúmenes durante las últimas dos semanas.
            </p>
            <div class="pt-1">
              <a
                href="/"
                class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-md bg-surface-muted hover:bg-canvas border border-rule text-xs font-sans font-semibold text-accent transition-colors"
              >
                <span>Explorar temas del día en Portada</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        )}
      </section>
    </div>
  ) : (
    <div class="max-w-xl mx-auto py-12 sm:py-16">
      {/* Clean 404 Fallback Card */}
      <section class="bg-surface border border-rule rounded-md p-6 sm:p-8 text-center space-y-5">
        <div class="inline-flex items-center justify-center px-2.5 py-1 rounded-md bg-surface-muted border border-rule font-mono text-xs font-semibold text-ink-muted">
          Error 404 · Perfil no encontrado
        </div>

        <div class="space-y-2">
          <h1 class="font-editorial text-2xl sm:text-3xl font-bold text-ink leading-[1.12]">
            No encontramos a ese candidato
          </h1>
          <p class="text-sm font-sans text-ink-secondary leading-relaxed">
            El perfil solicitado no coincide con ningún dirigente auditado actualmente en el observatorio de Politicheck.
          </p>
        </div>

        <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/promesas"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md bg-ink text-canvas text-xs font-sans font-semibold hover:opacity-90 transition-opacity"
          >
            <span>← Ir al Monitor de Promesas</span>
          </a>
          <a
            href="/"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md bg-surface-muted border border-rule text-ink text-xs font-sans font-semibold hover:border-ink-muted transition-colors"
          >
            <span>Volver a la Portada</span>
          </a>
        </div>
      </section>
    </div>
  )}
</Layout>

<script>
  // Status filter pills for candidate promises
  const statBtns = document.querySelectorAll<HTMLButtonElement>('.cand-stat-btn');
  const promiseItems = Array.from(document.querySelectorAll<HTMLElement>('.cand-promise-item'));
  const emptyEl = document.getElementById('cand-promises-empty');
  const resetBtn = document.getElementById('cand-promises-reset');

  let activeStat = 'all';

  function applyStatusFilter() {
    let visible = 0;
    promiseItems.forEach((item) => {
      const show = activeStat === 'all' || item.getAttribute('data-status') === activeStat;
      item.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
  }

  statBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeStat = btn.getAttribute('data-stat') || 'all';
      statBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('ring-2', active);
        b.classList.toggle('ring-ink', active);
        b.classList.toggle('font-bold', active);
        b.classList.toggle('opacity-100', active);
        b.classList.toggle('opacity-80', !active);
      });
      applyStatusFilter();
    });
  });

  resetBtn?.addEventListener('click', () => {
    document.querySelector<HTMLButtonElement>('.cand-stat-btn[data-stat="all"]')?.click();
  });

  // Share button hook for PromiseCard
  document.querySelectorAll<HTMLButtonElement>('.share-promise-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const candidate = btn.getAttribute('data-candidate') || 'Promesa de campaña';
      const text = btn.getAttribute('data-text') || '';
      const url = btn.getAttribute('data-url') || window.location.href;
      (window as any).sharePoliticheckContent?.(`Promesómetro: ${candidate}`, text, url, 'Promesómetro');
    });
  });

  // Interactive citizen voting widget (calls /api/promises/vote)
  document.querySelectorAll<HTMLElement>('.citizen-audit-widget').forEach((widget) => {
    const promiseId = widget.getAttribute('data-promise-id');
    if (!promiseId) return;

    function render(votes: { fulfilled: number; inProgress: number; broken: number }, activeVote?: string) {
      const total = (votes.fulfilled || 0) + (votes.inProgress || 0) + (votes.broken || 0);
      const fPct = total > 0 ? Math.round((votes.fulfilled / total) * 100) : 0;
      const ipPct = total > 0 ? Math.round((votes.inProgress / total) * 100) : 0;
      const bPct = total > 0 ? Math.round((votes.broken / total) * 100) : 0;

      const cf = widget.querySelector<HTMLElement>('.count-fulfilled');
      const cip = widget.querySelector<HTMLElement>('.count-in-progress');
      const cb = widget.querySelector<HTMLElement>('.count-broken');
      if (cf) { cf.textContent = `(${fPct}%)`; cf.classList.remove('hidden'); }
      if (cip) { cip.textContent = `(${ipPct}%)`; cip.classList.remove('hidden'); }
      if (cb) { cb.textContent = `(${bPct}%)`; cb.classList.remove('hidden'); }

      const ph = widget.querySelector<HTMLElement>('.bar-placeholder');
      if (ph) ph.style.opacity = '0';
      const bf = widget.querySelector<HTMLElement>('.bar-fulfilled');
      const bip = widget.querySelector<HTMLElement>('.bar-in-progress');
      const bb = widget.querySelector<HTMLElement>('.bar-broken');
      if (bf) { bf.style.width = `${fPct}%`; bf.style.opacity = '1'; }
      if (bip) { bip.style.width = `${ipPct}%`; bip.style.opacity = '1'; }
      if (bb) { bb.style.width = `${bPct}%`; bb.style.opacity = '1'; }

      const sub = widget.querySelector<HTMLElement>('.widget-sub');
      if (sub) sub.textContent = `${total} votos auditados`;

      if (activeVote) {
        widget.querySelectorAll<HTMLButtonElement>('.vote-btn').forEach((b) => {
          b.classList.toggle('ring-2', b.getAttribute('data-vote-type') === activeVote);
          b.classList.toggle('ring-ink', b.getAttribute('data-vote-type') === activeVote);
        });
      }
    }

    const saved = localStorage.getItem(`politicheck_vote_${promiseId}`);
    if (saved) {
      try {
        render(JSON.parse(widget.getAttribute('data-votes') || '{}'), saved);
      } catch {}
    }

    widget.querySelectorAll<HTMLButtonElement>('.vote-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const voteType = btn.getAttribute('data-vote-type') as 'fulfilled' | 'inProgress' | 'broken';
        if (!voteType || localStorage.getItem(`politicheck_vote_${promiseId}`) === voteType) return;
        try {
          const res = await fetch('/api/promises/vote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ promiseId, voteType })
          });
          if (res.ok) {
            const data = await res.json();
            if (data.success && data.promise?.votes) {
              localStorage.setItem(`politicheck_vote_${promiseId}`, voteType);
              widget.setAttribute('data-votes', JSON.stringify(data.promise.votes));
              render(data.promise.votes, voteType);
              (window as any).showPoliticheckToast?.('¡Voto registrado!', 'Ya podés ver la tendencia ciudadana en vivo.', 'check');
            }
          }
        } catch {}
      });
    });
  });
</script>
