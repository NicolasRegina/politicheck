---
import Layout from '../layouts/Layout.astro';
import StoryCard from '../components/StoryCard.astro';
import LiveFeedItem from '../components/LiveFeedItem.astro';
import PromiseCard from '../components/PromiseCard.astro';
import AdBanner from '../components/AdBanner.astro';
import { getCachedArticlesAsync, getCachedForeignArticlesAsync, getLastSyncTimestampAsync } from '../services/rss/sync';
import { 
  clusterArticlesWithGemini, 
  getCachedClusteredStories,
  clusterForeignArticlesWithGemini,
  getCachedForeignClustersAsync
} from '../services/ai/clustering';
import { getNewsClustersFromSupabase, getActiveCivicBanner } from '../services/supabase';
import { getPromisesWithLiveVotes, getPromisesStats } from '../services/promises';
import { getPolitician } from '../data/politicians';
import { getOptimizedImageUrl } from '../utils/image';
import { isBrazilElectionActive, brazilElectionMetadata, brazilElectionClusters, getLiveBrazilDispatches } from '../data/brasil_election';

export const prerender = false;

// Edge Cache: cache 120s at CDN, serve stale up to 600s while revalidating
Astro.response.headers.set('Cache-Control', 'public, s-maxage=120, stale-while-revalidate=600');

// Parallelize all initial database and cache requests for maximum TTFB speed
const [
  allPromises,
  liveArticles,
  cloudClusters,
  lastSyncIso,
  activeBanner
] = await Promise.all([
  getPromisesWithLiveVotes(),
  getCachedArticlesAsync(),
  getNewsClustersFromSupabase(1440),
  getLastSyncTimestampAsync(),
  getActiveCivicBanner('home_top')
]);

const promisesStats = getPromisesStats(allPromises);
const uniqueCandidates = Array.from(new Set(allPromises.map(p => p.candidate)));
const cachedClusters = getCachedClusteredStories();

// Separate national vs foreign clusters from Supabase
const nationalCloudClusters = cloudClusters ? cloudClusters.filter(c => c.category !== 'Internacional' && !c.kicker?.includes('MIRADA EXTERIOR')) : [];
const foreignCloudClusters = cloudClusters ? cloudClusters.filter(c => c.category === 'Internacional' || c.kicker?.includes('MIRADA EXTERIOR')) : [];

// Trigger background server sync if feeds are older than 15 minutes OR if clusters are older than 60 minutes (self-healing fallback)
const isFeedStale = !lastSyncIso || (Date.now() - new Date(lastSyncIso).getTime() > 15 * 60 * 1000);
const areClustersStale = !nationalCloudClusters.length || (
  cloudClusters && cloudClusters[0]?.updated_at && (Date.now() - new Date(cloudClusters[0].updated_at).getTime() > 60 * 60 * 1000)
);

if (isFeedStale || areClustersStale) {
  const cronSecret = process.env.CRON_SECRET || 'politicheck_cron_dev_secret';
  const syncEndpoint = new URL(`/api/rss/sync?key=${encodeURIComponent(cronSecret)}`, Astro.url.origin).toString();
  fetch(syncEndpoint).catch(() => {});
}

// Check if national cloud clusters contain fresh stories from today (< 12 hours)
const newestCloudTimestamp = nationalCloudClusters.length > 0
  ? Math.max(
      nationalCloudClusters[0].timestamp || 0,
      new Date(nationalCloudClusters[0].updatedAt).getTime() || 0
    )
  : 0;
const areCloudClustersFromToday = newestCloudTimestamp > 0 && (Date.now() - newestCloudTimestamp < 12 * 60 * 60 * 1000);

let dynamicStories: any[] = [];
if (areCloudClustersFromToday && nationalCloudClusters.length >= 3) {
  dynamicStories = nationalCloudClusters;
} else if (liveArticles.length > 0) {
  try {
    const freshlyClustered = await clusterArticlesWithGemini(liveArticles, import.meta.env.GEMINI_API_KEY);
    if (freshlyClustered.length > 0) {
      // Merge freshly clustered with existing historical clusters
      const seenIds = new Set(freshlyClustered.map(s => s.id));
      const historicalRest = nationalCloudClusters.filter(c => !seenIds.has(c.id));
      dynamicStories = [...freshlyClustered, ...historicalRest];
    } else {
      dynamicStories = nationalCloudClusters.length > 0 ? nationalCloudClusters : cachedClusters;
    }
  } catch {
    dynamicStories = nationalCloudClusters.length > 0 ? nationalCloudClusters : cachedClusters;
  }
} else {
  dynamicStories = nationalCloudClusters.length > 0 ? nationalCloudClusters : (cloudClusters || cachedClusters);
}

// Compute editorial score on storiesToDisplay to ensure the most relevant news of today leads
const { computeClusterEditorialScore } = await import('../services/supabase');
dynamicStories.sort((a, b) => {
  const scoreA = computeClusterEditorialScore(a);
  const scoreB = computeClusterEditorialScore(b);
  if (scoreA !== scoreB) return scoreB - scoreA;
  const timeA = a.timestamp || new Date(a.updatedAt).getTime() || 0;
  const timeB = b.timestamp || new Date(b.updatedAt).getTime() || 0;
  return timeB - timeA;
});

if (dynamicStories.length > 0) {
  dynamicStories.forEach((s, idx) => {
    s.isLeadStory = (idx === 0);
  });
}

const storiesToDisplay = dynamicStories;

// Dynamic Foreign Stories & Full Live Foreign Articles for "La Mirada Exterior"
const liveForeignArticles = await getCachedForeignArticlesAsync();
const cachedForeignClusters = await getCachedForeignClustersAsync();
const dynamicForeignStories = (foreignCloudClusters.length > 0)
  ? foreignCloudClusters
  : (cachedForeignClusters.length > 0
    ? cachedForeignClusters
    : (liveForeignArticles.length > 0
      ? await clusterForeignArticlesWithGemini(liveForeignArticles, import.meta.env.GEMINI_API_KEY)
      : []));

dynamicForeignStories.sort((a, b) => {
  const scoreA = computeClusterEditorialScore(a);
  const scoreB = computeClusterEditorialScore(b);
  if (scoreA !== scoreB) return scoreB - scoreA;
  return (b.timestamp || 0) - (a.timestamp || 0);
});
if (dynamicForeignStories.length > 0) {
  dynamicForeignStories.forEach((s, idx) => {
    s.isLeadStory = (idx === 0);
  });
}

const foreignStoriesToDisplay = dynamicForeignStories;

// Sort live foreign articles chronologically descending
const sortedForeignArticles = [...liveForeignArticles].sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));

const leadStory = storiesToDisplay[0];
const leadStoryPreload = leadStory?.imageUrl ? getOptimizedImageUrl(leadStory.imageUrl, 800, 75) : undefined;
const leadStoryPreloadMobile = leadStory?.imageUrl ? getOptimizedImageUrl(leadStory.imageUrl, 480, 70) : undefined;
const secondaryStories = storiesToDisplay.slice(1);
const liveRailArticles = liveArticles.slice(0, 6);
const fullLiveFeedArticles = liveArticles.slice(0, 60);
const liveBrazilDispatches = getLiveBrazilDispatches(liveArticles).slice(0, 9);

---

<Layout 
  title="Politicheck • Noticias de Política Argentina, Sesgo de Medios y Elecciones 2027"
  description="Observatorio de política argentina y cobertura periodística. Compará el sesgo mediático de 31 redacciones en tiempo real y auditá las promesas de campaña camino a las Elecciones 2027."
  preloadImage={leadStoryPreload} 
  preloadImageMobile={leadStoryPreloadMobile}
  stories={storiesToDisplay} 
  serverSyncIso={lastSyncIso}
>
  <!-- VIEW 1: Tapa del Periódico (Lead story + live rail + secondary bento grid) -->
  <div id="view-temas-del-dia" class="view-content space-y-10">
    <!-- SECTION 1: Grand Apertura & Wire Rail (8 cols / 4 cols) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: The Grand Lead Story (Apertura de Portada) -->
      <div class="lg:col-span-8 space-y-4">
        <div id="grand-opening-header" class="flex items-center justify-between text-xs font-sans text-slate-500 dark:text-slate-400 mb-1 border-b border-slate-200 dark:border-slate-800 pb-2">
          <span class="flex items-center gap-2">
            <span class="font-bold text-slate-900 dark:text-slate-100 text-xs">Gran apertura de tapa</span>
          </span>
          <span class="hidden sm:inline">Contraste simultáneo de redacciones</span>
        </div>

        <!-- Filter Status Banner (Shown when a category is selected) -->
        <div id="filter-status-banner" class="hidden p-3.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-sans text-slate-700 dark:text-slate-300 items-center justify-between">
          <div class="flex items-center gap-2">
            <span>Filtro por sección: <strong id="filter-status-text" class="text-slate-950 dark:text-white font-bold"></strong></span>
          </div>
          <button type="button" id="clear-filter-btn" class="text-slate-500 hover:text-slate-900 dark:hover:text-white underline underline-offset-2 cursor-pointer">
            Ver todas las secciones
          </button>
        </div>

        <!-- News Search Feedback Banner -->
        <div id="news-search-banner" class="hidden p-3.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-sans text-slate-700 dark:text-slate-300 items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 motion-safe:animate-pulse" aria-hidden="true"></span>
            <span id="news-search-text"></span>
          </div>
          <button type="button" id="clear-search-btn" class="text-slate-500 hover:text-slate-900 dark:hover:text-white underline underline-offset-2 cursor-pointer font-bold">
            Limpiar búsqueda
          </button>
        </div>

        <!-- News Empty State -->
        <div id="news-empty-state" class="hidden p-8 text-center rounded-2xl bg-white dark:bg-slate-900/60 border border-dashed border-slate-300 dark:border-slate-800 space-y-3">
          <p class="font-editorial text-lg font-bold text-slate-950 dark:text-white">
            No se encontraron noticias que coincidan con tu búsqueda.
          </p>
          <p class="text-xs font-sans text-slate-500 dark:text-slate-400 max-w-md mx-auto">
            Probá buscando términos clave como "dólar", "inflación", "Milei", "Kicillof", "justicia" o "universidad".
          </p>
          <div class="pt-2 flex flex-wrap items-center justify-center gap-2">
            <button 
              type="button" 
              id="reset-search-btn"
              class="px-3.5 py-1.5 rounded-lg bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 font-sans text-xs font-bold transition-opacity cursor-pointer hover:opacity-90"
            >
              Ver todas las noticias
            </button>
          </div>
        </div>

        <div id="lead-story-slot" class="w-full">
          {leadStory ? (
            <div id="grand-opening-card-wrapper" class="story-item" data-category={leadStory.category} data-text={`${leadStory.neutralHeadline} ${leadStory.summary} ${leadStory.articles.map((a: any) => a.title + ' ' + a.outletName).join(' ')}`}>
              <StoryCard story={leadStory} />
            </div>
          ) : (
            <div class="p-8 text-center rounded-2xl bg-white dark:bg-slate-900/60 border border-dashed border-slate-300 dark:border-slate-800 text-xs font-sans text-slate-500">
              Sincronizando flujo de noticias oficiales...
            </div>
          )}
        </div>
      </div>

      <!-- Right Column: Noticias de Último Momento (The Live Wire Rail) -->
      <aside class="lg:col-span-4 space-y-4 bg-slate-50/70 dark:bg-rail-dark border border-slate-200 dark:border-slate-800/80 rounded-2xl p-4 sm:p-5">
        <div class="flex items-center justify-between text-xs font-sans border-b border-slate-200 dark:border-slate-800 pb-3">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600 dark:bg-emerald-500"></span>
              </span>
              <span class="font-bold text-slate-900 dark:text-white text-xs">
              Minuto a minuto
              </span>
            </div>
          <span class="text-[11px] text-slate-500 dark:text-slate-400">Feeds oficiales RSS</span>
        </div>

        <!-- Wire Items List -->
        <div class="space-y-3" id="wire-rail-list">
          {liveRailArticles.map((article) => (
            <div class="live-item" data-text={`${article.title} ${article.snippet} ${article.outletName}`}>
              <LiveFeedItem article={article} />
            </div>
          ))}
        </div>

        <!-- Link to view full wire -->
        <div class="pt-2 text-center">
          <button 
            type="button" 
            onclick="document.querySelector('[data-tab=ultimo-momento]')?.click()"
            class="w-full py-2 px-3 rounded-xl bg-white hover:bg-slate-100 dark:bg-slate-900 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 text-xs font-sans text-slate-700 dark:text-slate-300 font-semibold transition-colors cursor-pointer inline-flex items-center justify-center gap-1.5"
          >
            <span>Ver todas las noticias en vivo</span>
            <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </button>
        </div>
      </aside>
    </section>

    <!-- Civic Sponsor Banner Placement (Rendered conditionally if active) -->
    <AdBanner banner={activeBanner} />

    <!-- SECTION 2: Segundas Aperturas (3-Column Bento Grid) -->
    <section id="secondary-stories-section" class="space-y-4 pt-4 border-t-2 border-slate-900 dark:border-slate-100">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-2">
        <h3 id="secondary-stories-heading" class="font-editorial text-xl sm:text-2xl font-bold text-slate-950 dark:text-white tracking-tight">
          Temas destacados en portada
        </h3>
        <span class="text-xs font-sans text-slate-500 dark:text-slate-400">
          Enfoques cruzados por redacción
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch" id="secondary-stories-grid">
        {secondaryStories.map((story) => (
          <div class="story-item h-full flex flex-col" data-category={story.category} data-text={`${story.neutralHeadline} ${story.summary} ${story.articles.map((a: any) => a.title + ' ' + a.outletName).join(' ')}`}>
            <StoryCard story={story} />
          </div>
        ))}
      </div>

      <!-- Historical Stories Pagination Toolbar -->
      <div id="stories-pagination" class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-slate-200 dark:border-slate-800 text-xs font-mono">
        <div class="text-slate-500 dark:text-slate-400 font-sans" id="pagination-info">
          Mostrando <span id="pagination-range" class="font-bold text-slate-800 dark:text-slate-200 font-mono">1-{Math.min(6, secondaryStories.length)}</span> de <span id="pagination-total" class="font-bold text-slate-800 dark:text-slate-200 font-mono">{secondaryStories.length}</span> historias
        </div>
        <div class="flex items-center gap-2 font-sans" id="pagination-controls">
          <button 
            type="button" 
            id="pagination-prev-btn" 
            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-30 disabled:pointer-events-none transition-colors cursor-pointer"
            disabled
          >
            <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            <span>Anterior</span>
          </button>
          <div id="pagination-pages" class="flex items-center gap-1"></div>
          <button 
            type="button" 
            id="pagination-next-btn" 
            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-30 disabled:pointer-events-none transition-colors cursor-pointer"
          >
            <span>Siguiente</span>
            <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- SECTION 3.5: Observatorio Cívico: Política Argentina, Medios & Elecciones 2027 -->
    <section class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-800/90 rounded-2xl p-6 sm:p-8 space-y-6 shadow-2xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800/80 pb-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-sans font-semibold text-slate-500 dark:text-slate-400">
              Observatorio electoral y prensa
            </span>
          </div>
          <h2 class="font-editorial text-xl sm:text-2xl font-bold text-slate-950 dark:text-white">
            Política Argentina, Encuadres Periodísticos y Elecciones 2027
          </h2>
        </div>
        <div class="flex items-center gap-2 text-xs font-sans text-slate-500">
          <span>Camino a las Elecciones Presidenciales 2027</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-slate-600 dark:text-slate-400 font-sans leading-relaxed">
        <div class="space-y-2 p-4 rounded-xl bg-slate-50/70 dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-slate-900 dark:text-slate-100 font-sans font-bold text-xs">
              <svg aria-hidden="true" class="w-4 h-4 text-slate-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>
              <span>Sesgo y cobertura política</span>
            </div>
            <p>
              Monitoreamos en simultáneo 31 redacciones argentinas e internacionales (Clarín, La Nación, Infobae, Página 12, TN, Ámbito, Perfil y cables globales). Nuestro algoritmo neutraliza adjetivaciones partidarias y calcula la distribución del espectro editorial fáctico en tiempo real.
            </p>
          </div>
          <a href="/metodologia" class="inline-flex items-center gap-1.5 font-sans text-xs font-semibold text-slate-900 dark:text-slate-200 hover:underline pt-2">
            <span>Conocé la fórmula matemática</span>
            <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        </div>

        <div class="space-y-2 p-4 rounded-xl bg-slate-50/70 dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-slate-900 dark:text-slate-100 font-sans font-bold text-xs">
              <svg aria-hidden="true" class="w-4 h-4 text-slate-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span>Auditoría de elecciones 2027</span>
            </div>
            <p>
              Rumbo a los comicios presidenciales de 2027, auditamos de forma rigurosa las promesas de campaña de Javier Milei, Axel Kicillof, Victoria Villarruel, Mauricio Macri, Patricia Bullrich y los principales referentes, contrastando cada anuncio con pruebas oficiales del Boletín Oficial e INDEC.
            </p>
          </div>
          <button type="button" onclick="document.querySelector('[data-tab=\'promesas\']')?.click(); window.scrollTo({top: 0, behavior: 'smooth'});" class="inline-flex items-center gap-1.5 font-sans text-xs font-semibold text-slate-900 dark:text-slate-200 hover:underline pt-2 cursor-pointer text-left">
            <span>Explorar promesas auditadas ({promisesStats.total})</span>
            <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </button>
        </div>

        <div class="space-y-2 p-4 rounded-xl bg-slate-50/70 dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-slate-900 dark:text-slate-100 font-sans font-bold text-xs">
              <svg aria-hidden="true" class="w-4 h-4 text-slate-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
              <span>Quién es quién en los medios</span>
            </div>
            <p>
              Investigamos la estructura corporativa, líneas de financiamiento e intereses de los conglomerados mediáticos que moldean la opinión pública argentina: Grupo Clarín, Grupo América, Grupo Indalo, Grupo Octubre, La Nación S.A. y Editorial Perfil.
            </p>
          </div>
          <a href="/guias/mapa-de-medios-argentina" class="inline-flex items-center gap-1.5 font-sans text-xs font-semibold text-slate-900 dark:text-slate-200 hover:underline pt-2">
            <span>Ver mapa integral de medios</span>
            <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 4: Metodología, Independencia y Fuentes RSS -->
    <section id="metodologia" class="bg-slate-50 dark:bg-surface-dark border border-slate-200 dark:border-slate-800/90 rounded-2xl p-6 sm:p-8 space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
        <div class="flex items-center gap-2 text-xs font-sans font-bold text-slate-800 dark:text-slate-200">
          <svg aria-hidden="true" class="w-4 h-4 text-slate-600 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Declaración de independencia y metodología de auditoría</span>
        </div>
        <a 
          href="/metodologia" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900 text-xs font-sans font-bold hover:opacity-90 transition-opacity self-start sm:self-auto shadow-sm"
        >
          <span>Ver metodología completa y 31 medios</span>
          <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
