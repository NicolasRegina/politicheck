---
import Layout from '../layouts/Layout.astro';
import StoryCard from '../components/StoryCard.astro';
import LiveFeedItem from '../components/LiveFeedItem.astro';
import { MOCK_STORIES, MOCK_LIVE_FEED, MOCK_FOREIGN_STORIES } from '../data/mockData';
---

<Layout>
  <!-- Hero / Dashboard Bar -->
  <section class="mb-8 space-y-4">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200 dark:border-slate-800/80 pb-6">
      <div class="space-y-1.5">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[11px] font-mono text-slate-700 dark:text-slate-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>Ciclo Electoral Argentina 2026/2027</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Comparador de Cobertura y Sesgos Mediáticos
        </h1>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
          Descubrí cómo cubren la misma noticia los diferentes medios del país. Contrastá titulares, encuadres y porcentajes de atención sin intermediarios partidarios.
        </p>
      </div>

      <!-- Live metrics pill -->
      <div class="flex items-center gap-3 bg-white dark:bg-slate-900/90 p-3 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm text-xs font-mono">
        <div class="text-right">
          <div class="text-slate-900 dark:text-slate-200 font-bold">9 MEDIOS</div>
          <div class="text-[10px] text-slate-500 dark:text-slate-400">SINCRONIZADOS</div>
        </div>
        <div class="h-6 w-px bg-slate-200 dark:bg-slate-800"></div>
        <div>
          <div class="text-emerald-600 dark:text-emerald-400 font-bold">100% RSS</div>
          <div class="text-[10px] text-slate-500 dark:text-slate-400">FUENTES OFICIALES</div>
        </div>
      </div>
    </div>

    <!-- Interactive Filters & Search Row -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-1">
      <!-- Category filters -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 text-xs font-mono" id="category-filters">
        <button class="cat-btn active px-3 py-1.5 rounded-lg bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-950 font-bold transition-colors cursor-pointer" data-cat="all">
          Todos
        </button>
        <button class="cat-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-cat="Economía">
          Economía
        </button>
        <button class="cat-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-cat="Política">
          Política
        </button>
        <button class="cat-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-cat="Justicia">
          Justicia
        </button>
      </div>

      <!-- Quick Search input -->
      <div class="relative w-full sm:w-72">
        <input 
          type="text" 
          id="search-input"
          placeholder="Buscar por tema, titular o medio..." 
          class="w-full bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-xl px-3.5 py-1.5 text-xs text-slate-900 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:border-slate-400 dark:focus:border-slate-500 shadow-sm transition-colors font-sans"
        />
        <svg class="w-3.5 h-3.5 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
  </section>

  <!-- VIEW 1: Temas del Día (Stories clustered with spectrum) -->
  <section id="view-temas-del-dia" class="view-content space-y-6">
    <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-slate-400 mb-2">
      <span class="flex items-center gap-2">
        <span>HISTORIAS DESTACADAS DEL DÍA</span>
        <span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-[10px] text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">AGRUPADAS POR HECHO</span>
      </span>
      <span>Actualizado automáticamente</span>
    </div>

    <div class="grid grid-cols-1 gap-6" id="stories-grid">
      {MOCK_STORIES.map((story) => (
        <div class="story-item" data-category={story.category} data-text={`${story.neutralHeadline} ${story.summary} ${story.articles.map(a => a.title + ' ' + a.outletName).join(' ')}`}>
          <StoryCard story={story} />
        </div>
      ))}
    </div>
  </section>

  <!-- VIEW 2: Último Momento (Chronological live feed) -->
  <section id="view-ultimo-momento" class="view-content space-y-4 hidden">
    <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-slate-400 mb-2">
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>FEED DE CABLES EN VIVO</span>
      </span>
      <span>Orden cronológico</span>
    </div>

    <div class="grid grid-cols-1 gap-3" id="live-feed-list">
      {MOCK_LIVE_FEED.map((article) => (
        <div class="live-item" data-text={`${article.title} ${article.snippet} ${article.outletName}`}>
          <LiveFeedItem article={article} />
        </div>
      ))}
    </div>
  </section>

  <!-- VIEW 3: Mirada Exterior (International coverage) -->
  <section id="view-mirada-exterior" class="view-content space-y-6 hidden">
    <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-slate-400 mb-2">
      <span class="flex items-center gap-2">
        <span>PRENSA INTERNACIONAL SOBRE ARGENTINA</span>
        <span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-[10px] text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">LA MIRADA DE AFUERA</span>
      </span>
      <span>Financial Times • El País • CNN</span>
    </div>

    <div class="grid grid-cols-1 gap-6" id="foreign-grid">
      {MOCK_FOREIGN_STORIES.map((story) => (
        <div class="story-item" data-category="Internacional" data-text={`${story.neutralHeadline} ${story.summary} ${story.articles.map(a => a.title + ' ' + a.outletName).join(' ')}`}>
          <StoryCard story={story} />
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  // Client-side Tab Switcher
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const viewSections = document.querySelectorAll<HTMLElement>('.view-content');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-tab');
      if (!targetTab) return;

      // Update button styles
      tabButtons.forEach(b => {
        b.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'shadow-sm');
        b.classList.add('text-slate-600', 'dark:text-slate-400');
        const icon = b.querySelector('svg');
        if (icon) {
          icon.classList.remove('text-slate-700', 'dark:text-slate-300');
          icon.classList.add('text-slate-500', 'dark:text-slate-400');
        }
      });
      btn.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'shadow-sm');
      btn.classList.remove('text-slate-600', 'dark:text-slate-400');
      const activeIcon = btn.querySelector('svg');
      if (activeIcon) {
        activeIcon.classList.add('text-slate-700', 'dark:text-slate-300');
        activeIcon.classList.remove('text-slate-500', 'dark:text-slate-400');
      }

      // Update visible view
      viewSections.forEach(view => {
        if (view.id === `view-${targetTab}`) {
          view.classList.remove('hidden');
        } else {
          view.classList.add('hidden');
        }
      });
    });
  });

  // Client-side Category Filter
  const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const storyItems = document.querySelectorAll<HTMLElement>('.story-item');

  catButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const selectedCat = btn.getAttribute('data-cat');
      if (!selectedCat) return;

      catButtons.forEach(b => {
        b.classList.remove('bg-slate-900', 'dark:bg-slate-100', 'text-white', 'dark:text-slate-950', 'font-bold');
        b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.add('bg-slate-900', 'dark:bg-slate-100', 'text-white', 'dark:text-slate-950', 'font-bold');
      btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');

      storyItems.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (selectedCat === 'all' || itemCat === selectedCat) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });

  // Client-side Quick Search Filter
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      const allFilterable = document.querySelectorAll<HTMLElement>('.story-item, .live-item');

      allFilterable.forEach(el => {
        const text = (el.getAttribute('data-text') || '').toLowerCase();
        if (!query || text.includes(query)) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  }
</script>
