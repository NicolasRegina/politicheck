---
import Layout from '../layouts/Layout.astro';
import StoryCard from '../components/StoryCard.astro';
import LiveFeedItem from '../components/LiveFeedItem.astro';
import PromiseCard from '../components/PromiseCard.astro';
import { MOCK_STORIES, MOCK_LIVE_FEED, MOCK_FOREIGN_STORIES } from '../data/mockData';
import { getCachedArticles } from '../services/rss/sync';
import { clusterArticlesWithGemini } from '../services/ai/clustering';
import { getPromises, getPromisesStats } from '../services/promises';

// Fetch live dynamic campaign promises
const allPromises = getPromises();
const promisesStats = getPromisesStats(allPromises);

// Fetch live articles cached from official RSS feeds
const cachedArticles = getCachedArticles();
const liveArticles = cachedArticles.length > 0 ? cachedArticles : MOCK_LIVE_FEED;

// Generate clustered stories dynamically from live articles
const dynamicStories = await clusterArticlesWithGemini(liveArticles, import.meta.env.GEMINI_API_KEY);
const storiesToDisplay = dynamicStories.length > 0 ? dynamicStories : MOCK_STORIES;

const leadStory = storiesToDisplay[0];
const secondaryStories = storiesToDisplay.slice(1);
const liveFeedArticles = liveArticles.slice(0, 20);
---

<Layout>
  <!-- News Search & Category Filter Toolbar -->
  <section class="mb-6 space-y-3">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
      <!-- Category Filter Pills -->
      <div class="flex items-center gap-1.5 overflow-x-auto text-xs font-mono py-1" id="category-filters">
        <button class="cat-btn active px-3 py-1.5 rounded-lg bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-950 font-bold transition-colors cursor-pointer" data-cat="all">
          Todos los Temas
        </button>
        <button class="cat-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-cat="Política">
          Política
        </button>
        <button class="cat-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-cat="Economía">
          Economía
        </button>
        <button class="cat-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-cat="Sociedad">
          Sociedad
        </button>
        <button class="cat-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-cat="Internacional">
          Mirada Exterior
        </button>
      </div>

      <!-- Quick Search input -->
      <div class="relative w-full sm:w-80">
        <input 
          type="text" 
          id="search-input"
          placeholder="Buscar tema, titular, funcionario o medio..." 
          class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl px-3.5 py-1.5 text-xs text-slate-900 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:border-slate-400 dark:focus:border-slate-500 shadow-xs transition-colors font-sans"
        />
        <svg class="w-3.5 h-3.5 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
  </section>

  <!-- VIEW 1: Tapa del Periódico (Lead story + live rail + secondary bento grid) -->
  <div id="view-temas-del-dia" class="view-content space-y-10">
    <!-- SECTION 1: Grand Apertura & Wire Rail (8 cols / 4 cols) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: The Grand Lead Story (Apertura de Portada) -->
      <div class="lg:col-span-8 space-y-4">
        <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-slate-400 mb-1 border-b border-slate-200 dark:border-slate-800 pb-2">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-slate-900 dark:bg-slate-100"></span>
            <span class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-widest text-[11px]">Gran Apertura de Tapa</span>
          </span>
          <span class="hidden sm:inline">Contraste simultáneo de redacciones</span>
        </div>

        <!-- Filter Status Banner (Shown when a category is selected) -->
        <div id="filter-status-banner" class="hidden p-3.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-mono text-slate-700 dark:text-slate-300 items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-slate-900 dark:bg-slate-100"></span>
            <span>Filtro por sección: <strong id="filter-status-text" class="text-slate-950 dark:text-white uppercase font-bold"></strong></span>
          </div>
          <button type="button" id="clear-filter-btn" class="text-slate-500 hover:text-slate-900 dark:hover:text-white underline underline-offset-2 cursor-pointer">
            Ver todas las secciones
          </button>
        </div>

        <div class="story-item" data-category={leadStory.category} data-text={`${leadStory.neutralHeadline} ${leadStory.summary} ${leadStory.articles.map(a => a.title + ' ' + a.outletName).join(' ')}`}>
          <StoryCard story={leadStory} />
        </div>
      </div>

      <!-- Right Column: Noticias de Último Momento (The Live Wire Rail) -->
      <aside class="lg:col-span-4 space-y-4 bg-slate-50/70 dark:bg-[#0C101A] border border-slate-200 dark:border-slate-800/80 rounded-2xl p-4 sm:p-5">
        <div class="flex items-center justify-between text-xs font-mono border-b border-slate-200 dark:border-slate-800 pb-3">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600 dark:bg-emerald-500"></span>
            </span>
            <span class="font-bold text-slate-900 dark:text-white uppercase tracking-wider text-[11px]">
              Minuto a Minuto
            </span>
          </div>
          <span class="text-[10px] text-slate-500 dark:text-slate-400">Feeds Oficiales RSS</span>
        </div>

        <!-- Wire Items List -->
        <div class="space-y-3" id="wire-rail-list">
          {liveFeedArticles.slice(0, 5).map((article) => (
            <div class="live-item" data-text={`${article.title} ${article.snippet} ${article.outletName}`}>
              <LiveFeedItem article={article} />
            </div>
          ))}
        </div>

        <!-- Link to view full wire -->
        <div class="pt-2 text-center">
          <button 
            type="button" 
            onclick="document.querySelector('[data-tab=ultimo-momento]')?.click()"
            class="w-full py-2 px-3 rounded-xl bg-white hover:bg-slate-100 dark:bg-slate-900 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 text-xs font-mono text-slate-700 dark:text-slate-300 font-semibold transition-colors cursor-pointer"
          >
            Ver todas las noticias en vivo →
          </button>
        </div>
      </aside>
    </section>

    <!-- SECTION 2: Segundas Aperturas (3-Column Bento Grid) -->
    <section class="space-y-4 pt-4 border-t-2 border-slate-900 dark:border-slate-100">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-2">
        <h3 class="font-editorial text-xl sm:text-2xl font-bold text-slate-950 dark:text-white uppercase tracking-tight">
          Temas Destacados en Portada
        </h3>
        <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
          Enfoques cruzados por redacción
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="secondary-stories-grid">
        {secondaryStories.map((story) => (
          <div class="story-item" data-category={story.category} data-text={`${story.neutralHeadline} ${story.summary} ${story.articles.map(a => a.title + ' ' + a.outletName).join(' ')}`}>
            <StoryCard story={story} />
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 3: Monitor de Promesas Electorales 2027 -->
    <section id="monitor-promesas" class="space-y-6 pt-6 border-t border-slate-200 dark:border-slate-800">
      <!-- Section Header & Metrics Dashboard Bento -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-slate-200 dark:border-slate-800 pb-5">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 text-[10px] font-mono font-bold uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Observatorio Cívico Electoral • Politicheck</span>
          </div>
          <h3 class="font-editorial text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-950 dark:text-white tracking-tight">
            Monitor de Promesas de Campaña 2027
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-sans leading-relaxed">
            Auditoría rigurosa y no partidaria de los compromisos asumidos por los principales dirigentes políticos. Cotejamos las declaraciones textuales contra resoluciones oficiales, leyes sancionadas y el termómetro de percepción ciudadana en tiempo real.
          </p>
        </div>

        <!-- Metrics Dashboard Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-center shrink-0">
          <div class="bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl p-3 shadow-2xs">
            <div class="text-[10px] uppercase text-slate-500 dark:text-slate-400">Auditadas</div>
            <div class="text-xl font-bold text-slate-900 dark:text-white">{promisesStats.total}</div>
            <div class="text-[9px] text-slate-400">100% cita oficial</div>
          </div>
          <div class="bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl p-3 shadow-2xs">
            <div class="text-[10px] uppercase text-emerald-700 dark:text-emerald-400">Cumplidas</div>
            <div class="text-xl font-bold text-emerald-700 dark:text-emerald-400">{promisesStats.fulfilledPct}%</div>
            <div class="text-[9px] text-slate-400">{promisesStats.fulfilled} de {promisesStats.total}</div>
          </div>
          <div class="bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl p-3 shadow-2xs">
            <div class="text-[10px] uppercase text-amber-700 dark:text-amber-400">En Progreso</div>
            <div class="text-xl font-bold text-amber-700 dark:text-amber-400">{promisesStats.inProgressPct}%</div>
            <div class="text-[9px] text-slate-400">{promisesStats.inProgress} activas</div>
          </div>
          <div class="bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl p-3 shadow-2xs">
            <div class="text-[10px] uppercase text-sky-700 dark:text-sky-400">Votos Cívicos</div>
            <div class="text-xl font-bold text-sky-700 dark:text-sky-400" id="total-citizen-votes-count">{promisesStats.totalCitizenVotes.toLocaleString('es-AR')}</div>
            <div class="text-[9px] text-slate-400">participación viva</div>
          </div>
        </div>
      </div>

      <!-- Promises Filter & Search Bar -->
      <div class="space-y-3 bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/90 rounded-2xl p-4">
        <!-- Top row: Candidate filter buttons & search -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
          <!-- Candidate Filter Pills -->
          <div class="flex items-center gap-1.5 overflow-x-auto text-xs font-mono py-1" id="candidate-filters">
            <button class="cand-filter-btn active px-3 py-1.5 rounded-lg bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-950 font-bold transition-colors cursor-pointer" data-candidate="all">
              Todos los Dirigentes
            </button>
            <button class="cand-filter-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-candidate="Javier Milei">
              Javier Milei
            </button>
            <button class="cand-filter-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-candidate="Axel Kicillof">
              Axel Kicillof
            </button>
            <button class="cand-filter-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-candidate="Mauricio Macri">
              Mauricio Macri
            </button>
            <button class="cand-filter-btn px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-candidate="Jorge Macri">
              Jorge Macri
            </button>
          </div>

          <!-- Promise Keyword Search -->
          <div class="relative w-full md:w-72">
            <input 
              type="text" 
              id="promise-search-input"
              placeholder="Buscar promesa (ej. inflación, retenciones, coparticipación)..." 
              class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl px-3.5 py-1.5 text-xs text-slate-900 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:border-slate-400 dark:focus:border-slate-500 shadow-2xs transition-colors font-sans"
            />
            <svg class="w-3.5 h-3.5 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>

        <!-- Bottom row: Status filter chips -->
        <div class="flex items-center gap-1.5 overflow-x-auto text-[11px] font-mono pt-1 border-t border-slate-200/60 dark:border-slate-800/60" id="status-filters">
          <span class="text-slate-400 dark:text-slate-500 text-[10px] uppercase tracking-wider mr-1">Filtrar por estado:</span>
          <button class="stat-filter-btn active px-2.5 py-1 rounded-md bg-slate-200 dark:bg-slate-800 text-slate-900 dark:text-white font-bold transition-colors cursor-pointer" data-status="all">
            Todos ({promisesStats.total})
          </button>
          <button class="stat-filter-btn px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-status="cumplida">
            Cumplidas ({promisesStats.fulfilled})
          </button>
          <button class="stat-filter-btn px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-status="en_progreso">
            En progreso ({promisesStats.inProgress})
          </button>
          <button class="stat-filter-btn px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-status="en_pausa">
            En pausa ({promisesStats.paused})
          </button>
          <button class="stat-filter-btn px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer" data-status="incumplida">
            Incumplidas ({promisesStats.broken})
          </button>
        </div>
      </div>

      <!-- Active Promises Filter Banner Indicator -->
      <div id="promises-filter-banner" class="hidden items-center justify-between p-3 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-mono">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-slate-900 dark:bg-white animate-pulse"></span>
          <span>Filtro activo de promesas: <strong id="promises-filter-text"></strong></span>
        </div>
        <button id="clear-promises-filter-btn" class="text-xs font-bold text-slate-900 dark:text-white underline hover:no-underline cursor-pointer">
          Restablecer todas las promesas
        </button>
      </div>

      <!-- Promises Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="promises-container">
        {allPromises.map((promise) => (
          <PromiseCard promise={promise} />
        ))}
      </div>

      <!-- Empty state if no promise matches filter -->
      <div id="promises-empty-state" class="hidden text-center py-12 px-4 rounded-2xl border border-dashed border-slate-300 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40 space-y-3">
        <div class="text-3xl">🔍</div>
        <h4 class="font-editorial text-lg font-bold text-slate-900 dark:text-slate-100">
          No se encontraron promesas para el filtro seleccionado
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 font-sans max-w-md mx-auto">
          Probá seleccionando otro dirigente o limpiando el término de búsqueda para ver los compromisos auditados.
        </p>
      </div>
    </section>

    <!-- SECTION 4: Metodología, Independencia y Fuentes RSS -->
    <section id="metodologia" class="bg-slate-50 dark:bg-[#0D111A] border border-slate-200 dark:border-slate-800/90 rounded-2xl p-6 sm:p-8 space-y-4">
      <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-widest text-slate-800 dark:text-slate-200">
        <svg class="w-4 h-4 text-slate-600 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Declaración de Independencia y Metodología de Auditoría</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-slate-600 dark:text-slate-400 font-sans leading-relaxed">
        <div class="space-y-1.5">
          <h4 class="font-bold text-slate-900 dark:text-slate-100 font-mono text-[11px] uppercase">
            1. Agregación RSS Oficial
          </h4>
          <p>
            No realizamos scraping invasivo ni intervenimos los contenidos. Toda la información proviene de los canales RSS públicos y oficiales sindicados directamente por Clarín, La Nación, Infobae, Ámbito Financiero, Página 12 y El Cronista.
          </p>
        </div>

        <div class="space-y-1.5">
          <h4 class="font-bold text-slate-900 dark:text-slate-100 font-mono text-[11px] uppercase">
            2. Análisis de Encuadres por IA
          </h4>
          <p>
            Los resúmenes de contraste son generados de manera automatizada mediante modelos de lenguaje analizando la selección de adjetivos, omisiones temáticas y encuadre del titular, sin adherencia a ninguna fuerza política partidaria.
          </p>
        </div>

        <div class="space-y-1.5">
          <h4 class="font-bold text-slate-900 dark:text-slate-100 font-mono text-[11px] uppercase">
            3. Neutralidad Cromática
          </h4>
          <p>
            La plataforma utiliza deliberadamente una paleta monocromática estricta (Zinc & Carbón) para no inducir afinidades con las identidades partidarias de la República Argentina (celeste, amarillo, violeta o rojo).
          </p>
        </div>
      </div>
    </section>
  </div>

  <!-- VIEW 2: Último Momento (Chronological full wire feed) -->
  <div id="view-ultimo-momento" class="view-content space-y-6 hidden">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Noticias de Redacción en Vivo</span>
        </div>
        <h2 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white">
          Minuto a Minuto: Flujo Cronológico de Noticias
        </h2>
      </div>
      <span class="text-xs font-mono text-slate-500 dark:text-slate-400">Sincronización en tiempo real</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="live-feed-full-list">
      {liveFeedArticles.map((article) => (
        <div class="live-item" data-text={`${article.title} ${article.snippet} ${article.outletName}`}>
          <LiveFeedItem article={article} />
        </div>
      ))}
    </div>
  </div>

  <!-- VIEW 3: Mirada Exterior (International coverage) -->
  <div id="view-mirada-exterior" class="view-content space-y-6 hidden">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400">
          <span class="w-2 h-2 rounded-full bg-slate-900 dark:bg-slate-100"></span>
          <span class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Prensa Internacional</span>
        </div>
        <h2 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white">
          La Mirada de Afuera: Argentina en los Medios del Mundo
        </h2>
      </div>
      <span class="text-xs font-mono text-slate-500 dark:text-slate-400">Financial Times • El País • CNN</span>
    </div>

    <div class="grid grid-cols-1 gap-6" id="foreign-grid">
      {MOCK_FOREIGN_STORIES.map((story) => (
        <div class="story-item" data-category="Internacional" data-text={`${story.neutralHeadline} ${story.summary} ${story.articles.map(a => a.title + ' ' + a.outletName).join(' ')}`}>
          <StoryCard story={story} />
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  // Client-side Tab Switcher
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const viewSections = document.querySelectorAll<HTMLElement>('.view-content');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-tab');
      if (!targetTab) return;

      // Update button styles
      tabButtons.forEach(b => {
        b.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'shadow-xs', 'font-bold');
        b.classList.add('text-slate-600', 'dark:text-slate-400');
        const icon = b.querySelector('svg');
        if (icon) {
          icon.classList.remove('text-slate-700', 'dark:text-slate-300');
          icon.classList.add('text-slate-500', 'dark:text-slate-400');
        }
      });
      btn.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'shadow-xs', 'font-bold');
      btn.classList.remove('text-slate-600', 'dark:text-slate-400');
      const activeIcon = btn.querySelector('svg');
      if (activeIcon) {
        activeIcon.classList.add('text-slate-700', 'dark:text-slate-300');
        activeIcon.classList.remove('text-slate-500', 'dark:text-slate-400');
      }

      // Update visible view
      viewSections.forEach(view => {
        if (view.id === `view-${targetTab}`) {
          view.classList.remove('hidden');
        } else {
          view.classList.add('hidden');
        }
      });

      // Smooth scroll to top of view
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  // Client-side Category Filter
  const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const storyItems = document.querySelectorAll<HTMLElement>('.story-item');

  catButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const selectedCat = btn.getAttribute('data-cat');
      if (!selectedCat) return;

      catButtons.forEach(b => {
        b.classList.remove('bg-slate-900', 'dark:bg-slate-100', 'text-white', 'dark:text-slate-950', 'font-bold');
        b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.add('bg-slate-900', 'dark:bg-slate-100', 'text-white', 'dark:text-slate-950', 'font-bold');
      btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');

      // Sync Header nav buttons
      const navButtons = document.querySelectorAll<HTMLButtonElement>('.nav-section-btn');
      navButtons.forEach(nb => {
        const sec = nb.getAttribute('data-nav-section');
        if (sec === selectedCat || (selectedCat === 'all' && sec === 'all')) {
          nb.classList.add('text-slate-950', 'dark:text-white', 'font-bold');
          nb.classList.remove('text-slate-700', 'dark:text-slate-300');
        } else {
          nb.classList.remove('text-slate-950', 'dark:text-white', 'font-bold');
          nb.classList.add('text-slate-700', 'dark:text-slate-300');
        }
      });

      // Filter banner management
      const filterBanner = document.getElementById('filter-status-banner');
      const filterText = document.getElementById('filter-status-text');
      if (filterBanner && filterText) {
        if (selectedCat === 'all') {
          filterBanner.classList.add('hidden');
          filterBanner.classList.remove('flex');
        } else {
          filterBanner.classList.remove('hidden');
          filterBanner.classList.add('flex');
          filterText.textContent = selectedCat;
        }
      }

      let firstVisibleMatch: HTMLElement | null = null;
      storyItems.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (selectedCat === 'all' || itemCat === selectedCat) {
          item.style.display = '';
          if (!firstVisibleMatch) firstVisibleMatch = item;
        } else {
          item.style.display = 'none';
        }
      });

      // If user filtered by a category and the lead story is hidden, scroll to the matching stories
      if (selectedCat !== 'all' && firstVisibleMatch) {
        firstVisibleMatch.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });

  // Clear filter button logic
  const clearFilterBtn = document.getElementById('clear-filter-btn');
  if (clearFilterBtn) {
    clearFilterBtn.addEventListener('click', () => {
      const allCatBtn = document.querySelector<HTMLButtonElement>('.cat-btn[data-cat="all"]');
      if (allCatBtn) allCatBtn.click();
    });
  }

  // Client-side Quick Search Filter
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      const allFilterable = document.querySelectorAll<HTMLElement>('.story-item, .live-item');

      allFilterable.forEach(el => {
        const text = (el.getAttribute('data-text') || '').toLowerCase();
        if (!query || text.includes(query)) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  }

  // --- Client-side Campaign Promises Filtering ---
  let activeCandidate = 'all';
  let activeStatus = 'all';
  let promiseSearchQuery = '';

  const candFilterButtons = document.querySelectorAll<HTMLButtonElement>('.cand-filter-btn');
  const statFilterButtons = document.querySelectorAll<HTMLButtonElement>('.stat-filter-btn');
  const promiseCards = document.querySelectorAll<HTMLElement>('.promise-card');
  const promiseSearchInput = document.getElementById('promise-search-input') as HTMLInputElement | null;
  const promisesFilterBanner = document.getElementById('promises-filter-banner');
  const promisesFilterText = document.getElementById('promises-filter-text');
  const clearPromisesFilterBtn = document.getElementById('clear-promises-filter-btn');
  const promisesEmptyState = document.getElementById('promises-empty-state');

  function applyPromisesFilters() {
    let visibleCount = 0;

    promiseCards.forEach(card => {
      const cand = card.getAttribute('data-candidate') || '';
      const stat = card.getAttribute('data-status') || '';
      const text = card.textContent?.toLowerCase() || '';

      const matchesCand = activeCandidate === 'all' || cand === activeCandidate;
      const matchesStat = activeStatus === 'all' || stat === activeStatus;
      const matchesSearch = !promiseSearchQuery || text.includes(promiseSearchQuery);

      if (matchesCand && matchesStat && matchesSearch) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Update banner
    if (promisesFilterBanner && promisesFilterText) {
      if (activeCandidate === 'all' && activeStatus === 'all' && !promiseSearchQuery) {
        promisesFilterBanner.classList.add('hidden');
        promisesFilterBanner.classList.remove('flex');
      } else {
        promisesFilterBanner.classList.remove('hidden');
        promisesFilterBanner.classList.add('flex');
        const filterDescriptions = [];
        if (activeCandidate !== 'all') filterDescriptions.push(`Dirigente: ${activeCandidate}`);
        if (activeStatus !== 'all') filterDescriptions.push(`Estado: ${activeStatus}`);
        if (promiseSearchQuery) filterDescriptions.push(`Búsqueda: "${promiseSearchQuery}"`);
        promisesFilterText.textContent = `${filterDescriptions.join(' • ')} (${visibleCount} promesas encontradas)`;
      }
    }

    // Empty state
    if (promisesEmptyState) {
      if (visibleCount === 0) {
        promisesEmptyState.classList.remove('hidden');
      } else {
        promisesEmptyState.classList.add('hidden');
      }
    }
  }

  // Candidate buttons
  candFilterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      candFilterButtons.forEach(b => {
        b.classList.remove('bg-slate-900', 'dark:bg-slate-100', 'text-white', 'dark:text-slate-950', 'font-bold');
        b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.add('bg-slate-900', 'dark:bg-slate-100', 'text-white', 'dark:text-slate-950', 'font-bold');
      btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');

      activeCandidate = btn.getAttribute('data-candidate') || 'all';
      applyPromisesFilters();
    });
  });

  // Status buttons
  statFilterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      statFilterButtons.forEach(b => {
        b.classList.remove('bg-slate-200', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'font-bold');
        b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.add('bg-slate-200', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'font-bold');
      btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');

      activeStatus = btn.getAttribute('data-status') || 'all';
      applyPromisesFilters();
    });
  });

  // Search input
  if (promiseSearchInput) {
    promiseSearchInput.addEventListener('input', () => {
      promiseSearchQuery = promiseSearchInput.value.toLowerCase().trim();
      applyPromisesFilters();
    });
  }

  // Clear filters button
  if (clearPromisesFilterBtn) {
    clearPromisesFilterBtn.addEventListener('click', () => {
      const allCand = document.querySelector<HTMLButtonElement>('.cand-filter-btn[data-candidate="all"]');
      const allStat = document.querySelector<HTMLButtonElement>('.stat-filter-btn[data-status="all"]');
      if (allCand) allCand.click();
      if (allStat) allStat.click();
      if (promiseSearchInput) {
        promiseSearchInput.value = '';
        promiseSearchQuery = '';
      }
      applyPromisesFilters();
    });
  }

  // --- Citizen Voting Interaction ---
  const voteButtons = document.querySelectorAll<HTMLButtonElement>('.vote-btn');

  // Highlight previously voted buttons from localStorage
  voteButtons.forEach(btn => {
    const promiseId = btn.getAttribute('data-promise-id');
    const voteType = btn.getAttribute('data-vote-type');
    if (!promiseId || !voteType) return;

    const savedVote = localStorage.getItem(`politicheck_vote_${promiseId}`);
    if (savedVote === voteType) {
      btn.classList.add('ring-2', 'ring-slate-900', 'dark:ring-white', 'font-bold');
    }
  });

  voteButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const promiseId = btn.getAttribute('data-promise-id');
      const voteType = btn.getAttribute('data-vote-type') as 'fulfilled' | 'inProgress' | 'broken';
      if (!promiseId || !voteType) return;

      const previousVote = localStorage.getItem(`politicheck_vote_${promiseId}`);
      if (previousVote === voteType) {
        return; // Already voted this option
      }

      // Optimistic UI updates
      const card = btn.closest<HTMLElement>('.promise-card');
      if (!card) return;

      // Update button styles in this card
      const cardVoteBtns = card.querySelectorAll<HTMLButtonElement>('.vote-btn');
      cardVoteBtns.forEach(b => {
        b.classList.remove('ring-2', 'ring-slate-900', 'dark:ring-white', 'font-bold');
      });
      btn.classList.add('ring-2', 'ring-slate-900', 'dark:ring-white', 'font-bold');

      // Dispatch to API
      try {
        const res = await fetch('/api/promises/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ promiseId, voteType })
        });

        if (res.ok) {
          const data = await res.json();
          if (data.success && data.promise && data.promise.votes) {
            localStorage.setItem(`politicheck_vote_${promiseId}`, voteType);
            const votes = data.promise.votes;

            // Update DOM counters
            const countFulfilled = card.querySelector('.count-fulfilled');
            const countInProgress = card.querySelector('.count-in-progress');
            const countBroken = card.querySelector('.count-broken');
            if (countFulfilled) countFulfilled.textContent = `(${votes.fulfilled})`;
            if (countInProgress) countInProgress.textContent = `(${votes.inProgress})`;
            if (countBroken) countBroken.textContent = `(${votes.broken})`;

            // Recalculate progress bars
            const total = votes.fulfilled + votes.inProgress + votes.broken;
            if (total > 0) {
              const fPct = Math.round((votes.fulfilled / total) * 100);
              const ipPct = Math.round((votes.inProgress / total) * 100);
              const bPct = Math.round((votes.broken / total) * 100);

              const barF = card.querySelector<HTMLElement>('.bar-fulfilled');
              const barIP = card.querySelector<HTMLElement>('.bar-in-progress');
              const barB = card.querySelector<HTMLElement>('.bar-broken');
              if (barF) barF.style.width = `${fPct}%`;
              if (barIP) barIP.style.width = `${ipPct}%`;
              if (barB) barB.style.width = `${bPct}%`;
            }
          }
        }
      } catch (err) {
        console.error('Error voting:', err);
      }
    });
  });

  // --- Dynamic Live News Auto-Refresh with Scroll Preservation ---
  // Only execute on Portada ('/' or '/index.html'), NEVER on /historia/:id
  if (window.location.pathname === '/' || window.location.pathname === '' || window.location.pathname.endsWith('/index.html')) {
    let lastArticleCount = 0;
    const initialBadge = document.querySelector<HTMLElement>('#news-count-badge');
    if (initialBadge) {
      const match = initialBadge.textContent?.match(/\d+/);
      if (match) lastArticleCount = parseInt(match[0], 10);
    }

    // Auto-refresh interval (every 60 seconds)
    const REFRESH_INTERVAL_MS = 60 * 1000;

    async function checkForNewsUpdates() {
      // If user is navigating away or in subpage like /historia/:id, abort
      if (window.location.pathname !== '/' && window.location.pathname !== '' && !window.location.pathname.endsWith('/index.html')) {
        return;
      }

      try {
        const res = await fetch('/api/news/latest', { cache: 'no-store' });
        if (!res.ok) return;

        const data = await res.json();
        if (!data.success) return;

        // Check if new articles arrived
        if (lastArticleCount > 0 && data.totalArticles > lastArticleCount) {
          const newCount = data.totalArticles - lastArticleCount;
          lastArticleCount = data.totalArticles;

          // Notify reader with an elegant floating pill that preserves scroll position
          showFloatingNewsAlert(newCount);
        } else if (lastArticleCount === 0) {
          lastArticleCount = data.totalArticles;
        }
      } catch (err) {
        // Silent network fallback
      }
    }

    function showFloatingNewsAlert(count: number) {
      // Check if alert already exists
      let alertEl = document.getElementById('live-news-update-pill');
      if (!alertEl) {
        alertEl = document.createElement('div');
        alertEl.id = 'live-news-update-pill';
        alertEl.className = 'fixed bottom-6 right-6 z-50 flex items-center gap-3 px-4 py-2.5 rounded-2xl bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-950 font-mono text-xs font-bold shadow-xl border border-slate-700 dark:border-slate-300 transition-all transform translate-y-0 animate-bounce cursor-pointer';
        alertEl.innerHTML = `
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>🔴 Hay ${count} noticias nuevas</span>
          <button class="ml-2 px-2 py-1 rounded bg-slate-800 dark:bg-slate-200 text-[10px] text-white dark:text-slate-900 font-bold hover:underline">Ver ahora</button>
        `;
        
        alertEl.addEventListener('click', () => {
          // Store exact scroll position, refresh and restore
          const currentY = window.scrollY;
          sessionStorage.setItem('politicheck_restore_scroll', currentY.toString());
          window.location.reload();
        });

        document.body.appendChild(alertEl);
      }
    }

    // Restore scroll position after a reload
    const restoreScroll = sessionStorage.getItem('politicheck_restore_scroll');
    if (restoreScroll) {
      sessionStorage.removeItem('politicheck_restore_scroll');
      const y = parseInt(restoreScroll, 10);
      if (!isNaN(y)) {
        window.scrollTo({ top: y, behavior: 'instant' });
      }
    }

    // Start background timer
    setInterval(checkForNewsUpdates, REFRESH_INTERVAL_MS);
  }
</script>
