---
import Layout from '../layouts/Layout.astro';
import StoryCard from '../components/StoryCard.astro';
import LiveFeedItem from '../components/LiveFeedItem.astro';
import PromiseCard from '../components/PromiseCard.astro';
import AdBanner from '../components/AdBanner.astro';
import { getCachedArticlesAsync, getCachedForeignArticlesAsync, getLastSyncTimestampAsync } from '../services/rss/sync';
import { 
  clusterArticlesWithGemini, 
  getCachedClusteredStories,
  clusterForeignArticlesWithGemini,
  getCachedForeignClustersAsync
} from '../services/ai/clustering';
import { getNewsClustersFromSupabase, getActiveCivicBanner } from '../services/supabase';
import { getPromisesWithLiveVotes, getPromisesStats } from '../services/promises';
import { getPolitician } from '../data/politicians';

export const prerender = false;

// Edge Cache: cache 30s at CDN, serve stale up to 60s while revalidating
Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=60');

// Fetch live dynamic campaign promises with real citizen votes from Supabase
const allPromises = await getPromisesWithLiveVotes();
const promisesStats = getPromisesStats(allPromises);
const uniqueCandidates = Array.from(new Set(allPromises.map(p => p.candidate)));

// Fetch live articles cached from Supabase or official RSS feeds (No mocks)
const liveArticles = await getCachedArticlesAsync();

// Load clustered stories dynamically (Check Supabase cloud first, fallback to cached local)
const cloudClusters = await getNewsClustersFromSupabase(1440);
const cachedClusters = getCachedClusteredStories();

// Separate national vs foreign clusters from Supabase
const nationalCloudClusters = cloudClusters ? cloudClusters.filter(c => c.category !== 'Internacional' && !c.kicker?.includes('MIRADA EXTERIOR')) : [];
const foreignCloudClusters = cloudClusters ? cloudClusters.filter(c => c.category === 'Internacional' || c.kicker?.includes('MIRADA EXTERIOR')) : [];

// Trigger background server sync if feeds are older than 15 minutes OR if clusters are older than 60 minutes (self-healing fallback)
const lastSyncIso = await getLastSyncTimestampAsync();
const isFeedStale = !lastSyncIso || (Date.now() - new Date(lastSyncIso).getTime() > 15 * 60 * 1000);
const areClustersStale = !nationalCloudClusters.length || (
  cloudClusters && cloudClusters[0]?.updated_at && (Date.now() - new Date(cloudClusters[0].updated_at).getTime() > 60 * 60 * 1000)
);

if (isFeedStale || areClustersStale) {
  const cronSecret = process.env.CRON_SECRET || 'politicheck_cron_dev_secret';
  const syncEndpoint = new URL(`/api/rss/sync?key=${encodeURIComponent(cronSecret)}`, Astro.url.origin).toString();
  fetch(syncEndpoint).catch(() => {});
}

const dynamicStories = (nationalCloudClusters.length > 0)
  ? nationalCloudClusters
  : (cloudClusters && cloudClusters.length > 0)
    ? cloudClusters
    : (cachedClusters.length > 0
      ? cachedClusters
      : (liveArticles.length > 0 ? await clusterArticlesWithGemini(liveArticles, import.meta.env.GEMINI_API_KEY) : []));

const storiesToDisplay = dynamicStories;

// Dynamic Foreign Stories & Full Live Foreign Articles for "La Mirada Exterior"
const liveForeignArticles = await getCachedForeignArticlesAsync();
const cachedForeignClusters = await getCachedForeignClustersAsync();
const dynamicForeignStories = (foreignCloudClusters.length > 0)
  ? foreignCloudClusters
  : (cachedForeignClusters.length > 0
    ? cachedForeignClusters
    : (liveForeignArticles.length > 0
      ? await clusterForeignArticlesWithGemini(liveForeignArticles, import.meta.env.GEMINI_API_KEY)
      : []));

const foreignStoriesToDisplay = dynamicForeignStories;

// Sort live foreign articles chronologically descending
const sortedForeignArticles = [...liveForeignArticles].sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));

const leadStory = storiesToDisplay[0];
const secondaryStories = storiesToDisplay.slice(1);
const liveRailArticles = liveArticles.slice(0, 6);
const fullLiveFeedArticles = liveArticles.slice(0, 60);

// Active Civic / Sponsor Banner
const activeBanner = await getActiveCivicBanner('home_top');
---

<Layout>
  <!-- VIEW 1: Tapa del Periódico (Lead story + live rail + secondary bento grid) -->
  <div id="view-temas-del-dia" class="view-content space-y-10">
    <!-- SECTION 1: Grand Apertura & Wire Rail (8 cols / 4 cols) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: The Grand Lead Story (Apertura de Portada) -->
      <div class="lg:col-span-8 space-y-4">
        <div id="grand-opening-header" class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-slate-400 mb-1 border-b border-slate-200 dark:border-slate-800 pb-2">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-slate-900 dark:bg-slate-100"></span>
            <span class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-widest text-[11px]">Gran Apertura de Tapa</span>
          </span>
          <span class="hidden sm:inline">Contraste simultáneo de redacciones</span>
        </div>

        <!-- Filter Status Banner (Shown when a category is selected) -->
        <div id="filter-status-banner" class="hidden p-3.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-mono text-slate-700 dark:text-slate-300 items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-slate-900 dark:bg-slate-100"></span>
            <span>Filtro por sección: <strong id="filter-status-text" class="text-slate-950 dark:text-white uppercase font-bold"></strong></span>
          </div>
          <button type="button" id="clear-filter-btn" class="text-slate-500 hover:text-slate-900 dark:hover:text-white underline underline-offset-2 cursor-pointer">
            Ver todas las secciones
          </button>
        </div>

        <!-- News Search Feedback Banner -->
        <div id="news-search-banner" class="hidden p-3.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-mono text-slate-700 dark:text-slate-300 items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="news-search-text"></span>
          </div>
          <button type="button" id="clear-search-btn" class="text-slate-500 hover:text-slate-900 dark:hover:text-white underline underline-offset-2 cursor-pointer font-bold">
            Limpiar búsqueda
          </button>
        </div>

        <!-- News Empty State -->
        <div id="news-empty-state" class="hidden p-8 text-center rounded-2xl bg-white dark:bg-slate-900/60 border border-dashed border-slate-300 dark:border-slate-800 space-y-3">
          <p class="font-editorial text-lg font-bold text-slate-950 dark:text-white">
            No se encontraron noticias que coincidan con tu búsqueda.
          </p>
          <p class="text-xs font-mono text-slate-500 dark:text-slate-400 max-w-md mx-auto">
            Probá buscando términos clave como "dólar", "inflación", "Milei", "Kicillof", "justicia" o "universidad".
          </p>
          <div class="pt-2 flex flex-wrap items-center justify-center gap-2">
            <button 
              type="button" 
              id="reset-search-btn"
              class="px-3.5 py-1.5 rounded-lg bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 font-mono text-xs font-bold transition-all cursor-pointer hover:opacity-90"
            >
              Ver todas las noticias
            </button>
          </div>
        </div>

        <div id="lead-story-slot" class="w-full">
          {leadStory ? (
            <div id="grand-opening-card-wrapper" class="story-item" data-category={leadStory.category} data-text={`${leadStory.neutralHeadline} ${leadStory.summary} ${leadStory.articles.map((a: any) => a.title + ' ' + a.outletName).join(' ')}`}>
              <StoryCard story={leadStory} />
            </div>
          ) : (
            <div class="p-8 text-center rounded-2xl bg-white dark:bg-slate-900/60 border border-dashed border-slate-300 dark:border-slate-800 text-xs font-mono text-slate-500">
              Sincronizando flujo de noticias oficiales...
            </div>
          )}
        </div>
      </div>

      <!-- Right Column: Noticias de Último Momento (The Live Wire Rail) -->
      <aside class="lg:col-span-4 space-y-4 bg-slate-50/70 dark:bg-[#0C101A] border border-slate-200 dark:border-slate-800/80 rounded-2xl p-4 sm:p-5">
        <div class="flex items-center justify-between text-xs font-mono border-b border-slate-200 dark:border-slate-800 pb-3">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600 dark:bg-emerald-500"></span>
            </span>
            <span class="font-bold text-slate-900 dark:text-white uppercase tracking-wider text-[11px]">
              Minuto a Minuto
            </span>
          </div>
          <span class="text-[10px] text-slate-500 dark:text-slate-400">Feeds Oficiales RSS</span>
        </div>

        <!-- Wire Items List -->
        <div class="space-y-3" id="wire-rail-list">
          {liveRailArticles.map((article) => (
            <div class="live-item" data-text={`${article.title} ${article.snippet} ${article.outletName}`}>
              <LiveFeedItem article={article} />
            </div>
          ))}
        </div>

        <!-- Link to view full wire -->
        <div class="pt-2 text-center">
          <button 
            type="button" 
            onclick="document.querySelector('[data-tab=ultimo-momento]')?.click()"
            class="w-full py-2 px-3 rounded-xl bg-white hover:bg-slate-100 dark:bg-slate-900 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 text-xs font-mono text-slate-700 dark:text-slate-300 font-semibold transition-colors cursor-pointer"
          >
            Ver todas las noticias en vivo →
          </button>
        </div>
      </aside>
    </section>

    <!-- Civic Sponsor Banner Placement (Rendered conditionally if active) -->
    <AdBanner banner={activeBanner} />

    <!-- SECTION 2: Segundas Aperturas (3-Column Bento Grid) -->
    <section id="secondary-stories-section" class="space-y-4 pt-4 border-t-2 border-slate-900 dark:border-slate-100">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-2">
        <h3 id="secondary-stories-heading" class="font-editorial text-xl sm:text-2xl font-bold text-slate-950 dark:text-white uppercase tracking-tight">
          Temas Destacados en Portada
        </h3>
        <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
          Enfoques cruzados por redacción
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch" id="secondary-stories-grid">
        {secondaryStories.map((story) => (
          <div class="story-item h-full flex flex-col" data-category={story.category} data-text={`${story.neutralHeadline} ${story.summary} ${story.articles.map((a: any) => a.title + ' ' + a.outletName).join(' ')}`}>
            <StoryCard story={story} />
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 3: Monitor de Promesas Electorales 2027 -->
    <section id="monitor-promesas" class="space-y-6 pt-6 border-t border-slate-200 dark:border-slate-800">
      <!-- Section Header & Metrics Dashboard Bento -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-slate-200 dark:border-slate-800 pb-5">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200 dark:border-indigo-800 text-indigo-900 dark:text-indigo-200 text-[11px] font-mono font-bold uppercase tracking-wider shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Promesómetro Cívico Electoral • Auditoría Documental</span>
          </div>
          <h3 class="font-editorial text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-950 dark:text-white tracking-tight">
            Monitor de Promesas de Campaña 2027
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-sans leading-relaxed">
            Auditoría rigurosa y no partidaria de los compromisos asumidos por los principales dirigentes políticos. Cotejamos las declaraciones textuales contra resoluciones oficiales, leyes sancionadas y el termómetro de percepción ciudadana en tiempo real.
          </p>
        </div>

        <!-- Metrics Dashboard Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-center shrink-0">
          <div class="bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl p-3 shadow-2xs">
            <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">Auditadas</div>
            <div class="text-xl font-bold text-slate-900 dark:text-white">{promisesStats.total}</div>
            <div class="text-[9px] text-slate-400">100% cita oficial</div>
          </div>
          <div class="bg-white dark:bg-slate-900/80 border border-emerald-200 dark:border-emerald-900/60 rounded-xl p-3 shadow-2xs">
            <div class="text-[10px] uppercase font-bold text-emerald-700 dark:text-emerald-400">Cumplidas</div>
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400">{promisesStats.fulfilledPct}%</div>
            <div class="text-[9px] text-slate-400">{promisesStats.fulfilled} de {promisesStats.total}</div>
          </div>
          <div class="bg-white dark:bg-slate-900/80 border border-amber-200 dark:border-amber-900/60 rounded-xl p-3 shadow-2xs">
            <div class="text-[10px] uppercase font-bold text-amber-700 dark:text-amber-400">En Progreso</div>
            <div class="text-xl font-bold text-amber-600 dark:text-amber-400">{promisesStats.inProgressPct}%</div>
            <div class="text-[9px] text-slate-400">{promisesStats.inProgress} activas</div>
          </div>
          <div class="bg-white dark:bg-slate-900/80 border border-sky-200 dark:border-sky-900/60 rounded-xl p-3 shadow-2xs">
            <div class="text-[10px] uppercase font-bold text-sky-700 dark:text-sky-400">Votos Cívicos</div>
            <div class="text-xl font-bold text-sky-600 dark:text-sky-400" id="total-citizen-votes-count">{promisesStats.totalCitizenVotes.toLocaleString('es-AR')}</div>
            <div class="text-[9px] text-slate-400">participación viva</div>
          </div>
        </div>
      </div>

      <!-- Promises Filter & Search Bar -->
      <div class="space-y-3 bg-white dark:bg-slate-950/60 border border-slate-200/90 dark:border-slate-800/90 rounded-2xl p-4 shadow-xs">
        <!-- Top row: Candidate filter buttons & search -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
          <!-- Candidate Filter Pills -->
          <div class="flex items-center gap-1.5 overflow-x-auto text-xs font-mono py-1 max-w-full" id="candidate-filters">
            <button class="cand-filter-btn active px-3 py-1.5 rounded-lg bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-950 font-bold transition-colors cursor-pointer shrink-0" data-candidate="all">
              Todos ({allPromises.length})
            </button>
            {uniqueCandidates.map((candidateName) => {
              const pol = getPolitician(candidateName);
              const count = allPromises.filter(p => p.candidate === candidateName).length;
              const dotColor = pol.partyColor?.border ? pol.partyColor.border.replace('border-', 'bg-') : 'bg-slate-500';
              return (
                <button 
                  class="cand-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition-colors cursor-pointer shrink-0" 
                  data-candidate={candidateName}
                >
                  <span class={`w-2 h-2 rounded-full ${dotColor} shrink-0`}></span>
                  <span>{candidateName}</span>
                  <span class="text-[10px] text-slate-400 font-mono">({count})</span>
                </button>
              );
            })}
          </div>

          <!-- Promise Keyword Search -->
          <div class="relative w-full md:w-72">
            <input 
              type="text" 
              id="promise-search-input"
              placeholder="Buscar promesa (ej. inflación, retenciones, coparticipación)..." 
              class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl px-3.5 py-1.5 text-xs text-slate-900 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:border-slate-400 dark:focus:border-slate-500 shadow-2xs transition-colors font-sans"
            />
            <svg class="w-3.5 h-3.5 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>

        <!-- Bottom row: Status filter chips with vivid colors -->
        <div class="flex items-center gap-1.5 overflow-x-auto text-[11px] font-mono pt-1 border-t border-slate-100 dark:border-slate-800/60" id="status-filters">
          <span class="text-slate-400 dark:text-slate-500 text-[10px] uppercase tracking-wider mr-1">Filtrar por estado:</span>
          <button class="stat-filter-btn active px-2.5 py-1 rounded-md bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 font-bold transition-colors cursor-pointer" data-status="all">
            Todos ({promisesStats.total})
          </button>
          <button class="stat-filter-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-emerald-800 dark:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 transition-colors cursor-pointer" data-status="cumplida">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>Cumplidas ({promisesStats.fulfilled})</span>
          </button>
          <button class="stat-filter-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-amber-800 dark:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950/40 border border-amber-200 dark:border-amber-800 transition-colors cursor-pointer" data-status="en_progreso">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            <span>En progreso ({promisesStats.inProgress})</span>
          </button>
          <button class="stat-filter-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-orange-800 dark:text-orange-300 hover:bg-orange-50 dark:hover:bg-orange-950/40 border border-orange-200 dark:border-orange-800 transition-colors cursor-pointer" data-status="en_pausa">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
            <span>En pausa ({promisesStats.paused})</span>
          </button>
          <button class="stat-filter-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 text-rose-800 dark:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40 border border-rose-200 dark:border-rose-800 transition-colors cursor-pointer" data-status="incumplida">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
            <span>Incumplidas ({promisesStats.broken})</span>
          </button>
        </div>
      </div>

      <!-- Active Promises Filter Banner Indicator -->
      <div id="promises-filter-banner" class="hidden items-center justify-between p-3 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-mono">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-slate-900 dark:bg-white animate-pulse"></span>
          <span>Filtro activo de promesas: <strong id="promises-filter-text"></strong></span>
        </div>
        <button id="clear-promises-filter-btn" class="text-xs font-bold text-slate-900 dark:text-white underline hover:no-underline cursor-pointer">
          Restablecer todas las promesas
        </button>
      </div>

      <!-- Promises Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="promises-container">
        {allPromises.map((promise) => (
          <PromiseCard promise={promise} />
        ))}
      </div>

      <!-- Promises Pagination Toolbar (Paginado de a 4 promesas) -->
      <div id="promises-pagination" class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-5 border-t border-slate-200 dark:border-slate-800 text-xs font-mono">
        <div id="promises-pagination-label" class="text-slate-500 dark:text-slate-400 text-[11px]">
          Mostrando 1-4 de {allPromises.length} promesas auditadas
        </div>

        <div class="flex items-center gap-1.5">
          <button
            type="button"
            id="promises-prev-btn"
            class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium text-xs transition-colors cursor-pointer disabled:opacity-30 disabled:pointer-events-none"
            disabled
          >
            ← Anterior
          </button>

          <div id="promises-page-indicators" class="flex items-center gap-1 px-1">
            <!-- Rendered by JS -->
          </div>

          <button
            type="button"
            id="promises-next-btn"
            class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium text-xs transition-colors cursor-pointer disabled:opacity-30 disabled:pointer-events-none"
          >
            Siguiente →
          </button>
        </div>
      </div>

      <!-- Empty state if no promise matches filter -->
      <div id="promises-empty-state" class="hidden text-center py-12 px-4 rounded-2xl border border-dashed border-slate-300 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40 space-y-3">
        <div class="text-3xl">🔍</div>
        <h4 class="font-editorial text-lg font-bold text-slate-900 dark:text-slate-100">
          No se encontraron promesas para el filtro seleccionado
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 font-sans max-w-md mx-auto">
          Probá seleccionando otro dirigente o limpiando el término de búsqueda para ver los compromisos auditados.
        </p>
      </div>
    </section>

    <!-- SECTION 4: Metodología, Independencia y Fuentes RSS -->
    <section id="metodologia" class="bg-slate-50 dark:bg-[#0D111A] border border-slate-200 dark:border-slate-800/90 rounded-2xl p-6 sm:p-8 space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
        <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-widest text-slate-800 dark:text-slate-200">
          <svg class="w-4 h-4 text-slate-600 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Declaración de Independencia y Metodología de Auditoría</span>
        </div>
        <a 
          href="/metodologia" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900 text-xs font-mono font-bold hover:opacity-90 transition-opacity self-start sm:self-auto shadow-sm"
        >
          <span>Ver Metodología Completa & 31 Medios</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-slate-600 dark:text-slate-400 font-sans leading-relaxed">
        <div class="space-y-1.5">
          <h4 class="font-bold text-slate-900 dark:text-slate-100 font-mono text-[11px] uppercase">
            1. Agregación RSS Oficial (31 Redacciones)
          </h4>
          <p>
            No realizamos scraping invasivo ni intervenimos los contenidos. Toda la información proviene de los canales RSS públicos y oficiales sindicados directamente por Clarín, La Nación, Infobae, TN, Ámbito, El Cronista, Perfil, elDiarioAR, Crónica, BAE, Cenital, La Izquierda Diario, El Economista, La Derecha Diario, Financial Times, El País, CNN, BBC Mundo, France 24, Le Monde, DW y agencias globales.
          </p>
        </div>

        <div class="space-y-1.5">
          <h4 class="font-bold text-slate-900 dark:text-slate-100 font-mono text-[11px] uppercase">
            2. Análisis de Encuadres por IA
          </h4>
          <p>
            Los resúmenes de contraste son generados de manera automatizada mediante modelos de lenguaje analizando la selección de adjetivos, omisiones temáticas y encuadre del titular, sin adherencia a ninguna fuerza política partidaria.
          </p>
        </div>

        <div class="space-y-1.5">
          <h4 class="font-bold text-slate-900 dark:text-slate-100 font-mono text-[11px] uppercase">
            3. Espectro y Transparencia
          </h4>
          <p>
            La plataforma computa de manera determinística la distribución del espectro editorial en base a las notas publicadas por cada redacción, contrastando encuadres oficialistas, fácticos y opositores para empoderar al lector.
          </p>
        </div>
      </div>
    </section>
  </div>

  <!-- VIEW 2: Último Momento (Chronological full wire feed) -->
  <div id="view-ultimo-momento" class="view-content space-y-6 hidden">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Noticias de Redacción en Vivo</span>
        </div>
        <h2 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white">
          Minuto a Minuto: Flujo Cronológico de Noticias
        </h2>
      </div>
      <span class="text-xs font-mono text-slate-500 dark:text-slate-400">Sincronización en tiempo real</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="live-feed-full-list">
      {fullLiveFeedArticles.map((article) => (
        <div class="live-item" data-text={`${article.title} ${article.snippet} ${article.outletName}`}>
          <LiveFeedItem article={article} />
        </div>
      ))}
    </div>
  </div>

  <!-- VIEW 3: Mirada Exterior (International coverage) -->
  <div id="view-mirada-exterior" class="view-content space-y-10 hidden">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400">
          <span class="w-2 h-2 rounded-full bg-slate-900 dark:bg-slate-100"></span>
          <span class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Prensa Internacional</span>
        </div>
        <h2 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white">
          La Mirada de Afuera: Argentina en los Medios del Mundo
        </h2>
      </div>
      <div class="flex flex-col sm:items-end text-xs font-mono text-slate-500 dark:text-slate-400">
        <span class="text-emerald-600 dark:text-emerald-400 font-bold">● Cobertura internacional en tiempo real</span>
        <span>Le Figaro • France 24 • BBC Mundo • El País • The Guardian • Expansión • Le Monde • Nikkei</span>
      </div>
    </div>

    <!-- Section A: Cobertura Cruzada y Encuadres (Clusters) -->
    {foreignStoriesToDisplay.length > 0 && (
      <div class="space-y-4">
        <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800 pb-2">
          <span class="font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
            Grandes Encuadres Internacionales
          </span>
          <span>{foreignStoriesToDisplay.length} temas analizados</span>
        </div>
        <div class="grid grid-cols-1 gap-6" id="foreign-grid">
          {foreignStoriesToDisplay.map((story) => (
            <div class="story-item" data-category="Internacional" data-text={`${story.neutralHeadline} ${story.summary} ${story.articles.map((a: any) => a.title + ' ' + a.outletName).join(' ')}`}>
              <StoryCard story={story} />
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Section B: Cable Internacional en Vivo (Feed individual de corresponsales) -->
    <div class="space-y-4">
      <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800 pb-2">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
          <span class="font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
            Cable Internacional en Directo
          </span>
        </div>
        <span>{sortedForeignArticles.length} despachos sobre Argentina</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="foreign-wire-grid">
        {sortedForeignArticles.map((art) => (
          <a
            href={art.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col justify-between p-4 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/60 hover:border-slate-400 dark:hover:border-slate-600 transition-all hover:shadow-xs"
          >
            <div class="space-y-2">
              <div class="flex items-center justify-between text-[11px] font-mono">
                <span class="font-bold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200">
                  {art.outletName}
                </span>
                <span class="text-slate-400">
                  {art.publishedAt || 'Reciente'}
                </span>
              </div>
              <h3 class="font-editorial text-base font-bold text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-3">
                {art.title}
              </h3>
              {art.snippet && (
                <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-3 leading-relaxed">
                  {art.snippet}
                </p>
              )}
            </div>
            <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800/50 flex items-center justify-between text-[11px] font-mono text-slate-400 group-hover:text-slate-700 dark:group-hover:text-slate-300">
              <span>Leer en {art.outletName}</span>
              <span class="transition-transform group-hover:translate-x-0.5">↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  // Client-side Tab Switcher
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const viewSections = document.querySelectorAll<HTMLElement>('.view-content');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-tab');
      if (!targetTab) return;

      // Update button styles
      tabButtons.forEach(b => {
        b.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'shadow-xs', 'font-bold');
        b.classList.add('text-slate-600', 'dark:text-slate-400');
        const icon = b.querySelector('svg');
        if (icon) {
          icon.classList.remove('text-slate-700', 'dark:text-slate-300');
          icon.classList.add('text-slate-500', 'dark:text-slate-400');
        }
      });
      btn.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'shadow-xs', 'font-bold');
      btn.classList.remove('text-slate-600', 'dark:text-slate-400');
      const activeIcon = btn.querySelector('svg');
      if (activeIcon) {
        activeIcon.classList.add('text-slate-700', 'dark:text-slate-300');
        activeIcon.classList.remove('text-slate-500', 'dark:text-slate-400');
      }

      // Update visible view
      viewSections.forEach(view => {
        if (view.id === `view-${targetTab}`) {
          view.classList.remove('hidden');
        } else {
          view.classList.add('hidden');
        }
      });

      // Smooth scroll to top of view
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  // --- Dynamic Lead Story Promotion & Category/Search Filtering ---
  const leadSlot = document.getElementById('lead-story-slot');
  const grandOpeningHeader = document.getElementById('grand-opening-header');
  const secondarySection = document.getElementById('secondary-stories-section');
  const secondaryHeading = document.getElementById('secondary-stories-heading');
  const secondaryGrid = document.getElementById('secondary-stories-grid');
  const filterBanner = document.getElementById('filter-status-banner');
  const filterText = document.getElementById('filter-status-text');
  const clearFilterBtn = document.getElementById('clear-filter-btn');
  const newsSearchBanner = document.getElementById('news-search-banner');
  const newsSearchText = document.getElementById('news-search-text');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const clearSearchBtn = document.getElementById('clear-search-btn');
  const resetSearchBtn = document.getElementById('reset-search-btn');
  const newsEmptyState = document.getElementById('news-empty-state');

  const origLeadCard = document.getElementById('grand-opening-card-wrapper');
  const origSecondaryCards = secondaryGrid ? (Array.from(secondaryGrid.children) as HTMLElement[]) : [];
  const allStories = origLeadCard ? [origLeadCard, ...origSecondaryCards] : origSecondaryCards;
  const liveItems = document.querySelectorAll<HTMLElement>('.live-item');

  let activeCategory = 'all';
  let activeSearchQuery = '';

  function normalizeStr(str: string): string {
    return (str || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  function updateNewsLayout() {
    const normQuery = normalizeStr(activeSearchQuery);
    const isCategoryFilter = activeCategory !== 'all';
    const isSearchFilter = normQuery.length > 0;

    // Filter live rail items if searching
    liveItems.forEach(el => {
      const text = normalizeStr(el.getAttribute('data-text') || '');
      if (!normQuery || text.includes(normQuery)) {
        el.style.display = '';
      } else {
        el.style.display = 'none';
      }
    });

    // Match stories against both category and search query
    const matchingStories = allStories.filter(card => {
      const cat = card.getAttribute('data-category') || '';
      const text = normalizeStr(card.getAttribute('data-text') || '');

      const matchesCat = !isCategoryFilter || cat.toLowerCase() === activeCategory.toLowerCase();
      const matchesSearch = !isSearchFilter || text.includes(normQuery);

      return matchesCat && matchesSearch;
    });

    // Hide non-matching stories
    allStories.forEach(card => {
      if (!matchingStories.includes(card)) {
        card.style.display = 'none';
      }
    });

    // State 1: Reset / No filters active
    if (!isCategoryFilter && !isSearchFilter) {
      if (origLeadCard && leadSlot) {
        leadSlot.appendChild(origLeadCard);
        origLeadCard.style.display = '';
      }
      if (secondaryGrid) {
        origSecondaryCards.forEach(card => {
          secondaryGrid.appendChild(card);
          card.style.display = '';
        });
        secondaryGrid.className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch';
      }
      if (grandOpeningHeader) grandOpeningHeader.style.display = '';
      if (secondarySection) secondarySection.style.display = '';
      if (secondaryHeading) secondaryHeading.textContent = 'Temas Destacados en Portada';
      if (filterBanner) {
        filterBanner.classList.add('hidden');
        filterBanner.classList.remove('flex');
      }
      if (newsSearchBanner) {
        newsSearchBanner.classList.add('hidden');
        newsSearchBanner.classList.remove('flex');
      }
      if (newsEmptyState) newsEmptyState.classList.add('hidden');
      return;
    }

    // State 2: Filters active - update status banners
    if (filterBanner && filterText) {
      if (isCategoryFilter) {
        filterBanner.classList.remove('hidden');
        filterBanner.classList.add('flex');
        filterText.textContent = `${activeCategory} • ${matchingStories.length} ${matchingStories.length === 1 ? 'historia encontrada' : 'historias encontradas'}`;
      } else {
        filterBanner.classList.add('hidden');
        filterBanner.classList.remove('flex');
      }
    }

    if (newsSearchBanner && newsSearchText) {
      if (isSearchFilter) {
        newsSearchBanner.classList.remove('hidden');
        newsSearchBanner.classList.add('flex');
        newsSearchText.textContent = `Búsqueda: "${activeSearchQuery}" • ${matchingStories.length} noticias encontradas`;
      } else {
        newsSearchBanner.classList.add('hidden');
        newsSearchBanner.classList.remove('flex');
      }
    }

    // Case 2A: 0 matching stories
    if (matchingStories.length === 0) {
      if (origLeadCard) origLeadCard.style.display = 'none';
      if (grandOpeningHeader) grandOpeningHeader.style.display = 'none';
      if (secondarySection) secondarySection.style.display = 'none';
      if (newsEmptyState) {
        newsEmptyState.classList.remove('hidden');
        const emptyTitle = newsEmptyState.querySelector('p');
        if (emptyTitle) {
          emptyTitle.textContent = isSearchFilter 
            ? `No se encontraron noticias que coincidan con "${activeSearchQuery}".`
            : `No se encontraron historias en la sección ${activeCategory} en este momento.`;
        }
      }
      return;
    }

    // Case 2B: 1 or more matching stories -> DYNAMIC PROMOTION to lead slot
    if (newsEmptyState) newsEmptyState.classList.add('hidden');
    if (grandOpeningHeader) grandOpeningHeader.style.display = '';

    const firstMatch = matchingStories[0];
    if (leadSlot && firstMatch) {
      leadSlot.appendChild(firstMatch);
      firstMatch.style.display = '';
    }

    const secondaryMatches = matchingStories.slice(1);
    if (secondaryMatches.length > 0 && secondarySection && secondaryGrid) {
      secondarySection.style.display = '';
      secondaryMatches.forEach(card => {
        secondaryGrid.appendChild(card);
        card.style.display = '';
      });

      if (secondaryMatches.length === 1) {
        secondaryGrid.className = 'grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch';
      } else {
        secondaryGrid.className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch';
      }

      if (secondaryHeading) {
        secondaryHeading.textContent = isCategoryFilter
          ? `Más coberturas en ${activeCategory} (${secondaryMatches.length})`
          : `Otras noticias encontradas (${secondaryMatches.length})`;
      }
    } else {
      // No extra stories -> hide secondary section cleanly
      if (secondarySection) {
        secondarySection.style.display = 'none';
      }
    }
  }

  // Expose category filter function globally
  (window as any).politicheckFilterCategory = (category: string) => {
    activeCategory = category || 'all';
    updateNewsLayout();
  };

  // Clear filter button logic
  if (clearFilterBtn) {
    clearFilterBtn.addEventListener('click', () => {
      const allNavBtn = document.querySelector<HTMLButtonElement>('.nav-section-btn[data-nav-section="all"]');
      if (allNavBtn) {
        allNavBtn.click();
      } else {
        (window as any).politicheckFilterCategory('all');
      }
    });
  }

  // Quick Search input events
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      activeSearchQuery = searchInput.value.trim();
      if (activeSearchQuery) {
        const mainTab = document.querySelector<HTMLButtonElement>('[data-tab="temas-del-dia"]');
        const mainView = document.getElementById('view-temas-del-dia');
        if (mainView && mainView.classList.contains('hidden') && mainTab) {
          mainTab.click();
        }
      }
      updateNewsLayout();
    });
  }

  const clearSearchHandler = () => {
    if (searchInput) {
      searchInput.value = '';
      activeSearchQuery = '';
      updateNewsLayout();
    }
  };

  if (clearSearchBtn) clearSearchBtn.addEventListener('click', clearSearchHandler);
  if (resetSearchBtn) resetSearchBtn.addEventListener('click', clearSearchHandler);

  // Check URL params (?q=... or ?sec=...) on load
  const urlParams = new URLSearchParams(window.location.search);
  const qParam = urlParams.get('q');
  const secParam = urlParams.get('sec');

  if (qParam && searchInput) {
    searchInput.value = qParam;
    activeSearchQuery = qParam.trim();
    updateNewsLayout();
  } else if (secParam) {
    const matchingNavBtn = document.querySelector<HTMLButtonElement>(`.nav-section-btn[data-nav-section="${secParam}"]`);
    if (matchingNavBtn) {
      matchingNavBtn.click();
    } else {
      (window as any).politicheckFilterCategory(secParam);
    }
  }

  // --- Client-side Campaign Promises Filtering & 4-Item Pagination ---
  let activeCandidate = 'all';
  let activeStatus = 'all';
  let promiseSearchQuery = '';
  let currentPromisesPage = 1;
  const PROMISES_PER_PAGE = 4;

  const candFilterButtons = document.querySelectorAll<HTMLButtonElement>('.cand-filter-btn');
  const statFilterButtons = document.querySelectorAll<HTMLButtonElement>('.stat-filter-btn');
  const promiseCards = Array.from(document.querySelectorAll<HTMLElement>('.promise-card'));
  const promiseSearchInput = document.getElementById('promise-search-input') as HTMLInputElement | null;
  const promisesFilterBanner = document.getElementById('promises-filter-banner');
  const promisesFilterText = document.getElementById('promises-filter-text');
  const clearPromisesFilterBtn = document.getElementById('clear-promises-filter-btn');
  const promisesEmptyState = document.getElementById('promises-empty-state');
  const promisesPagination = document.getElementById('promises-pagination');
  const promisesPaginationLabel = document.getElementById('promises-pagination-label');
  const promisesPrevBtn = document.getElementById('promises-prev-btn') as HTMLButtonElement | null;
  const promisesNextBtn = document.getElementById('promises-next-btn') as HTMLButtonElement | null;
  const promisesPageIndicators = document.getElementById('promises-page-indicators');

  function applyPromisesFilters(resetPage = false) {
    if (resetPage) {
      currentPromisesPage = 1;
    }

    const normQuery = normalizeStr(promiseSearchQuery);

    // 1. Identify all cards matching filters
    const matchingCards = promiseCards.filter(card => {
      const cand = card.getAttribute('data-candidate') || '';
      const stat = card.getAttribute('data-status') || '';
      const text = normalizeStr(card.textContent || '');

      const matchesCand = activeCandidate === 'all' || cand === activeCandidate;
      const matchesStat = activeStatus === 'all' || stat === activeStatus;
      const matchesSearch = !normQuery || text.includes(normQuery);

      return matchesCand && matchesStat && matchesSearch;
    });

    const totalMatching = matchingCards.length;
    const totalPages = Math.max(1, Math.ceil(totalMatching / PROMISES_PER_PAGE));

    // Clamp page
    if (currentPromisesPage > totalPages) currentPromisesPage = totalPages;
    if (currentPromisesPage < 1) currentPromisesPage = 1;

    const startIndex = (currentPromisesPage - 1) * PROMISES_PER_PAGE;
    const endIndex = Math.min(startIndex + PROMISES_PER_PAGE, totalMatching);

    // 2. Hide all cards, then show only the 4 cards on the active page
    promiseCards.forEach(card => {
      card.style.display = 'none';
    });

    matchingCards.slice(startIndex, endIndex).forEach(card => {
      card.style.display = '';
    });

    // 3. Update filter indicator banner
    if (promisesFilterBanner && promisesFilterText) {
      if (activeCandidate === 'all' && activeStatus === 'all' && !promiseSearchQuery) {
        promisesFilterBanner.classList.add('hidden');
        promisesFilterBanner.classList.remove('flex');
      } else {
        promisesFilterBanner.classList.remove('hidden');
        promisesFilterBanner.classList.add('flex');
        const filterDescriptions = [];
        if (activeCandidate !== 'all') filterDescriptions.push(`Dirigente: ${activeCandidate}`);
        if (activeStatus !== 'all') filterDescriptions.push(`Estado: ${activeStatus}`);
        if (promiseSearchQuery) filterDescriptions.push(`Búsqueda: "${promiseSearchQuery}"`);
        promisesFilterText.textContent = `${filterDescriptions.join(' • ')} (${totalMatching} promesas encontradas)`;
      }
    }

    // 4. Update empty state vs pagination visibility
    if (totalMatching === 0) {
      if (promisesEmptyState) promisesEmptyState.classList.remove('hidden');
      if (promisesPagination) promisesPagination.classList.add('hidden');
    } else {
      if (promisesEmptyState) promisesEmptyState.classList.add('hidden');
      if (promisesPagination) {
        promisesPagination.classList.remove('hidden');

        // Update range label
        if (promisesPaginationLabel) {
          promisesPaginationLabel.textContent = `Mostrando ${startIndex + 1}-${endIndex} de ${totalMatching} promesas auditadas`;
        }

        // Update Prev & Next buttons
        if (promisesPrevBtn) {
          promisesPrevBtn.disabled = currentPromisesPage <= 1;
        }
        if (promisesNextBtn) {
          promisesNextBtn.disabled = currentPromisesPage >= totalPages;
        }

        // Render page numeric indicators
        if (promisesPageIndicators) {
          promisesPageIndicators.innerHTML = '';
          if (totalPages > 1) {
            for (let p = 1; p <= totalPages; p++) {
              const pageBtn = document.createElement('button');
              pageBtn.type = 'button';
              pageBtn.textContent = p.toString();
              const isActive = p === currentPromisesPage;
              pageBtn.className = isActive
                ? 'w-7 h-7 rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-bold text-xs flex items-center justify-center transition-colors'
                : 'w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs flex items-center justify-center transition-colors cursor-pointer';
              pageBtn.addEventListener('click', () => {
                currentPromisesPage = p;
                applyPromisesFilters(false);
                document.getElementById('promesas')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
              });
              promisesPageIndicators.appendChild(pageBtn);
            }
          }
        }
      }
    }
  }

  // Connect Prev & Next Buttons
  if (promisesPrevBtn) {
    promisesPrevBtn.addEventListener('click', () => {
      if (currentPromisesPage > 1) {
        currentPromisesPage--;
        applyPromisesFilters(false);
        document.getElementById('promesas')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

  if (promisesNextBtn) {
    promisesNextBtn.addEventListener('click', () => {
      const normQuery = normalizeStr(promiseSearchQuery);
      const matchingCount = promiseCards.filter(card => {
        const cand = card.getAttribute('data-candidate') || '';
        const stat = card.getAttribute('data-status') || '';
        const text = normalizeStr(card.textContent || '');
        return (activeCandidate === 'all' || cand === activeCandidate) &&
               (activeStatus === 'all' || stat === activeStatus) &&
               (!normQuery || text.includes(normQuery));
      }).length;
      const totalPages = Math.ceil(matchingCount / PROMISES_PER_PAGE);

      if (currentPromisesPage < totalPages) {
        currentPromisesPage++;
        applyPromisesFilters(false);
        document.getElementById('promesas')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

  // Candidate buttons
  candFilterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      candFilterButtons.forEach(b => {
        b.classList.remove('bg-slate-900', 'dark:bg-slate-100', 'text-white', 'dark:text-slate-950', 'font-bold');
        b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.add('bg-slate-900', 'dark:bg-slate-100', 'text-white', 'dark:text-slate-950', 'font-bold');
      btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');

      activeCandidate = btn.getAttribute('data-candidate') || 'all';
      applyPromisesFilters(true);
    });
  });

  // Status buttons
  statFilterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      statFilterButtons.forEach(b => {
        b.classList.remove('bg-slate-200', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'font-bold');
        b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.add('bg-slate-200', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'font-bold');
      btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300');

      activeStatus = btn.getAttribute('data-status') || 'all';
      applyPromisesFilters(true);
    });
  });

  // Search input
  if (promiseSearchInput) {
    promiseSearchInput.addEventListener('input', () => {
      promiseSearchQuery = promiseSearchInput.value.toLowerCase().trim();
      applyPromisesFilters(true);
    });
  }

  // Clear filters button
  if (clearPromisesFilterBtn) {
    clearPromisesFilterBtn.addEventListener('click', () => {
      const allCand = document.querySelector<HTMLButtonElement>('.cand-filter-btn[data-candidate="all"]');
      const allStat = document.querySelector<HTMLButtonElement>('.stat-filter-btn[data-status="all"]');
      if (allCand) allCand.click();
      if (allStat) allStat.click();
      if (promiseSearchInput) {
        promiseSearchInput.value = '';
        promiseSearchQuery = '';
      }
      applyPromisesFilters(true);
    });
  }

  // Initial execution: display exactly 4 promises on page 1
  applyPromisesFilters(true);

  // --- Citizen Voting Interaction (Unbiased: Results hidden until user votes) ---
  const citizenWidgets = document.querySelectorAll<HTMLElement>('.citizen-audit-widget');

  function renderCardPercentages(widget: HTMLElement, votes: { fulfilled: number; inProgress: number; broken: number }, activeVote?: string) {
    const total = (votes.fulfilled || 0) + (votes.inProgress || 0) + (votes.broken || 0);
    const fPct = total > 0 ? Math.round((votes.fulfilled / total) * 100) : 0;
    const ipPct = total > 0 ? Math.round((votes.inProgress / total) * 100) : 0;
    const bPct = total > 0 ? Math.round((votes.broken / total) * 100) : 0;

    // Show percentages inside buttons
    const countFulfilled = widget.querySelector<HTMLElement>('.count-fulfilled');
    const countInProgress = widget.querySelector<HTMLElement>('.count-in-progress');
    const countBroken = widget.querySelector<HTMLElement>('.count-broken');

    if (countFulfilled) {
      countFulfilled.textContent = `(${fPct}%)`;
      countFulfilled.classList.remove('hidden');
    }
    if (countInProgress) {
      countInProgress.textContent = `(${ipPct}%)`;
      countInProgress.classList.remove('hidden');
    }
    if (countBroken) {
      countBroken.textContent = `(${bPct}%)`;
      countBroken.classList.remove('hidden');
    }

    // Hide placeholder and reveal colorful bars
    const placeholder = widget.querySelector<HTMLElement>('.bar-placeholder');
    if (placeholder) placeholder.style.opacity = '0';

    const barF = widget.querySelector<HTMLElement>('.bar-fulfilled');
    const barIP = widget.querySelector<HTMLElement>('.bar-in-progress');
    const barB = widget.querySelector<HTMLElement>('.bar-broken');
    if (barF) {
      barF.style.width = `${fPct}%`;
      barF.style.opacity = '1';
    }
    if (barIP) {
      barIP.style.width = `${ipPct}%`;
      barIP.style.opacity = '1';
    }
    if (barB) {
      barB.style.width = `${bPct}%`;
      barB.style.opacity = '1';
    }

    // Update labels
    const title = widget.querySelector<HTMLElement>('.widget-title');
    const sub = widget.querySelector<HTMLElement>('.widget-sub');
    if (title) title.textContent = 'Tendencia Ciudadana';
    if (sub) {
      sub.textContent = total > 100 ? `${total} votos registrados` : 'Votación comunitaria activa';
    }

    // Highlight user selection
    if (activeVote) {
      const btns = widget.querySelectorAll<HTMLButtonElement>('.vote-btn');
      btns.forEach(b => {
        b.classList.remove('ring-2', 'ring-slate-900', 'dark:ring-white', 'font-bold');
        if (b.getAttribute('data-vote-type') === activeVote) {
          b.classList.add('ring-2', 'ring-slate-900', 'dark:ring-white', 'font-bold');
        }
      });
    }
  }

  // Check saved votes on load
  citizenWidgets.forEach(widget => {
    const promiseId = widget.getAttribute('data-promise-id');
    if (!promiseId) return;

    const savedVote = localStorage.getItem(`politicheck_vote_${promiseId}`);
    if (savedVote) {
      try {
        const rawVotes = widget.getAttribute('data-votes');
        const votes = rawVotes ? JSON.parse(rawVotes) : { fulfilled: 0, inProgress: 0, broken: 0 };
        renderCardPercentages(widget, votes, savedVote);
      } catch (e) {
        // fallback
      }
    }
  });

  // Handle vote button clicks
  const voteButtons = document.querySelectorAll<HTMLButtonElement>('.vote-btn');
  voteButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const promiseId = btn.getAttribute('data-promise-id');
      const voteType = btn.getAttribute('data-vote-type') as 'fulfilled' | 'inProgress' | 'broken';
      if (!promiseId || !voteType) return;

      const widget = btn.closest<HTMLElement>('.citizen-audit-widget');
      if (!widget) return;

      const previousVote = localStorage.getItem(`politicheck_vote_${promiseId}`);
      if (previousVote === voteType) return;

      // Optimistic highlight
      const btns = widget.querySelectorAll<HTMLButtonElement>('.vote-btn');
      btns.forEach(b => b.classList.remove('ring-2', 'ring-slate-900', 'dark:ring-white', 'font-bold'));
      btn.classList.add('ring-2', 'ring-slate-900', 'dark:ring-white', 'font-bold');

      try {
        const res = await fetch('/api/promises/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ promiseId, voteType })
        });

        if (res.ok) {
          const data = await res.json();
          if (data.success && data.promise && data.promise.votes) {
            localStorage.setItem(`politicheck_vote_${promiseId}`, voteType);
            widget.setAttribute('data-votes', JSON.stringify(data.promise.votes));
            renderCardPercentages(widget, data.promise.votes, voteType);

            // Viral Loop: Post-vote invitation toast (Aha moment)
            const cand = widget.closest('.promise-card')?.getAttribute('data-candidate') || 'este dirigente';
            const shareUrl = `${window.location.origin}/promesa/${promiseId}`;
            const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(`🗳️ Acabo de auditar el cumplimiento de campaña de ${cand} en Politicheck. ¿Vos qué opinás? Votá acá: ${shareUrl}`)}`;
            const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(`🗳️ Audité las promesas de campaña de ${cand} en @politicheck_ok. Sumá tu voto ciudadano sin sesgo:`)}&url=${encodeURIComponent(shareUrl)}`;

            if (typeof (window as any).showPoliticheckToast === 'function') {
              (window as any).showPoliticheckToast(
                '🎉 ¡Tu voto ciudadano fue registrado!',
                `Sumá más voces a la auditoría de ${cand}:`,
                '🗳️',
                [
                  { label: '📱 WhatsApp', url: waUrl, bg: 'bg-emerald-600 text-white' },
                  { label: '𝕏 Twitter', url: xUrl, bg: 'bg-black text-white dark:bg-slate-800' }
                ]
              );
            }
          }
        }
      } catch (err) {
        console.error('Error recording vote:', err);
      }
    });
  });

  // --- Viral Share Buttons Event Listeners ---
  document.querySelectorAll<HTMLElement>('.share-story-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const title = btn.getAttribute('data-title') || 'Contraste periodístico en Politicheck';
      const url = btn.getAttribute('data-url') || window.location.href;
      const text = btn.getAttribute('data-text') || `Mirá cómo cubrieron distintos diarios esta noticia: "${title}". Comparativa sin sesgo en Politicheck:`;
      const category = btn.getAttribute('data-category') || 'Contraste Mediático';
      if (typeof (window as any).sharePoliticheckContent === 'function') {
        (window as any).sharePoliticheckContent(title, text, url, category);
      }
    });
  });

  document.querySelectorAll<HTMLElement>('.share-promise-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const candidate = btn.getAttribute('data-candidate') || 'Dirigente';
      const text = btn.getAttribute('data-text') || '';
      const promiseId = btn.getAttribute('data-id');
      const url = btn.getAttribute('data-url') || (promiseId ? `${window.location.origin}/promesa/${promiseId}` : `${window.location.origin}#monitor-promesas`);
      if (typeof (window as any).sharePoliticheckContent === 'function') {
        (window as any).sharePoliticheckContent(`Compromiso de ${candidate}`, text, url, 'Auditoría Ciudadana');
      }
    });
  });

  // --- Dynamic Live News Auto-Refresh with Scroll Preservation ---
  // Only execute on Portada ('/' or '/index.html'), NEVER on /historia/:id
  if (window.location.pathname === '/' || window.location.pathname === '' || window.location.pathname.endsWith('/index.html')) {
    let initialSyncTimestamp: string | null = null;
    let initialLeadStoryId: string | null = null;
    let hasAlertShown = false;

    // Grab current server sync timestamp from header if present
    const syncTimeEl = document.getElementById('sync-time-ago');
    if (syncTimeEl) {
      initialSyncTimestamp = syncTimeEl.getAttribute('data-server-sync') || null;
    }

    // Auto-refresh interval (every 45 seconds)
    const REFRESH_INTERVAL_MS = 45 * 1000;

    async function checkForNewsUpdates() {
      // If user is navigating away or in subpage like /historia/:id, abort
      if (window.location.pathname !== '/' && window.location.pathname !== '' && !window.location.pathname.endsWith('/index.html')) {
        return;
      }

      try {
        const res = await fetch('/api/news/latest', { cache: 'no-store' });
        if (!res.ok) return;

        const data = await res.json();
        if (!data.success) return;

        // Dynamic Breaking News Update
        if (data.breakingAlert && typeof (window as any).updateBreakingNewsBanner === 'function') {
          (window as any).updateBreakingNewsBanner(data.breakingAlert);
        }

        // Initialize baseline if not set yet
        if (!initialSyncTimestamp && data.lastSyncTimestamp) {
          initialSyncTimestamp = data.lastSyncTimestamp;
        }
        if (!initialLeadStoryId && data.leadStoryId) {
          initialLeadStoryId = data.leadStoryId;
        }

        // Check: If a sync occurred on the server (Vercel Cron or server self-healing)
        const syncTimestampChanged = initialSyncTimestamp && data.lastSyncTimestamp && (data.lastSyncTimestamp !== initialSyncTimestamp);
        const leadStoryChanged = initialLeadStoryId && data.leadStoryId && (data.leadStoryId !== initialLeadStoryId);

        if (syncTimestampChanged || leadStoryChanged) {
          triggerLiveRefresh();
        }
      } catch (err) {
        // Silent network fallback
      }
    }

    function triggerLiveRefresh() {
      if (hasAlertShown) return;
      hasAlertShown = true;

      // If user is at or near the top of the page (general browsing), refresh automatically!
      if (window.scrollY < 250) {
        const currentY = window.scrollY;
        sessionStorage.setItem('politicheck_restore_scroll', currentY.toString());
        window.location.reload();
      } else {
        // If user is scrolled down reading an article or auditing a promise, show polite floating pill
        showFloatingNewsAlert();
      }
    }

    function showFloatingNewsAlert() {
      let alertEl = document.getElementById('live-news-update-pill');
      if (!alertEl) {
        alertEl = document.createElement('div');
        alertEl.id = 'live-news-update-pill';
        alertEl.className = 'fixed bottom-6 right-6 z-50 flex items-center gap-3 px-4 py-2.5 rounded-2xl bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-950 font-mono text-xs font-bold shadow-2xl border border-slate-700 dark:border-slate-300 transition-all transform translate-y-0 animate-bounce cursor-pointer';
        alertEl.innerHTML = `
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
          <span>🔴 Hay noticias y aperturas de tapa nuevas</span>
          <button class="ml-2 px-2.5 py-1 rounded bg-slate-800 dark:bg-slate-200 text-[10px] text-white dark:text-slate-900 font-bold hover:underline">Actualizar ahora</button>
        `;
        
        alertEl.addEventListener('click', () => {
          const currentY = window.scrollY;
          sessionStorage.setItem('politicheck_restore_scroll', currentY.toString());
          window.location.reload();
        });

        // Also if user scrolls back up near the top, auto-refresh
        window.addEventListener('scroll', () => {
          if (window.scrollY < 200) {
            const currentY = window.scrollY;
            sessionStorage.setItem('politicheck_restore_scroll', currentY.toString());
            window.location.reload();
          }
        }, { passive: true });

        document.body.appendChild(alertEl);
      }
    }

    // Restore scroll position after a reload
    const restoreScroll = sessionStorage.getItem('politicheck_restore_scroll');
    if (restoreScroll) {
      sessionStorage.removeItem('politicheck_restore_scroll');
      const y = parseInt(restoreScroll, 10);
      if (!isNaN(y)) {
        window.scrollTo({ top: y, behavior: 'instant' });
      }
    }

    // Check after 3 seconds, then poll every REFRESH_INTERVAL_MS
    setTimeout(checkForNewsUpdates, 3000);
    setInterval(checkForNewsUpdates, REFRESH_INTERVAL_MS);
  }
</script>

<style is:global>
  /* Promoted Lead Story styling when inside #lead-story-slot */
  #lead-story-slot article {
    padding: 1.5rem !important;
  }
  @media (min-width: 640px) {
    #lead-story-slot article {
      padding: 2rem !important;
    }
  }
  #lead-story-slot .story-img-wrapper .aspect-video {
    max-height: 420px !important;
  }
  #lead-story-slot h3.font-editorial {
    font-size: 1.75rem !important;
    line-height: 2.25rem !important;
  }
  @media (min-width: 768px) {
    #lead-story-slot h3.font-editorial {
      font-size: 2.25rem !important;
      line-height: 2.5rem !important;
    }
    #lead-story-slot .articles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }
  #lead-story-slot .story-expandable-block .expandable-text {
    -webkit-line-clamp: unset !important;
    display: block !important;
    font-size: 1.05rem !important;
    line-height: 1.625rem !important;
  }
  #lead-story-slot .story-expandable-block .btn-toggle-expand {
    display: none !important;
  }
</style>

