---
import Layout from '../../layouts/Layout.astro';
import SpectrumBar from '../../components/SpectrumBar.astro';
import HeadlineComparison from '../../components/HeadlineComparison.astro';
import StoryCivicForum from '../../components/StoryCivicForum.astro';
import { getStoryClusterByIdAsync } from '../../services/ai/clustering';
import { getForumComments } from '../../services/supabase';
import { getOptimizedImageUrl, isValidNewsImageUrl } from '../../utils/image';

export const prerender = false;

const { id } = Astro.params;
const story = id ? await getStoryClusterByIdAsync(id) : undefined;
Astro.response.headers.set(
  'Cache-Control',
  story ? 'public, s-maxage=3600, stale-while-revalidate=86400' : 'public, s-maxage=60'
);

// Fetch initial comments once and reuse for both counter (ADR-0007 / Fix #9) and StoryCivicForum
const initialComments = story ? await getForumComments(story.id, 'top') : [];
const totalContributions = initialComments.reduce((acc, c) => acc + 1 + (c.replies?.length || 0), 0);

const isBrazilStory = Boolean(story?.id?.startsWith('brasil-'));
const backHref = isBrazilStory ? '/elecciones-brasil' : '/';
const backLabel = isBrazilStory ? 'Volver al Especial Brasil 2026' : 'Volver a la Portada';
const resolvedHeroImage = story
  ? isValidNewsImageUrl(story.imageUrl)
    ? story.imageUrl!
    : (story.articles || []).find((a) => isValidNewsImageUrl(a.imageUrl))?.imageUrl || ''
  : '';
const optimizedHeroImage = resolvedHeroImage ? getOptimizedImageUrl(resolvedHeroImage, 1000, 75) : undefined;

const topOutlets = story ? story.articles.slice(0, 4).map(a => a.outletName) : [];
const outletsText = topOutlets.length > 1
  ? `${topOutlets.slice(0, -1).join(', ')} y ${topOutlets[topOutlets.length - 1]}`
  : topOutlets[0] || 'múltiples redacciones';

// Non-partisan spectrum text (ADR-0008 — no partisan color circles)
const spectrumText = story
  ? `Espectro: Oficialismo ${story.spectrum.oficialismoPct}% · Centro ${story.spectrum.centroDatosPct}% · Oposición ${story.spectrum.oposicionPct}%.`
  : '';
const metaDesc = story
  ? `${story.summary} Cotejo de ${story.articles.length} medios (${outletsText}). ${spectrumText}`
  : undefined;
const pageUrl = `https://www.politicheck.com.ar/historia/${id}`;
const cleanHeadline = (story?.neutralHeadline || '').length > 110
  ? story!.neutralHeadline.slice(0, 110).trim().replace(/[,.:;]+$/, '') + '...'
  : (story?.neutralHeadline || '');
const viralShareText = story
  ? `"${cleanHeadline}"\n\nMedios: ${outletsText}\n${spectrumText}\n\nComparativa de encuadres en Politicheck:`
  : '';

const OUTLET_GUIDES = [
  { match: ['clarin', 'clarín', 'todo noticias', 'tn'], slug: 'quien-es-el-dueno-de-clarin', label: 'Quién es el dueño de Clarín y su grupo económico' },
  { match: ['la nacion', 'la nación', 'ln+'], slug: 'quien-es-el-dueno-de-la-nacion', label: 'Quién es el dueño de La Nación y LN+' },
  { match: ['infobae'], slug: 'quien-es-el-dueno-de-infobae', label: 'Quién es el dueño de Infobae y cómo se financia' },
  { match: ['ambito', 'ámbito', 'c5n'], slug: 'quien-es-el-dueno-de-ambito-financiero', label: 'Quién es el dueño de Ámbito Financiero y C5N' },
  { match: ['cronista', 'america', 'américa', 'a24'], slug: 'quien-es-el-dueno-de-grupo-america-el-cronista', label: 'Quién es el dueño de Grupo América y El Cronista' },
  { match: ['pagina', 'página', 'ip noticias'], slug: 'quien-es-el-dueno-de-pagina-12', label: 'Quién es el dueño de Página/12 y Grupo Octubre' },
  { match: ['perfil'], slug: 'quien-es-el-dueno-de-editorial-perfil', label: 'Quién es el dueño de Editorial Perfil' },
];

const matchedGuides = story
  ? OUTLET_GUIDES.filter((g) =>
      story.articles.some((a) => {
        const name = (a.outletName || '').toLowerCase();
        return g.match.some((kw) => name.includes(kw));
      })
    )
  : [];
---

<Layout
  title={story ? `${story.neutralHeadline} • Comparativa de Medios | Politicheck` : 'Historia no encontrada | Politicheck'}
  description={metaDesc}
  image={resolvedHeroImage || undefined}
  canonicalUrl={pageUrl}
  ogType="article"
  preloadImage={optimizedHeroImage}
>
  {story ? (
    <article class="max-w-4xl mx-auto space-y-7 pb-16">
      <!-- 1. Breadcrumb & Back button -->
      <nav class="flex items-center justify-between text-xs font-mono border-b border-rule pb-3">
        <a
          href={backHref}
          class="inline-flex items-center gap-1.5 text-ink-muted hover:text-ink font-semibold transition-colors"
        >
          <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>{backLabel}</span>
        </a>

        <div class="flex items-center gap-2 text-ink-muted">
          <span>{story.category}</span>
          <span aria-hidden="true">·</span>
          <span>Actualizado: {story.updatedAt}</span>
        </div>
      </nav>

      <!-- 2. Header (Volanta + Titular + Síntesis) -->
      <header class="space-y-3.5">
        {story.kicker && (
          <div class="inline-flex items-center px-2.5 py-0.5 rounded-md bg-surface-muted border border-rule text-[11px] font-sans font-bold uppercase tracking-wider text-accent">
            {story.kicker}
          </div>
        )}

        <h1 class="font-editorial text-3xl sm:text-4xl md:text-[2.75rem] font-bold text-ink leading-[1.12] tracking-tight min-w-0 break-words">
          {story.neutralHeadline}
        </h1>

        <p class="text-base sm:text-lg text-ink-secondary leading-relaxed font-sans">
          {story.summary}
        </p>
      </header>

      <!-- 2b. Press Photo (Compact 16:9 editorial framing, prioritizing upper-center for portraits) -->
      {optimizedHeroImage && (
        <figure class="space-y-2">
          <div class="overflow-hidden rounded-md border border-rule bg-surface-muted aspect-video max-h-[360px] w-full">
            <img
              src={optimizedHeroImage}
              data-original-src={resolvedHeroImage}
              alt={story.neutralHeadline}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1000"
              height="562"
              class="w-full h-full object-cover object-[50%_20%]"
              referrerpolicy="no-referrer"
              onerror="if (this.dataset.retry !== '1') { this.dataset.retry = '1'; this.setAttribute('src', this.dataset.originalSrc); } else { this.closest('figure')?.style.setProperty('display', 'none'); }"
            />
          </div>
          {story.imageCaption && (
            <figcaption class="text-xs font-sans italic text-ink-muted">
              {story.imageCaption}
            </figcaption>
          )}
        </figure>
      )}

      <!-- 3. Lectura Rápida: SpectrumBar + Dictamen IA (Unificado — Fix #9) -->
      <section class="bg-surface border border-rule rounded-md p-5 sm:p-6 space-y-5">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-rule pb-2.5">
            <h2 class="font-sans text-xs font-bold uppercase tracking-wider text-ink">
              Distribución del espectro editorial ({story.articles.length} medios)
            </h2>
            <span class="text-[11px] font-mono text-ink-muted">Clic en un polo para filtrar</span>
          </div>
          <SpectrumBar spectrum={story.spectrum} articles={story.articles} />
        </div>

        {story.aiComparisonNotice && (
          <div class="pt-4 border-t border-rule space-y-2">
            <div class="font-sans text-xs font-bold uppercase tracking-wider text-accent">
              Dictamen de encuadres mediáticos (Auditoría de IA)
            </div>
            <p class="text-sm sm:text-base text-ink-secondary leading-relaxed font-sans">
              {story.aiComparisonNotice}
            </p>
          </div>
        )}
      </section>

      <!-- 4. Comparador Cara a Cara / Cobertura Comparada por Medio (Valor central — Fix #8 & #9) -->
      <section id="comparativa" class="space-y-4 scroll-mt-20">
        <div class="flex items-baseline justify-between border-b border-rule-strong pb-2.5">
          <h2 class="font-editorial text-2xl font-bold text-ink">
            Cobertura Comparada por Medio
          </h2>
          <span class="font-mono text-xs text-ink-muted">{story.articles.length} noticias cotejadas</span>
        </div>

        <HeadlineComparison articles={story.articles} storyId={story.id} isLeadStory={true} />
      </section>

      <!-- 5. Share & Debate Bar (After reading the contrast, with real (N) count per ADR-0007 / Fix #9) -->
      <section class="flex flex-wrap items-center justify-between gap-3 p-4 sm:p-5 rounded-md bg-surface-muted border border-rule">
        <div class="flex items-center gap-2">
          <span class="text-xs sm:text-sm font-sans font-semibold text-ink">
            ¿Querés compartir o debatir este contraste de redacciones?
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(viralShareText + ' ' + pageUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-surface border border-rule hover:border-ink text-ink font-sans text-xs font-semibold transition-colors"
          >
            WhatsApp
          </a>

          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(viralShareText)}&url=${encodeURIComponent(pageUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-ink text-canvas hover:opacity-90 font-sans text-xs font-semibold transition-opacity"
          >
            <span class="font-mono">𝕏</span>
            <span>Publicar</span>
          </a>

          <a
            href={`https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(viralShareText)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-surface border border-rule hover:border-ink text-ink font-sans text-xs font-semibold transition-colors"
          >
            Telegram
          </a>

          <a
            href="#debate-civico"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-accent text-white hover:opacity-90 font-sans text-xs font-semibold transition-opacity cursor-pointer"
          >
            <span>Debate Cívico ({totalContributions})</span>
          </a>

          <button
            type="button"
            id="copy-story-link-btn"
            data-url={pageUrl}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-rule bg-surface text-ink hover:border-ink font-sans text-xs font-semibold transition-colors cursor-pointer"
          >
            <span id="copy-story-btn-text">Copiar enlace</span>
          </button>
        </div>
      </section>

      <!-- 7. Contextual Internal Links to Media Ownership Guides -->
      <section class="bg-surface border border-rule rounded-md p-5 sm:p-6 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="font-editorial text-lg font-bold text-ink">
            ¿Quiénes están detrás de estos medios?
          </h3>
          <a
            href="/guias/mapa-de-medios-argentina"
            class="text-xs font-mono font-semibold text-accent hover:underline"
          >
            Ver mapa completo de medios →
          </a>
        </div>
        <p class="text-xs sm:text-sm text-ink-secondary font-sans">
          Consultá la estructura societaria, los grupos económicos propietarios y la auditoría de sesgo de las redacciones citadas en esta cobertura:
        </p>
        <div class="flex flex-wrap gap-2 pt-1">
          {matchedGuides.map((guide) => (
            <a
              href={`/guias/${guide.slug}`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-surface-muted border border-rule hover:border-accent text-xs font-sans font-medium text-ink transition-colors"
            >
              <span>{guide.label}</span>
            </a>
          ))}
          {matchedGuides.length === 0 && (
            <a
              href="/guias"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-surface-muted border border-rule hover:border-accent text-xs font-sans font-medium text-ink transition-colors"
            >
              <span>Explorar todas las guías de propiedad y sesgo de medios en Argentina</span>
            </a>
          )}
        </div>
      </section>

      <!-- 8. Story Civic Forum -->
      <StoryCivicForum storyId={story.id} storyTitle={story.neutralHeadline} initialComments={initialComments} />
    </article>
  ) : (
    <div class="max-w-xl mx-auto text-center py-24 space-y-4">
      <h1 class="font-editorial text-2xl font-bold text-ink">
        Historia no encontrada
      </h1>
      <p class="text-xs text-ink-muted font-sans">
        El identificador solicitado no coincide con los clusters activos del día.
      </p>
      <a
        href="/"
        class="inline-block px-4 py-2 rounded-md bg-ink text-canvas font-mono text-xs font-bold"
      >
        Volver a la Portada
      </a>
    </div>
  )}
</Layout>

<script>
  const copyBtn = document.getElementById('copy-story-link-btn');
  const copyBtnText = document.getElementById('copy-story-btn-text');
  if (copyBtn && copyBtnText) {
    copyBtn.addEventListener('click', () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        copyBtnText.textContent = '¡Enlace copiado!';
        setTimeout(() => {
          copyBtnText.textContent = 'Copiar enlace';
        }, 2500);
      });
    });
  }
</script>
