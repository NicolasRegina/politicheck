---
import Layout from '../../layouts/Layout.astro';
import SpectrumBar from '../../components/SpectrumBar.astro';
import HeadlineComparison from '../../components/HeadlineComparison.astro';
import StoryCivicForum from '../../components/StoryCivicForum.astro';
import { getStoryClusterByIdAsync } from '../../services/ai/clustering';
import { getOptimizedImageUrl } from '../../utils/image';

export const prerender = false;

const { id } = Astro.params;
const story = id ? await getStoryClusterByIdAsync(id) : undefined;
Astro.response.headers.set(
  'Cache-Control',
  story ? 'public, s-maxage=3600, stale-while-revalidate=86400' : 'public, s-maxage=60'
);
const isBrazilStory = Boolean(story?.id?.startsWith('brasil-'));
const backHref = isBrazilStory ? '/elecciones-brasil' : '/';
const backLabel = isBrazilStory ? 'Volver al Especial Brasil 2026' : 'Volver a la Portada';
const optimizedHeroImage = story?.imageUrl ? getOptimizedImageUrl(story.imageUrl, 1000, 75) : undefined;

const topOutlets = story ? story.articles.slice(0, 4).map(a => a.outletName) : [];
const outletsText = topOutlets.length > 1
  ? `${topOutlets.slice(0, -1).join(', ')} y ${topOutlets[topOutlets.length - 1]}`
  : topOutlets[0] || 'múltiples redacciones';
const spectrumText = story 
  ? `Espectro: 🟣 ${story.spectrum.oficialismoPct}% Oficialismo | 🟢 ${story.spectrum.centroDatosPct}% Centro | 🟠 ${story.spectrum.oposicionPct}% Oposición.`
  : '';
const metaDesc = story 
  ? `${story.summary} Cotejo de ${story.articles.length} medios (${outletsText}). ${spectrumText}`
  : undefined;
const pageUrl = `https://www.politicheck.com.ar/historia/${id}`;
const cleanHeadline = (story?.neutralHeadline || '').length > 110
  ? story!.neutralHeadline.slice(0, 110).trim().replace(/[,.:;]+$/, '') + '...'
  : (story?.neutralHeadline || '');
const viralShareText = story
  ? `🗞️ "${cleanHeadline}"\n\nMedios: ${outletsText}\n📊 Espectro: 🟣 ${story.spectrum.oficialismoPct}% | 🟢 ${story.spectrum.centroDatosPct}% | 🟠 ${story.spectrum.oposicionPct}%\n\n👉 Comparativa sin sesgo:`
  : '';

const OUTLET_GUIDES = [
  { match: ['clarin', 'clarín', 'todo noticias', 'tn'], slug: 'quien-es-el-dueno-de-clarin', label: 'Quién es el dueño de Clarín y su grupo económico' },
  { match: ['la nacion', 'la nación', 'ln+'], slug: 'quien-es-el-dueno-de-la-nacion', label: 'Quién es el dueño de La Nación y LN+' },
  { match: ['infobae'], slug: 'quien-es-el-dueno-de-infobae', label: 'Quién es el dueño de Infobae y cómo se financia' },
  { match: ['ambito', 'ámbito', 'c5n'], slug: 'quien-es-el-dueno-de-ambito-financiero', label: 'Quién es el dueño de Ámbito Financiero y C5N' },
  { match: ['cronista', 'america', 'américa', 'a24'], slug: 'quien-es-el-dueno-de-grupo-america-el-cronista', label: 'Quién es el dueño de Grupo América y El Cronista' },
  { match: ['pagina', 'página', 'ip noticias'], slug: 'quien-es-el-dueno-de-pagina-12', label: 'Quién es el dueño de Página/12 y Grupo Octubre' },
  { match: ['perfil'], slug: 'quien-es-el-dueno-de-editorial-perfil', label: 'Quién es el dueño de Editorial Perfil' },
];

const matchedGuides = story
  ? OUTLET_GUIDES.filter((g) =>
      story.articles.some((a) => {
        const name = (a.outletName || '').toLowerCase();
        return g.match.some((kw) => name.includes(kw));
      })
    )
  : [];
---

<Layout 
  title={story ? `${story.neutralHeadline} • Comparativa de Medios | Politicheck` : 'Historia no encontrada | Politicheck'}
  description={metaDesc}
  image={story?.imageUrl}
  canonicalUrl={pageUrl}
  ogType="article"
  preloadImage={optimizedHeroImage}
>
  {story ? (
    <article class="max-w-4xl mx-auto space-y-8 pb-16">
      <!-- Breadcrumb & Back button -->
      <nav class="flex items-center justify-between text-xs font-mono border-b border-slate-200 dark:border-slate-800 pb-3">
        <a 
          href={backHref} 
          class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-slate-950 dark:hover:text-white font-bold transition-colors"
        >
          <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>{backLabel}</span>
        </a>

        <div class="flex items-center gap-2 text-slate-400 dark:text-slate-500">
          <span>{story.category}</span>
          <span aria-hidden="true">|</span>
          <span>Actualizado: {story.updatedAt}</span>
        </div>
      </nav>

      <!-- Header & Volanta -->
      <header class="space-y-4">
        {story.kicker && (
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800/90 text-xs font-sans font-semibold text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700">
            <span>{story.kicker}</span>
          </div>
        )}

        <h1 class="font-editorial text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-950 dark:text-white leading-[1.15] tracking-tight min-w-0 break-words">
          {story.neutralHeadline}
        </h1>

        <p class="text-lg sm:text-xl text-slate-700 dark:text-slate-300 leading-relaxed font-sans font-light">
          {story.summary}
        </p>
      </header>

      <!-- Viral Contrast Share Bar -->
      <section class="flex flex-wrap items-center justify-between gap-3 p-4 sm:p-5 rounded-2xl bg-slate-100/90 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" class="w-4 h-4 text-slate-600 dark:text-slate-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
          <span class="text-xs font-sans font-medium text-slate-800 dark:text-slate-200">
            ¿Querés debatir este contraste de redacciones?
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a 
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(viralShareText + ' ' + pageUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-sans text-xs font-bold shadow-2xs transition-colors"
          >
            <span>WhatsApp</span>
          </a>

          <a 
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(viralShareText)}&url=${encodeURIComponent(pageUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-black hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-200 text-white dark:text-black font-sans text-xs font-bold shadow-2xs transition-colors"
          >
            <span class="font-mono">𝕏</span>
            <span>Twitter</span>
          </a>

          <a 
            href={`https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(viralShareText)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-sky-500 hover:bg-sky-600 text-white font-sans text-xs font-bold shadow-2xs transition-colors"
          >
            <span>Telegram</span>
          </a>

          <a 
            href="#debate-civico"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 font-sans text-xs font-semibold transition-colors cursor-pointer"
          >
            <span>Debate Cívico</span>
          </a>

          <button 
            type="button"
            id="copy-story-link-btn"
            data-url={pageUrl}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 font-sans text-xs font-semibold transition-colors cursor-pointer"
          >
            <span id="copy-story-btn-text">Copiar enlace</span>
          </button>
        </div>
      </section>

      <!-- Lead Press Photo -->
      {story.imageUrl && (
        <figure class="space-y-2.5">
          <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 max-h-[520px]">
            <img 
              src={optimizedHeroImage} 
              data-original-src={story.imageUrl}
              alt={story.neutralHeadline}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1000"
              height="562"
              class="w-full h-full object-cover object-center"
              referrerpolicy="no-referrer"
              onerror="if (this.dataset.retry !== '1') { this.dataset.retry = '1'; this.setAttribute('src', this.dataset.originalSrc); } else { this.closest('figure')?.style.setProperty('display', 'none'); }"
            />
          </div>
          {story.imageCaption && (
            <figcaption class="text-xs font-mono text-slate-500 dark:text-slate-400 pl-1 leading-normal">
              {story.imageCaption}
            </figcaption>
          )}
        </figure>
      )}

      <!-- Media Spectrum Breakdown -->
      <section class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-800/90 rounded-2xl p-6 space-y-4 shadow-2xs">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
          <h3 class="font-sans text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-2">
            <svg aria-hidden="true" class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Distribución del espectro editorial ({story.articles.length} medios analizados)</span>
          </h3>
          <span class="text-[11px] font-sans text-slate-400">Algoritmo Politicheck</span>
        </div>

        <SpectrumBar spectrum={story.spectrum} articles={story.articles} />
      </section>

      <!-- AI Framing Synthesis Notice -->
      {story.aiComparisonNotice && (
        <section class="bg-slate-50 dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 rounded-2xl p-6 space-y-3 shadow-2xs">
          <div class="flex items-center gap-2 font-sans text-xs font-bold text-slate-800 dark:text-slate-200">
            <svg aria-hidden="true" class="w-4 h-4 text-slate-700 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
            <span>Dictamen de encuadres mediáticos (Auditoría de IA)</span>
          </div>
          <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed font-sans">
            {story.aiComparisonNotice}
          </p>
        </section>
      )}

      <!-- Side-by-side Outlet Headlines Matrix with Leaning Filter & Pagination -->
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
          <h2 class="font-editorial text-2xl font-bold text-slate-950 dark:text-white">
            Cobertura Comparada por Diario
          </h2>
          <span class="font-mono text-xs text-slate-500">{story.articles.length} artículos cotejados</span>
        </div>

        <HeadlineComparison articles={story.articles} storyId={story.id} isLeadStory={true} />
      </section>

      <!-- Contextual Internal Links to Media Ownership Guides -->
      <section class="bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 sm:p-6 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="font-editorial text-lg font-bold text-slate-950 dark:text-white">
            ¿Quiénes están detrás de estos medios?
          </h3>
          <a
            href="/guias/mapa-de-medios-argentina"
            class="text-xs font-mono font-semibold text-arg-blue hover:underline"
          >
            Ver mapa completo de medios argentinos
          </a>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-sans">
          Consultá la estructura societaria, los grupos económicos propietarios y la auditoría de sesgo de las redacciones citadas en esta cobertura:
        </p>
        <div class="flex flex-wrap gap-2 pt-1">
          {matchedGuides.map((guide) => (
            <a
              href={`/guias/${guide.slug}`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-arg-blue dark:hover:border-arg-blue text-xs font-sans font-medium text-slate-800 dark:text-slate-200 transition-colors"
            >
              <span>{guide.label}</span>
            </a>
          ))}
          {matchedGuides.length === 0 && (
            <a
              href="/guias"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-arg-blue dark:hover:border-arg-blue text-xs font-sans font-medium text-slate-800 dark:text-slate-200 transition-colors"
            >
              <span>Explorar todas las guías de propiedad y sesgo de medios en Argentina</span>
            </a>
          )}
        </div>
      </section>

      <!-- Story Civic Forum: Ciudadanía, Contraste de Fuentes & Deliberación -->
      <StoryCivicForum storyId={story.id} storyTitle={story.neutralHeadline} />
    </article>

  ) : (
    <div class="max-w-xl mx-auto text-center py-24 space-y-4">
      <div class="flex justify-center text-slate-400" aria-hidden="true">
        <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
      </div>
      <h1 class="font-editorial text-2xl font-bold text-slate-950 dark:text-white">
        Historia no encontrada
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 font-sans">
        El identificador solicitado no coincide con los clusters activos del día.
      </p>
      <a 
        href="/" 
        class="inline-block px-4 py-2 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-mono text-xs font-bold"
      >
        Volver a la Portada
      </a>
    </div>
  )}
</Layout>

<script>
  const copyBtn = document.getElementById('copy-story-link-btn');
  const copyBtnText = document.getElementById('copy-story-btn-text');
  if (copyBtn && copyBtnText) {
    copyBtn.addEventListener('click', () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        copyBtnText.textContent = '¡Enlace copiado!';
        setTimeout(() => {
          copyBtnText.textContent = 'Copiar enlace';
        }, 2500);
      });
    });
  }
</script>
