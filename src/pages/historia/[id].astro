---
import Layout from '../../layouts/Layout.astro';
import SpectrumBar from '../../components/SpectrumBar.astro';
import HeadlineComparison from '../../components/HeadlineComparison.astro';
import StoryCivicForum from '../../components/StoryCivicForum.astro';
import { getStoryClusterByIdAsync } from '../../services/ai/clustering';
import { getOptimizedImageUrl } from '../../utils/image';

export const prerender = false;

const { id } = Astro.params;
const story = id ? await getStoryClusterByIdAsync(id) : undefined;
const optimizedHeroImage = story?.imageUrl ? getOptimizedImageUrl(story.imageUrl, 1000, 75) : undefined;

const topOutlets = story ? story.articles.slice(0, 4).map(a => a.outletName) : [];
const outletsText = topOutlets.length > 1
  ? `${topOutlets.slice(0, -1).join(', ')} y ${topOutlets[topOutlets.length - 1]}`
  : topOutlets[0] || 'múltiples redacciones';
const spectrumText = story 
  ? `Espectro: 🟣 ${story.spectrum.oficialismoPct}% Oficialismo | 🟢 ${story.spectrum.centroDatosPct}% Centro | 🟠 ${story.spectrum.oposicionPct}% Oposición.`
  : '';
const metaDesc = story 
  ? `${story.summary} Cotejo de ${story.articles.length} medios (${outletsText}). ${spectrumText}`
  : undefined;
const pageUrl = `https://www.politicheck.com.ar/historia/${id}`;
const cleanHeadline = (story?.neutralHeadline || '').length > 110
  ? story!.neutralHeadline.slice(0, 110).trim().replace(/[,.:;]+$/, '') + '...'
  : (story?.neutralHeadline || '');
const viralShareText = story
  ? `🗞️ "${cleanHeadline}"\n\nMedios: ${outletsText}\n📊 Espectro: 🟣 ${story.spectrum.oficialismoPct}% | 🟢 ${story.spectrum.centroDatosPct}% | 🟠 ${story.spectrum.oposicionPct}%\n\n👉 Comparativa sin sesgo:`
  : '';
---

<Layout 
  title={story ? `${story.neutralHeadline} • Comparativa de Medios | Politicheck` : 'Historia no encontrada | Politicheck'}
  description={metaDesc}
  image={story?.imageUrl}
  canonicalUrl={pageUrl}
  ogType="article"
  preloadImage={optimizedHeroImage}
>
  {story ? (
    <article class="max-w-4xl mx-auto space-y-8 pb-16">
      <!-- Breadcrumb & Back button -->
      <nav class="flex items-center justify-between text-xs font-mono border-b border-slate-200 dark:border-slate-800 pb-3">
        <a 
          href="/" 
          class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-slate-950 dark:hover:text-white font-bold transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Volver a la Portada</span>
        </a>

        <div class="flex items-center gap-2 text-slate-400 dark:text-slate-500">
          <span>{story.category}</span>
          <span>•</span>
          <span>Actualizado: {story.updatedAt}</span>
        </div>
      </nav>

      <!-- Header & Volanta -->
      <header class="space-y-4">
        {story.kicker && (
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800/90 text-[11px] font-mono font-bold tracking-widest uppercase text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-900 dark:bg-white"></span>
            <span>{story.kicker}</span>
          </div>
        )}

        <h1 class="font-editorial text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-950 dark:text-white leading-[1.15] tracking-tight">
          {story.neutralHeadline}
        </h1>

        <p class="text-lg sm:text-xl text-slate-700 dark:text-slate-300 leading-relaxed font-sans font-light">
          {story.summary}
        </p>
      </header>

      <!-- Viral Contrast Share Bar -->
      <section class="flex flex-wrap items-center justify-between gap-3 p-4 sm:p-5 rounded-2xl bg-slate-100/90 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-2">
          <span class="text-base">📣</span>
          <span class="text-xs font-mono font-medium text-slate-800 dark:text-slate-200">
            ¿Querés debatir este contraste de redacciones?
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a 
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(viralShareText + ' ' + pageUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-mono text-xs font-bold shadow-2xs transition-all"
          >
            <span>📱 WhatsApp</span>
          </a>

          <a 
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(viralShareText)}&url=${encodeURIComponent(pageUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-black hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-200 text-white dark:text-black font-mono text-xs font-bold shadow-2xs transition-all"
          >
            <span>𝕏 Twitter</span>
          </a>

          <a 
            href={`https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(viralShareText)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-sky-500 hover:bg-sky-600 text-white font-mono text-xs font-bold shadow-2xs transition-all"
          >
            <span>✈️ Telegram</span>
          </a>

          <a 
            href="#debate-civico"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 font-mono text-xs font-semibold transition-all cursor-pointer"
          >
            <span>💬 Debate Cívico</span>
          </a>

          <button 
            type="button"
            id="copy-story-link-btn"
            data-url={pageUrl}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 font-mono text-xs font-semibold transition-all cursor-pointer"
          >
            <span id="copy-story-btn-text">🔗 Copiar enlace</span>
          </button>
        </div>
      </section>

      <!-- Lead Press Photo -->
      {story.imageUrl && (
        <figure class="space-y-2.5">
          <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 max-h-[520px]">
            <img 
              src={optimizedHeroImage} 
              data-original-src={story.imageUrl}
              alt={story.neutralHeadline}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1000"
              height="562"
              class="w-full h-full object-cover object-center"
              referrerpolicy="no-referrer"
              onerror="if (this.dataset.retry !== '1') { this.dataset.retry = '1'; this.setAttribute('src', this.dataset.originalSrc); } else { this.closest('figure')?.style.setProperty('display', 'none'); }"
            />
          </div>
          {story.imageCaption && (
            <figcaption class="text-xs font-mono text-slate-500 dark:text-slate-400 pl-1 leading-normal">
              {story.imageCaption}
            </figcaption>
          )}
        </figure>
      )}

      <!-- Media Spectrum Breakdown -->
      <section class="bg-white dark:bg-[#0F1420] border border-slate-200 dark:border-slate-800/90 rounded-2xl p-6 space-y-4 shadow-2xs">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Distribución del Espectro Editorial ({story.articles.length} medios analizados)</span>
          </h3>
          <span class="text-[11px] font-mono text-slate-400">Algoritmo Politicheck</span>
        </div>

        <SpectrumBar spectrum={story.spectrum} articles={story.articles} />
      </section>

      <!-- AI Framing Synthesis Notice -->
      {story.aiComparisonNotice && (
        <section class="bg-slate-50 dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 rounded-2xl p-6 space-y-3 shadow-2xs">
          <div class="flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">
            <svg class="w-4 h-4 text-slate-700 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
            <span>Dictamen de Encuadres Mediáticos (Auditoría de IA)</span>
          </div>
          <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed font-sans">
            {story.aiComparisonNotice}
          </p>
        </section>
      )}

      <!-- Side-by-side Outlet Headlines Matrix with Leaning Filter & Pagination -->
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
          <h2 class="font-editorial text-2xl font-bold text-slate-950 dark:text-white">
            Cobertura Comparada por Diario
          </h2>
          <span class="font-mono text-xs text-slate-500">{story.articles.length} artículos cotejados</span>
        </div>

        <HeadlineComparison articles={story.articles} storyId={story.id} isLeadStory={true} />
      </section>

      <!-- Story Civic Forum: Ciudadanía, Contraste de Fuentes & Deliberación -->
      <StoryCivicForum storyId={story.id} storyTitle={story.neutralHeadline} />
    </article>

  ) : (
    <div class="max-w-xl mx-auto text-center py-24 space-y-4">
      <div class="text-4xl">📰</div>
      <h1 class="font-editorial text-2xl font-bold text-slate-950 dark:text-white">
        Historia no encontrada
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 font-sans">
        El identificador solicitado no coincide con los clusters activos del día.
      </p>
      <a 
        href="/" 
        class="inline-block px-4 py-2 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-mono text-xs font-bold"
      >
        Volver a la Portada
      </a>
    </div>
  )}
</Layout>

<script>
  const copyBtn = document.getElementById('copy-story-link-btn');
  const copyBtnText = document.getElementById('copy-story-btn-text');
  if (copyBtn && copyBtnText) {
    copyBtn.addEventListener('click', () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        copyBtnText.textContent = '✅ ¡Enlace copiado!';
        setTimeout(() => {
          copyBtnText.textContent = '🔗 Copiar enlace';
        }, 2500);
      });
    });
  }
</script>
