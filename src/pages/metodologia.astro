---
import Layout from '../layouts/Layout.astro';
import { OUTLETS_REGISTRY } from '../utils/outlets';
import type { OutletMeta, Ideology, FactualityRating, FundingType } from '../types';

export type OutletDetail = OutletMeta;

const OUTLETS_CATALOG: OutletMeta[] = Object.values(OUTLETS_REGISTRY);

const totalOutlets = OUTLETS_CATALOG.length;
const nationalCount = OUTLETS_CATALOG.filter(o => o.category === 'nacional').length;
const foreignCount = OUTLETS_CATALOG.filter(o => o.category === 'internacional').length;

const FUNDING_LABELS: Record<FundingType, string> = {
  privado_corporativo: 'Corporativo / Privado',
  sindical_partidario: 'Sindical / Partidario',
  publico_estatal: 'Público / Estatal',
  independiente_suscripcion: 'Independiente / Suscripción',
};

const IDEOLOGY_LABELS: Record<Ideology, string> = {
  izquierda: 'Izquierda',
  centro_izquierda: 'Centro-Izquierda',
  centro: 'Centro',
  centro_derecha: 'Centro-Derecha',
  derecha: 'Derecha',
};

const IDEOLOGY_BADGES: Record<Ideology, string> = {
  izquierda: 'bg-rose-100 text-rose-800 dark:bg-rose-950/70 dark:text-rose-300 border-rose-300 dark:border-rose-800',
  centro_izquierda: 'bg-amber-100 text-amber-800 dark:bg-amber-950/70 dark:text-amber-300 border-amber-300 dark:border-amber-800',
  centro: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800',
  centro_derecha: 'bg-sky-100 text-sky-800 dark:bg-sky-950/70 dark:text-sky-300 border-sky-300 dark:border-sky-800',
  derecha: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950/70 dark:text-indigo-300 border-indigo-300 dark:border-indigo-800',
};

const FACTUALITY_LABELS: Record<FactualityRating, string> = {
  muy_alta: 'Muy Alta',
  alta: 'Alta',
  mixta: 'Mixta',
};

const FACTUALITY_BADGES: Record<FactualityRating, string> = {
  muy_alta: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/30',
  alta: 'bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/30',
  mixta: 'bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/30',
};
---

<Layout 
  title="Metodología Científica, Fórmula Editorial y Catálogo de 31 Medios • Politicheck"
  description="Conocé en detalle la fórmula matemática del espectro editorial, la auditoría documental con el Boletín Oficial y el catálogo público de los 31 medios monitoreados sin pauta oficial."
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 space-y-16">
    
    <!-- Top Breadcrumb Navigation -->
    <nav class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4 text-xs font-sans">
      <a href="/" class="inline-flex items-center gap-1.5 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors">
        <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Volver a la Portada del Observatorio</span>
      </a>
      <div class="flex items-center gap-2 text-slate-400 dark:text-slate-500">
        <span>Documento Metodológico v2.5</span>
        <span aria-hidden="true">|</span>
        <span>Revisión Septiembre 2026</span>
      </div>
    </nav>

    <!-- Hero Header: Institutional Manifesto -->
    <header class="space-y-6 max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 text-xs font-sans font-semibold shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 motion-safe:animate-pulse" aria-hidden="true"></span>
        <span>Transparencia cívica y neutralidad algorítmica</span>
      </div>
      
      <h1 class="font-editorial text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 dark:text-white leading-[1.1] tracking-tight">
        Cómo Funciona Politicheck
      </h1>

      <p class="text-lg sm:text-xl text-slate-700 dark:text-slate-300 font-editorial leading-relaxed">
        Un observatorio cívico automatizado para contrastar el sesgo de la prensa, desarmar cámaras de eco partidarias y auditar los compromisos de campaña con prueba documental primaria verificable.
      </p>

      <!-- Key Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4">
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800">
          <div class="font-mono text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white">{totalOutlets}</div>
          <div class="text-xs font-sans text-slate-500 dark:text-slate-400 mt-0.5">Medios en simultáneo</div>
          <div class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">15 Nac. / 16 Internacionales</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800">
          <div class="font-mono text-2xl sm:text-3xl font-bold text-emerald-600 dark:text-emerald-400">$0</div>
          <div class="text-xs font-sans text-slate-500 dark:text-slate-400 mt-0.5">Pauta oficial</div>
          <div class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">100% Independencia Financiera</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800">
          <div class="font-mono text-2xl sm:text-3xl font-bold text-blue-600 dark:text-blue-400">100%</div>
          <div class="text-xs font-sans text-slate-500 dark:text-slate-400 mt-0.5">Fuentes primarias</div>
          <div class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Boletín Oficial e INDEC</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800">
          <div class="font-mono text-2xl sm:text-3xl font-bold text-purple-600 dark:text-purple-400">SHA-256</div>
          <div class="text-xs font-sans text-slate-500 dark:text-slate-400 mt-0.5">Voto anti-fraude</div>
          <div class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Anonimato Criptográfico</div>
        </div>
      </div>
    </header>

    <!-- Quick Navigation Index / Jump Anchors -->
    <div class="sticky top-2 z-20 p-2.5 rounded-2xl bg-white/90 dark:bg-slate-900/90 backdrop-blur border border-slate-200 dark:border-slate-800 shadow-sm overflow-x-auto">
      <div class="flex items-center gap-2 text-xs font-sans whitespace-nowrap px-1">
        <span class="text-slate-400 text-[11px] font-bold mr-1">Índice:</span>
        <a href="#manifiesto" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 transition-colors">1. Manifiesto Cívico</a>
        <a href="#espectro" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 transition-colors">2. Fórmula del Espectro</a>
        <a href="#catalogo" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 transition-colors">3. Catálogo de 31 Medios</a>
        <a href="#promesas" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 transition-colors">4. Monitor de Promesas</a>
        <a href="#antifraude" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 transition-colors">5. Voto Anti-Fraude</a>
      </div>
    </div>

    <!-- SECTION 1: MANIFIESTO CÍVICO -->
    <section id="manifiesto" class="scroll-mt-20 p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-6">
      <div class="flex items-center gap-3">
        <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-950 font-mono text-sm font-bold">
          01
        </span>
        <div>
          <h2 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white">
            Manifiesto de Independencia Cívica
          </h2>
          <p class="text-xs font-sans text-slate-500 dark:text-slate-400">Principios rectores de neutralidad, legalidad y financiamiento cero</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        <div class="space-y-2 p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80">
          <div class="flex items-center gap-2 font-sans font-bold text-slate-900 dark:text-slate-100 text-xs">
            <span class="text-emerald-500 font-bold">✓</span> 0% pauta oficial o partidaria
          </div>
          <p class="text-xs">
            Politicheck <strong>no recibe ni aceptará pauta publicitaria</strong> ni transferencias de fondos provenientes de ningún nivel estatal (Nación, Provincias o Municipios) ni de fundaciones ligadas a partidos políticos. El proyecto opera bajo infraestructura austera y donaciones cívicas individuales transparentes.
          </p>
        </div>

        <div class="space-y-2 p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80">
          <div class="flex items-center gap-2 font-sans font-bold text-slate-900 dark:text-slate-100 text-xs">
            <span class="text-blue-500 font-bold">✓</span> Derecho de cita (Ley 11.723)
          </div>
          <p class="text-xs">
            Respetamos estrictamente la propiedad intelectual de las redacciones. No realizamos web scraping invasivo ni eludimos barreras de pago (paywalls). Consumimos únicamente los <strong>feeds RSS públicos y oficiales</strong> emitidos por los medios, enmarcado en el artículo 10 de la Ley 11.723 de la República Argentina, vinculando siempre con enlace saliente directo a la nota original.
          </p>
        </div>

        <div class="space-y-2 p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80">
          <div class="flex items-center gap-2 font-sans font-bold text-slate-900 dark:text-slate-100 text-xs">
            <span class="text-purple-500 font-bold">✓</span> Neutralidad algorítmica
          </div>
          <p class="text-xs">
            El sistema de clusterización y asignación de espectro opera bajo modelos de lenguaje de última generación (Google Gemini) mediante prompts determinísticos con temperatura reducida. Las reglas de ponderación son públicas, inalterables por presiones de coyuntura y auditables por cualquier ciudadano.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 2: FÓRMULA MATEMÁTICA DEL ESPECTRO -->
    <section id="espectro" class="scroll-mt-20 p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-8">
      <div class="flex items-center gap-3">
        <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-950 font-mono text-sm font-bold">
          02
        </span>
        <div>
          <h2 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white">
            Fórmula Matemática del Espectro Editorial
          </h2>
          <p class="text-xs font-sans text-slate-500 dark:text-slate-400">Cómo calculamos la distribución de Oficialismo, Centro-Datos y Oposición</p>
        </div>
      </div>

      <!-- Definition of the 3 Leanings -->
      <div class="space-y-3">
        <h3 class="text-xs font-sans font-bold text-slate-700 dark:text-slate-300">
          Definición fáctica de los tres polos
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-4 rounded-xl border border-purple-200 dark:border-purple-900/60 bg-purple-50/50 dark:bg-purple-950/20 space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-purple-600" aria-hidden="true"></span>
              <span class="font-bold text-purple-950 dark:text-purple-300 font-sans text-sm">Oficialismo</span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Titulares y notas con encuadre prioritario en los logros del Gobierno Nacional, defensa de medidas del Poder Ejecutivo, citas extensas y preeminentes a voceros oficiales, o énfasis en beneficios macroeconómicos y reformas pro-mercado.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/50 dark:bg-emerald-950/20 space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-emerald-600" aria-hidden="true"></span>
              <span class="font-bold text-emerald-950 dark:text-emerald-300 font-sans text-sm">Centro / Fáctico / Datos</span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Cobertura ceñida estrictamente a datos duros verificables (cotizaciones cambiarias, índices de inflación INDEC, balances del BCRA, cables de agencia) con citas equilibradas a todas las partes involucradas y ausencia de adjetivación editorial valorativa.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-amber-200 dark:border-amber-900/60 bg-amber-50/50 dark:bg-amber-950/20 space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-amber-600" aria-hidden="true"></span>
              <span class="font-bold text-amber-950 dark:text-amber-300 font-sans text-sm">Oposición</span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Titulares y notas que enfatizan el costo social del ajuste, pérdida del poder adquisitivo, reclamos sindicales, amparos judiciales contra decretos o críticas expresas de dirigentes y bloques parlamentarios no oficialistas.
            </p>
          </div>
        </div>
      </div>

      <!-- The Mathematical Equation Box -->
      <div class="p-6 rounded-2xl bg-slate-900 text-white dark:bg-slate-950 border border-slate-800 space-y-4 font-mono">
        <div class="flex items-center justify-between text-xs text-slate-400 border-b border-slate-800 pb-3">
          <span class="font-sans font-semibold text-slate-300">Algoritmo de ponderación normalizada base 100</span>
          <span class="text-emerald-400">Σ (P_ofi + P_cen + P_opo) ≡ 100%</span>
        </div>

        <div class="text-center py-4 bg-slate-800/50 rounded-xl border border-slate-700/60 text-lg sm:text-xl font-bold tracking-wider text-slate-100 overflow-x-auto">
          P<sub>k</sub> = ( ∑ [ w<sub>i,k</sub> × α<sub>i</sub> ] / ∑<sub>m</sub> ∑ [ w<sub>i,m</sub> × α<sub>i</sub> ] ) × 100%
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-300 pt-2">
          <div>
            <span class="text-purple-400 font-bold">α<sub>i</sub> (Factor de Prominencia):</span>
            <ul class="list-disc list-inside mt-1 space-y-0.5 text-slate-400">
              <li><strong>1.5</strong>: Gran Apertura / Tapa Principal</li>
              <li><strong>1.2</strong>: Portada sección Política o Economía</li>
              <li><strong>1.0</strong>: Cable general o sección secundaria</li>
            </ul>
          </div>
          <div>
            <span class="text-emerald-400 font-bold">w<sub>i,k</sub> (Vector de Encuadre Semántico):</span>
            <ul class="list-disc list-inside mt-1 space-y-0.5 text-slate-400">
              <li>Peso probabilístico [0.0 a 1.0] extraído del análisis de titular, bajada y adjetivación.</li>
              <li>Ponderado con el sesgo editorial histórico de base de la redacción emisora.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Real Example Walkthrough -->
      <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-950/50 border border-slate-200 dark:border-slate-800 text-xs space-y-2">
        <span class="font-sans font-bold text-slate-900 dark:text-slate-100">Ejemplo práctico de cálculo:</span>
        <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
          Si en una jornada caliente sobre la <em>"Ley de Presupuesto"</em>, 4 redacciones publican con foco en superávit (Oficialismo), 6 presentan cifras cuantitativas de coparticipación sin juicios (Centro) y 5 destacan reclamos de gobernadores por fondos (Oposición), el algoritmo pondera cada artículo según su ubicación en portada y arroja exactamente: <strong>27% Oficialismo, 40% Centro y 33% Oposición</strong>.
        </p>
      </div>
    </section>

    <!-- SECTION 3: CATÁLOGO DE LOS 31 MEDIOS (ESTÁNDAR GROUND NEWS) -->
    <section id="catalogo" class="scroll-mt-20 p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-950 font-mono text-sm font-bold">
            03
          </span>
          <div>
            <h2 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-950 dark:text-white">
              Catálogo de Medios Monitoreados ({totalOutlets})
            </h2>
            <p class="text-xs font-mono text-slate-500 dark:text-slate-400">
              {nationalCount} redacciones nacionales y {foreignCount} periódicos internacionales bajo auditoría tripartita
            </p>
          </div>
        </div>

        <!-- Live Search Box for Outlets -->
        <div class="relative w-full sm:w-80">
          <input 
            type="search" 
            id="outlet-search-input" 
            placeholder="Buscar por medio, dueño, sesgo, país..."
            class="w-full text-xs font-mono px-3 py-2 pl-8 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 dark:focus:ring-white transition"
          />
          <svg aria-hidden="true" class="w-4 h-4 text-slate-400 absolute left-2.5 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Ground News Tripartite Standard Framework Info Banner -->
      <div class="p-4 sm:p-5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 space-y-3">
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" class="w-4 h-4 text-slate-600 dark:text-slate-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>
          <h3 class="font-sans text-xs font-bold text-slate-900 dark:text-white">
            Metodología tripartita de auditoría (Estándar Ground News)
          </h3>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Siguiendo el modelo de referencia global implementado por <em>Ground News</em>, Politicheck evalúa cada redacción integrando las bases de datos de <strong>AllSides</strong>, <strong>Media Bias/Fact Check (MBFC)</strong> y el <strong>Media Ownership Monitor (MOM / Reporteros Sin Fronteras)</strong> en tres ejes complementarios:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-1 text-xs font-sans">
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 space-y-1">
            <span class="font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
              1. Ideología y sesgo
            </span>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-normal">
              Posición editorial en escala AllSides/MBFC de 5 puntos (Izquierda a Derecha) ponderada con el escenario argentino.
            </p>
          </div>
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 space-y-1">
            <span class="font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
              2. Calidad factual
            </span>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-normal">
              Nivel de rigor periodístico y respaldo documental (Muy Alta, Alta o Mixta) según auditorías de verificación y políticas de rectificación de errores.
            </p>
          </div>
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 space-y-1">
            <span class="font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
              3. Propiedad y control
            </span>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-normal">
              Transparencia corporativa sobre grupos de medios, accionistas mayoritarios y tipo de financiamiento según el Media Ownership Monitor.
            </p>
          </div>
        </div>
      </div>

      <!-- Callout to Pillar Page: Mapa de Medios de Argentina -->
      <div class="p-4 sm:p-5 rounded-xl border border-sky-200 dark:border-sky-900/60 bg-sky-50/50 dark:bg-sky-950/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-sans">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded text-[11px] font-sans font-bold bg-sky-500/20 text-sky-700 dark:text-sky-300">
              Investigación especial
            </span>
            <span class="font-bold text-slate-950 dark:text-white text-xs sm:text-sm font-sans">
              Mapa del Ecosistema de Medios en Argentina
            </span>
          </div>
