  </main>
</Layout>

<!-- Client-side script for Outlet Catalog live filtering & search -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('outlet-search-input');
    const catButtons = document.querySelectorAll('.outlet-cat-btn');
    const factualityFilter = document.getElementById('outlet-factuality-filter');
    const ideologyFilter = document.getElementById('outlet-ideology-filter');
    const outletCards = document.querySelectorAll('.outlet-card');
    const noResultsMsg = document.getElementById('no-outlets-found');
    const countDisplay = document.getElementById('visible-outlets-count');

    let currentCategory = 'all';
    let currentFactuality = 'all';
    let currentIdeology = 'all';
    let searchQuery = '';

    function filterOutlets() {
      let visibleCount = 0;

      outletCards.forEach(card => {
        const name = card.getAttribute('data-name') || '';
        const code = card.getAttribute('data-code') || '';
        const country = card.getAttribute('data-country') || '';
        const category = card.getAttribute('data-category') || '';
        const leaning = card.getAttribute('data-leaning') || '';
        const ideology = card.getAttribute('data-ideology') || '';
        const factuality = card.getAttribute('data-factuality') || '';
        const group = card.getAttribute('data-group') || '';

        const matchesCategory = currentCategory === 'all' || category === currentCategory;
        const matchesFactuality = currentFactuality === 'all' || factuality === currentFactuality;
        const matchesIdeology = currentIdeology === 'all' || ideology === currentIdeology;
        const matchesSearch = !searchQuery || 
          name.includes(searchQuery) || 
          code.includes(searchQuery) || 
          country.includes(searchQuery) || 
          leaning.includes(searchQuery) ||
          ideology.includes(searchQuery) ||
          group.includes(searchQuery);

        if (matchesCategory && matchesFactuality && matchesIdeology && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countDisplay) {
        countDisplay.textContent = visibleCount;
      }

      if (noResultsMsg) {
        if (visibleCount === 0) {
          noResultsMsg.classList.remove('hidden');
        } else {
          noResultsMsg.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target.value || '').trim().toLowerCase();
        filterOutlets();
      });
    }

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.classList.remove('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-950');
          b.classList.add('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');
        });

        btn.classList.add('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-950');
        btn.classList.remove('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');

        currentCategory = btn.getAttribute('data-filter') || 'all';
        filterOutlets();
      });
    });

    if (factualityFilter) {
      factualityFilter.addEventListener('change', (e) => {
        currentFactuality = e.target.value;
        filterOutlets();
      });
    }

    if (ideologyFilter) {
      ideologyFilter.addEventListener('change', (e) => {
        currentIdeology = e.target.value;
        filterOutlets();
      });
    }
  });
</script>
