---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Politicheck • Monitor de Sesgo Mediático y Promesas Electorales | Argentina",
  description = "Plataforma cívica independiente para comparar el sesgo y encuadre entre medios de noticias en Argentina y auditar compromisos electorales."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Editorial Web Fonts (Preconnected for instant performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..800;1,6..72,400..800&family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {import.meta.env.DEV && (
      <link rel="stylesheet" href="/src/styles/global.css" />
    )}
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://politicheck.ar" />
    <meta property="og:site_name" content="Politicheck Argentina" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://politicheck.ar/images/universidad.jpg" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://politicheck.ar" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://politicheck.ar/images/universidad.jpg" />
    
    <link rel="canonical" href="https://politicheck.ar" />

    <!-- Search Engine Indexing & Bot Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="author" content="Politicheck Argentina" />
    <meta name="keywords" content="sesgo mediático, noticias argentina, encuadre de medios, elecciones argentina, promesas de campaña, verificación periodística, espectro editorial, clarín, la nación, infobae, página 12, ámbito" />

    <!-- Theme & Colors -->
    <meta name="theme-color" content="#090D16" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F8FAFC" media="(prefers-color-scheme: light)" />

    <!-- Structured Data (JSON-LD) for Google Rich Snippets -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "NewsMediaOrganization",
            "@id": "https://politicheck.ar/#organization",
            "name": "Politicheck",
            "url": "https://politicheck.ar",
            "logo": {
              "@type": "ImageObject",
              "url": "https://politicheck.ar/favicon.svg"
            },
            "description": "Plataforma cívica independiente para comparar el sesgo y encuadre entre medios de noticias en Argentina y auditar compromisos electorales."
          },
          {
            "@type": "WebSite",
            "@id": "https://politicheck.ar/#website",
            "url": "https://politicheck.ar",
            "name": "Politicheck",
            "publisher": {
              "@id": "https://politicheck.ar/#organization"
            },
            "inLanguage": "es-AR"
          }
        ]
      }
    </script>

    <!-- Theme Initialization Script (Prevents FOUC) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('politicheck-theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#F8FAFC] dark:bg-[#090D16] text-slate-900 dark:text-slate-100 antialiased selection:bg-slate-300 dark:selection:bg-slate-700 selection:text-slate-900 dark:selection:text-white transition-colors duration-200">
    <Header />
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
