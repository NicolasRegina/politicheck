---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShareModal from '../components/ShareModal.astro';
import PwaBanner from '../components/PwaBanner.astro';
import LiveChat from '../components/LiveChat.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  preloadImage?: string;
  preloadImageMobile?: string;
  stories?: any[];
  serverSyncIso?: string | null;
}

const { 
  title = "Politicheck • Noticias de Política Argentina, Sesgo de Medios y Elecciones 2027",
  description = "Observatorio cívico de política argentina y cobertura periodística. Compará el sesgo mediático de 31 redacciones en tiempo real y auditá las promesas de campaña camino a las Elecciones 2027.",
  image = "/images/social/twitter_banner.jpg",
  canonicalUrl = "https://www.politicheck.com.ar",
  ogType = "website",
  preloadImage,
  preloadImageMobile,
  stories,
  serverSyncIso
} = Astro.props;

// Ensure absolute image url for Social Media previews
const absoluteImageUrl = image.startsWith('http') ? image : `https://www.politicheck.com.ar${image}`;
---

<!doctype html>
<html lang="es" class="scroll-smooth overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Politicheck" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Image CDN Preconnect for instantaneous mobile LCP -->
    <link rel="preconnect" href="https://wsrv.nl" crossorigin />

    <!-- Editorial Web Fonts (ADR-0008: Fraunces + DM Sans + JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" id="editorial-fonts" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,SOFT,wght@0,9..144,50,600..800;1,9..144,50,500&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <script is:inline>
      const ef = document.getElementById('editorial-fonts');
      if (ef) ef.rel = 'stylesheet';
    </script>
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,SOFT,wght@0,9..144,50,600..800;1,9..144,50,500&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    </noscript>

    {preloadImage && (
      <link 
        rel="preload" 
        as="image" 
        href={preloadImage}
        imagesrcset={preloadImageMobile ? `${preloadImageMobile} 480w, ${preloadImage} 800w` : undefined}
        imagesizes={preloadImageMobile ? '(max-width: 640px) 100vw, 800px' : undefined}
        fetchpriority="high" 
      />
    )}
    {import.meta.env.DEV && (
      <link rel="stylesheet" href="/src/styles/global.css" />
    )}
    
    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="gPSqhiXNmTHAEtjvIsK-z_0f1DoQh-aw68CYkpE6cf0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Politicheck Argentina" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@politicheck_ok" />
    <meta name="twitter:creator" content="@politicheck_ok" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />
    
    <link rel="canonical" href={canonicalUrl} />

    <!-- Search Engine Indexing & Bot Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="author" content="Politicheck Argentina" />
    <meta name="keywords" content="politica argentina, elecciones 2027, elecciones brasil 2026, lula da silva, elecciones presidenciales brasil, candidatos argentina, sesgo mediatico, encuadre de medios, noticias politica argentina, promesas de campaña, clarin, la nacion, infobae, pagina 12, ambito, editorial perfil, verificacion periodistica, espectro politico" />

    <!-- Theme & Colors (ADR-0008: Crema Editorial / Carbón Cálido) -->
    <meta name="theme-color" content="#121210" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAF9F6" media="(prefers-color-scheme: light)" />

    <!-- Structured Data (JSON-LD) for Google Rich Snippets -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "NewsMediaOrganization",
            "@id": "https://www.politicheck.com.ar/#organization",
            "name": "Politicheck",
            "url": "https://www.politicheck.com.ar",
            "logo": {
              "@type": "ImageObject",
              "url": "https://www.politicheck.com.ar/favicon.svg"
            },
            "description": "Plataforma cívica independiente para comparar el sesgo y encuadre entre medios de noticias en Argentina y auditar compromisos electorales."
          },
          {
            "@type": "WebSite",
            "@id": "https://www.politicheck.com.ar/#website",
            "url": "https://www.politicheck.com.ar",
            "name": "Politicheck",
            "publisher": {
              "@id": "https://www.politicheck.com.ar/#organization"
            },
            "inLanguage": "es-AR"
          }
        ]
      }
    </script>

    <!-- Theme Initialization Script (Default to White/Light Theme) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('politicheck-theme');
      // Default to Light Mode as explicitly requested
      if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-canvas text-ink antialiased selection:bg-accent-soft selection:text-ink transition-colors duration-200 overflow-x-clip w-full pb-16 md:pb-0">
    <Header stories={stories} serverSyncIso={serverSyncIso} />
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">
      <slot />
    </main>
    <Footer />
    <ShareModal />
    <PwaBanner />
    <LiveChat />

    <!-- Global Floating Toast Notification (Bottom-left to avoid collision with LiveChat & Mobile Bottom Nav) -->
    <div 
      id="politicheck-toast" 
      class="fixed bottom-20 md:bottom-6 left-4 md:left-6 z-50 transform translate-y-20 opacity-0 pointer-events-none motion-safe:transition-transform transition-opacity duration-300 max-w-sm w-[calc(100vw-2rem)] sm:w-full p-4 rounded-md bg-ink text-canvas shadow-lg border border-rule flex items-start gap-3"
      role="alert"
    >
      <div id="toast-icon" class="shrink-0 mt-0.5 text-emerald-400 dark:text-emerald-600" aria-hidden="true">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
      </div>
      <div class="flex-1 space-y-1">
        <p id="toast-title" class="text-xs font-sans font-bold tracking-tight"></p>
        <p id="toast-message" class="text-[11px] font-sans text-slate-300 dark:text-slate-700 leading-snug"></p>
        <div id="toast-actions" class="hidden pt-1.5 flex items-center gap-2"></div>
      </div>
      <button 
        type="button" 
        id="toast-close-btn"
        class="text-slate-400 hover:text-white dark:hover:text-black cursor-pointer text-sm font-bold shrink-0 ml-1"
        aria-label="Cerrar notificación"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <script is:inline>
      let toastTimeout = null;

      function hidePoliticheckToast() {
        const toast = document.getElementById('politicheck-toast');
        if (toast) {
          toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        }
        if (toastTimeout) clearTimeout(toastTimeout);
      }

      function showPoliticheckToast(title, message, icon = 'check', actions = []) {
        const toast = document.getElementById('politicheck-toast');
        const titleEl = document.getElementById('toast-title');
        const msgEl = document.getElementById('toast-message');
        const iconEl = document.getElementById('toast-icon');
        const actionsEl = document.getElementById('toast-actions');

        if (!toast || !titleEl || !msgEl) return;

        titleEl.textContent = title;
        msgEl.textContent = message;
        if (iconEl && typeof icon === 'string' && !icon.startsWith('<')) {
          // Keep clean SVG if generic string key is passed
          if (icon === 'link') {
            iconEl.innerHTML = '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>';
          } else {
            iconEl.innerHTML = '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
          }
        }

        if (actionsEl) {
          if (actions && actions.length > 0) {
            actionsEl.innerHTML = '';
            actionsEl.classList.remove('hidden');
            actions.forEach(a => {
              const link = document.createElement('a');
              link.href = a.url;
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              link.className = `px-2.5 py-1 rounded-md text-[10px] font-sans font-bold motion-safe:transition-transform motion-safe:hover:scale-105 ${a.bg || 'bg-slate-800 text-white'}`;
              link.textContent = a.label;
              actionsEl.appendChild(link);
            });
          } else {
            actionsEl.classList.add('hidden');
          }
        }

        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');

        if (toastTimeout) clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => {
          hidePoliticheckToast();
        }, 6000);
      }

      document.getElementById('toast-close-btn')?.addEventListener('click', hidePoliticheckToast);

      // Global share function
      window.sharePoliticheckContent = function(title, text, url, category) {
        if (typeof window.openShareModal === 'function') {
          window.openShareModal({ title, text, url, category });
        } else if (navigator.share && /mobile|android|iphone|ipad/i.test(navigator.userAgent)) {
          navigator.share({ title, text, url }).catch(() => {});
        } else {
          navigator.clipboard.writeText(url).then(() => {
            const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(text + ' ' + url)}`;
            const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}`;
            const tgUrl = `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`;

            showPoliticheckToast(
              '¡Enlace copiado al portapapeles!',
              'Listo para pegar o compartir directamente:',
              'link',
              [
                { label: 'WhatsApp', url: waUrl, bg: 'bg-emerald-600 text-white' },
                { label: 'X / Twitter', url: xUrl, bg: 'bg-black text-white dark:bg-slate-800' },
                { label: 'Telegram', url: tgUrl, bg: 'bg-sky-500 text-white' }
              ]
            );
          }).catch(() => {
            window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text + ' ' + url)}`, '_blank');
          });
        }
      };
    </script>
  </body>
</html>
